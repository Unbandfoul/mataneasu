u002f\u002e\u004d\u0071\u0076\u0065\u006f\u0029\u007d\u005b\u0038\u004e\u0022\u002a\u0079\u0047\u0064\u0050\u0035\u0045\u0051\u007d\u0069\u007b\u006d\u003e\u0074\u0036\u0046\u0061\u0058\u003e\u0053\u0066\u0057\u0070\u0048\u0075\u0041\u0059\u005e\u0062\u0049\u002e\u006e\u0064\u0032\u0033\u002f\u002e\u004d\u0071\u0076\u0065\u006f\u0029\u007d\u005b\u0038\u004e\u0022\u002a\u0079\u0047\u0064\u0050\u0035\u0045\u0051\u007d\u0069\u007b\u006d\u003e\u0074\u0045\u0062\u004f\u004a\u0040\u005d\u0042\u006e\u0031\u004c\u0076\u0054\u0079\u003e\u002f\u004d\u0022\u006b\u0036\u0042\u004b\u004c\u0059\u002b\u006d\u0063\u0037\u005f\u0021\u0067\u003a\u0079\u0063\u0023\u0063\u0060\u003a\u002b\u0063\u0023\u007e\u0079\u004a\u0051\u0042\u006e\u0031\u004c\u0070\u0042\u004b\u006c\u0031\u004d\u0075\u0041\u002e\u005e\u0062\u0049\u002e\u006e\u0064\u0032\u0033\u002f\u002e\u004d\u0071\u0076\u0065\u006f\u0029\u007d\u005b\u0038\u004e\u0022\u002a\u0079\u0047\u0064\u0050\u0035\u0045\u0051\u007d\u0069\u007b\u006d\u003e\u0074\u0036\u0046\u0061\u0058\u003e\u0053\u0066\u0057\u0070\u0048\u0075\u0041\u0059\u005e\u0062\u0049\u002e\u006e\u0064\u0032\u0033\u002f\u002e\u004d\u0071\u0076\u0065\u006f\u0029\u007d\u005b\u0038\u004e\u0022\u002a\u0079\u0047\u0064\u0050\u0035\u0045\u0051\u007d\u0069\u007b\u006d\u003e\u0074\u0036\u0046\u0061\u0058\u003e\u0053\u0066\u0057\u0070\u0048\u0075\u0041\u0059\u005e\u0025\u004e\u0074\u005e\u0075\u004a\u0040\u005d\u0021\u006a\u0075\u004a\u0040\u005d\u0021\u006a\u0075\u004a\u0040\u005d\u0021\u006a\u0075\u004a\u007a\u0061\u007b\u004e\u0073\u006b\u0065\u0048\u0066\u0021\u002c\u0050\u0071\u005f\u003c\u007a\u006c\u0072\u004b\u0042\u0021\u007b\u002a\u0051\u003f\u0051\u007e\u002a\u0054\u004b\u0031\u0069\u0079\u0038\u0077\u0076\u0026\u003d\u0038\u0030\u0055\u0077\u0067\u002a\u0069\u0041\u005b\u006c\u0060\u0066\u0064\u0024\u0042\u0077\u0028\u0028\u0036\u003e\u0029\u004d\u006e\u0023\u004d\u006c\u0068\u003d\u0046\u006c\u007d\u005e\u0046\u0040\u0076\u0060\u0031\u0079\u0026\u007d\u003d\u0021\u005d\u006d\u0058\u0057\u0079\u0078\u0039\u007b\u0048\u0036\u003d\u006d\u0024\u0032\u002e\u0026\u0039\u002a\u006c\u005d\u003d\u0075\u0034\u0024\u006f\u0038\u002a\u0072\u0068\u0074\u0067\u0056\u0053\u0045\u005d\u004b\u007e\u006a\u0039\u0064\u0047\u0066\u0069\u0023\u0049\u0049\u0062\u0031\u004d\u006c\u004e\u0022\u003f\u0035\u0079\u0059\u0044\u0046\u0024\u003b\u0065\u0076\u0063\u007b\u0074\u0042\u0034\u006a\u0060\u0058\u0079\u0029\u007c\u005f\u004f\u006c\u0040\u002b\u0064\u0075\u0078\u003a\u0061\u003e\u003b\u0047\u002a\u0073\u006c\u0061\u0059\u005d\u007b\u0049\u0043\u0062\u005a\u002e\u0022\u004d\u0065\u0036\u0033\u003e\u005d\u002e\u006f\u0078\u0039\u0047\u006e\u0030\u006f\u005d\u004e\u0025\u0024\u0063\u0078\u003f\u0030\u004a\u0073\u0028\u0028\u002e\u0022\u004d\u0065\u0036\u0033\u006f\u0057\u0073\u004b\u0067\u005d\u0046\u006f\u007d\u004e\u0059\u006d\u0068\u0033\u0048\u002b\u0029\u003a\u0076\u0066\u006c\u0028\u0039\u007a\u007c\u0058\u003d\u006a\u005d\u0022\u005b\u0032\u0044\u0060\u0022\u004e\u0044\u0046\u004e\u0042\u004b\u004c\u006e\u0038\u0078\u0059\u0045\u0059\u0048\u005b\u0059\u003e\u002f\u003d\u0056\u003d\u004c\u0078\u0026\u0034\u003e\u005d\u005d\u003f\u0053\u004f\u0053\u0075\u0029\u0071\u0049\u007b\u0021\u004c\u0056\u0073\u0047\u004a\u0028\u0053\u0056\u003a\u0028\u0032\u0068\u0033\u0024\u0034\u004a\u0052\u002e\u002a\u0026\u004a\u0044\u003a\u0026\u0078\u0076\u0028\u0049\u003b\u0034\u007d\u0062\u0067\u003d\u007b\u0036\u0076\u0079\u004a\u0072\u0026\u0062\u0054\u0039\u0021\u006c\u0076\u0073\u004f\u002f\u0036\u0061\u0024\u003c\u0062\u0028\u003a\u0040\u0051\u0047\u0036\u006c\u006e\u0043\u0065\u005e\u0037\u004c\u0065\u007b\u0032\u004f\u006a\u002b\u0030\u0028\u0067\u0046\u0070\u0032\u0045\u0062\u0069\u005a\u007e\u006c\u006e\u0062\u0065\u0044\u0078\u006f\u0071\u006b\u007d\u0054\u0064\u0076\u0025\u0040\u0052\u0056\u0051\u0055\u0053\u0040\u0029\u0031\u0068\u002e\u003b\u0072\u0035\u0048\u0045\u002c\u0039\u0047\u004e\u002a\u0056\u0063\u0037\u0021\u0033\u0035\u0070\u0075\u0024\u0062\u0069\u005a\u007e\u006c\u006e\u0062\u0065\u0044\u0078\u006f\u0071\u006b\u007d\u0054\u0064\u0076\u0025\u0040\u0052\u0056\u0051\u0055\u0053\u0040\u0029\u0031\u0068\u002e\u003b\u0072\u0035\u0048\u0045\u002c\u0039\u0047\u004e\u002a\u0056\u0063\u0037\u0021\u0033\u0035\u0070\u0075\u0024\u0062\u0069\u0021\u0076\u004b\u0041\u0022\u0058\u0029\u003a\u0060\u005b\u0042\u002c\u0032\u0049\u0041\u0058\u0052\u0047\u0054\u006e\u0073\u0045\u0034\u007e\u0060\u004e\u002e\u007c\u0072\u0072\u0024\u0050\u0042\u003b\u0073\u0065\u002c\u0032\u006d\u0071\u0034\u0030\u0028\u0067\u003a\u007e\u0060\u005b\u0042\u002c\u0047\u0064\u006b\u0041\u002e\u0046\u002c\u0039\u0075\u004e\u002a\u0056\u007b\u0064\u0063\u006c\u0021\u0072\u0035\u0048\u0045\u002c\u0039\u0047\u004e\u002a\u0056\u0063\u0037\u0021\u0033\u0035\u0070\u0075\u0024\u0062\u0069\u005a\u007e\u006c\u006e\u0062\u0065\u0044\u0078\u006f\u0071\u006b\u007d\u0054\u0064\u0076\u0025\u0040\u0052\u0056\u0051\u0055\u0053\u0040\u0029\u0031\u0068\u002e\u003b\u0072\u0035\u0048\u0045\u002c\u0039\u0047\u004e\u002a\u0056\u0063\u0037\u0021\u0033\u0035\u0070\u0075\u0024\u0062\u0069\u005a\u007e\u006c\u006e\u0062\u0065\u0044\u0078\u006f\u0071\u006b\u007d\u0054\u0064\u0076\u0025\u0040\u0052\u0056\u0051\u0055\u0053\u0040\u0029\u0031\u0068\u0028\u0059\u002b\u0030\u0028\u0067\u003a\u007e\u0034\u0030\u0028\u0067\u0077\u0038\u002c\u005e\u0074\u004c\u007b\u0071\u004a\u0063\u0064\u0036\u0061\u0067\u006a\u0075\u0047\u0033\u004a\u0033\u0030\u002b\u0076\u0038\u0078\u0034\u0030\u004d\u0029\u0045\u002c\u0046\u006a\u007a\u006a\u0074\u0066\u006b\u0041\u0041\u0048\u0079\u002f\u0026\u007c\u0029\u0036\u004c\u002a\u0044\u0041\u0060\u003d\u007c\u0040\u0036\u0039\u005a\u0055\u0037\u0038\u0079\u0078\u0033\u002f\u005f\u0028\u004a\u0028\u005d\u006b\u004a\u0059\u006a\u0078\u0064\u002f\u0038\u0024\u0058\u003c\u0030\u0056\u0025\u006a\u0056\u0031\u0055\u0065\u0056\u0039\u0030\u005d\u0065\u0034\u007b\u004c\u0063\u004b\u0048\u0041\u0063\u0050\u002b\u0079\u005f\u007b\u006f\u0066\u0029\u0021\u006f\u0056\u007a\u004c\u0060\u0065\u007a\u0076\u004e\u0029\u0060\u0045\u0032\u003c\u005b\u0029\u0063\u0028\u0045\u004f\u0074\u006b\u0074\u0037\u002b\u0043\u0044\u0069\u0074\u0035\u0072\u0043\u003f\u0022\u0028\u0024\u007c\u0069\u0073\u0059\u0030\u0072\u003c\u0076\u006e\u002f\u0045\u0076\u007e\u006e\u0042\u0071\u0061\u0055\u0065\u0047\u0037\u0065\u0028\u007d\u0024\u0034\u0058\u004f\u007d\u007a\u0032\u0038\u002c\u0051\u002f\u006f\u003e\u002f\u007a\u006a\u0049\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u003d\u0054\u006d\u006f\u0044\u002f\u007a\u006a\u0049\u0079\u0051\u0035\u0022\u005f\u0047\u0038\u0055\u0044\u005e\u004f\u0069\u006a\u0025\u0022\u007d\u0035\u0071\u004c\u003c\u007c\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u0067\u005f\u0056\u0061\u0072\u005d\u0043\u0075\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u007c\u002f\u0021\u005a\u0062\u0037\u006e\u0033\u005b\u002f\u0060\u0067\u007c\u007e\u007d\u0031\u007c\u002f\u0021\u005a\u0062\u0037\u006e\u0033\u005b\u002f\u0060\u0067\u007c\u007e\u0063\u002a\u004d\u0034\u002f\u006f\u003e\u002f\u007a\u006a\u0049\u0079\u003f\u0056\u0059\u0044\u0024\u0034\u004e\u0061\u0035\u007e\u0024\u0031\u007c\u002f\u0074\u0059\u0036\u0075\u0042\u0056\u0074\u0053\u0060\u0067\u0055\u007a\u0057\u003c\u005a\u0051\u005d\u006f\u0077\u002f\u0033\u0039\u005f\u0034\u0060\u0067\u0063\u0041\u0032\u0038\u002c\u0051\u002f\u006f\u003e\u002f\u005d\u002e\u0067\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u003d\u0054\u0034\u006f\u0071\u004c\u005a\u007c\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u007b\u0032\u0074\u005a\u0062\u0037\u006e\u0033\u005b\u002f\u0060\u0067\u006a\u0041\u0057\u003c\u005a\u0051\u005d\u006f\u0077\u002f\u0047\u006a\u0067\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u003d\u0054\u006d\u006f\u0072\u005d\u0043\u0075\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u007c\u002f\u0074\u0059\u003c\u0054\u005a\u007d\u0066\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u003d\u0054\u0063\u0076\u006a\u006b\u0028\u007d\u0066\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u003d\u0054\u0063\u0076\u0072\u006b\u003a\u0033\u005b\u002f\u0058\u004f\u007d\u007a\u0032\u0038\u002c\u0051\u0054\u0071\u0074\u006b\u0078\u0056\u005d\u0063\u0058\u004f\u007d\u007a\u0032\u0038\u002c\u0051\u002f\u006f\u003e\u002f\u0063\u0060\u0067\u0079\u0042\u007b\u0079\u0066\u0032\u0038\u002c\u0051\u002f\u006f\u003e\u002f\u0074\u0072\u0067\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u003d\u0054\u0063\u0076\u0072\u006b\u007b\u002c\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u007b\u0032\u0074\u005a\u0062\u0037\u006e\u0033\u005b\u002f\u0060\u0067\u006a\u0041\u0032\u0038\u002c\u0051\u002f\u006f\u003e\u002f\u005d\u002e\u003a\u0034\u0058\u004f\u007d\u007a\u0032\u0038\u002c\u0051\u0054\u0071\u004b\u0051\u0028\u007d\u0024\u0034\u0058\u004f\u007d\u007a\u0032\u0038\u002c\u0051\u0054\u0071\u004a\u006b\u0028\u007d\u0066\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u003d\u0054\u0063\u0076\u0044\u002f\u007a\u006a\u0049\u0079\u0051\u0035\u0022\u005f\u006e\u0051\u0025\u0022\u007d\u0035\u0072\u005d\u0043\u0075\u004f\u003e\u0049\u007d\u005e\u004f\u0069\u006a\u0025\u0022\u007d\u0035\u0071\u004c\u0046\u0075\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u007b\u0032\u0056\u0061\u0072\u006b\u003a\u0033\u005b\u002f\u0058\u004f\u007d\u007a\u0057\u003c\u003a\u0051\u002f\u006f\u003e\u002f\u007a\u006a\u0049\u0079\u005f\u0070\u0022\u005f\u0040\u0078\u0025\u0022\u007d\u0035\u0072\u005d\u0043\u0075\u004f\u003e\u006f\u0062\u0035\u007e\u0024\u0031\u007c\u002f\u0074\u0059\u0056\u0035\u005f\u0044\u006d\u0061\u0044\u002f\u0032\u007c\u0039\u0079\u0051\u0035\u0059\u004f\u0069\u006a\u0025\u0022\u007d\u0035\u0072\u005d\u0043\u0075\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u0023\u0076\u0033\u0059\u0030\u003a\u006e\u0033\u005b\u002f\u0058\u004f\u007d\u007a\u0057\u003c\u0066\u0051\u0054\u0071\u0079\u006b\u003a\u0033\u005b\u002f\u0058\u004f\u007d\u007a\u0057\u003c\u0047\u0051\u002f\u006f\u003e\u002f\u007a\u006a\u0049\u0079\u005f\u0070\u0022\u005f\u0040\u0078\u0025\u0022\u007d\u0035\u0072\u005d\u0043\u0075\u0061\u0047\u0034\u0062\u0035\u007e\u0024\u0031\u007c\u002f\u0021\u005a\u0062\u0037\u0042\u0056\u002a\u003e\u0060\u0067\u004b\u0041\u0032\u0038\u002c\u0051\u002f\u006f\u003e\u002f\u0074\u0072\u003a\u0034\u0060\u0067\u0063\u0041\u0032\u0038\u002c\u0051\u002f\u006f\u003e\u002f\u007a\u006a\u0049\u0079\u0051\u0035\u0022\u005f\u0054\u0037\u006c\u0044\u0021\u005b\u0063\u002a\u0045\u0054\u0038\u0024\u0071\u004c\u004b\u0075\u004f\u003e\u0052\u0062\u0038\u007e\u007c\u0031\u006f\u0069\u0033\u0059\u007c\u002c\u0042\u0056\u0028\u0030\u004e\u0061\u0072\u0041\u003f\u0031\u006f\u0069\u0033\u0059\u0030\u003a\u005a\u007d\u0066\u0079\u0071\u0048\u0022\u005f\u0049\u0034\u003d\u0054\u004f\u0024\u0071\u004c\u0024\u007c\u004f\u003e\u0052\u0062\u0039\u0057\u002e\u002a\u0045\u0054\u0038\u0024\u0071\u004c\u004b\u0075\u004f\u003e\u0052\u0062\u0038\u007e\u007c\u0031\u006f\u0069\u0033\u0059\u007c\u002c\u0042\u0056\u0028\u0030\u004e\u0061\u0072\u0041\u003f\u0031\u006f\u0069\u0033\u0059\u0030\u003a\u005a\u007d\u0066\u0079\u0071\u0048\u0022\u005f\u0049\u0034\u003d\u0054\u0022\u0076\u0071\u004c\u004b\u0075\u004f\u003e\u004b\u007c\u0048\u005b\u0063\u002a\u004f\u0044\u0021\u005b\u0063\u002a\u0044\u002a\u0022\u0057\u006e\u0032\u0045\u0039\u0071\u0073\u0079\u006c\u0052\u003c\u0047\u003d\u007a\u0043\u0051\u007d\u006a\u004c\u003f\u005b\u0064\u002a\u005b\u0055\u007e\u007d\u002c\u004e\u002a\u0064\u0052\u0051\u005b\u0053\u003e\u003e\u002e\u007e\u0029\u006b\u007b\u006d\u0032\u0061\u0048\u006d\u0025\u007c\u0076\u006d\u004d\u007d\u0051\u0049\u006c\u0072\u007d\u005e\u0064\u006c\u0057\u0061\u0037\u0025\u0061\u003e\u0060\u0043\u002b\u0067\u0061\u0037\u0040\u0045\u0062\u002b\u0076\u0039\u0059\u0071\u0075\u0057\u0037\u005b\u0079\u0044\u007d\u002b\u0052\u0035\u0035\u004b\u004a\u0039\u0061\u002e\u0048\u002c\u0035\u0045\u005d\u0071\u0044\u007d\u0079\u0023\u0044\u006d\u005f\u0048\u0036\u002a\u002c\u005a\u0074\u0066\u0021\u0075\u005b\u0028\u0038\u0065\u0046\u0042\u004b\u0066\u002a\u004b\u0053\u005b\u0068\u0067\u0076\u007d\u0060\u006e\u005d\u007d\u007d\u002a\u0076\u0043\u0069\u005d\u0079\u005e\u0044\u0065\u0029\u0071\u0063\u007e\u004f\u007b\u0060\u0050\u003f\u0024\u0055\u0021\u0055\u0073\u0068\u004a\u002c\u007a\u003c\u0036\u002c\u0026\u0023\u005a\u002c\u0056\u004f\u0024\u006b\u0025\u0071\u002c\u0028\u0067\u0067\u0022\u0042\u0024\u002f\u0067\u0031\u0079\u0065\u004e\u003e\u004e\u0055\u0060\u003f\u004b\u0021\u0041\u0056\u004c\u003c\u0033\u0023\u0076\u0022\u0079\u0067\u0046\u0071\u006e\u004b\u0021\u0039\u0064\u006d\u0067\u0051\u004c\u0045\u0065\u006c\u007c\u0055\u0072\u006d\u003d\u0021\u0043\u0035\u0042\u0074\u0055\u0071\u003c\u007d\u007d\u0032\u0064\u003c\u002f\u0045\u0054\u004b\u0077\u005b\u0046\u0047\u004f\u0044\u007d\u007a\u0068\u006b\u0051\u003d\u0069\u0058\u0038\u0065\u005b\u0046\u0070\u0028\u0034\u0061\u0037\u0034\u0061\u0032\u0057\u0061\u004d\u0072\u003b\u0023\u0072\u006c\u0078\u003c\u006c\u003d\u005b\u0032\u0073\u0078\u0079\u0047\u002b\u006e\u0063\u006f\u0034\u005d\u003f\u004b\u0062\u0076\u0062\u0054\u0036\u0024\u0052\u003c\u0060\u0032\u0075\u0071\u0043\u005b\u004e\u0073\u0078\u0062\u0053\u0069\u0025\u0032\u007c\u0071\u0065\u0044\u0022\u0025\u0069\u0043\u0030\u002e\u005f\u004f\u0045\u006b\u002b\u0029\u005b\u006b\u0060\u0071\u004b\u0022\u0050\u0054\u0052\u0068\u0066\u0032\u0067\u0026\u0037\u0067\u0026\u0028\u002a\u003a\u0072\u002c\u0031\u0079\u006e\u005b\u0024\u004b\u0076\u0066\u0030\u0041\u0023\u0048\u0028\u0050\u0070\u0047\u0045\u0054\u003b\u006a\u006c\u0079\u004d\u0061\u004a\u0028\u0070\u0022\u0047\u0024\u003a\u0032\u006d\u0077\u0049\u0055\u0047\u003e\u0074\u007c\u003d\u0041\u0077\u0079\u0076\u0068\u003d\u0067\u002f\u003f\u0054\u0060\u007d\u0033\u002a\u002f\u0052\u0055\u0054\u0032\u0057\u0063\u0054\u003a\u0076\u0051\u003e\u0035\u0066\u0046\u0035\u0060\u006d\u0023\u0031\u007c\u0055\u004c\u004c\u0065\u004c\u0072\u004d\u007e\u0048\u007d\u0053\u007c\u0069\u0031\u0064\u007e\u004d\u003e\u004b\u007d\u003b\u0079\u0035\u0034\u002e\u002f\u0069\u0071\u002e\u005e\u0045\u002e\u0055\u0064\u0036\u0073\u0074\u0032\u002a\u0062\u0034\u0039\u006c\u0073\u0023\u003e\u0077\u0062\u0064\u005b\u006f\u002c\u004c\u0026\u002f\u0071\u004d\u0066\u0056\u005f\u0046\u006e\u0065\u0028\u007a\u0022\u006c\u0023\u0066\u0026\u0067\u004f\u0025\u0038\u003b\u006d\u0072\u0054\u006a\u0073\u003b\u0036\u0053\u0070\u0032\u003b\u0064\u0065\u0031\u0056\u004d\u0046\u0030\u0029\u0060\u0053\u003c\u0034\u0067\u0064\u0047\u003a\u0075\u0041\u0063\u006b\u005a\u0078\u0055\u002c\u0069\u006f\u006c\u005a\u005a\u004c\u0022\u007b\u0061\u0054\u0069\u0029\u006a\u007d\u003f\u006f\u0031\u0030\u005f\u0034\u0037\u0036\u002b\u007c\u0023\u004d\u0039\u003e\u0042\u0045\u0059\u004c\u0070\u0065\u0045\u003d\u0054\u0058\u0029\u003d\u0053\u003d\u0079\u004d\u005b\u0070\u0074\u0050\u004d\u0026\u006e\u006c\u0065\u0077\u0059\u0053\u004e\u0045\u007c\u0077\u003d\u0068\u005a\u004a\u005f\u002e\u0023\u0040\u0048\u0021\u0047\u006a\u004b\u004c\u0072\u007b\u004f\u006a\u003e\u0022\u0049\u003f\u0076\u0075\u0073\u0062\u0065\u0061\u007d\u0028\u0071\u0031\u004c\u0025\u0058\u006f\u0044\u0073\u006e\u0043\u0052\u0077\u0059\u0053\u004e\u0045\u007c\u0077\u003d\u0068\u005a\u004a\u005f\u002e\u0023\u0040\u0048\u0021\u0047\u006a\u004b\u004c\u0072\u007b\u004f\u006a\u003e\u0022\u0049\u003f\u0076\u0075\u0073\u0062\u0065\u0061\u007d\u0028\u0071\u0031\u004c\u0025\u0058\u006f\u0044\u0073\u006e\u0043\u0052\u0077\u0059\u0053\u004e\u0045\u007c\u0077\u003d\u0068\u005a\u0031\u0044\u0056\u0023\u005d\u0066\u0075\u0073\u0062\u0065\u0061\u007d\u0028\u0071\u0031\u004c\u0025\u0058\u006f\u0044\u0073\u006e\u0043\u0052\u0077\u0059\u0053\u004e\u0045\u007c\u0077\u003d\u0068\u005a\u007d\u006a\u0079\u004e\u0056\u0074\u003c\u0049\u0067\u0075\u0056\u0074\u0050\u004d\u006b\u004e\u002f\u0060\u0030\u0047\u0064\u0035\u007b\u007a\u002b\u0071\u005f\u005f\u0042\u0058\u0038\u0035\u007b\u0074\u005d\u0043\u004f\u005f\u004f\u0076\u003d\u006c\u0042\u0058\u0071\u0055\u0034\u004e\u003a\u004b\u007b\u0063\u004d\u004e\u0061\u004b\u0059\u002a\u0042\u007c\u003a\u0066\u0025\u006c\u0060\u007e\u0039\u006a\u005e\u0026\u0079\u007a\u003d\u005a\u0032\u0043\u005b\u0069\u0060\u003c\u0037\u002e\u0071\u0062\u0051\u0028\u0047\u0058\u0057\u003f\u0051\u006d\u0078\u0054\u0049\u0024\u0042\u007c\u0065\u0066\u0039\u0077\u006f\u0048\u007d\u0047\u003b\u0025\u0070\u0055\u007c\u006e\u007b\u0075\u003d\u006a\u005f\u002a\u0079\u007a\u003d\u005a\u0032\u0043\u007d\u0055\u004c\u0066\u007e\u0067\u006c\u0042\u007c\u0065\u0066\u0039\u0077\u006f\u0048\u007d\u0047\u003b\u0025\u0070\u0055\u007c\u006e\u007b\u0075\u003d\u006a\u005f\u002a\u0079\u007a\u003d\u005a\u0032\u0043\u005b\u0069\u0060\u003c\u0037\u002e\u0071\u0062\u0051\u0028\u0047\u0058\u0057\u003f\u0051\u006d\u0078\u0054\u0049\u0024\u0042\u007c\u0065\u0066\u0039\u0077\u006f\u0048\u007d\u0047\u003b\u0025\u0070\u0055\u007c\u006e\u007b\u0075\u003d\u006a\u005f\u002a\u0079\u007a\u003d\u005a\u0032\u0043\u005b\u0069\u0060\u003c\u005b\u0051\u0023\u0030\u0033\u006c\u0060\u007e\u0056\u0030\u0033\u006c\u0060\u007e\u0056\u0030\u0023\u0072\u0030\u004f\u002e\u0064\u0039\u0072\u0073\u002f\u007e\u0038\u0034\u0041\u007a\u0078\u005a\u006c\u0021\u0042\u0055\u0041\u0043\u004b\u002b\u0070\u003f\u006a\u004f\u0079\u006f\u0042\u0028\u0066\u005f\u0063\u003f\u006a\u004f\u0079\u003d\u0021\u0051\u0053\u0056\u004d\u0038\u003a\u0039\u003d\u006d\u0074\u0033\u0031\u004b\u0078\u0028\u006a\u0053\u003c\u0066\u0038\u0040\u002f\u0051\u0071\u003d\u005e\u0055\u005e\u0045\u0077\u0061\u0041\u0075\u0077\u0063\u0039\u007b\u006d\u004d\u0045\u0023\u004c\u0069\u0029\u006e\u0064\u0033\u007b\u006c\u0040\u002c\u0070\u0074\u0050\u004d\u0026\u006e\u006c\u0065\u0077\u0059\u0053\u004e\u0045\u007c\u0077\u003d\u0068\u005a\u004a\u005f\u002e\u0023\u0040\u0048\u0021\u0047\u006a\u004b\u004c\u0072\u007b\u004f\u006a\u003e\u0022\u0049\u003f\u0076\u0075\u0073\u0062\u0065\u0061\u007d\u0028\u0071\u0031\u004c\u0025\u0058\u006f\u0044\u0073\u006e\u0043\u0052\u0077\u0059\u0053\u004e\u0045\u007c\u0077\u003d\u0068\u005a\u004a\u005f\u002e\u0023\u0040\u0048\u0021\u0047\