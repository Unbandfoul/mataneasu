063\u003a\u004a\u0035\u0034\u0032\u0047\u0021\u0079\u006f\u0074\u0072\u005e\u0037\u003c\u0040\u0021\u0041\u004a\u002f\u0079\u0048\u006a\u005a\u003d\u0055\u002f\u005b\u0021\u0064\u005f\u0030\u007e\u007c\u0021\u0025\u0079\u0029\u006a\u0033\u0050\u0078\u004e\u007c\u0021\u0069\u0046\u0074\u003c\u006c\u0026\u0049\u0034\u0035\u0034\u0032\u0047\u005f\u005f\u0039\u004e\u004d\u0026\u0043\u0024\u0023\u0063\u0030\u0039\u0026\u0024\u0072\u005e\u007a\u004a\u0046\u0065\u0055\u003a\u003e\u003b\u0024\u003f\u006f\u0067\u004b\u0047\u002a\u004a\u0054\u0035\u0057\u003d\u0023\u004e\u0068\u0069\u0074\u0055\u0079\u006b\u0073\u0075\u005b\u007d\u0050\u0039\u0058\u005f\u0059\u006e\u004d\u003a\u003a\u0075\u0052\u007a\u0030\u0036\u0045\u006d\u0032\u0037\u002e\u0062\u0054\u0053\u0054\u007b\u0029\u0068\u0029\u0052\u0051\u003b\u0058\u0024\u002e\u006b\u003b\u0032\u0070\u0078\u007b\u0036\u0035\u0034\u0035\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0055\u002b\u0032\u0037\u002e\u0062\u0054\u0053\u0054\u007b\u0029\u0068\u0029\u0052\u0051\u003b\u005e\u0046\u0021\u0039\u0057\u0078\u0067\u0028\u005e\u0030\u0029\u002e\u0035\u0034\u0035\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0055\u002b\u0032\u0037\u002e\u0062\u0054\u0053\u0054\u007b\u0029\u0068\u0028\u0068\u003b\u0062\u006f\u0051\u003d\u0068\u002c\u0065\u0037\u0076\u0052\u005b\u0052\u0057\u004d\u004f\u0064\u003f\u0039\u0030\u0039\u0033\u0062\u0076\u0051\u0040\u005b\u0026\u006a\u0071\u006f\u007b\u004d\u002e\u002b\u0053\u0039\u0069\u0024\u002f\u005b\u0028\u002a\u005a\u006a\u0026\u003e\u0033\u005a\u0068\u003f\u0052\u003f\u006d\u0024\u002b\u004f\u003e\u003b\u0033\u0078\u0037\u004c\u002b\u002b\u0075\u006c\u0054\u004f\u004e\u006a\u002a\u005b\u002a\u006f\u0046\u006d\u003a\u0024\u0054\u0043\u002b\u0065\u0079\u0033\u003c\u0077\u0079\u0044\u006e\u0047\u0070\u002a\u004b\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0065\u0076\u0022\u003a\u006b\u0061\u006e\u0079\u0043\u0070\u0023\u0047\u005f\u0024\u0063\u0024\u006e\u0079\u0034\u0062\u0045\u003c\u0037\u005d\u004f\u002f\u0021\u0034\u006d\u004e\u0074\u0062\u002c\u007b\u005d\u0029\u003c\u003b\u0035\u0075\u003d\u003b\u0074\u0073\u0054\u0069\u0042\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u0060\u0068\u0056\u006e\u006b\u0061\u005e\u0062\u002f\u0056\u0052\u004d\u004f\u0032\u004d\u0067\u0064\u0052\u0048\u006d\u0052\u002a\u0029\u006a\u0048\u004d\u005b\u0055\u0030\u0048\u0053\u0070\u0033\u0043\u0070\u006b\u0038\u0049\u0033\u0029\u0074\u006c\u003b\u0022\u002a\u0045\u0041\u0072\u002b\u0062\u0031\u0051\u0060\u0038\u002c\u0047\u004a\u0070\u005a\u003e\u003d\u003a\u0070\u0059\u003d\u002b\u003c\u004b\u0070\u0046\u0072\u007b\u0050\u0070\u0044\u0035\u0057\u0030\u0058\u0063\u005f\u0079\u0072\u0051\u006d\u0036\u0024\u0043\u006f\u003a\u0073\u003b\u0068\u003f\u002f\u0063\u0043\u0052\u0056\u006e\u005e\u0061\u0048\u0062\u0078\u0041\u002b\u0049\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u004a\u0068\u0045\u005e\u002a\u0022\u0074\u0028\u0038\u003d\u0049\u0041\u0032\u0041\u003a\u0024\u0054\u0043\u002b\u0065\u0023\u0047\u004c\u0053\u0033\u0031\u0065\u0042\u0045\u0047\u0035\u0034\u0040\u0040\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0061\u002f\u006c\u0041\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0065\u0076\u0022\u003a\u004f\u0061\u0065\u0079\u0074\u007e\u0058\u003a\u0031\u0039\u0021\u006c\u0076\u0031\u0079\u0043\u0068\u007b\u0034\u006d\u004e\u0063\u0024\u0042\u0052\u003d\u007e\u0045\u003c\u007e\u006c\u0076\u002c\u002c\u005a\u007e\u0032\u0066\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0039\u0047\u0051\u003d\u0049\u0075\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u007b\u0033\u0076\u0067\u004d\u007c\u0051\u0076\u0074\u0048\u003d\u0066\u004e\u006d\u0043\u0035\u0064\u0069\u0023\u0070\u0068\u0033\u002f\u0028\u002a\u005a\u006a\u0054\u0071\u007c\u0034\u0041\u005a\u0046\u007e\u0032\u0062\u0045\u006c\u0030\u0065\u0023\u0061\u0030\u003e\u007d\u0043\u0049\u003f\u004e\u0045\u0049\u0066\u003a\u0044\u0022\u0040\u006d\u0036\u0075\u005f\u003e\u007e\u0064\u0028\u007d\u004a\u0043\u0070\u004a\u0070\u002c\u005a\u006b\u002b\u003a\u007e\u002e\u006a\u002c\u004a\u0028\u002a\u0075\u006a\u004d\u0037\u0030\u003b\u003a\u003f\u0057\u0059\u0071\u0024\u0032\u006a\u0045\u004c\u005e\u0040\u005e\u0069\u0022\u003a\u0056\u0061\u005a\u005f\u0059\u006e\u004d\u003a\u0029\u0068\u002b\u0068\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u003e\u0034\u0072\u0022\u0044\u006a\u003c\u004b\u0054\u003f\u003a\u0024\u0054\u0043\u002b\u0065\u0079\u0033\u003c\u0077\u0079\u0044\u006e\u0047\u0070\u002a\u004b\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u0053\u0045\u004d\u0062\u007b\u0065\u002f\u0069\u0021\u0079\u0024\u0061\u0071\u0040\u0046\u0061\u0024\u0073\u0051\u0047\u006b\u0069\u004c\u0046\u0032\u0066\u0058\u003b\u007e\u0061\u0025\u003a\u004e\u0062\u002c\u0079\u002c\u0077\u003d\u003b\u0042\u0035\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u005b\u0024\u002e\u0054\u007e\u0076\u0023\u0047\u003a\u0048\u0047\u003a\u004b\u0022\u0074\u003d\u0033\u0075\u0031\u0070\u0070\u0068\u0056\u006e\u004d\u0071\u0064\u0062\u0058\u0056\u0068\u006b\u0037\u0063\u007e\u0047\u0036\u0076\u0063\u0028\u0061\u002f\u004d\u0050\u0055\u003a\u004e\u0034\u0056\u002b\u0021\u0029\u0060\u0040\u0032\u0074\u0079\u0056\u0029\u0039\u0029\u0064\u007b\u002a\u007d\u0046\u0047\u004d\u004c\u004d\u0072\u006d\u0070\u0059\u003d\u002b\u003a\u0044\u0030\u0065\u002f\u0026\u0048\u003e\u0021\u0066\u003a\u0030\u0058\u0063\u0032\u0029\u002a\u004a\u0048\u002f\u003d\u003c\u0065\u0055\u0030\u003b\u003b\u0053\u0054\u0036\u003d\u0031\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0067\u0037\u004c\u0074\u0023\u005e\u0026\u0070\u0048\u003b\u002f\u0079\u005a\u0057\u0061\u0044\u0068\u007b\u006d\u0072\u0054\u0064\u0042\u003a\u0024\u0054\u0043\u002b\u0065\u0079\u0033\u0039\u0067\u0050\u0024\u0041\u005f\u0024\u006b\u0068\u0035\u0070\u0071\u0040\u005a\u004e\u002e\u005a\u0034\u0061\u0036\u006c\u0021\u0070\u0026\u0023\u0055\u007e\u0024\u0072\u004b\u0029\u004c\u0077\u0023\u0024\u0071\u0032\u006a\u002a\u006b\u0075\u004e\u004a\u0031\u0024\u0021\u003b\u0024\u0056\u0023\u0024\u0071\u003f\u0062\u002a\u006b\u0075\u004e\u004a\u0031\u0024\u0021\u0063\u005a\u0039\u0067\u0076\u006c\u0022\u0033\u004f\u0061\u0056\u0058\u0041\u005f\u0050\u0057\u0076\u0035\u007a\u003c\u006a\u0022\u004e\u002e\u0066\u0061\u0047\u0036\u006c\u0021\u003c\u007c\u0044\u0058\u0026\u002f\u0045\u0047\u0074\u0064\u0070\u0040\u0042\u0035\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u0044\u0077\u0022\u0041\u003f\u0067\u0041\u0024\u0072\u004b\u0035\u002b\u0073\u0023\u0024\u0071\u0054\u0062\u002a\u006b\u007b\u005d\u004a\u0031\u0024\u0021\u0035\u005a\u0039\u0067\u002f\u004e\u0022\u0033\u0039\u0067\u0074\u0071\u0041\u005f\u0074\u0053\u0028\u0035\u0070\u0071\u0034\u0077\u004e\u002e\u005a\u0034\u0032\u0079\u0063\u005f\u0074\u0053\u0023\u0035\u0070\u0071\u002c\u003b\u004e\u002e\u0024\u0065\u0037\u0036\u006c\u0021\u0075\u0053\u0055\u0022\u0070\u0071\u0064\u004b\u004e\u002e\u0024\u0065\u0037\u0036\u006c\u0021\u0075\u0053\u0044\u0058\u0026\u002f\u004b\u002e\u003a\u006b\u0029\u0069\u005f\u005f\u006c\u0021\u0074\u0053\u0044\u0058\u0026\u002f\u004b\u002e\u003a\u006b\u0071\u0069\u003a\u004c\u0061\u0038\u0052\u002c\u006a\u0067\u002e\u003c\u0072\u004b\u003b\u0055\u0077\u0023\u0024\u0071\u0066\u0038\u0044\u005e\u0068\u0069\u004e\u006d\u0065\u0049\u0077\u0062\u002e\u0054\u0074\u005b\u007d\u0065\u0040\u0065\u0079\u0024\u0061\u0071\u0040\u0046\u0061\u0024\u0073\u0051\u0047\u0069\u006c\u0063\u0052\u0076\u0034\u0074\u0072\u005a\u0064\u007b\u0052\u005b\u0048\u0022\u004d\u0061\u005b\u003e\u0026\u0034\u0063\u0030\u0061\u0038\u004e\u0034\u007d\u005b\u007d\u0053\u0039\u0038\u0079\u007a\u007b\u0043\u0061\u0068\u0072\u003a\u005b\u0048\u0073\u004f\u0070\u0045\u0028\u007c\u0053\u005d\u0023\u0024\u0069\u0075\u0029\u003d\u0079\u0030\u007e\u007c\u0021\u0053\u0050\u0063\u005b\u007d\u0076\u0039\u002c\u0079\u0047\u0059\u0064\u0061\u0037\u0021\u0041\u006b\u0042\u005d\u0067\u0076\u0028\u007c\u0053\u005d\u0023\u0024\u0071\u002e\u003b\u0064\u007b\u0052\u005b\u0048\u0022\u0045\u006a\u006c\u0055\u0045\u002e\u0043\u0052\u0039\u0066\u0069\u0066\u0072\u007a\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u0039\u0046\u007d\u0072\u006a\u0053\u0055\u0022\u0070\u0071\u0052\u0043\u003c\u0075\u0034\u0024\u004b\u004e\u002e\u005a\u0034\u0070\u0036\u006c\u0021\u007e\u0052\u0044\u0058\u007b\u0068\u0040\u002e\u003a\u006b\u0057\u0069\u005f\u005f\u006c\u0021\u0023\u0057\u0044\u0058\u0074\u0071\u004b\u002e\u003a\u006b\u004c\u0061\u0033\u0075\u0033\u004e\u006d\u0056\u0040\u0047\u0072\u003a\u0024\u0054\u0043\u002b\u0065\u0079\u0033\u0039\u0067\u0050\u0024\u0041\u005f\u0024\u006b\u0068\u0035\u0070\u0071\u0040\u005a\u004e\u002e\u005a\u0034\u0061\u0036\u006c\u0021\u0070\u0026\u0023\u0055\u007e\u0024\u0072\u004b\u0040\u0051\u0077\u0023\u0024\u0071\u0044\u0062\u002a\u006b\u004a\u0074\u0041\u005f\u0074\u0053\u0026\u0035\u0070\u0071\u0040\u005a\u004e\u002e\u0066\u0061\u002b\u0036\u006c\u0021\u0024\u0026\u0074\u0075\u004e\u0068\u006f\u0062\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u002e\u0074\u003e\u004e\u002e\u005a\u0034\u0037\u0036\u006c\u0021\u004f\u0053\u0044\u0058\u007b\u0068\u0040\u002e\u003a\u006b\u0053\u0077\u0073\u0079\u0074\u006e\u0071\u0048\u0033\u004c\u006d\u0048\u0022\u0031\u002f\u0061\u002a\u0064\u007b\u0052\u005b\u0048\u0022\u0034\u0026\u0079\u006f\u007c\u004d\u0024\u0029\u007d\u005e\u004b\u003a\u0024\u0054\u0043\u002b\u0065\u0079\u0033\u0039\u0067\u0050\u0024\u0041\u005f\u0024\u006b\u0068\u0035\u0070\u0071\u0040\u005a\u004e\u002e\u005a\u0034\u0061\u0036\u006c\u0021\u0070\u0026\u0023\u0055\u007e\u0024\u0072\u004b\u0029\u004c\u0077\u0023\u0024\u0071\u0032\u006a\u002a\u006b\u0075\u004e\u004a\u0031\u0024\u0021\u003b\u0024\u0056\u0023\u0052\u0070\u0061\u006d\u0064\u0053\u0059\u007d\u004a\u0031\u0024\u0021\u005a\u005a\u0039\u0067\u004c\u0062\u0041\u005f\u0024\u006b\u0078\u0066\u002f\u0031\u0073\u0043\u0046\u005d\u004f\u0061\u006a\u0054\u0041\u005f\u0050\u0057\u0076\u0035\u0070\u0071\u004e\u0066\u004e\u002e\u005a\u0034\u0069\u0036\u006c\u0021\u003c\u007c\u0074\u0075\u0025\u003c\u0026\u002e\u004e\u0054\u007a\u0066\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0047\u005d\u005b\u005b\u0066\u002f\u0031\u0024\u0021\u0030\u005a\u0039\u0067\u006f\u0071\u0041\u005f\u0024\u006b\u0067\u0035\u0070\u0071\u0033\u0077\u004e\u002e\u005a\u0034\u0042\u0079\u0063\u005f\u0074\u0053\u0028\u0035\u0070\u0071\u0024\u0021\u004e\u002e\u005a\u0034\u0032\u0079\u0063\u005f\u0074\u0053\u0028\u0035\u0070\u0071\u0024\u0021\u004e\u002e\u005a\u0034\u0037\u0036\u006c\u0021\u004f\u0053\u0044\u0058\u005a\u0045\u0022\u0062\u003a\u0024\u0023\u005e\u0037\u004e\u002e\u0074\u0067\u004f\u0079\u0033\u0074\u004c\u002c\u0056\u0029\u0057\u005e\u0067\u0078\u0046\u0022\u003a\u0078\u0063\u002e\u0079\u0063\u005f\u0024\u006b\u0045\u0035\u0070\u0071\u004f\u0040\u004e\u002e\u0074\u0067\u004c\u0036\u006c\u0021\u0023\u0057\u0044\u0058\u0074\u0071\u0056\u004e\u0051\u0074\u0053\u004d\u002b\u003d\u005e\u006c\u0033\u0064\u007b\u0052\u005b\u0048\u0022\u0050\u0059\u0041\u006f\u004f\u0064\u0024\u0024\u0045\u0046\u003f\u003a\u0024\u0054\u0043\u002b\u0065\u0079\u0033\u0039\u0067\u0050\u0024\u0041\u005f\u0024\u006b\u0068\u0035\u0070\u0071\u0040\u005a\u004e\u002e\u005a\u0034\u0061\u0036\u006c\u0021\u0070\u0026\u003f\u002b\u0073\u005d\u0033\u002f\u0031\u0024\u0021\u0075\u005a\u0039\u0067\u0046\u0061\u0041\u005f\u0024\u006b\u0026\u0035\u0070\u0071\u004e\u0066\u004e\u002e\u0074\u0067\u0065\u0079\u004c\u0030\u0079\u0025\u0046\u004f\u002f\u0052\u0054\u0036\u0045\u006d\u006d\u0059\u003c\u0071\u0050\u005b\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u003f\u004d\u0079\u0030\u004b\u0049\u0066\u0039\u0067\u0059\u0046\u0041\u005f\u0074\u0053\u0068\u0035\u0070\u0071\u0039\u0075\u004e\u002e\u0066\u0061\u0051\u006a\u0079\u0026\u0076\u0026\u0055\u004e\u002e\u0074\u0067\u0065\u0079\u0030\u007d\u004b\u0064\u005f\u0069\u0042\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u005b\u006a\u0029\u006a\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u004c\u0074\u002f\u005a\u003d\u0079\u005a\u0057\u0061\u0044\u0048\u0022\u0069\u006a\u0035\u0069\u005a\u006c\u0045\u006c\u0062\u003a\u007c\u0041\u003e\u006d\u003d\u005b\u007d\u0065\u0040\u0065\u0079\u0024\u0061\u0070\u0048\u0023\u0023\u0058\u002b\u0057\u0074\u003d\u004d\u0079\u0041\u0024\u004d\u007d\u006d\u0060\u0077\u0062\u003f\u006c\u004b\u0025\u004e\u0024\u003c\u0046\u0056\u005a\u005b\u007d\u0076\u0039\u002c\u0079\u0047\u0059\u002a\u0034\u0055\u007c\u0030\u0048\u0077\u007b\u0025\u0069\u0068\u0046\u0062\u0030\u0054\u0070\u0022\u002f\u005f\u0062\u0045\u0069\u0062\u0034\u0056\u003b\u006d\u0052\u0062\u0023\u007c\u0029\u006b\u0037\u005a\u0057\u0061\u0044\u0048\u0022\u002a\u0046\u0054\u003e\u0043\u0072\u0065\u0033\u0068\u0059\u0045\u0022\u0051\u007c\u0032\u002f\u0026\u004a\u003e\u004b\u0056\u004d\u0074\u0067\u003d\u0036\u003c\u002e\u0051\u0048\u0031\u0060\u0038\u004f\u0028\u004c\u002c\u0049\u0021\u0066\u003c\u0024\u0048\u0028\u002b\u0065\u0048\u006a\u0067\u0029\u0029\u004b\u0047\u0026\u006c\u0075\u006b\u005a\u006a\u0048\u0035\u0047\u005b\u003c\u002e\u0051\u0048\u0031\u0060\u0038\u004f\u0051\u0031\u0072\u0066\u007c\u0072\u0058\u0063\u0072\u0045\u0051\u007c\u0060\u0035\u0025\u0059\u0055\u003a\u0037\u0034\u0068\u003f\u0039\u0047\u006d\u006d\u0042\u0028\u0044\u002f\u0043\u0070\u0021\u006f\u0065\u0055\u006b\u002a\u0052\u0039\u0030\u007c\u0037\u0051\u0057\u0039\u003d\u0038\u005b\u007d\u006e\u0048\u0065\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0056\u0053\u0046\u0037\u0073\u0050\u0059\u0030\u0060\u0058\u0060\u0043\u004f\u0065\u003c\u0067\u0072\u0071\u0021\u003b\u0024\u003d\u0032\u003a\u0025\u0036\u0044\u0069\u004e\u0024\u002a\u0021\u0025\u0079\u0041\u007a\u0074\u0071\u0076\u005e\u004f\u002e\u0026\u0040\u007b\u0065\u0022\u0047\u0025\u0066\u002e\u0026\u0072\u0071\u0048\u004a\u0034\u0072\u0077\u0039\u004e\u0024\u003a\u004a\u0036\u0065\u003c\u0067\u0055\u003a\u004e\u0034\u0070\u004f\u004e\u0045\u0053\u005a\u0051\u007c\u0077\u005b\u0052\u006a\u006f\u002f\u004e\u003b\u0041\u003c\u002e\u0051\u0048\u0025\u0066\u002e\u0026\u0072\u0071\u0048\u004a\u0034\u0072\u0077\u0039\u004e\u0024\u0052\u0028\u0042\u004a\u0034\u0026\u0060\u0055\u0074\u005d\u005b\u006d\u0075\u003d\u0073\u0042\u0034\u0044\u0063\u0069\u005b\u007d\u006e\u0048\u0065\u0079\u0055\u0068\u0041\u006f\u0024\u0030\u006b\u002a\u0072\u004e\u0060\u0058\u0060\u0043\u004f\u0065\u003c\u0067\u0072\u0071\u0021\u003b\u0065\u006d\u0046\u0041\u0037\u0024\u0073\u002a\u0062\u006b\u0079\u006a\u004b\u0052\u0031\u0030\u003d\u0059\u0045\u0022\u0051\u0064\u0073\u002f\u0026\u004a\u003e\u0059\u0044\u006b\u0032\u0057\u0059\u003e\u0021\u0062\u007e\u0039\u003f\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u007c\u0047\u006d\u006d\u003e\u0055\u0041\u0049\u0066\u003c\u0077\u0073\u003d\u004e\u007b\u005a\u0071\u0062\u002e\u0079\u0035\u0051\u0035\u0074\u006d\u0076\u0051\u0040\u005b\u0026\u006a\u0064\u0057\u002e\u0067\u002e\u0043\u0022\u006b\u0052\u006a\u006d\u005e\u0070\u003b\u0057\u0056\u006c\u0046\u0032\u0052\u006a\u0063\u002b\u002b\u006b\u006c\u0063\u0064\u0052\u006a\u0057\u0044\u003c\u0079\u003b\u0043\u0051\u002b\u006d\u004e\u0076\u0051\u005e\u0036\u006f\u0074\u005e\u0060\u0060\u0040\u0072\u0045\u0064\u0028\u005e\u0053\u0031\u0022\u0059\u0045\u0022\u0051\u006a\u006b\u0045\u006a\u005e\u0032\u005f\u003c\u002e\u0051\u0048\u0031\u0060\u0038\u004f\u0051\u0031\u0072\u0066\u0076\u002b\u0043\u0045\u003c\u0024\u0052\u0028\u006b\u0079\u005d\u0061\u004b\u006f\u0069\u0035\u0024\u0044\u004e\u005b\u007d\u006e\u0048\u0065\u0079\u007a\u007a\u0044\u004e\u0047\u0054\u0075\u0046\u0024\u006d\u0079\u004b\u0073\u0079\u0062\u0024\u003e\u0060\u0023\u0023\u0049\u0064\u0073\u005b\u006f\u0074\u0053\u004f\u004d\u0058\u0024\u0021\u007c\u0075\u0059\u0045\u0022\u0051\u005d\u0072\u0042\u0026\u004b\u006f\u004d\u0064\u0069\u0030\u0072\u0041\u0026\u0024\u0033\u0029\u0056\u0023\u0023\u0055\u0052\u0079\u004a\u004e\u006a\u007c\u0049\u006d\u004b\u0029\u0077\u0055\u0023\u007b\u0065\u0022\u0047\u0025\u0066\u002e\u0026\u0072\u0071\u003f\u0072\u0046\u002a\u003b\u0042\u0068\u0023\u0035\u005b\u0025\u0079\u006a\u006f\u003c\u0031\u0021\u0057\u0074\u006c\u0063\u0064\u0052\u006a\u006a\u006c\u003f\u0064\u0076\u0068\u0044\u002f\u0079\u0046\u0065\u003c\u0054\u0071\u0048\u0029\u0049\u0026\u003c\u002e\u0051\u0048\u0025\u0066\u002e\u0026\u0072\u0071\u0040\u0043\u0038\u0072\u0070\u0041\u004b\u0047\u0064\u0028\u005d\u0035\u0070\u0043\u0065\u0055\u004c\u004d\u0024\u0069\u0053\u003f\u005b\u007d\u006e\u0048\u0065\u0079\u0055\u0068\u0041\u006f\u0024\u0030\u006b\u002a\u0072\u004e\u0060\u0058\u0060\u0043\u004f\u0065\u003c\u0067\u0043\u0037\u0035\u0031\u0070\u004f\u0050\u0063\u0060\u0058\u002a\u0021\u0024\u006b\u0074\u0049\u0066\u003c\u0077\u0073\u003d\u004e\u007b\u005a\u0071\u0024\u005d\u007c\u003f\u0048\u004f\u0073\u0056\u0062\u0029\u003b\u0038\u004e\u0051\u007c\u003d\u002a\u0025\u0059\u0075\u0071\u0053\u0034\u0024\u0045\u0058\u003d\u0026\u0076\u0071\u0024\u0066\u004a\u004f\u0065\u0045\u006a\u0056\u003e\u0043\u0066\u0074\u0039\u0023\u002e\u003a\u0065\u0064\u0076\u0068\u0044\u002f\u0079\u0046\u0065\u0072\u0055\u003f\u0058\u0033\u0032\u0077\u0064\u0076\u0053\u0051\u005e\u0036\u0045\u006a\u0071\u0065\u002c\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0034\u0056\u0035\u0025\u003f\u0039\u0030\u0039\u0033\u0062\u0076\u0051\u0040\u005b\u0026\u006a\u0056\u003e\u0063\u003e\u0072\u0073\u0067\u0047\u0067\u0023\u003d\u0028\u002a\u0079\u005d\u0061\u004b\u006f\u0069\u0035\u0070\u004f\u0050\u0063\u005d\u002a\u0038\u0062\u006e\u004f\u007a\u0046\u0064\u006f\u006d\u0035\u0030\u006b\u0067\u0047\u0061\u006d\u004e\u005b\u002a\u0079\u0046\u0065\u0070\u0055\u007c\u004d\u003e\u0040\u0073\u0039\u0077\u006c\u0025\u0021\u0054\u0035\u005b\u0025\u0050\u0070\u0058\u004b\u0062\u0063\u0043\u0045\u0076\u0021\u005f\u005d\u003d\u005f\u0060\u006a\u0056\u003e\u0043\u0066\u0070\u0030\u0067\u0047\u007c\u0023\u004c\u0044\u0040\u0079\u005b\u007a\u0058\u004e\u0068\u0025\u0034\u0072\u0079\u0029\u003f\u0024\u003a\u004a\u005a\u0035\u0063\u006a\u0071\u006f\u005b\u0055\u0043\u0073\u004e\u0045\u006c\u0051\u003b\u0043\u0025\u0079\u0050\u0068\u0063\u006f\u0077\u0066\u0069\u0060\u0026\u0029\u0024\u006d\u0046\u006d\u004c\u007a\u003d\u007b\u0029\u003c\u0058\u0059\u007b\u0065\u0022\u0047\u006a\u0060\u0071\u0042\u0033\u0069\u0059\u0066\u0033\u0064\u006c\u0071\u0061\u002b\u002a\u004a\u006a\u0075\u0076\u005b\u0025\u0023\u0047\u0047\u0061\u0024\u0034\u0062\u004f\u003c\u0036\u0077\u002c\u0068\u0058\u0069\u0033\u006a\u0024\u0049\u004c\u004b\u0074\u0036\u0072\u007b\u0021\u0022\u003a\u0079\u0021\u0057\u004f\u0072\u0040\u0050\u002b\u0024\u0047\u0037\u006d\u0067\u003f\u007d\u0069\u0068\u0046\u005a\u005a\u0079\u0026\u003e\u003a\u0059\u0046\u0024\u0064\u0053\u0037\u0064\u0062\u007e\u0046\u0051\u0056\u0045\u003b\u003f\u0073\u0054\u0052\u0024\u0056\u0066\u005a\u003e\u0030\u0045\u002a\u0033\u0036\u005d\u006e\u0079\u002c\u0033\u0040\u007c\u0065\u0053\u002a\u0031\u0042\u0066\u003c\u006d\u0067\u0069\u007a\u0040\u0050\u0024\u0065\u0062\u0045\u0069\u0062\u003b\u0034\u0079\u0076\u0024\u0057\u0033\u0040\u0045\u0044\u0024\u0040\u0051\u0054\u0035\u0060\u006a\u003f\u0068\u0053\u0041\u0049\u0030\u007c\u0037\u0051\u0046\u0059\u006f\u0074\u0050\u003a\u0023\u0023\u005a\u0046\u0046\u0036\u0023\u0061\u0036\u0056\u0026\u006b\u0059\u006d\u0021\u002f\u004f\u0038\u006f\u0047\u005b\u007d\u003a\u0061\u0038\u0079\u005b\u007a\u0058\u004e\u0025\u003a\u0040\u006d\u0030\u007e\u0030\u0045\u0079\u0028\u006b\u0079\u0047\u0059\u0041\u006f\u004f\u0064\u0062\u006a\u005a\u0067\u005b\u007d\u003b\u004f\u0038\u0079\u005b\u007a\u0058\u004e\u004c\u0032\u0026\u0031\u0049\u0074\u004b\u0047\u0026\u006c\u0024\u0078\u003b\u006a\u006b\u004f\u005a\u005a\u0033\u0062\u0049\u0064\u007b\u004a\u004e\u006a\u0044\u0050\u0061\u0024\u0023\u002f\u003e\u005b\u004e\u006a\u004a\u0028\u007c\u003e\u007d\u0021\u007b\u003b\u0043\u0073\u005b\u0022\u0078\u0064\u003f\u0031\u0031\u0046\u0060\u0069\u007e\u002e\u0078\u003f\u0031\u0058\u0071\u005a\u0053\u005b\u0065\u0065\u0074\u002c\u0030\u0040\u0057\u0077\u005e\u0044\u0046\u0028\u0068\u0028\u0073\u0069\u0028\u0058\u0025\u0074\u006b\u0056\u0040\u006b\u0065\u0049\u0074\u0035\u0049\u0079\u002f\u0068\u0044\u003b\u0038\u005a\u006a\u0024\u0061\u0066\u005e\u003f\u0076\u0044\u003a\u0065\u0049\u0074\u0079\u003c\u0041\u002c\u003f\u005d\u0021\u003e\u0028\u0045\u004f\u0074\u004b\u003b\u0056\u004d\u0046\u0056\u0077\u0056\u0053\u007e\u007e\u0074\u0063\u0024\u006d\u005e\u006c\u0058\u004f\u0052\u006a\u0048\u0043\u003f\u003a\u005a\u0051\u0068\u0079\u004d\u0056\u0053\u0038\u0049\u0074\u0075\u0056\u0078\u004f\u0078\u002c\u004b\u0021\u003f\u0049\u0026\u0055\u0030\u0068\u0036\u0064\u0044\u003a\u0065\u0049\u0074\u002c\u0044\u0029\u0073\u0048\u0040\u0057\u0022\u0051\u0026\u004e\u0029\u0070\u006c\u0053\u006b\u0056\u0044\u003a\u0063\u007e\u0074\u003a\u0070\u0024\u0053\u003f\u0076\u0056\u0053\u007e\u007e\u0074\u0075\u0024\u0068\u0078\u0067\u0047\u0056\u0077\u0040\u006b\u0065\u0049\u0074\u0054\u006e\u0063\u0031\u003a\u0035\u0044\u003a\u007e\u007e\u0074\u004a\u0039\u0056\u007e\u0042\u0050\u0031\u0043\u0036\u0064\u0056\u0053\u007e\u007e\u0074\u004a\u007c\u003e\u0049\u0040\u0057\u004c\u0044\u007d\u0070\u007d\u004b\u0077\u0044\u003a\u0065\u0049\u0074\u007c\u0068\u005e\u003f\u0076\u0040\u006b\u0065\u0049\u0074\u003e\u004c\u003b\u0062\u0074\u0056\u0077\u0044\u003a\u0063\u007e\u0074\u0034\u0072\u0030\u0023\u0055\u003a\u0035\u0047\u0060\u0065\u0049\u0074\u0022\u0041\u0036\u0064\u0040\u006b\u0065\u0049\u0074\u0023\u0078\u007c\u0066\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u0039\u0058\u003a\u0051\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u005f\u006c\u003d\u0047\u0032\u0079\u0030\u007d\u0053\u0057\u002a\u0066\u005a\u0069\u0074\u0026\u0064\u0062\u006f\u003c\u0058\u0034\u007d\u007a\u0063\u0034\u0054\u0052\u0063\u0024\u0051\u004f\u006d\u0042\u006b\u005e\u004a\u0049\u003d\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0076\u0030\u0028\u002b\u0025\u004b\u0021\u0037\u0059\u0061\u0024\u0050\u006a\u004f\u0045\u006f\u0074\u0031\u0034\u0047\u0022\u003a\u004b\u004f\u005f\u0079\u007d\u0072\u0056\u0022\u0046\u004f\u0052\u003c\u006d\u004d\u0049\u0067\u005a\u003b\u0064\u0065\u0025\u0068\u0044\u003b\u0038\u005a\u006a\u005b\u0022\u004e\u006c\u0029\u0033\u0060\u006a\u006d\u0022\u006c\u0046\u003a\u0035\u004c\u0022\u003a\u004b\u004f\u005f\u0079\u0030\u007d\u004d\u0026\u0032\u0066\u0074\u006c\u0040\u0075\u0076\u002b\u0021\u003e\u0028\u0045\u004f\u006f\u0074\u002b\u006b\u0022\u003a\u004b\u004f\u005f\u0079\u0030\u007d\u0031\u0078\u0035\u0066\u0034\u0069\u0051\u0067\u002a\u0076\u007c\u0021\u0064\u0079\u007c\u0024\u006a\u006c\u0023\u003b\u0022\u003a\u004b\u004f\u005f\u0079\u0030\u007d\u0031\u0078\u005b\u0066\u0074\u0040\u0022\u0050\u007b\u0021\u003f\u0049\u0064\u0079\u006f\u0074\u0067\u0022\u003a\u004b\u004f\u0039\u0046\u006c\u0049\u006d\u0028\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0053\u002a\u0059\u0039\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0055\u004f\u005a\u0046\u0062\u0041\u0079\u0025\u0036\u0031\u0034\u0050\u0045\u0047\u007d\u0069\u0062\u005a\u0048\u002b\u0072\u0054\u0037\u0045\u0067\u0023\u0021\u0028\u0064\u0079\u0076\u0061\u0047\u0070\u006e\u005a\u0043\u006d\u0069\u0029\u0058\u0048\u0076\u005e\u005e\u0063\u0051\u0063\u007e\u0074\u006d\u004e\u005b\u0054\u0035\u005a\u006a\u0068\u0055\u005f\u0064\u0040\u006d\u006e\u0067\u0075\u0057\u0046\u006d\u002b\u0032\u0059\u0057\u0038\u0059\u0061\u003c\u0054\u003a\u004e\u0049\u0030\u0078\u0021\u006f\u006a\u0030\u0079\u0030\u0070\u0041\u0028\u002b\u0054\u003a\u0075\u0039\u0079\u0067\u0026\u0036\u0062\u0045\u0069\u0062\u0034\u0056\u003b\u006d\u0052\u0062\u003f\u0049\u0055\u0029\u0026\u003d\u0065\u0062\u007b\u004a\u006c\u0022\u003d\u006a\u0067\u0068\u0048\u0074\u0049\u004e\u004a\u0074\u0043\u006a\u0039\u0078\u0054\u0041\u0048\u003e\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u0039\u0058\u003a\u0051\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u005f\u006c\u003d\u0047\u0032\u0079\u0030\u007d\u0053\u0057\u002a\u0066\u005a\u0069\u0074\u0026\u0064\u0062\u006f\u003c\u0058\u0034\u007d\u007a\u0063\u0034\u0054\u0052\u0030\u0048\u0075\u0053\u0042\u0058\u0039\u0068\u0076\u0034\u004c\u0046\u002c\u0041\u0079\u003d\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0051\u0057\u006a\u002b\u0042\u0021\u0026\u005a\u0022\u003a\u004b\u004f\u005f\u0079\u0058\u003b\u003c\u006f\u006b\u0056\u006e\u002b\u002f\u0063\u0049\u0066\u0026\u006c\u0061\u002f\u0057\u006a\u0054\u0031\u0052\u004d\u007c\u006d\u0065\u0059\u0024\u0051\u0022\u0051\u0051\u0046\u0023\u0053\u0048\u007b\u007b\u0077\u0057\u0072\u007d\u0059\u0050\u0029\u0049\u0064\u0059\u0025\u002c\u0078\u0047\u0070\u0077\u0066\u003b\u003f\u002f\u0063\u0048\u0024\u007b\u0021\u0022\u006b\u0046\u0065\u0050\u0024\u0029\u0068\u002a\u003a\u0069\u0029\u0058\u0048\u0076\u005e\u006d\u004a\u0068\u005d\u0047\u0070\u0077\u0066\u0077\u002b\u004b\u0029\u0064\u004d\u0076\u005e\u006b\u0079\u0046\u0065\u0075\u0071\u0068\u0069\u0042\u0021\u0026\u005a\u0022\u003a\u003f\u0061\u007e\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0044\u0049\u0036\u003d\u0045\u0031\u0050\u002a\u003f\u004c\u0061\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0046\u007e\u0056\u005e\u005b\u007d\u005f\u0029\u0036\u0079\u0060\u003b\u0077\u0047\u0050\u0062\u0023\u0038\u0064\u007b\u006b\u006c\u005d\u0035\u0042\u0042\u0033\u004d\u0067\u0075\u0024\u0044\u005b\u007d\u0051\u0048\u0036\u0079\u0060\u003b\u002f\u0069\u007c\u002e\u0035\u0030\u0064\u007b\u006b\u006c\u005d\u0035\u0060\u006a\u003a\u0037\u0063\u003a\u0055\u0035\u004d\u0026\u006c\u0072\u0035\u0074\u004d\u0040\u005b\u007d\u005f\u0029\u002e\u0079\u0060\u003b\u002f\u0069\u0073\u0031\u0052\u0037\u0035\u004d\u0026\u006c\u0068\u004a\u0042\u0029\u007d\u0062\u0028\u004a\u0072\u0035\u0029\u006a\u002e\u007a\u006d\u0063\u0039\u0056\u002e\u003e\u0065\u0062\u007b\u004a\u006c\u0022\u002c\u0046\u0073\u003e\u003c\u005d\u0078\u006d\u007e\u003f\u0057\u0037\u0035\u004d\u007c\u0021\u0026\u002f\u007b\u0028\u0040\u0032\u0069\u0040\u0021\u0060\u0038\u007d\u0046\u0055\u003a\u0074\u005d\u003f\u0032\u0026\u0029\u0070\u0024\u002b\u003d\u0056\u005a\u002a\u0036\u0044\u005e\u0045\u0037\u0063\u0064\u007b\u006b\u006c\u005d\u0035\u0042\u0042\u0033\u004d\u004d\u0025\u007c\u006d\u0055\u0032\u0069\u0040\u0021\u0060\u0038\u0051\u006a\u004f\u0067\u0035\u0052\u003c\u0024\u004a\u0028\u0021\u0064\u0056\u006a\u005f\u0026\u0060\u0049\u0056\u0032\u0050\u0029\u0049\u0064\u003b\u0076\u005b\u0024\u0068\u0046\u006c\u0045\u003c\u0072\u0047\u0053\u0024\u003a\u004c\u006c\u006c\u0064\u007b\u006b\u006c\u005d\u0035\u0042\u0042\u0033\u004d\u004d\u0025\u0024\u004a\u0028\u007e\u0068\u002b\u0046\u004a\u005b\u0065\u003f\u006a\u006c\u005a\u005f\u002a\u003c\u002e\u0051\u0048\u0037\u005d\u0037\u0065\u0023\u004d\u0036\u0056\u0076\u006a\u003b\u003f\u0068\u002b\u0046\u004a\u005b\u0065\u0070\u005d\u0055\u003a\u002e\u0054\u003f\u003c\u0031\u002b\u0061\u006c\u003e\u0028\u0040\u005b\u0060\u003d\u003a\u0037\u0043\u0072\u002f\u003c\u002e\u0051\u0048\u004a\u003b\u0076\u0061\u0060\u0055\u004b\u0066\u0069\u006a\u007e\u0041\u0049\u0066\u0052\u005b\u0065\u0065\u002c\u0047\u0047\u0070\u0040\u0044\u0047\u0057\u0024\u0052\u0028\u006b\u0079\u0070\u005d\u0047\u0070\u004b\u0047\u0074\u003d\u0040\u007c\u002b\u0075\u006c\u0063\u0064\u005e\u0064\u0034\u004e\u0071\u007a\u0072\u003d\u002b\u0022\u0051\u0079\u002a\u0075\u006a\u004e\u0046\u006d\u0021\u0028\u0042\u0040\u004e\u006a\u002f\u003a\u005e\u0039\u007b\u0065\u0022\u0047\u0078\u0040\u005b\u0046\u0023\u0070\u0077\u0066\u003b\u0073\u004e\u0045\u002c\u0062\u0077\u0051\u0079\u004a\u0074\u0062\u004f\u0037\u0053\u007b\u003c\u002e\u0051\u0048\u006a\u0060\u005d\u0059\u0047\u0070\u004b\u0066\u005d\u0039\u0077\u0039\u003f\u0024\u0061\u004a\u004f\u0065\u006e\u0056\u0021\u006f\u007c\u004d\u003f\u0039\u006f\u0067\u0059\u0045\u0037\u0051\u004c\u004a\u0038\u0074\u0060\u002e\u004d\u0077\u0069\u002b\u0042\u0028\u007a\u004a\u006f\u0034\u0075\u0071\u0055\u0029\u005f\u006f\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u006e\u004e\u0066\u0057\u007a\u004a\u006f\u0034\u0075\u0071\u004e\u003b\u003b\u0032\u0063\u007e\u0031\u007e\u0079\u006c\u003f\u0023\u004f\u0052\u0050\u005e\u002f\u0022\u0059\u0061\u0024\u0071\u0056\u0066\u004c\u006d\u005d\u0041\u0049\u0068\u0073\u0043\u0021\u0064\u005d\u005d\u006a\u0048\u0052\u003c\u006f\u0061\u0023\u005f\u0059\u006e\u0077\u004b\u0067\u0025\u0025\u0073\u003b\u0039\u0067\u0023\u005f\u0028\u0065\u0023\u007a\u0068\u0078\u0037\u0064\u004f\u0063\u0024\u0030\u0039\u0046\u006d\u006f\u006c\u0070\u007a\u0038\u004f\u003f\u0071\u0074\u0075\u002c\u0057\u0046\u007e\u0043\u0057\u0051\u007c\u007a\u004a\u006f\u0034\u0075\u0071\u0055\u0022\u0057\u0030\u0058\u0063\u004c\u0073\u0040\u0021\u0068\u0058\u0057\u0048\u003c\u006f\u004a\u0072\u006e\u002b\u0053\u0059\u0054\u0040\u002e\u0043\u002b\u0035\u002a\u0030\u004b\u0021\u0078\u0060\u0054\u004f\u0048\u006a\u0039\u0043\u0026\u0035\u0066\u0053\u002e\u0066\u0045\u0022\u0051\u0036\u0065\u0052\u006a\u0026\u004f\u0050\u0066\u0045\u0022\u0051\u0036\u0065\u0045\u003d\u0057\u004e\u003d\u004a\u0059\u002b\u0073\u0061\u0044\u0039\u005f\u006b\u0042\u0050\u003e\u006f\u0031\u002e\u002b\u0061\u003c\u004c\u0057\u006c\u002b\u0073\u0061\u0044\u0039\u005f\u006b\u0042\u0050\u003e\u006f\u0031\u002e\u002b\u0060\u0049\u007e\u0048\u0062\u0032\u007d\u004b\u006c\u0071\u005d\u004a\u0028\u002a\u0060\u006a\u004b\u0072\u0071\u004b\u0021\u0078\u0060\u0054\u004f\u0064\u003b\u0046\u0067\u0073\u002f\u002f\u0024\u0038\u0062\u004f\u006c\u002b\u002f\u0037\u0065\u002a\u0030\u007b\u004d\u0049\u003f\u007a\u0045\u004e\u002b\u0061\u0044\u0063\u006e\u0032\u0043\u004f\u0065\u0052\u006a\u0021\u0038\u0058\u004b\u0040\u002b\u006f\u0021\u0057\u0041\u004a\u0052\u0069\u006d\u0045\u0073\u003a\u0057\u0068\u007a\u0044\u002b\u0048\u005b\u005b\u002f\u0052\u006a\u0044\u0047\u0064\u0051\u0062\u005f\u0021\u0049\u0057\u0050\u005e\u004c\u0021\u0067\u0033\u006a\u005f\u0040\u0058\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u006e\u004e\u0066\u0057\u007a\u004a\u006f\u0034\u0075\u0071\u004e\u003b\u003b\u0032\u0063\u007e\u0031\u007e\u0079\u006c\u003f\u0023\u004f\u0052\u0050\u005e\u002f\u0022\u0059\u0061\u0024\u0071\u0056\u0066\u004c\u006d\u005d\u0041\u0049\u0068\u0073\u0043\u0021\u0064\u005d\u005d\u006a\u0048\u0052\u003c\u006f\u0061\u0023\u005f\u0059\u006e\u0077\u004b\u0067\u0025\u0025\u0073\u003b\u0039\u0067\u0023\u005f\u0028\u0065\u0023\u0054\u003b\u0073\u003e\u0024\u0030\u0030\u0048\u0053\u0039\u003c\u0024\u004e\u0028\u0071\u0065\u0042\u0042\u004c\u0037\u004e\u003b\u003b\u0032\u0063\u007e\u0069\u0024\u004d\u0051\u0059\u004f\u003d\u003d\u0023\u004d\u0062\u0030\u0068\u003f\u0068\u003f\u005f\u0058\u0040\u005e\u0049\u005f\u003c\u006f\u0042\u006f\u0035\u0031\u0029\u0030\u007a\u004c\u006c\u0072\u0024\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u0059\u006d\u0076\u0039\u003d\u005a\u003b\u0043\u0040\u0064\u0039\u0061\u003c\u006f\u0078\u002c\u0059\u0066\u0072\u0029\u0059\u0036\u0031\u005b\u002e\u0028\u0049\u0050\u0043\u0037\u007b\u0034\u003e\u0040\u0058\u0063\u0051\u0068\u0064\u0028\u006e\u0025\u0028\u0050\u006a\u0076\u0056\u0064\u0040\u0078\u003a\u0037\u004c\u004d\u004c\u006d\u0056\u0029\u0074\u0071\u0070\u0021\u0050\u0022\u0029\u006a\u0073\u0070\u0069\u003c\u0023\u0060\u0052\u004e\u0073\u002c\u005d\u005b\u003f\u007a\u0046\u005d\u0029\u0067\u0076\u0069\u0048\u005b\u005b\u002f\u0046\u0065\u0050\u0056\u0070\u0053\u0023\u0038\u003f\u0053\u0063\u0069\u0052\u002f\u007b\u003b\u004b\u0024\u0033\u0056\u005a\u0052\u0025\u0067\u0040\u0068\u0024\u0048\u002f\u006b\u006d\u0078\u0040\u0040\u0022\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u006f\u0049\u0044\u0023\u0042\u0075\u0068\u0023\u0076\u0051\u007e\u0035\u0070\u005d\u003c\u0066\u004f\u005f\u0034\u0043\u005e\u0078\u0046\u0069\u0022\u003a\u0042\u0067\u0025\u0073\u004e\u0034\u0036\u003d\u007e\u0025\u0021\u0048\u002f\u006f\u0074\u0071\u007d\u0063\u006d\u005f\u0058\u0034\u0043\u0071\u0046\u0074\u0035\u0029\u004f\u005f\u004c\u004a\u0040\u0064\u004e\u006a\u0024\u002c\u003d\u0042\u003d\u0060\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u0035\u005d\u0036\u0045\u006f\u007e\u0067\u0028\u0049\u005f\u006e\u003b\u006f\u0060\u005b\u0055\u0067\u0053\u003c\u007e\u002f\u007c\u003d\u0028\u0046\u0026\u0074\u0063\u0026\u0038\u0056\u0062\u007e\u0075\u0072\u006b\u0052\u0039\u0050\u0076\u0077\u005e\u002a\u0022\u004c\u0065\u0078\u0037\u0034\u0066\u0051\u0053\u0031\u0067\u0051\u0048\u002e\u0044\u0040\u0045\u0033\u002e\u006a\u004d\u0028\u004f\u0061\u006d\u0078\u006b\u0047\u0068\u0079\u006f\u004b\u005e\u0068\u002a\u0045\u0054\u0057\u0066\u0060\u007b\u005f\u0077\u0050\u0047\u0070\u0077\u0066\u0077\u0077\u0058\u0063\u0024\u0051\u003c\u0028\u006b\u0079\u0048\u003b\u0055\u003a\u0075\u0052\u007e\u0075\u0066\u004e\u005f\u0058\u0034\u0043\u0071\u0046\u0074\u006c\u006c\u006b\u006c\u0052\u002a\u0047\u0039\u0024\u0037\u0040\u0032\u0036\u0032\u002c\u002b\u003e\u007e\u0025\u0021\u0048\u002f\u004a\u0052\u0079\u006f\u003e\u0077\u0065\u0073\u007d\u0067\u003e\u0038\u0074\u0062\u0069\u005e\u003f\u005e\u0025\u0068\u0077\u007b\u0070\u003c\u006c\u002f\u0059\u0074\u0075\u0066\u0034\u003f\u0029\u0035\u005b\u0037\u0049\u007a\u0059\u0033\u003b\u005b\u0055\u0067\u0053\u003c\u007e\u0044\u004e\u0035\u005b\u0051\u0058\u0032\u0070\u0043\u0037\u0021\u003b\u0079\u007c\u0054\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u0063\u0024\u0059\u0033\u0028\u0025\u004f\u005f\u0034\u0043\u0049\u0058\u007a\u0059\u0033\u003b\u005b\u0055\u0067\u0053\u0061\u0033\u0030\u0069\u0024\u0067\u0028\u0049\u005f\u006e\u003b\u0033\u003b\u0037\u0076\u0071\u007c\u006d\u0048\u0038\u0064\u0030\u006d\u0048\u0063\u0065\u0076\u0050\u005e\u0037\u0078\u0032\u0039\u003c\u0049\u0043\u0024\u003e\u0077\u0022\u0057\u004b\u0029\u0029\u0048\u0024\u003c\u005f\u0022\u0072\u002f\u0060\u0066\u0073\u0074\u003e\u004e\u005a\u0043\u003a\u0048\u002a\u0056\u0021\u0028\u0069\u002a\u006b\u0042\u004d\u0055\u002a\u002c\u0058\u0038\u0061\u0052\u006c\u002e\u005e\u006d\u0075\u006c\u0037\u005d\u0059\u0037\u0054\u004d\u0038\u0055\u003e\u0040\u005e\u006f\u0032\u0078\u0055\u0039\u0067\u0023\u005f\u0028\u0046\u0059\u004d\u007a\u007b\u0070\u0051\u0066\u0074\u0041\u0041\u0064\u0073\u004f\u005f\u0069\u0072\u004e\u004a\u0068\u0037\u0065\u0055\u002b\u0050\u0038\u0072\u0030\u0039\u003e\u0074\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0060\u0036\u0054\u0039\u005f\u006a\u0026\u002a\u0064\u0034\u0047\u0070\u0060\u0051\u0053\u0033\u0040\u0031\u0028\u0029\u0039\u0069\u0024\u0038\u0043\u0054\u004f\u0055\u0061\u004d\u0060\u006d\u005d\u0057\u0072\u007e\u0047\u0026\u002b\u0040\u0021\u0054\u0035\u0025\u0046\u003c\u003a\u0062\u0063\u0069\u0048\u005b\u005b\u002f\u0046\u0065\u0043\u004b\u0046\u0075\u0075\u0032\u002c\u0029\u0074\u0072\u004a\u005b\u004f\u0065\u0033\u004f\u0062\u004d\u003a\u003d\u0073\u006f\u006c\u002b\u002f\u0067\u006a\u003b\u007b\u002c\u0035\u0034\u0040\u0040\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0074\u004f\u0030\u0040\u0036\u005d\u0074\u0073\u004e\u0026\u0038\u0040\u0059\u0046\u003f\u0039\u0068\u0066\u0026\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0065\u0076\u0022\u003a\u004b\u004f\u005f\u0079\u0030\u007d\u007a\u0052\u004a\u0066\u0030\u0065\u007a\u0045\u002b\u0062\u0031\u005e\u002b\u002f\u0031\u003d\u0050\u0024\u0029\u0068\u002a\u003a\u005d\u0036\u006a\u004b\u0036\u006a\u0076\u002a\u004e\u0022\u0021\u0054\u0054\u0052\u003a\u0028\u0025\u0079\u0074\u0040\u0036\u002e\u0067\u0032\u0043\u0061\u002f\u0060\u006a\u0068\u006e\u007d\u004b\u0047\u0038\u005e\u002b\u002f\u0051\u006a\u0040\u0069\u007d\u005d\u0022\u003a\u004b\u004f\u003d\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0039\u0047\u0056\u0076\u0056\u0039\u0026\u006f\u0023\u002f\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0024\u0028\u0038\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u005b\u0053\u0030\u0041\u0072\u007b\u006c\u005e\u005d\u003d\u0032\u0066\u006a\u003f\u002f\u0056\u0076\u0063\u005f\u0051\u006f\u0047\u0024\u0078\u0023\u0023\u004c\u002f\u0033\u0032\u004e\u006a\u0029\u0055\u006c\u003c\u004a\u0028\u002a\u0074\u003c\u0065\u005b\u002b\u003d\u002b\u0035\u005b\u0021\u0064\u0074\u006f\u003a\u0031\u002b\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u002f\u0056\u0052\u004d\u004f\u0032\u004d\u0067\u0034\u0074\u0028\u0047\u0041\u006f\u0026\u0069\u0060\u0058\u0040\u0051\u005f\u0065\u003e\u0026\u006f\u0060\u0074\u006b\u0024\u006f\u0060\u0058\u003d\u007c\u006b\u004a\u006c\u007a\u0073\u0060\u0075\u0056\u0024\u0053\u007b\u0057\u0060\u0058\u003d\u007c\u0058\u0064\u006c\u007a\u0077\u003a\u0026\u0045\u0075\u007a\u0058\u006e\u003c\u0062\u0075\u0047\u0059\u002a\u0034\u0077\u0052\u006d\u0062\u0073\u0068\u002b\u0025\u0074\u003d\u007b\u0065\u0022\u0047\u0037\u005d\u004a\u0042\u003a\u0037\u0073\u0031\u0078\u006b\u0067\u0047\u0063\u0057\u0047\u0051\u005b\u0065\u0071\u006f\u0047\u0070\u004b\u0065\u0063\u0052\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0028\u0040\u007a\u0064\u0024\u004a\u004c\u0049\u0066\u0024\u006d\u004c\u0044\u006e\u004f\u0048\u006a\u0079\u003d\u005d\u0075\u0032\u0064\u0074\u006d\u003e\u0028\u005e\u0051\u007b\u0065\u0022\u0047\u0037\u005d\u004a\u0042\u003a\u0037\u0073\u0031\u0078\u006b\u0067\u0047\u0063\u0057\u003d\u004b\u0054\u0035\u0057\u006a\u005b\u0055\u0076\u0066\u0074\u0052\u005b\u0044\u0035\u0059\u0045\u0022\u0051\u0032\u0078\u005e\u0064\u0072\u0055\u0043\u0063\u0064\u007c\u0037\u002a\u005f\u0077\u0037\u0051\u005d\u0050\u0038\u004f\u0026\u0044\u0057\u0031\u002a\u002a\u007a\u0045\u0021\u006c\u0068\u0044\u0061\u002f\u0051\u006a\u0072\u0037\u0056\u0066\u0059\u003a\u003b\u003f\u0059\u0045\u0022\u0051\u0032\u0078\u005e\u0064\u0072\u0055\u0021\u0066\u0067\u006b\u0074\u0067\u0047\u0036\u0049\u0064\u0028\u0035\u002e\u0026\u0060\u0055\u005e\u0050\u0024\u003f\u0064\u007e\u002b\u0062\u0068\u0044\u0039\u005f\u0034\u003d\u004d\u0055\u002a\u0072\u0044\u003a\u0062\u0059\u0045\u0022\u0051\u007e\u005d\u005e\u0064\u0072\u0055\u0043\u002b\u0029\u0055\u004e\u007b\u0065\u0022\u0047\u0025\u0066\u002e\u0026\u0072\u0071\u0077\u0066\u003f\u007c\u0049\u0024\u0057\u002f\u0077\u0062\u0051\u0072\u0050\u006f\u0074\u0075\u0047\u0071\u004e\u0023\u0072\u003c\u002e\u0051\u0048\u0025\u0066\u002e\u0026\u0060\u0055\u0032\u002f\u0024\u003f\u0064\u007e\u0060\u0058\u0070\u0076\u0070\u0069\u0042\u0061\u0073\u0035\u005b\u0023\u004f\u0054\u0034\u004a\u003e\u003e\u0025\u0024\u0030\u0044\u0042\u0038\u005b\u007d\u006c\u0065\u006e\u0079\u0076\u0068\u0023\u004e\u0024\u002f\u0033\u0044\u007a\u0044\u0032\u004e\u0024\u0031\u0068\u0050\u002f\u004e\u006a\u002f\u0040\u0049\u006c\u0048\u0051\u0040\u0049\u0064\u003c\u004b\u0074\u0045\u003b\u0023\u0068\u0048\u0028\u004a\u0075\u0035\u0079\u006a\u0073\u003a\u0056\u003c\u002e\u0051\u0048\u006a\u0060\u0028\u0065\u0048\u003e\u0074\u005d\u005b\u006d\u0037\u0039\u0069\u0024\u0046\u0021\u0029\u005f\u003b\u006a\u0046\u0065\u0054\u004b\u002a\u005d\u0036\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0040\u0077\u007c\u0076\u0024\u0029\u0069\u0076\u0072\u0060\u003e\u003b\u007b\u0049\u0064\u007a\u0066\u0072\u0024\u004e\u0051\u0063\u003c\u0046\u006d\u005a\u0028\u005a\u0072\u0052\u006a\u0074\u0069\u0026\u002b\u006f\u007b\u0065\u0022\u0047\u006a\u0060\u0038\u0042\u0034\u004e\u006a\u003e\u0022\u005a\u006e\u004c\u0024\u002f\u0068\u007e\u0072\u005d\u0024\u0030\u0046\u002a\u0072\u0038\u006b\u002b\u002b\u006d\u005b\u0075\u0035\u0029\u003d\u003c\u0066\u0075\u0030\u007d\u003c\u002e\u0051\u0048\u0058\u0034\u0070\u0039\u003f\u0048\u0032\u006e\u0044\u004d\u004b\u0047\u0026\u006c\u005a\u0035\u0058\u006a\u007b\u0075\u002a\u0038\u0050\u007e\u0025\u0034\u0026\u006b\u0030\u0034\u003b\u0052\u0053\u0077\u0039\u007b\u0024\u0076\u007c\u0053\u005a\u003d\u0028\u005b\u0065\u004e\u006a\u0061\u0023\u0028\u0025\u0030\u0075\u002a\u0038\u0050\u007e\u0025\u0048\u006a\u002f\u0028\u0079\u006c\u0052\u0061\u0054\u006e\u0044\u0051\u007a\u004a\u0069\u006a\u003e\u0048\u004a\u0021\u0042\u007c\u002b\u0024\u005f\u004f\u0078\u0057\u006a\u003d\u0040\u0065\u003d\u003d\u002a\u0067\u006a\u006e\u0070\u0061\u002b\u003a\u0044\u0051\u004c\u0024\u0043\u0079\u0057\u003d\u0028\u005d\u0050\u003d\u003c\u0073\u003e\u0075\u0064\u0030\u0065\u0072\u005f\u0061\u0073\u0035\u005b\u006e\u0040\u0054\u0034\u004a\u003e\u003e\u0025\u0024\u004d\u0022\u0058\u0063\u005b\u007d\u006c\u0065\u006e\u0079\u0076\u0068\u0054\u004d\u0056\u0066\u006e\u0073\u0044\u0063\u006c\u006d\u003a\u0044\u004e\u0052\u0071\u004f\u0023\u004d\u006b\u006d\u002b\u0060\u003c\u007e\u0066\u0057\u0024\u003b\u003f\u002b\u0078\u0069\u0072\u007b\u002b\u003b\u0043\u0051\u002a\u0023\u0024\u0043\u0079\u0076\u0041\u0024\u0038\u002c\u0062\u004c\u0044\u0053\u002b\u006f\u006c\u0047\u002f\u0063\u006a\u0068\u0058\u0048\u004a\u0029\u002b\u0050\u004e\u0076\u005b\u0043\u0038\u0058\u006a\u0050\u0022\u0021\u002e\u0043\u0077\u0076\u0071\u006a\u005f\u0071\u0073\u0075\u006c\u0069\u004b\u0048\u006a\u0053\u006f\u0078\u007a\u0064\u0076\u0053\u0051\u005e\u0036\u0028\u0046\u0079\u006f\u0060\u0074\u003c\u0051\u003d\u002b\u006f\u006c\u0041\u0021\u006c\u0037\u0052\u004d\u0039\u004b\u0059\u006d\u0045\u0060\u0061\u002f\u0033\u0034\u005b\u007d\u0043\u0061\u006e\u0079\u005b\u007a\u002f\u0069\u0025\u003a\u007d\u0067\u007d\u0068\u0069\u0057\u0040\u0076\u003a\u0046\u0030\u007d\u002c\u0064\u005f\u0066\u0040\u007c\u0053\u0059\u004c\u0024\u0044\u003a\u005e\u004c\u0072\u006c\u0047\u0066\u003c\u0077\u0041\u0069\u0051\u0076\u0074\u0048\u0070\u0066\u0032\u007b\u003d\u0047\u0055\u0026\u007e\u0023\u0070\u0079\u0052\u0056\u006e\u0039\u0048\u0056\u0062\u005e\u0069\u0060\u006f\u006f\u0059\u0036\u0029\u0046\u004a\u003b\u0038\u007c\u0024\u0074\u0043\u0065\u0031\u0022\u003a\u0028\u0056\u0042\u0079\u0028\u0046\u004c\u0037\u0069\u0054\u006b\u003c\u0024\u0050\u006a\u0021\u0079\u006f\u0074\u0069\u005d\u0022\u003a\u0028\u0056\u0042\u0079\u0035\u0071\u004a\u0070\u0041\u002a\u0062\u0035\u0034\u0045\u003c\u0028\u003d\u002a\u006f\u0074\u0046\u003f\u0042\u0022\u003a\u0028\u0056\u0042\u0079\u0044\u0026\u0030\u003a\u0070\u0066\u007e\u0024\u0053\u0047\u0066\u0025\u0050\u006a\u0070\u007b\u0065\u0022\u0047\u0041\u0076\u0068\u0043\u0063\u006f\u0074\u005d\u005b\u006d\u0078\u0078\u0050\u0029\u006d\u005b\u0033\u0032\u005e\u006a\u0035\u006a\u0034\u002c\u003c\u002e\u0051\u0048\u002b\u0077\u002c\u0078\u0048\u003e\u0043\u0038\u002b\u002b\u0037\u0051\u0061\u0022\u0074\u005b\u007e\u0032\u006c\u0045\u0022\u0051\u007e\u005d\u003b\u006a\u0056\u0034\u0078\u005a\u006f\u0024\u005a\u0057\u0045\u006c\u0047\u002a\u005a\u006a\u0043\u007c\u007a\u002f\u0059\u0023\u003c\u004b\u0069\u004b\u0073\u0055\u0046\u007b\u0062\u0075\u006c\u0049\u005f\u0048\u0064\u0030\u003e\u007b\u004d\u0043\u003f\u0058\u0049\u0050\u0041\u0053\u0057\u0044\u006c\u0053\u0067\u003c\u002e\u0051\u0048\u005a\u005a\u0058\u006f\u0047\u0070\u0056\u0066\u0077\u0032\u004a\u0063\u0035\u0076\u007a\u006a\u003e\u002b\u0066\u0072\u006a\u006c\u006c\u0042\u0053\u002b\u006f\u006c\u0047\u002f\u0025\u0059\u0060\u0048\u0022\u0031\u0069\u003a\u0021\u0045\u002e\u0036\u0060\u0062\u005f\u004c\u0050\u0029\u006d\u005b\u0033\u0032\u0074\u0041\u0024\u003d\u0032\u003b\u0036\u0047\u007b\u0065\u0022\u0047\u005a\u005a\u0042\u0026\u006f\u003a\u002f\u0073\u0023\u0041\u004c\u006f\u0063\u0057\u007c\u0021\u003f\u002f\u0063\u006a\u003e\u0053\u0063\u0054\u007b\u0065\u0022\u0047\u005a\u005a\u0042\u0026\u006f\u003a\u004e\u0034\u0048\u0053\u005e\u007e\u0069\u0051\u003b\u0043\u0025\u0079\u002c\u0078\u0050\u0070\u0043\u0066\u0077\u0032\u004a\u0063\u0035\u0076\u0062\u0024\u0062\u0024\u002c\u006f\u002b\u002b\u0037\u0051\u003d\u0043\u0049\u003c\u002e\u0051\u0048\u005a\u005a\u0042\u0026\u006f\u003a\u004e\u0034\u004f\u0032\u0047\u0063\u0024\u0051\u0062\u003c\u006c\u0074\u0054\u0077\u0028\u003c\u002e\u0051\u0048\u005a\u005a\u0042\u0026\u006f\u003a\u004e\u0034\u0024\u0041\u0072\u004b\u0023\u0023\u0062\u0051\u005d\u0050\u006c\u007a\u003a\u0037\u0050\u0078\u006a\u0056\u007b\u0049\u0064\u0033\u0032\u0060\u003d\u0044\u004e\u007b\u007a\u007a\u0046\u0061\u0055\u0065\u0062\u004e\u005b\u0068\u0025\u0034\u0026\u0040\u0034\u005b\u0055\u0043\u0073\u004e\u0045\u0053\u0051\u005d\u004d\u0021\u0026\u006c\u0059\u0025\u0037\u0065\u0050\u0070\u0063\u005f\u0025\u0040\u0057\u0040\u003c\u002e\u0051\u0048\u0068\u0072\u0055\u0061\u007b\u006f\u0030\u0025\u0076\u006a\u003b\u003f\u004d\u0021\u0026\u006c\u003d\u0032\u0071\u006b\u0022\u007b\u0025\u0021\u003d\u002a\u003d\u003c\u004f\u006c\u004a\u0022\u0047\u005d\u0059\u0071\u0075\u0074\u0045\u005b\u0040\u0059\u004c\u0035\u0025\u003e\u0057\u0055\u006c\u0028\u005f\u0069\u005e\u0058\u004e\u0032\u0072\u006b\u002a\u002a\u0071\u003d\u0024\u0079\u003b\u0023\u0073\u003c\u002e\u0051\u0048\u0068\u0072\u0055\u0061\u007b\u006f\u0030\u0025\u0076\u006a\u003b\u003f\u004d\u0021\u0026\u006c\u0059\u0025\u0037\u0065\u0050\u0070\u006c\u0078\u006e\u0026\u002c\u003f\u0053\u0036\u004b\u006d\u0028\u002c\u0029\u004f\u0073\u003e\u0028\u006b\u0057\u0072\u0078\u0023\u002c\u0062\u0026\u006c\u004c\u0025\u0064\u003b\u0042\u003f\u0023\u0063\u0026\u003e\u0054\u002a\u002b\u007c\u0030\u0064\u003b\u0058\u004e\u0021\u005a\u003e\u0040\u003f\u0041\u0026\u002b\u006f\u006c\u0030\u0051\u002a\u0036\u006a\u0063\u0054\u0069\u0068\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u0072\u0041\u0053\u003c\u006d\u0079\u004b\u0074\u0065\u0052\u006a\u0077\u004e\u0034\u005d\u0070\u0078\u0038\u0022\u0031\u005f\u0035\u0043\u0057\u0067\u007a\u0077\u0076\u0073\u003e\u007b\u002b\u005a\u0055\u004a\u0073\u005b\u0049\u0050\u0038\u006f\u0034\u0043\u0056\u0052\u007c\u0054\u0040\u0032\u005e\u0043\u0054\u0070\u0043\u0079\u006f\u0060\u0051\u0072\u006d\u003c\u0076\u005e\u0038\u0065\u004e\u006a\u0070\u0041\u006b\u0058\u0046\u0043\u002a\u003b\u0068\u0059\u004f\u003f\u006a\u002e\u0035\u0061\u0032\u004a\u0021\u004f\u0066\u0045\u0022\u0051\u006f\u006b\u004e\u006a\u003a\u004d\u003b\u004e\u0049\u007a\u0063\u006a\u005f\u005e\u003b\u0043\u0054\u004f\u0052\u006a\u005f\u0035\u0076\u0067\u0068\u002e\u004a\u004e\u006a\u005e\u0022\u003e\u0079\u0033\u0067\u0041\u004a\u0070\u0065\u0048\u006a\u0024\u0071\u002b\u002e\u0068\u0030\u002e\u0060\u006a\u0072\u0061\u0076\u007e\u002e\u0030\u0054\u0069\u0048\u005b\u005b\u002f\u0070\u0037\u0058\u004d\u0060\u003e\u004d\u0073\u0070\u0029\u0079\u005a\u0062\u0051\u007c\u007e\u0021\u004b\u004d\u003c\u002e\u0051\u0048\u006a\u0060\u005d\u0059\u0047\u0070\u004b\u0066\u0074\u004b\u0048\u0068\u0026\u002b\u004e\u005b\u0066\u0035\u0077\u0061\u0075\u0071\u003e\u0048\u0070\u0024\u0052\u0028\u005b\u0065\u0048\u006a\u004b\u0070\u002f\u003c\u0076\u007d\u0048\u0073\u006e\u006f\u0076\u0026\u006c\u0025\u0066\u0067\u003b\u0048\u005e\u0062\u006a\u0034\u0045\u006f\u0076\u0076\u0051\u0049\u007a\u0059\u0024\u007e\u0024\u0052\u0036\u0063\u002b\u0071\u005a\u0028\u0059\u004f\u0074\u004e\u007b\u0065\u0022\u0047\u0058\u0034\u0075\u006a\u005f\u0048\u0022\u007b\u0025\u0021\u003d\u002a\u006f\u0074\u006e\u0048\u007a\u0055\u007b\u0036\u0025\u003a\u002a\u005f\u005d\u0067\u0035\u0063\u006a\u005d\u0021\u0056\u0029\u0048\u0024\u007b\u003c\u0043\u0076\u0022\u0024\u0033\u0069\u003c\u004b\u005a\u0035\u0071\u006a\u0046\u007e\u006d\u004c\u007a\u0069\u0024\u002e\u0028\u0069\u0065\u0048\u006a\u004a\u007e\u003a\u003a\u0038\u0034\u004d\u0074\u006d\u003e\u0028\u0040\u005b\u006f\u0074\u0058\u0055\u0057\u0051\u0069\u0046\u006d\u0076\u005e\u0050\u0079\u0067\u006a\u0066\u0045\u005e\u006c\u003b\u0038\u0069\u006a\u005e\u0048\u0023\u005b\u002a\u0030\u0045\u0021\u0028\u006b\u0079\u0041\u0024\u0033\u006d\u004d\u0071\u0057\u003c\u006d\u005d\u0052\u0064\u006a\u007c\u007c\u0069\u002b\u002c\u004a\u0033\u0032\u0063\u006a\u0029\u0031\u0051\u0031\u007c\u0023\u004c\u0044\u006c\u005d\u0038\u0021\u005e\u005f\u0077\u0037\u0051\u005d\u0050\u0038\u004f\u0026\u0044\u0057\u0031\u0056\u0073\u0078\u007e\u002e\u004d\u004d\u0021\u003d\u005f\u0060\u006a\u0034\u0056\u0076\u0052\u0071\u0072\u0065\u0053\u0065\u0069\u0065\u0076\u003a\u0046\u0036\u007a\u007e\u0037\u0035\u0031\u005e\u0053\u0021\u0062\u002c\u005e\u0041\u004a\u0051\u005f\u0039\u0065\u0052\u003e\u0035\u0025\u0030\u0048\u0077\u0070\u0050\u0056\u003e\u0072\u007a\u0045\u003e\u0048\u0050\u0047\u007e\u0046\u005e\u0062\u005e\u0043\u0048\u002e\u003f\u003f\u0032\u0069\u004e\u005b\u0054\u0035\u0061\u0043\u0055\u003a\u0073\u003b\u003a\u003f\u0047\u0063\u006c\u0051\u005f\u005d\u003d\u005f\u0068\u0065\u0044\u005e\u007b\u0060\u004d\u0077\u006e\u007e\u0040\u004c\u0044\u0070\u0065\u007c\u0024\u004d\u0058\u0072\u005e\u0069\u002f\u0024\u0024\u0031\u0078\u0071\u0068\u002e\u0034\u007e\u0021\u002a\u0023\u004f\u0026\u006a\u005d\u005a\u0072\u0056\u0023\u0061\u003c\u006b\u006c\u0068\u0067\u0061\u0035\u0029\u007d\u0037\u004e\u0032\u005e\u0023\u0021\u004e\u006a\u0036\u0048\u0072\u0054\u0047\u0023\u0042\u0028\u0034\u005b\u006f\u0074\u003a\u0038\u0074\u0031\u0072\u0045\u0032\u0051\u004e\u004a\u0052\u006a\u0071\u0058\u0045\u0046\u002c\u0055\u0043\u003d\u0062\u0039\u0051\u0034\u0051\u003e\u003d\u003c\u0044\u0024\u007b\u002b\u006c\u0021\u0075\u0035\u002b\u0065\u006a\u005f\u0076\u004b\u004a\u006d\u0078\u0042\u0026\u0046\u002e\u007a\u0061\u004e\u0052\u007b\u002e\u003d\u0037\u004e\u0032\u005e\u006c\u0073\u006e\u0026\u0047\u0070\u003e\u003b\u003c\u003a\u0043\u003e\u0078\u0079\u006d\u006d\u0076\u0051\u002e\u004a\u0075\u006a\u0029\u0043\u0040\u002a\u003d\u005a\u0057\u0047\u0051\u0036\u0065\u0074\u006d\u0059\u003e\u0050\u0029\u006d\u005b\u0033\u0032\u0031\u0026\u002a\u0030\u0069\u0035\u0073\u002b\u002e\u0045\u0076\u0021\u0062\u0039\u003a\u004d\u0060\u0060\u0078\u0055\u005d\u0068\u0048\u0076\u005e\u0029\u0038\u0075\u006a\u0046\u0046\u003a\u0039\u0061\u003d\u0035\u0076\u0037\u0051\u002e\u004a\u004e\u006a\u004b\u007c\u0031\u0079\u0057\u003d\u0028\u005d\u0050\u003d\u003c\u0073\u003e\u0072\u0066\u005e\u003f\u0058\u0063\u003c\u0024\u005b\u0062\u002c\u0035\u0071\u0071\u0043\u0064\u0079\u0057\u003d\u0028\u005d\u0050\u003d\u003c\u0073\u003e\u0072\u0066\u0026\u003f\u0033\u0059\u0067\u002a\u0076\u005e\u0050\u0079\u0070\u005d\u0047\u0070\u0077\u0066\u0077\u002b\u007a\u0045\u003e\u007e\u004a\u005b\u005a\u0035\u0070\u0065\u002a\u0024\u007c\u006d\u002a\u0057\u0026\u0029\u004b\u0047\u0076\u005e\u0075\u0035\u0045\u006f\u0047\u0070\u0056\u0066\u004e\u0075\u0028\u0047\u0053\u002b\u0047\u0051\u0079\u004a\u0071\u006f\u0026\u0044\u007d\u0035\u006a\u006a\u0063\u0057\u006b\u0076\u0064\u0028\u0025\u0079\u0032\u0070\u0054\u004d\u005f\u0064\u0044\u003a\u0030\u007e\u0044\u0024\u0061\u004a\u004f\u0065\u006f\u0074\u006a\u0063\u006c\u0034\u0054\u002e\u0035\u0035\u0060\u003a\u006d\u0048\u003b\u0048\u006a\u0036\u002f\u0039\u006d\u005b\u0026\u0074\u006d\u004e\u005b\u005a\u0035\u0063\u006a\u0048\u0041\u0077\u0062\u0051\u0040\u005b\u0026\u006a\u005b\u0053\u0060\u0058\u004e\u0028\u0075\u0050\u0045\u006a\u0065\u0055\u0045\u002b\u004a\u004f\u0065\u006f\u0074\u0051\u005d\u0062\u005e\u0079\u0052\u004d\u003a\u0072\u0035\u003b\u006a\u0045\u003e\u0062\u0030\u003e\u0040\u007b\u0029\u0057\u0073\u0076\u005e\u0025\u0079\u004a\u003b\u0055\u003a\u002b\u0062\u0038\u0072\u0064\u0026\u003d\u0040\u003e\u0028\u0059\u004f\u0056\u002e\u0071\u006f\u0054\u0075\u0038\u0072\u0021\u0045\u0035\u002e\u0050\u006a\u0069\u002f\u0024\u0043\u0051\u0071\u0074\u0075\u0038\u0072\u007e\u0047\u006f\u0033\u005f\u006a\u002a\u007c\u0056\u0056\u0053\u005b\u0068\u002a\u003e\u0034\u0064\u005a\u006c\u004d\u0026\u0032\u0067\u0047\u007c\u0023\u0079\u004b\u0070\u0046\u0028\u0046\u0079\u006f\u0044\u0038\u007e\u0024\u004a\u005d\u0073\u0036\u0070\u0077\u0034\u0051\u0059\u004f\u0063\u006a\u0044\u006d\u005f\u0056\u0060\u0034\u007e\u002e\u0043\u0073\u0079\u007e\u0024\u0046\u003f\u0021\u005d\u0053\u0029\u0056\u0053\u005b\u0068\u002a\u0063\u006a\u002a\u0056\u003a\u0067\u0079\u0023\u003e\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0033\u0074\u0040\u0068\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u007a\u0046\u003c\u0066\u007e\u0024\u0053\u0047\u0049\u0066\u0021\u0052\u0060\u0076\u0052\u003b\u004c\u0061\u0052\u0052\u0079\u007e\u0049\u0026\u004f\u0033\u0030\u0065\u0034\u0068\u0051\u0074\u0043\u0049\u003c\u0057\u0032\u0068\u0028\u0021\u0078\u0055\u0023\u0047\u0066\u0069\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0033\u0074\u007b\u004b\u0075\u0073\u0075\u0022\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0054\u0056\u0046\u0077\u005b\u0055\u0034\u0072\u003c\u007e\u003f\u0024\u0044\u003a\u006c\u0066\u0074\u0031\u0053\u0066\u0041\u003a\u0028\u005d\u0035\u006f\u0074\u0022\u0068\u0032\u006e\u0073\u0024\u0039\u0038\u0069\u004e\u005b\u0075\u0050\u0048\u006a\u0039\u0077\u0035\u004c\u0024\u0044\u003a\u005e\u0041\u007c\u0074\u003c\u0051\u0056\u004e\u006a\u003d\u006d\u0045\u0057\u005d\u0057\u0062\u0051\u0072\u0050\u006f\u0074\u0077\u0073\u007c\u0054\u004d\u0033\u0029\u0056\u0053\u005b\u0068\u002a\u0063\u006a\u0034\u0056\u0035\u0025\u002e\u007b\u003d\u0047\u002e\u0053\u007c\u0028\u0034\u007e\u0032\u005e\u005a\u005a\u0045\u006a\u0063\u0074\u0069\u0048\u0054\u007c\u0024\u0044\u003a\u006c\u0066\u0074\u0072\u004a\u006e\u002e\u0058\u004c\u0044\u004f\u0045\u006f\u0074\u0047\u0058\u0028\u0060\u0079\u0052\u0058\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0024\u0048\u0034\u007b\u0064\u0025\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0024\u0041\u0052\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u003b\u0062\u003c\u0057\u0062\u0061\u0031\u0053\u004b\u0046\u002b\u0075\u0037\u0028\u002b\u0047\u0051\u003b\u0050\u0038\u004f\u006f\u0060\u0066\u003e\u0059\u006d\u0067\u0047\u0079\u002a\u0062\u004b\u0058\u003d\u0078\u0075\u0040\u0063\u0028\u003d\u0046\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0024\u0067\u0076\u003b\u005b\u0023\u004f\u007c\u0024\u006a\u0040\u0042\u005b\u0068\u0044\u0058\u003c\u006d\u0077\u0051\u003b\u0050\u0069\u006a\u0056\u0064\u005f\u0077\u0037\u0051\u005d\u0050\u0038\u004f\u0026\u0044\u0057\u0031\u0026\u003f\u003b\u0045\u004c\u0051\u002b\u004a\u004f\u0065\u0037\u007b\u002c\u0034\u0045\u0046\u0037\u0038\u003d\u007b\u0048\u0040\u0041\u0049\u006a\u0075\u004e\u003d\u0073\u0077\u0055\u007c\u002c\u0079\u003b\u007b\u004b\u0045\u0035\u005b\u0045\u0025\u0072\u0040\u0026\u005e\u006d\u005d\u003d\u0030\u002a\u007e\u007c\u0023\u004c\u0044\u0060\u0029\u007d\u0070\u0070\u0021\u0079\u004a\u0025\u0061\u0053\u007b\u0033\u0047\u006c\u0076\u0067\u002c\u003b\u0045\u0065\u0021\u0050\u0022\u0073\u0026\u0074\u0071\u003b\u0074\u0032\u003d\u0075\u0069\u006e\u0058\u0076\u0051\u005d\u0035\u0060\u006a\u007b\u004d\u0063\u003e\u007c\u006d\u0035\u0047\u0056\u0056\u0053\u005b\u0068\u002a\u007a\u0078\u0032\u0048\u0029\u003b\u004e\u007b\u005b\u007d\u0076\u0039\u0065\u0079\u006f\u0071\u0047\u0070\u0052\u004d\u0061\u006b\u004d\u0067\u0056\u0056\u0062\u0071\u0076\u004b\u004a\u002b\u0051\u002e\u0043\u0025\u0079\u0060\u0042\u0058\u004e\u002f\u0060\u006b\u002a\u0067\u0047\u0023\u003f\u0045\u0032\u0062\u0022\u0051\u0070\u0078\u0024\u0037\u004a\u0070\u0021\u005a\u0070\u003f\u0067\u0047\u0046\u0049\u004f\u0028\u002b\u0062\u0051\u004d\u006b\u0048\u005e\u004c\u0037\u002c\u006f\u006a\u006a\u0063\u0028\u0035\u0039\u0021\u002e\u0043\u0052\u0023\u0073\u0045\u006c\u0051\u003d\u0049\u0071\u006a\u0075\u002e\u0076\u0025\u0021\u0068\u0042\u002e\u0066\u0041\u0023\u0061\u0044\u0068\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u0075\u0053\u006a\u0078\u0063\u0060\u0057\u0046\u006d\u0051\u002a\u005a\u003d\u003f\u0071\u0040\u006e\u003d\u0028\u007c\u0025\u0041\u0062\u0034\u007e\u0021\u002a\u0023\u004f\u0073\u0042\u0026\u003e\u004b\u004a\u007e\u0031\u006e\u0043\u0032\u005e\u0023\u0021\u0073\u006a\u004b\u0052\u004b\u007e\u0043\u002b\u007d\u0030\u0062\u0047\u0051\u007c\u002c\u0031\u0063\u002f\u0069\u0035\u0073\u0062\u003b\u005b\u0066\u0035\u0025\u0068\u005d\u0056\u002e\u0079\u0040\u0067\u006b\u0063\u0071\u002b\u006f\u006c\u0039\u005f\u006f\u0026\u0077\u0070\u0024\u0065\u0057\u006e\u0055\u0072\u0047\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u006d\u0035\u0061\u006b\u005b\u0045\u0036\u0029\u0041\u004a\u0059\u004f\u007c\u0050\u002b\u0043\u007a\u0064\u0052\u0032\u005d\u0029\u0054\u0040\u0062\u0023\u0079\u0067\u0024\u0047\u002f\u0069\u0073\u005b\u0045\u004f\u0052\u006a\u007c\u0023\u0030\u0047\u0077\u004f\u0079\u0066\u0040\u002a\u004a\u0073\u005b\u0074\u002b\u002b\u0073\u005b\u0045\u004f\u0052\u006a\u0042\u002e\u0058\u004c\u0044\u007a\u0025\u003a\u0043\u0055\u003a\u003e\u003b\u0024\u003f\u006f\u0067\u004b\u0047\u0064\u0028\u002e\u004a\u006b\u003b\u003a\u0037\u0021\u005a\u0024\u003f\u004d\u0067\u0066\u0052\u004d\u0068\u0061\u0065\u0058\u006f\u0055\u003a\u0072\u004f\u0076\u006a\u006d\u0026\u0025\u0058\u0028\u007a\u0043\u0052\u006a\u002f\u0061\u002f\u0063\u006a\u004a\u0070\u0025\u0035\u003d\u0025\u003d\u006e\u0043\u0032\u005e\u0023\u0021\u0072\u0037\u003b\u006f\u0065\u0055\u006b\u002a\u0052\u0039\u0026\u0024\u0025\u0037\u0033\u004f\u006f\u0057\u0023\u0047\u0051\u005d\u0035\u002e\u0026\u0057\u004e\u002b\u0022\u005e\u0024\u005a\u002e\u0077\u0062\u0051\u0044\u002f\u0074\u002f\u0037\u002b\u0075\u006c\u0052\u0063\u0047\u0021\u0067\u0072\u0062\u006f\u006c\u004b\u0038\u0048\u006a\u0038\u0049\u0041\u0048\u0035\u0042\u0064\u0047\u0032\u005e\u003d\u002a\u0060\u006a\u0046\u0041\u0059\u0034\u002f\u0031\u002f\u004d\u0032\u0043\u007e\u0025\u0045\u006a\u003e\u0038\u0074\u0062\u0044\u007b\u0065\u0022\u0047\u005a\u005a\u0079\u0026\u003e\u003a\u0051\u006e\u0055\u0033\u0055\u005d\u0025\u0043\u0024\u0050\u003b\u0034\u005d\u0024\u006e\u0073\u007b\u0028\u0034\u007a\u0033\u0079\u0069\u007a\u0052\u004d\u0074\u0055\u004f\u0025\u0059\u0033\u0077\u0047\u0068\u0047\u0046\u005b\u0024\u0066\u0074\u0070\u003a\u006f\u0076\u0021\u0028\u005f\u0065\u007c\u0024\u0068\u0040\u0071\u0079\u0052\u0056\u006e\u006b\u0061\u006f\u0062\u0056\u0069\u0062\u005d\u0025\u006d\u0076\u0039\u0039\u002b\u0079\u0028\u0038\u0065\u0031\u0026\u0069\u005e\u002c\u006f\u0074\u0062\u0061\u006f\u003b\u0042\u0030\u0035\u0067\u002e\u0058\u007e\u0046\u0041\u0076\u004d\u0024\u0055\u0050\u0033\u0032\u0077\u006a\u0026\u004d\u0074\u002f\u0041\u0036\u0061\u0048\u0073\u0076\u002f\u0033\u0079\u0069\u007a\u0052\u004d\u0074\u0045\u0044\u0028\u004b\u0073\u0033\u0077\u0047\u0068\u005e\u002a\u005a\u0065\u003c\u003b\u004d\u0037\u0051\u0059\u004f\u007c\u0024\u004a\u0042\u007a\u0024\u0023\u007c\u0021\u005e\u0059\u006f\u0074\u002e\u0058\u007e\u0046\u0072\u0043\u0036\u0024\u0066\u0056\u002c\u0068\u002b\u0062\u006b\u003c\u007a\u0066\u0050\u0024\u0073\u003c\u006d\u006f\u006c\u0028\u005f\u0067\u006a\u0052\u0036\u0057\u0029\u0045\u0032\u006e\u0043\u002e\u0043\u0040\u0064\u0055\u0024\u0042\u004d\u007c\u0053\u0076\u0021\u0077\u0051\u006f\u006b\u004e\u006a\u003a\u006e\u0072\u0073\u0021\u007b\u0076\u005e\u0048\u0022\u002f\u0026\u003c\u004a\u0045\u006d\u0066\u0045\u004b\u0079\u0052\u0056\u006e\u0066\u0069\u003d\u0062\u0062\u0061\u0049\u0056\u007b\u0070\u0057\u0065\u0076\u0073\u0079\u0074\u0024\u0030\u0042\u0036\u003b\u0068\u005b\u007d\u007d\u0040\u0042\u0079\u006a\u0042\u004f\u0048\u0041\u007b\u0038\u0047\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u0061\u0039\u0039\u0051\u0022\u003c\u0025\u0043\u0024\u0050\u003b\u0034\u0067\u0071\u003e\u003a\u0062\u0061\u0036\u0069\u007c\u0068\u004f\u0028\u007a\u005d\u006c\u0077\u0039\u0061\u0071\u0055\u0055\u0025\u0076\u006a\u006d\u0073\u002a\u0078\u002b\u0047\u0066\u003b\u0065\u0075\u0052\u0021\u0070\u0035\u0037\u0026\u006a\u006a\u0071\u0035\u007e\u0053\u0034\u007e\u0048\u003a\u005e\u0043\u007d\u0035\u0060\u006d\u006d\u0076\u0051\u002e\u004a\u0031\u0026\u004a\u0070\u0049\u006b\u0024\u0048\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0034\u0056\u0035\u0025\u0041\u005a\u003a\u007e\u0047\u003c\u0075\u006c\u0079\u0060\u0051\u0074\u003e\u0073\u006c\u0045\u006c\u0030\u0065\u0039\u0061\u0071\u0055\u0055\u0025\u006e\u007b\u0024\u007a\u0061\u0036\u005f\u0074\u0047\u0023\u0022\u0051\u004e\u004a\u0043\u0070\u002a\u006f\u0050\u0055\u0076\u006a\u006d\u0056\u0067\u006e\u0025\u0044\u0060\u0021\u0057\u0047\u0051\u007c\u0036\u0050\u0047\u0066\u0045\u0066\u0057\u004b\u0034\u0074\u0053\u0028\u0051\u0057\u0023\u0023\u004c\u002f\u002e\u0078\u0077\u0078\u004a\u003e\u0021\u0025\u007c\u003f\u0050\u0063\u0048\u0024\u0058\u002b\u0021\u0064\u0028\u0068\u0049\u0055\u0024\u0067\u007b\u006b\u002c\u0055\u007b\u0024\u0051\u0046\u004a\u0070\u0065\u0048\u006a\u005e\u0036\u0034\u003c\u0021\u0057\u0047\u0051\u003b\u0055\u0045\u006a\u0039\u0036\u0046\u0069\u002b\u0021\u0064\u0028\u0068\u0049\u007b\u0046\u0051\u0031\u006d\u0035\u0073\u0053\u0026\u0029\u0079\u0061\u003f\u007b\u002b\u002e\u0068\u0042\u004a\u004e\u006a\u0054\u0033\u0065\u007e\u003f\u0040\u0076\u0051\u0077\u005b\u0026\u006a\u0054\u0077\u006a\u003c\u0039\u003b\u005e\u0028\u0023\u003d\u004b\u0064\u0029\u006c\u0024\u0065\u002f\u0029\u0059\u0064\u005e\u0054\u007b\u002b\u005d\u0052\u005b\u0065\u004e\u006a\u007b\u0060\u004c\u005d\u005d\u0036\u0029\u002b\u0041\u004a\u0056\u0064\u0064\u003b\u0046\u005e\u0025\u0039\u0023\u004e\u005b\u007c\u0032\u0079\u0057\u0073\u0047\u0051\u0059\u004f\u0070\u0037\u003c\u0062\u0048\u0058\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u0024\u006d\u005a\u0033\u0046\u005a\u007a\u0065\u0074\u0079\u0056\u0077\u005a\u0029\u0064\u0042\u0066\u0069\u0026\u003a\u0069\u0068\u0073\u0048\u002c\u0033\u0032\u0077\u0058\u0057\u0051\u0076\u0035\u0060\u0061\u0060\u0074\u0021\u007c\u002b\u0068\u0022\u002a\u0036\u0049\u0066\u0076\u0067\u0073\u0047\u0066\u0056\u0022\u0041\u0055\u0070\u006e\u0021\u0037\u0066\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u006f\u005e\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u003f\u006d\u0038\u0031\u0059\u002e\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u004d\u0062\u0035\u0034\u0023\u0047\u005f\u005f\u0038\u002c\u0043\u0052\u003f\u0047\u0077\u0066\u004a\u007c\u0057\u0050\u003a\u0047\u0046\u0023\u0053\u002c\u0079\u0070\u0066\u007e\u0024\u006d\u006d\u0067\u006e\u0022\u003a\u006c\u0034\u005f\u0079\u006f\u0074\u0050\u006a\u0064\u0071\u0030\u0022\u003a\u005e\u0061\u0051\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\