07e\u0039\u0075\u0040\u0055\u0077\u0051\u002a\u007a\u0059\u0047\u007e\u007e\u004b\u002e\u0032\u0064\u003d\u0024\u0055\u0045\u0075\u004f\u0053\u0046\u0026\u0029\u0040\u002b\u003b\u0053\u007a\u0066\u0050\u0065\u002b\u005f\u005b\u0037\u0038\u0045\u0057\u002b\u0021\u004b\u0072\u0053\u005d\u004d\u0039\u0055\u002b\u0075\u0039\u0039\u0064\u0073\u003f\u0048\u006d\u0079\u0052\u0050\u0075\u003a\u0046\u004a\u0056\u0037\u004b\u007d\u0067\u0042\u0079\u0059\u0057\u0063\u0052\u0056\u006b\u0068\u0046\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u0046\u0046\u002b\u0055\u007d\u003a\u0063\u007c\u0051\u0026\u004c\u0057\u0077\u0068\u0040\u002e\u005d\u0024\u003f\u0040\u006c\u0061\u006c\u006b\u0042\u0052\u006a\u0048\u006d\u002f\u007c\u0049\u0077\u007a\u005a\u0056\u0064\u0024\u0060\u007c\u0042\u0079\u002a\u0069\u0073\u0057\u003d\u0021\u007d\u0024\u005b\u0030\u004a\u0035\u0032\u0060\u0076\u005a\u0074\u0034\u0031\u0048\u0055\u0056\u0031\u0078\u0039\u0028\u007e\u007e\u0060\u005e\u0037\u0078\u002f\u003b\u0050\u0070\u0046\u0038\u0074\u002a\u0067\u0028\u0066\u0040\u0042\u006d\u007e\u0056\u0064\u0042\u0079\u0034\u0062\u0034\u0048\u005d\u0068\u0068\u005b\u0035\u003c\u0028\u004b\u0043\u0047\u0043\u0069\u0071\u007c\u004b\u0054\u0032\u006f\u0067\u0044\u0051\u0033\u0051\u005d\u0030\u006d\u003d\u0043\u006f\u007b\u0062\u002e\u0032\u004f\u0045\u0043\u004e\u0071\u006b\u0034\u0064\u0021\u0045\u004f\u0040\u0045\u0044\u0026\u002a\u003b\u0029\u004d\u0035\u003a\u004b\u002a\u0036\u0022\u0039\u005e\u004e\u004b\u0064\u002e\u0067\u002b\u0041\u003c\u0039\u005f\u006d\u007c\u0032\u002e\u005a\u007b\u0061\u0074\u006c\u006c\u002e\u007b\u0058\u003e\u0035\u007e\u004a\u003c\u002f\u0064\u0071\u0035\u006c\u0062\u0036\u0036\u0062\u0037\u0029\u0046\u0021\u0047\u005b\u0072\u0072\u0037\u0040\u004b\u0046\u0059\u0070\u0054\u005d\u0067\u0071\u0034\u0077\u0045\u0053\u0046\u0078\u005b\u0078\u0058\u004e\u0026\u003e\u0031\u0078\u0074\u0023\u0078\u0028\u004c\u003b\u004a\u0075\u0078\u0061\u0056\u0061\u0056\u004a\u0038\u0065\u0049\u0067\u0023\u003e\u0045\u0072\u006a\u0073\u0072\u0037\u0050\u0070\u0075\u004a\u007b\u0053\u004a\u0037\u007c\u002a\u002f\u0075\u0053\u0063\u004f\u0026\u007a\u0037\u007e\u0029\u0044\u007e\u0048\u0063\u007c\u002a\u003e\u004b\u003a\u0029\u0054\u0034\u0031\u0048\u0076\u0025\u0032\u0039\u0034\u0059\u0059\u0076\u007c\u003d\u0021\u0043\u0074\u0026\u0051\u0043\u002e\u007c\u0065\u0067\u006f\u0028\u007d\u0075\u0070\u0051\u005d\u0038\u003e\u003d\u006f\u0071\u0062\u003c\u0078\u0073\u0046\u007c\u0029\u006c\u007c\u0021\u0065\u0067\u0055\u007b\u0066\u003e\u0034\u0069\u0078\u0075\u0026\u002b\u0052\u006c\u0069\u004a\u0078\u0075\u0060\u006a\u006a\u003a\u003c\u0079\u0037\u0057\u005a\u0070\u005f\u0059\u0056\u0069\u0026\u002f\u0047\u007a\u005e\u0034\u0061\u0051\u0070\u005f\u0070\u006f\u003c\u002e\u005f\u0053\u0059\u0059\u004e\u0070\u003d\u004b\u0063\u002a\u007e\u004e\u0055\u0055\u004a\u0040\u005b\u0064\u003d\u006b\u0061\u0063\u0036\u0047\u0077\u0031\u0026\u0036\u004d\u0070\u0050\u0048\u0032\u0067\u006a\u0051\u002b\u004e\u0038\u0034\u0072\u004d\u007b\u0025\u003e\u0069\u004b\u0041\u007a\u004b\u0046\u006b\u0061\u0038\u0064\u0039\u0057\u0029\u0067\u0048\u0057\u0043\u002f\u0064\u0043\u0022\u0059\u0029\u0040\u0026\u0062\u002e\u0039\u0048\u004e\u007b\u004d\u0047\u0068\u0069\u0075\u0075\u006a\u0035\u006c\u0061\u0050\u0034\u007c\u0074\u0071\u0031\u0021\u0030\u0057\u0070\u0040\u005e\u0026\u005e\u0034\u005b\u0024\u004e\u0032\u0036\u0029\u0055\u006c\u005b\u0057\u0045\u005d\u0065\u0040\u0060\u0073\u0073\u0024\u006e\u005d\u0048\u004e\u007a\u0066\u0021\u004b\u006c\u004a\u0067\u0026\u002c\u0061\u004d\u0025\u0037\u0057\u0079\u0053\u002b\u0055\u0030\u0057\u003d\u0021\u004a\u0045\u0043\u0037\u0042\u002f\u007d\u0075\u003e\u0058\u0026\u004d\u006a\u0051\u0073\u0075\u005a\u006a\u0029\u0040\u0057\u0053\u007b\u0038\u0075\u0041\u0068\u0045\u0030\u004b\u006d\u006b\u0040\u0039\u0039\u006c\u0026\u0044\u005e\u005d\u0063\u0071\u0069\u0040\u0028\u003b\u0023\u004f\u0066\u0078\u0077\u0070\u004f\u0079\u0025\u006b\u0044\u004e\u0046\u0071\u0024\u0050\u004f\u0065\u0076\u0039\u0047\u0077\u0038\u005b\u0065\u0026\u007c\u0068\u004e\u0073\u004c\u0044\u0038\u0063\u0023\u0039\u0029\u0037\u0030\u0077\u0069\u003a\u0048\u007c\u0077\u0035\u0042\u002a\u0054\u004f\u0025\u0076\u003e\u0071\u0041\u003e\u006e\u002a\u0063\u0063\u0056\u0075\u0068\u003b\u0048\u003e\u007e\u0040\u007b\u0061\u0043\u0025\u0022\u0038\u006e\u007b\u0067\u0035\u0031\u003a\u004d\u006b\u0063\u006a\u0039\u0047\u0072\u003c\u0021\u004b\u006c\u0048\u0042\u004d\u0050\u0060\u0073\u0038\u0064\u002c\u0069\u0023\u0063\u0076\u0066\u0032\u0051\u0040\u002e\u0056\u0035\u0029\u0021\u0025\u005e\u0070\u006b\u0053\u0059\u0036\u0070\u003f\u005f\u0036\u0065\u004d\u0039\u006c\u004b\u0026\u003e\u002e\u0032\u0025\u0041\u0024\u0021\u003a\u002f\u0071\u0045\u003c\u0058\u004d\u006c\u0043\u0078\u0040\u006d\u0062\u003d\u0078\u0076\u0038\u0076\u0048\u002f\u007e\u0046\u0032\u006f\u0039\u006b\u0072\u0061\u005a\u0037\u0026\u0035\u007b\u006c\u004f\u004a\u006a\u0071\u002f\u003e\u0058\u0039\u0026\u005d\u002c\u0029\u0050\u0069\u0062\u0051\u006d\u0042\u003e\u005a\u004b\u004e\u005d\u0078\u005a\u0064\u0048\u0057\u005d\u007e\u0035\u002f\u007c\u004a\u0046\u0055\u0075\u0071\u0038\u0024\u0047\u0038\u005d\u0057\u0039\u0048\u003f\u0072\u0034\u0034\u002f\u0029\u0022\u0040\u002a\u007c\u0028\u0034\u0031\u0026\u0022\u0058\u006b\u0025\u002c\u0063\u003a\u0046\u0051\u002b\u0031\u0043\u0031\u0061\u0022\u0028\u007c\u0068\u0072\u0076\u0078\u0036\u0068\u005d\u006b\u0070\u0079\u0075\u0069\u0065\u0021\u003f\u0047\u0040\u0031\u005e\u0073\u005a\u002f\u0042\u004f\u0021\u005b\u0024\u0021\u007c\u0051\u0026\u0072\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0042\u0079\u003d\u0061\u0033\u0079\u007e\u004e\u0028\u0052\u0056\u006b\u0064\u0048\u0047\u0077\u0058\u0062\u0053\u0038\u0035\u0037\u006f\u0062\u0070\u0076\u006f\u0075\u0046\u0046\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0038\u0066\u0073\u0057\u007d\u0066\u002f\u0045\u003e\u0056\u004d\u005b\u0060\u007c\u004e\u0052\u007a\u003c\u003b\u002f\u0037\u0045\u0051\u006a\u0058\u0036\u0022\u007c\u005b\u007d\u004f\u0048\u0029\u0078\u0028\u0064\u0061\u0058\u0044\u0079\u004d\u0023\u005e\u0056\u002e\u0044\u006a\u0063\u0029\u0029\u0059\u0038\u0053\u0043\u0063\u0072\u0072\u0024\u005d\u0036\u0062\u0053\u004f\u005d\u0030\u0079\u006b\u0026\u0023\u004e\u0051\u006b\u003d\u0065\u0043\u003f\u0064\u0062\u0043\u0057\u003d\u002a\u0032\u0070\u0054\u004d\u0025\u0072\u007d\u0073\u004e\u0045\u006d\u006d\u007b\u004a\u0028\u0049\u0071\u006f\u0051\u0031\u002c\u0055\u0072\u0073\u004a\u0063\u006c\u0051\u0076\u005e\u0057\u0021\u005d\u005b\u0024\u006d\u0035\u005b\u007e\u0025\u004e\u006a\u003d\u005d\u0044\u007b\u0036\u0029\u0055\u0049\u0040\u0038\u005e\u0032\u0065\u0074\u0064\u005e\u0056\u005e\u0060\u0054\u002f\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u0065\u005a\u0024\u0024\u003a\u0066\u007b\u0066\u0064\u0046\u007e\u0041\u004a\u0074\u0065\u0070\u0043\u0054\u003e\u0040\u003b\u0024\u0026\u0050\u0026\u003d\u0037\u0069\u0026\u005a\u0046\u004a\u005d\u0050\u0030\u0076\u0065\u0055\u004a\u004f\u0024\u0051\u0037\u0024\u004b\u0057\u006c\u0024\u006d\u003d\u004b\u0061\u002f\u007d\u0046\u0051\u0071\u0071\u0042\u0070\u0073\u0040\u0053\u005a\u0071\u0053\u0078\u0062\u004a\u005b\u002e\u0032\u0058\u004d\u0023\u005e\u0056\u002e\u0044\u0047\u0077\u0031\u006a\u004f\u0077\u003a\u0053\u006d\u0073\u0026\u0068\u0079\u005b\u007d\u004f\u0048\u0029\u0078\u0028\u0064\u0061\u0058\u0044\u0079\u004d\u0023\u005e\u0056\u002e\u0044\u005d\u002b\u0050\u0059\u0061\u003d\u002e\u003e\u0031\u0054\u005d\u0035\u0077\u003f\u0049\u0077\u0070\u003f\u003c\u005d\u0046\u0073\u0050\u0064\u0036\u0076\u002e\u0043\u002b\u002f\u004e\u006a\u0063\u0070\u005d\u003b\u0040\u0073\u0044\u0028\u002a\u0074\u0051\u0030\u0060\u0050\u0023\u003a\u0023\u0039\u0068\u0070\u0063\u0061\u0069\u0057\u004e\u005b\u004e\u0060\u005a\u006a\u0077\u004b\u0053\u0073\u004f\u006c\u003d\u007a\u0058\u006a\u004c\u0035\u0074\u0055\u0063\u006d\u0065\u005b\u007e\u0063\u004a\u0070\u0065\u0048\u006a\u0024\u005b\u002c\u004c\u0035\u0033\u0040\u0053\u0078\u0068\u007a\u004a\u0037\u0065\u003c\u0038\u0058\u0037\u0029\u006a\u0076\u0076\u0030\u0044\u005a\u0035\u005a\u006a\u0038\u0046\u0044\u007e\u0060\u0021\u004b\u002e\u0050\u0054\u0074\u0026\u005e\u007c\u003b\u006b\u0069\u0064\u0052\u003a\u004b\u0062\u0039\u005b\u0056\u0030\u007c\u005a\u007c\u007b\u003d\u0067\u0076\u0050\u0068\u0078\u004b\u007d\u0040\u0074\u006c\u0064\u0022\u002c\u0022\u0066\u004e\u0040\u0053\u0078\u0068\u007a\u004a\u0037\u0065\u004a\u0069\u0025\u004f\u004a\u002b\u004e\u0045\u0060\u0021\u005f\u005d\u004a\u0054\u0073\u0040\u0052\u0048\u0024\u0038\u0054\u004e\u006a\u0068\u003e\u007e\u0025\u0021\u0029\u0077\u0061\u0043\u0029\u0055\u005f\u0064\u002b\u0063\u007e\u0047\u0028\u007d\u004b\u0060\u0036\u0025\u003e\u003d\u0079\u006f\u006e\u006f\u002c\u0077\u002f\u0057\u0051\u004d\u003c\u0028\u0056\u0064\u0023\u0068\u0050\u005e\u0045\u0025\u0059\u0061\u0053\u0070\u007c\u004d\u0026\u0053\u0068\u0039\u007e\u0068\u0050\u005e\u0045\u0025\u0059\u0061\u0053\u0070\u007c\u004d\u0026\u0053\u0068\u0039\u005f\u0060\u0023\u004d\u005b\u0055\u003e\u0078\u0074\u0028\u0052\u0062\u0050\u003a\u0041\u0035\u0057\u003d\u003a\u0037\u0072\u006d\u0024\u003f\u002c\u0029\u003f\u0024\u0073\u0028\u0059\u004f\u004e\u006a\u0041\u004d\u0056\u0066\u0051\u006d\u007b\u0029\u007e\u0068\u004c\u006c\u0051\u002a\u0077\u0061\u0048\u0043\u0073\u0071\u0047\u0069\u0050\u0057\u0032\u0056\u0030\u0044\u0028\u002a\u007d\u0076\u0078\u0061\u0066\u0046\u0048\u002a\u0049\u0026\u003c\u002f\u004a\u0046\u006a\u0059\u004d\u0066\u0058\u004e\u0069\u0035\u003b\u0053\u004b\u003f\u005b\u0064\u0053\u0051\u0038\u0065\u0050\u0061\u0050\u0070\u0054\u0072\u0069\u0030\u0030\u003f\u0028\u0076\u007e\u0028\u0041\u007a\u005e\u0042\u0063\u006f\u0037\u004e\u0038\u0072\u003c\u0026\u0074\u0055\u0063\u007b\u0036\u0065\u0049\u0050\u005f\u005e\u0024\u0029\u0079\u0061\u0053\u007b\u0077\u0062\u0069\u0028\u004c\u004a\u0032\u0076\u0043\u006f\u0064\u0052\u0073\u0053\u0077\u0039\u0041\u007c\u0022\u0051\u007a\u004a\u0032\u0036\u0059\u0047\u0055\u007c\u0068\u0067\u0050\u004e\u0049\u0076\u0046\u004a\u0069\u002f\u0065\u0078\u0073\u0060\u0030\u007c\u0042\u0024\u004c\u0068\u004a\u004a\u004d\u006b\u0077\u0059\u005f\u0060\u0023\u004d\u005b\u0055\u002f\u0078\u0074\u0028\u0052\u0062\u0050\u003a\u0041\u0035\u0057\u003d\u003a\u0037\u0034\u007c\u004e\u0032\u003a\u007e\u004b\u0045\u0063\u007b\u006d\u004b\u0078\u0040\u002b\u0073\u0064\u0024\u0040\u0075\u005e\u0075\u0024\u004b\u0021\u006f\u0025\u0023\u004f\u0056\u006a\u0038\u002f\u003a\u0062\u0031\u0039\u006f\u0076\u003d\u0028\u004b\u0064\u0074\u0074\u005e\u004e\u0021\u002a\u0034\u004e\u0023\u0068\u0073\u006b\u006c\u0051\u002a\u0050\u0046\u0040\u0070\u0073\u0050\u0068\u0048\u0032\u0051\u0059\u004f\u0070\u0043\u0053\u004d\u004f\u0064\u0055\u0069\u0058\u0063\u0044\u0024\u007c\u004f\u0064\u0043\u0026\u002b\u003d\u0028\u005a\u0035\u0054\u003b\u002a\u006f\u0060\u006a\u0033\u0045\u0066\u0033\u0029\u0046\u004a\u0053\u002a\u0057\u006a\u0072\u006a\u002f\u0044\u0023\u0025\u005d\u007d\u0029\u003d\u0028\u0059\u004f\u0077\u0024\u002c\u006a\u0042\u0028\u003c\u0032\u003a\u004d\u0075\u002b\u0046\u004a\u0043\u0063\u0025\u005b\u0078\u007e\u0037\u0042\u0064\u004c\u006d\u004a\u0028\u003f\u007a\u0033\u0042\u007b\u0065\u0022\u0047\u006e\u004f\u0033\u004f\u0058\u004e\u0055\u0057\u006b\u0058\u0056\u0056\u006b\u006c\u0030\u0065\u0048\u006a\u0042\u004e\u0032\u005e\u0068\u0050\u003c\u002e\u0051\u0048\u003b\u0073\u0041\u005d\u0049\u0048\u0044\u0054\u0060\u0078\u0041\u0033\u006a\u0026\u005f\u0076\u0022\u005e\u0049\u005f\u0075\u006a\u0072\u0032\u004a\u006c\u003e\u007b\u0045\u0041\u0057\u0053\u005b\u002f\u0079\u004e\u006a\u0058\u0057\u0074\u006d\u0023\u004e\u005b\u0068\u002a\u0073\u006a\u0064\u0048\u0050\u005a\u0059\u002b\u0067\u007d\u003a\u0046\u004a\u005d\u0050\u0074\u007b\u0049\u002a\u003b\u005d\u0073\u0062\u0045\u006c\u0072\u0043\u003b\u006a\u005e\u003e\u0044\u0035\u0062\u0063\u007e\u0047\u004c\u002b\u0040\u0021\u0060\u0038\u0060\u006a\u007a\u0059\u0046\u0030\u0069\u0073\u0024\u0021\u0052\u002a\u0034\u003d\u0062\u0065\u0033\u0043\u004a\u002a\u007e\u007e\u0053\u0068\u003a\u0044\u0045\u004f\u0058\u006a\u0075\u0045\u0037\u004d\u003e\u0028\u005b\u0065\u0069\u005e\u0078\u0037\u0068\u004d\u006c\u0030\u002e\u0045\u0031\u0060\u004f\u0024\u007c\u0069\u0073\u004c\u0044\u0039\u005f\u0053\u0037\u005a\u0077\u0057\u006b\u006f\u0032\u0050\u0063\u003d\u002b\u0052\u0068\u0069\u0065\u0069\u005e\u0070\u0055\u0060\u0025\u0021\u003d\u002b\u0062\u0051\u0038\u0078\u0060\u006a\u0066\u0052\u004b\u0049\u0048\u0028\u0052\u0038\u0065\u0060\u006a\u0047\u006a\u0044\u006f\u007e\u004b\u0045\u0059\u003c\u007c\u006c\u002b\u007b\u0071\u0049\u0048\u005d\u0052\u002b\u0065\u0058\u006a\u0075\u0046\u006c\u0075\u0074\u006d\u0030\u0044\u0026\u002a\u0034\u006a\u004c\u006a\u003c\u0073\u0053\u0023\u0079\u0028\u007d\u004a\u0033\u004f\u0023\u004d\u0058\u003b\u0050\u0063\u0026\u0029\u0071\u002b\u0062\u0023\u0076\u0043\u0073\u007b\u005a\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u0065\u0055\u003a\u006b\u0038\u0059\u002c\u0062\u0035\u005b\u0075\u0035\u0058\u006a\u002b\u005e\u0077\u003b\u004f\u0032\u0060\u0059\u002a\u0056\u006b\u0072\u0054\u0051\u0037\u0024\u007e\u0053\u0055\u0028\u0062\u002e\u0061\u0049\u0075\u0075\u0053\u0057\u0039\u0072\u007a\u002b\u006c\u0074\u006b\u0070\u0065\u006f\u0071\u0053\u004d\u0036\u003d\u007e\u007e\u0056\u0045\u003f\u006c\u0034\u0064\u0040\u0061\u0073\u0070\u006b\u0056\u0059\u006b\u0075\u0041\u002b\u0024\u003e\u0076\u0059\u006b\u0074\u0067\u0050\u0076\u0065\u0021\u005b\u002f\u005d\u005d\u0044\u004e\u003c\u0035\u0032\u0057\u0052\u0039\u0054\u0048\u0022\u003f\u0052\u004d\u002c\u002a\u002c\u0029\u0048\u006c\u0035\u0043\u002b\u0023\u0046\u0024\u006d\u002b\u0034\u0042\u0044\u007e\u0021\u0072\u002b\u005f\u0041\u0050\u0054\u0043\u0036\u0023\u004a\u0077\u002e\u0079\u0039\u0057\u004b\u0025\u005a\u0055\u003f\u003b\u0070\u002b\u002c\u0079\u0064\u007c\u0048\u0063\u0068\u0068\u0065\u0076\u0033\u0040\u0041\u0024\u0071\u0076\u0026\u0048\u005f\u0035\u0047\u004b\u0072\u002a\u0065\u0049\u0046\u0037\u0040\u0040\u0025\u0065\u0075\u006a\u0070\u006f\u007e\u003d\u0046\u0058\u0072\u0025\u0055\u0060\u0048\u003c\u006a\u0030\u0075\u0035\u0028\u0056\u0058\u0063\u0028\u0061\u0063\u0070\u0024\u006a\u004b\u0071\u007a\u005b\u0047\u003d\u0052\u0036\u0063\u004c\u0039\u0031\u003f\u004a\u0072\u0042\u007e\u0046\u007e\u003e\u0038\u003f\u0053\u0062\u0029\u007b\u0068\u005a\u005e\u005a\u0055\u0076\u0063\u005e\u0071\u007a\u0056\u0076\u0051\u0051\u002a\u0074\u0057\u0023\u0033\u003f\u0054\u006f\u0045\u0046\u005a\u004f\u006c\u0061\u002f\u0025\u0046\u0023\u004d\u003e\u0031\u0056\u0032\u0045\u0041\u007d\u0070\u0062\u0075\u0041\u0068\u0054\u0023\u004c\u0045\u0048\u0037\u006b\u0034\u005b\u006a\u005e\u0075\u0071\u006a\u0030\u0063\u0034\u0051\u007b\u0045\u004d\u0076\u005b\u0047\u004b\u0075\u003d\u004f\u0071\u0067\u0062\u002f\u0078\u0059\u007c\u0023\u002a\u005f\u0028\u0045\u0056\u0035\u005a\u003c\u0034\u0064\u0068\u007e\u0075\u006a\u0071\u0056\u002a\u0047\u006b\u0070\u0023\u0074\u006b\u0050\u006d\u006d\u0021\u0028\u0067\u005d\u0045\u006a\u0023\u0036\u0030\u0045\u004c\u0044\u006a\u006c\u003e\u002a\u006c\u0067\u003d\u0071\u0028\u002b\u005e\u007b\u0032\u0064\u0042\u0079\u0024\u0073\u003b\u0044\u004b\u0034\u0058\u0026\u0031\u002b\u0068\u0070\u0028\u0057\u005e\u007c\u0062\u0073\u005b\u0060\u0055\u0029\u0026\u002f\u0029\u0073\u0057\u004b\u0028\u0038\u0043\u0053\u007d\u0070\u0079\u004a\u003f\u0023\u0074\u006f\u0072\u0048\u0045\u0057\u0062\u0051\u0048\u004b\u0048\u006a\u0073\u0060\u007d\u0029\u002f\u0037\u0051\u0073\u005a\u0059\u0046\u0035\u0061\u0069\u004b\u007c\u003f\u0032\u0052\u004f\u003e\u0024\u005d\u0066\u0077\u007e\u0023\u0070\u005e\u005f\u0021\u0043\u0035\u003c\u0068\u004c\u0046\u0061\u007b\u0057\u0038\u0052\u003a\u0073\u0024\u0067\u0022\u007c\u0041\u0028\u007b\u0041\u0025\u0028\u0025\u0077\u005d\u002f\u0070\u0055\u0069\u0056\u0032\u0034\u0052\u0030\u0074\u0058\u0060\u0047\u007e\u003e\u002b\u006d\u0053\u0063\u0036\u0036\u006f\u0021\u0070\u0078\u0064\u0034\u0034\u0070\u0064\u0058\u0043\u006d\u0074\u0067\u0021\u0045\u0051\u006c\u0053\u005b\u002f\u002c\u004a\u0057\u0075\u0041\u004d\u007b\u004f\u006c\u004c\u004a\u0024\u007c\u0042\u003f\u005e\u0035\u005b\u006d\u0041\u007e\u0028\u0061\u0065\u0021\u007c\u0056\u0033\u0060\u006c\u0033\u0062\u007d\u0059\u003e\u006a\u003a\u004a\u0063\u0025\u0076\u0070\u0021\u0034\u0064\u006e\u0026\u006f\u0071\u003c\u0035\u002e\u002a\u0056\u005b\u0061\u0068\u0063\u006f\u0072\u0076\u0066\u005a\u0048\u006c\u0035\u0043\u002b\u0023\u006f\u003c\u0042\u0046\u0022\u0043\u004f\u006d\u0021\u004c\u0051\u0075\u0036\u003d\u0066\u007e\u003a\u0046\u0032\u0040\u0029\u0030\u004c\u003a\u0074\u0024\u002f\u003e\u0052\u0064\u0073\u0025\u0024\u003c\u0061\u005d\u003e\u0026\u0053\u0075\u0053\u007a\u0076\u0079\u0052\u0042\u005d\u007e\u0040\u0059\u004d\u0041\u003f\u0077\u0048\u002b\u005b\u0046\u0037\u003e\u0029\u006a\u0069\u0055\u0068\u0053\u004e\u002a\u003e\u003d\u0036\u004e\u0046\u0049\u0060\u0034\u007a\u0040\u0035\u0076\u004b\u004e\u003f\u0058\u0031\u0055\u0038\u0064\u0072\u0047\u0063\u0035\u0048\u0070\u0040\u005d\u006d\u0059\u004f\u0025\u0063\u0053\u006e\u0034\u0051\u0056\u0064\u0023\u0068\u006b\u0070\u0026\u0066\u004d\u004d\u0057\u0049\u0040\u0069\u007b\u006d\u0062\u0028\u0068\u0072\u006d\u006d\u003f\u0049\u003d\u002a\u002e\u0026\u006b\u0030\u007c\u004d\u0026\u0032\u0061\u0068\u003a\u0068\u0050\u0047\u007d\u003c\u003a\u004a\u0035\u006b\u0032\u0046\u0044\u004e\u0057\u006b\u0024\u0026\u0062\u0048\u003a\u0048\u0079\u003b\u0062\u0028\u007b\u007b\u0021\u0037\u003a\u005d\u0075\u0032\u004c\u0029\u0067\u0023\u003d\u004b\u004f\u0065\u0024\u0040\u0073\u004c\u0061\u004a\u0057\u0072\u0057\u0059\u0022\u003c\u0044\u003a\u0046\u0028\u0061\u007a\u0074\u0071\u0053\u006b\u0058\u0072\u0044\u0048\u0058\u0075\u004c\u006d\u006d\u006e\u004e\u0048\u0046\u004d\u0074\u0021\u002c\u0057\u0030\u0039\u0077\u006c\u0041\u004a\u006c\u002f\u0059\u0061\u004e\u0044\u0070\u0074\u0074\u0030\u0048\u0029\u0074\u0062\u0063\u007a\u0021\u003d\u006d\u003c\u0061\u0075\u002e\u006d\u0055\u0058\u0043\u0057\u0079\u0028\u004e\u004a\u0029\u0045\u0021\u006f\u0079\u0076\u003b\u0053\u005d\u002b\u003b\u0058\u003a\u0044\u0052\u002a\u0078\u0061\u004c\u004b\u0066\u0075\u003c\u0060\u0026\u0029\u0051\u0073\u0069\u004b\u004f\u0045\u0064\u0033\u002e\u0043\u0040\u0064\u0046\u0065\u003f\u0071\u0046\u003e\u007b\u0039\u0053\u0059\u0028\u0040\u006b\u006c\u0072\u0035\u0040\u0061\u004c\u004b\u0066\u0075\u0045\u003f\u0044\u0063\u0051\u002b\u0062\u0075\u0032\u0049\u004e\u0048\u0072\u0037\u0024\u0021\u003d\u0030\u002e\u0045\u005d\u0025\u0068\u006d\u0065\u0049\u0026\u0064\u0024\u0076\u007a\u0064\u0030\u0073\u004e\u0045\u0052\u0040\u0030\u0044\u0028\u002a\u0024\u0040\u006a\u0076\u0035\u007c\u0026\u0077\u002e\u0052\u0048\u0029\u005a\u007c\u0036\u0065\u0049\u0050\u0057\u004e\u0064\u0065\u0078\u007e\u0047\u0048\u006a\u006d\u0047\u0051\u0070\u0026\u0075\u0048\u006a\u0044\u0059\u003b\u0048\u0029\u005a\u007c\u002e\u004a\u003b\u003d\u0063\u0037\u0058\u0075\u0052\u0067\u0047\u0048\u0044\u006d\u0062\u0051\u0051\u002a\u0024\u0040\u0023\u005e\u003c\u0075\u0067\u006b\u0074\u0067\u003d\u002b\u0079\u004b\u004f\u0045\u0046\u0024\u0054\u0043\u003b\u003e\u0035\u0048\u0053\u0059\u0059\u0045\u0022\u0051\u0036\u0065\u0032\u0061\u004e\u0044\u0069\u003e\u007b\u0039\u0026\u0029\u007b\u002b\u0065\u003d\u002e\u004a\u003b\u003d\u0063\u0037\u0034\u002f\u0033\u004b\u005d\u0025\u004a\u004b\u0046\u0032\u0077\u0078\u0077\u004d\u0029\u0075\u0060\u006a\u0072\u002b\u003b\u0058\u0024\u0021\u0069\u0065\u0031\u0026\u003a\u003c\u0079\u0078\u0044\u006a\u006a\u0054\u002c\u0038\u0024\u0047\u0062\u0026\u005e\u005e\u0051\u0031\u0034\u003b\u005f\u0072\u0076\u0049\u003d\u002b\u004c\u0044\u002b\u002f\u0025\u0059\u0057\u004e\u0064\u0065\u0078\u007e\u0047\u0048\u004b\u002a\u0039\u0051\u0070\u0026\u0075\u0048\u0031\u006f\u003b\u003d\u0034\u0047\u002c\u007c\u003c\u0053\u002f\u0075\u006e\u0048\u0044\u0072\u0035\u0070\u0043\u0054\u003e\u0035\u0072\u0038\u0072\u0077\u0039\u0048\u0029\u0074\u0062\u0069\u002f\u0062\u002c\u007c\u004e\u003a\u005d\u0049\u003f\u002c\u0029\u0054\u006c\u006b\u006c\u0052\u002a\u0024\u0040\u0073\u004c\u0054\u0055\u002c\u0057\u006e\u0029\u002c\u0062\u006f\u006c\u0048\u0022\u006d\u005e\u0079\u006f\u0029\u0075\u003a\u007c\u006d\u0074\u0046\u003e\u007b\u0039\u0073\u0039\u002c\u003c\u0047\u0060\u005e\u003d\u0022\u0061\u0035\u0048\u0029\u005d\u0064\u0068\u002a\u003a\u002c\u0058\u004d\u003f\u0035\u002c\u0057\u0045\u004e\u0025\u007c\u003a\u0078\u006c\u007b\u0058\u002f\u005e\u003c\u003b\u006c\u0026\u0065\u0050\u0041\u003f\u003c\u0075\u003a\u003a\u007b\u0029\u0024\u0040\u003c\u0022\u006b\u0068\u002b\u0039\u005e\u0075\u0035\u0025\u0050\u0050\u0070\u0035\u0025\u0042\u007e\u0042\u0045\u003a\u0078\u0026\u0031\u003c\u0050\u0038\u003d\u0040\u004a\u005b\u004e\u0026\u0062\u0039\u0047\u0070\u003d\u006b\u004d\u0073\u002b\u0057\u0050\u005f\u0047\u0047\u0079\u004d\u0066\u006d\u0056\u0029\u0070\u0024\u0077\u005e\u0067\u003d\u0045\u0064\u0046\u0032\u005e\u007b\u0048\u0045\u0057\u0062\u0051\u0077\u0034\u0057\u006a\u0040\u004c\u006e\u0062\u0064\u0024\u0056\u005b\u006f\u0076\u003e\u0072\u0061\u0070\u0041\u0036\u007b\u006c\u003e\u0028\u0023\u0076\u0075\u003d\u003d\u004c\u002f\u0056\u0029\u007c\u0076\u0059\u004d\u003c\u0070\u0053\u0060\u0038\u0073\u005a\u0074\u0040\u005f\u0072\u0030\u0026\u0078\u0026\u0041\u0076\u0039\u0068\u007b\u007a\u0049\u005d\u0044\u004e\u006d\u0036\u006c\u0067\u0079\u0045\u0046\u0035\u0071\u006b\u002b\u0023\u0074\u0072\u003a\u007c\u0046\u007d\u007b\u006c\u003e\u0028\u0023\u0076\u0075\u003d\u003d\u004c\u0060\u0025\u006e\u002c\u0062\u0041\u0072\u0042\u0078\u0043\u0068\u006c\u003e\u0034\u0057\u0028\u0035\u005a\u0025\u007a\u0078\u0028\u0040\u0029\u0048\u0067\u0063\u0056\u004f\u0057\u0045\