u006a\u0074\u0031\u0037\u007d\u007a\u0058\u006e\u003c\u0062\u0075\u0047\u0059\u002a\u0034\u0077\u0052\u0054\u0077\u0049\u0026\u0051\u0043\u0037\u0036\u007a\u0058\u006e\u003c\u0062\u0075\u0022\u0024\u0022\u007c\u0028\u0045\u0029\u005e\u0078\u0075\u007a\u0024\u006c\u006d\u0057\u0023\u006b\u006c\u0040\u0064\u0050\u0059\u0041\u006f\u0040\u0060\u005b\u0029\u002a\u004a\u005d\u0050\u0036\u007a\u0043\u0037\u004c\u0076\u0073\u0032\u004a\u0063\u0035\u0068\u006f\u0064\u002c\u0047\u006d\u003c\u004b\u003d\u002a\u0043\u0059\u006c\u004d\u0069\u0050\u0055\u0063\u0069\u002f\u0034\u0070\u0063\u003c\u005a\u006c\u0022\u0051\u007c\u0032\u0049\u0050\u0025\u0070\u0069\u0050\u003c\u003a\u0021\u0070\u006e\u0047\u002a\u006d\u006d\u0021\u0028\u0067\u005d\u0048\u006a\u0048\u002e\u0021\u007b\u0032\u005e\u0036\u0029\u0063\u0057\u0073\u005b\u003d\u005f\u0029\u004f\u0073\u003e\u0068\u0036\u0024\u0038\u004b\u0045\u0038\u0073\u003a\u0022\u0022\u006c\u0064\u0072\u003b\u003a\u0055\u0076\u003b\u0032\u0065\u004c\u0054\u0052\u0063\u002a\u0055\u0037\u0039\u003a\u003d\u0045\u005f\u0041\u0043\u0029\u004f\u0042\u0026\u0028\u0045\u0024\u007e\u0066\u0036\u003e\u0063\u002f\u004a\u007d\u004b\u0023\u0052\u0048\u0049\u0035\u0048\u0037\u006e\u0077\u0032\u0032\u0056\u004a\u0049\u0073\u0024\u0037\u0054\u004f\u0039\u0023\u005e\u006c\u0044\u0034\u0078\u003f\u0066\u0063\u0029\u007b\u0029\u0057\u004a\u0052\u0044\u004a\u0030\u0079\u0033\u003b\u0052\u004a\u0069\u0038\u0069\u006f\u006f\u003e\u0063\u0041\u0043\u0079\u004a\u0026\u0042\u003a\u0079\u0037\u0024\u0055\u003c\u003c\u004e\u005e\u003a\u0077\u002f\u0021\u0037\u006b\u0060\u004e\u0043\u0075\u0079\u0029\u002a\u0075\u0067\u0028\u004f\u0024\u0076\u0067\u0033\u002f\u0058\u003e\u0061\u006e\u005e\u0047\u0039\u0072\u0038\u006b\u0043\u0035\u0051\u0060\u003e\u004e\u0061\u0032\u0070\u0046\u006c\u0070\u006a\u002b\u0026\u0072\u0026\u0029\u0038\u002a\u0033\u0077\u0066\u0043\u0050\u0067\u0026\u003e\u0024\u0043\u0031\u0061\u0053\u003b\u0075\u0026\u0051\u0060\u003c\u0061\u0066\u006c\u003c\u0059\u0033\u0049\u0026\u0064\u005e\u0041\u0078\u0033\u0049\u004d\u0045\u0058\u002b\u0026\u004d\u0040\u002a\u0078\u0038\u0050\u0033\u0050\u0045\u003e\u0051\u0061\u0060\u0052\u0059\u007a\u002c\u0043\u007e\u0075\u0031\u0053\u0037\u0028\u007e\u004a\u0073\u0077\u007d\u0025\u0055\u003e\u0051\u0077\u0060\u0022\u004d\u0032\u0077\u002f\u003b\u0064\u0052\u006a\u0034\u002e\u005a\u0061\u004d\u0037\u0032\u004c\u0031\u002b\u0024\u0025\u003c\u0079\u0064\u0052\u006a\u0034\u002e\u005a\u0071\u0038\u004b\u0045\u0040\u0033\u0073\u007c\u0049\u003f\u0070\u003b\u0042\u0029\u0073\u0038\u0035\u0031\u0057\u005f\u0050\u006e\u0075\u0034\u002e\u005a\u0041\u0035\u0058\u0052\u0038\u003f\u0070\u003b\u0042\u0029\u0073\u0052\u0076\u007d\u005b\u0068\u0077\u002e\u0054\u0076\u007a\u006b\u004f\u0034\u002c\u006c\u0048\u0038\u0026\u0062\u0075\u003f\u007b\u0058\u003e\u007a\u006b\u004f\u0034\u002c\u006c\u0046\u002b\u0024\u006f\u0047\u005d\u0066\u005d\u003e\u002e\u0030\u0043\u0034\u0033\u0046\u0025\u0049\u0074\u0045\u0052\u005f\u0051\u0059\u0046\u0053\u0049\u002b\u0049\u0050\u0056\u0058\u002e\u0030\u0043\u0034\u0033\u0046\u0025\u0049\u0039\u006a\u0056\u0075\u0035\u0059\u006b\u0034\u002e\u0030\u0043\u0034\u005f\u006e\u0073\u0049\u0037\u0077\u002e\u007e\u0031\u005d\u0026\u002e\u0077\u0039\u0060\u0064\u0049\u0024\u0066\u0039\u0071\u0029\u002e\u0030\u0043\u0034\u005f\u006e\u0048\u0035\u0035\u005d\u007d\u0063\u0063\u0079\u0039\u0060\u0073\u0066\u0035\u0058\u0045\u005d\u0064\u0029\u0073\u0024\u0049\u0047\u0034\u006f\u0066\u0035\u005f\u006a\u0035\u0023\u006f\u0074\u0039\u0061\u006c\u004c\u005a\u0030\u0035\u0046\u006b\u0078\u0036\u0029\u007e\u0046\u0077\u0028\u0054\u0036\u0042\u0036\u0046\u0048\u0035\u005d\u0058\u002f\u0031\u006b\u0023\u0062\u0070\u006c\u0022\u003c\u0068\u0035\u0041\u005e\u0069\u0077\u0030\u0063\u006e\u004b\u0074\u0042\u006f\u003b\u0035\u0068\u006f\u002f\u006c\u002f\u006f\u0047\u0048\u006f\u0057\u0052\u0030\u005f\u0048\u0044\u004e\u003f\u0071\u0025\u0074\u0033\u0068\u002f\u0021\u0058\u002b\u0037\u0054\u0059\u0035\u0065\u005d\u005d\u0026\u002e\u0053\u0034\u0065\u006f\u0022\u0071\u002c\u0066\u0072\u0026\u0063\u007a\u0059\u0040\u003d\u0034\u0031\u0059\u004f\u0026\u007d\u005a\u0031\u004a\u005a\u0047\u0047\u0066\u0025\u0053\u002f\u0028\u0053\u007e\u0033\u0068\u006c\u0062\u006c\u0023\u0042\u0063\u006d\u0045\u0036\u0032\u0063\u006c\u002f\u0034\u0072\u0078\u002c\u006f\u0051\u002f\u0068\u0022\u0021\u007a\u0056\u003a\u0068\u0041\u0062\u0056\u0022\u0030\u0032\u004d\u005a\u0033\u0077\u0031\u003c\u0043\u007e\u005b\u005a\u0023\u003b\u0063\u0048\u0069\u004c\u006e\u003d\u004b\u0057\u0077\u0058\u0026\u002a\u005f\u0079\u0036\u0039\u0024\u006d\u0074\u004f\u0052\u003b\u0070\u003c\u0031\u004b\u0026\u003b\u0079\u0049\u0028\u0037\u0031\u007e\u0055\u004c\u0040\u0023\u0074\u0067\u004a\u0034\u0058\u005f\u0033\u0068\u0048\u0067\u006f\u0026\u0046\u003e\u004b\u0033\u0056\u006d\u003e\u0048\u004c\u0062\u006a\u0044\u006c\u0040\u0040\u0054\u0069\u0046\u0032\u0059\u0049\u0030\u0047\u0025\u0034\u0026\u0031\u007c\u002e\u0053\u0042\u0030\u0068\u0049\u005a\u0069\u0052\u007c\u0022\u0072\u002e\u0061\u0040\u003d\u0034\u0031\u0059\u004f\u0052\u0054\u003f\u003c\u0066\u0043\u0021\u0079\u002c\u0059\u004b\u0039\u0062\u006b\u003b\u005e\u0035\u006f\u003d\u0038\u0046\u0062\u0038\u0030\u0026\u0078\u0062\u003c\u007c\u0034\u0058\u0053\u0060\u006f\u0040\u003a\u0053\u0056\u0043\u0057\u0052\u0073\u0077\u005e\u0061\u002f\u003f\u006a\u005b\u0052\u0075\u0076\u003c\u0078\u0038\u0038\u006c\u004c\u0063\u0061\u0025\u0022\u002c\u0041\u0055\u0063\u0032\u0075\u005b\u0059\u003a\u005f\u003a\u006a\u0046\u0047\u006f\u0074\u003d\u0031\u0022\u004e\u0072\u0075\u0024\u005e\u0034\u0031\u002a\u0023\u0031\u0065\u0048\u004b\u002e\u002c\u007b\u0073\u007a\u0040\u002a\u0057\u0031\u005b\u0060\u0050\u003a\u0044\u0033\u0049\u004d\u0056\u0032\u0022\u004e\u005e\u0052\u003c\u0066\u0054\u0043\u0023\u0065\u0075\u0063\u003a\u0022\u0029\u0033\u0063\u0038\u0061\u0031\u006e\u0026\u0046\u0077\u002e\u007a\u0057\u003b\u005e\u0040\u004e\u0028\u007e\u005b\u0072\u006d\u007d\u003f\u0071\u0051\u0042\u0056\u0053\u0054\u0038\u003d\u0055\u004b\u0061\u003d\u0040\u0035\u002a\u004a\u0065\u0065\u007e\u0037\u003d\u004c\u004a\u0072\u0024\u0047\u0070\u0049\u0046\u0025\u0067\u004e\u0077\u003f\u007d\u0044\u0060\u0035\u0046\u0044\u0043\u0077\u0021\u0053\u0025\u005a\u0065\u0069\u0072\u0072\u0048\u006b\u0051\u0030\u0068\u0033\u007d\u0049\u005d\u0034\u0023\u005f\u004e\u005f\u0038\u003a\u004d\u0042\u003f\u0054\u004d\u005f\u002b\u0051\u0037\u0079\u0043\u002e\u0048\u004d\u0034\u007a\u0068\u0076\u0072\u0055\u0076\u0023\u0064\u004e\u0055\u0025\u0021\u003c\u0078\u0034\u0043\u0022\u007d\u0041\u0074\u005d\u0054\u0042\u0067\u002b\u002c\u003a\u0031\u0072\u0024\u0070\u0068\u0064\u0025\u0058\u005a\u0074\u007d\u0068\u0070\u007d\u0044\u0072\u0064\u0071\u0066\u0068\u004f\u0065\u0056\u0051\u0066\u0052\u002e\u0072\u006c\u0066\u004d\u0029\u006e\u0053\u007d\u005d\u0045\u006a\u0040\u0038\u0067\u007a\u0060\u003e\u004d\u0057\u006f\u0051\u0050\u007c\u007d\u0028\u005d\u0066\u006b\u0057\u0074\u0046\u0057\u0074\u004e\u0066\u002f\u002f\u0052\u0026\u004a\u0043\u0030\u0034\u0067\u0025\u0065\u0049\u0077\u007a\u0032\u0074\u004f\u0040\u006a\u004d\u0061\u0048\u0070\u005e\u0021\u003e\u007d\u0066\u004f\u0070\u0049\u0046\u0025\u0067\u004e\u0026\u003c\u0061\u005e\u002e\u0072\u0054\u0044\u0032\u003b\u002b\u004d\u0030\u0036\u0059\u0066\u0063\u006b\u0049\u0075\u0023\u0077\u0056\u0030\u002c\u004e\u0037\u0023\u0036\u0028\u0030\u0036\u0022\u003b\u003a\u0061\u002b\u0055\u004c\u0061\u0055\u004b\u006c\u0071\u0074\u006c\u0045\u0059\u0039\u0052\u0051\u0041\u0024\u0021\u0056\u0035\u0048\u0065\u0079\u0028\u0065\u0023\u0062\u0057\u0026\u0058\u005d\u0066\u006a\u0070\u0044\u0055\u006b\u0072\u007a\u005f\u0031\u0058\u002b\u004b\u0063\u005b\u0062\u0069\u003c\u0039\u002c\u0072\u006e\u0079\u0046\u004f\u0045\u0033\u0067\u002f\u0040\u005e\u006a\u004e\u007b\u002a\u0062\u0058\u0060\u0072\u0056\u006a\u0033\u0054\u002e\u0072\u0075\u0062\u006b\u0058\u0024\u0034\u007e\u0021\u0070\u0069\u003c\u0029\u0061\u0024\u0033\u0036\u0068\u0071\u007c\u0040\u0050\u0049\u0035\u004f\u0035\u003c\u0073\u0022\u0050\u002b\u0040\u004b\u0051\u002a\u0026\u0042\u0021\u004e\u0045\u0040\u004f\u0025\u0067\u003c\u003d\u003d\u002f\u0053\u0038\u0050\u006c\u0040\u0041\u003b\u005a\u0057\u0056\u0025\u0063\u0072\u007b\u0024\u0021\u0045\u0049\u0042\u0029\u0032\u0069\u0039\u006a\u0050\u003f\u0061\u0046\u0060\u006d\u0047\u0043\u004e\u0064\u003b\u003b\u0041\u0047\u007e\u002c\u004d\u0060\u0074\u0061\u0028\u007b\u0069\u003b\u002f\u007b\u0026\u006c\u0051\u002a\u0024\u0043\u0057\u004e\u0054\u0044\u006b\u0032\u0057\u0059\u003e\u0021\u0062\u003e\u0070\u0036\u003a\u004c\u0043\u007c\u0072\u0045\u0022\u005e\u0043\u0038\u0071\u006a\u0074\u002c\u0072\u0072\u0042\u002a\u0028\u0058\u002a\u0066\u0064\u0052\u0028\u0074\u0022\u0075\u0021\u006b\u0047\u0053\u007c\u007b\u005e\u0041\u0072\u0072\u0026\u0079\u002c\u004a\u004a\u0072\u0060\u007a\u0033\u0044\u005a\u005f\u0029\u0055\u005b\u0078\u0070\u006d\u006d\u007a\u0070\u0045\u0032\u0070\u0035\u0028\u0074\u0040\u005b\u0067\u005a\u0029\u0041\u0060\u0041\u004d\u002c\u007d\u0049\u0059\u0021\u0043\u002b\u0057\u0034\u0053\u003d\u0029\u004f\u0025\u0078\u003b\u0038\u007c\u006e\u0039\u0054\u0058\u0056\u007a\u007a\u0044\u006f\u0069\u002b\u0024\u0064\u0031\u0074\u0035\u0075\u0026\u0071\u0024\u0059\u002a\u003b\u0061\u0041\u003f\u004b\u0076\u0024\u005d\u007d\u005b\u002a\u003f\u006c\u0079\u0031\u0074\u0035\u0075\u0026\u0071\u0053\u003e\u0072\u002f\u0048\u0047\u0072\u006b\u0072\u0054\u0079\u002a\u0028\u0054\u0038\u0079\u007d\u0023\u0023\u003d\u0046\u0066\u004f\u0052\u006a\u003e\u0057\u0055\u0043\u0040\u003f\u0079\u0059\u0024\u006a\u007c\u0074\u0036\u002b\u0042\u0073\u0041\u0055\u003a\u0051\u005f\u002f\u0075\u0054\u007b\u0024\u0077\u004e\u005b\u0079\u0057\u0071\u0021\u003c\u0028\u003f\u0079\u0059\u0024\u006a\u007c\u0056\u0036\u0075\u0057\u0025\u0074\u002b\u0046\u002b\u0030\u003f\u0079\u0059\u0024\u006a\u007c\u005d\u005e\u0075\u0053\u0061\u0078\u0072\u0029\u0041\u0037\u005a\u0040\u0035\u002a\u004a\u0065\u0065\u0075\u006a\u0030\u003b\u0030\u0055\u0079\u002a\u004e\u005b\u0026\u003b\u004e\u0059\u004a\u0068\u0045\u006d\u005a\u004c\u0073\u0037\u0079\u006f\u0048\u002f\u0074\u0054\u005d\u003f\u0045\u0044\u0047\u0034\u0026\u0079\u0058\u0044\u0032\u0050\u006a\u0079\u0044\u004c\u007a\u0054\u0076\u003e\u0057\u0067\u002a\u0066\u0066\u0037\u0044\u005a\u0057\u0067\u0041\u0029\u0042\u005b\u003c\u0048\u0055\u0045\u0050\u0070\u0060\u0075\u0079\u0071\u0054\u0055\u0021\u0048\u002e\u0044\u0061\u0079\u004c\u0065\u0023\u0062\u002b\u0068\u0045\u006d\u005a\u004c\u0073\u0033\u003d\u0041\u005b\u006e\u006b\u006f\u0049\u002b\u005f\u0050\u006c\u0056\u006a\u0028\u0062\u0037\u0042\u0030\u006e\u0041\u007e\u0067\u0076\u006f\u0070\u0062\u0061\u0063\u006d\u0042\u0076\u0026\u006c\u0051\u002a\u003f\u003b\u003c\u006f\u007c\u0053\u005b\u006b\u002c\u0029\u006e\u0077\u005e\u006a\u0043\u0061\u0071\u007b\u006c\u003d\u002a\u0074\u0068\u0062\u0075\u0040\u0076\u0051\u0077\u005b\u0026\u006a\u004c\u0049\u0047\u0071\u0056\u0022\u0034\u007c\u003b\u006a\u0034\u0039\u002f\u006d\u004a\u002a\u004e\u0021\u0052\u0056\u0029\u0045\u006a\u002b\u002f\u003f\u0072\u006e\u0071\u0064\u004d\u0052\u0024\u0039\u003c\u0078\u0042\u003b\u0029\u0063\u0049\u0035\u0056\u0067\u0066\u004b\u0048\u0055\u006d\u0068\u004e\u0066\u0038\u0021\u0066\u005d\u0079\u0040\u003c\u0025\u0066\u0058\u0024\u004d\u0032\u0037\u002b\u0061\u004c\u0057\u0050\u0048\u0079\u004b\u002a\u0071\u0050\u0066\u0048\u0054\u003c\u0055\u0034\u0060\u0038\u004d\u0066\u0063\u0058\u005e\u0071\u0073\u004f\u007a\u0024\u0032\u0025\u002f\u007d\u002b\u0038\u004a\u004d\u0055\u006d\u0043\u0071\u0035\u005f\u0032\u005b\u0062\u004e\u0073\u0073\u0041\u002a\u0048\u0051\u0075\u002e\u002a\u006f\u0067\u002b\u0024\u0064\u0064\u003f\u0076\u0053\u004d\u0045\u0053\u0036\u0066\u0059\u0024\u0033\u0047\u006c\u0076\u0070\u0056\u0072\u004c\u0021\u002f\u005d\u0048\u005e\u0060\u0058\u0063\u0040\u0051\u0043\u007a\u003a\u0044\u0055\u0057\u004d\u003a\u002a\u004d\u006c\u004f\u0041\u0071\u0067\u005f\u004b\u0050\u002e\u0035\u005e\u006e\u0068\u0064\u0070\u007c\u0028\u003c\u0032\u003a\u004d\u0075\u002e\u0045\u004d\u0040\u0058\u0069\u0052\u0062\u0072\u0052\u0072\u005a\u0067\u007e\u007e\u0067\u002f\u0023\u0056\u0062\u0061\u0077\u0069\u0074\u003d\u006b\u0062\u0053\u004d\u007b\u0070\u0037\u006f\u0074\u0057\u003c\u006f\u0049\u007a\u0046\u0079\u006a\u0070\u0029\u0040\u0078\u003c\u0069\u0036\u004c\u003f\u004c\u0039\u0048\u0045\u007a\u0029\u0052\u0068\u0033\u0058\u0073\u003c\u002a\u0030\u005e\u006b\u007d\u0038\u0055\u0045\u002a\u0051\u0021\u0052\u004b\u0068\u003e\u003e\u005b\u0059\u0073\u003e\u0034\u0079\u0029\u003e\u0032\u0036\u002e\u006b\u0057\u0041\u006a\u0040\u007e\u0078\u003c\u006d\u0063\u0045\u0051\u0050\u0063\u0032\u002c\u007a\u006d\u0031\u0036\u004f\u0045\u0066\u0024\u0055\u0076\u006f\u0065\u0058\u0060\u002f\u0035\u006f\u0078\u002c\u0026\u0069\u004c\u004e\u002c\u0059\u006a\u0033\u0076\u004a\u006a\u0052\u0021\u0035\u0078\u003f\u0037\u006d\u005a\u0051\u0060\u0024\u0065\u0070\u002a\u0071\u003f\u006f\u003d\u002b\u0035\u0075\u0069\u0060\u005b\u002c\u0059\u0030\u0058\u0074\u0050\u007d\u0079\u004d\u003b\u0062\u0022\u0079\u004d\u004f\u0054\u0068\u003e\u0037\u0060\u004d\u0053\u0045\u004c\u0033\u0046\u0060\u003e\u0035\u0053\u0036\u0039\u007d\u003d\u0067\u0051\u0060\u0079\u0077\u004a\u006f\u007c\u006f\u0040\u0066\u0031\u007a\u006d\u0031\u0036\u004f\u0045\u0024\u0063\u0045\u002a\u005b\u004d\u0070\u0069\u0077\u007e\u0024\u0045\u0070\u0067\u0075\u004e\u003d\u0038\u0052\u0069\u002c\u006a\u006f\u006f\u0048\u003a\u0069\u0050\u0059\u0029\u005b\u003b\u0024\u003a\u0067\u006f\u0067\u004b\u0034\u0066\u0051\u003c\u0060\u004e\u0054\u002c\u0040\u0048\u0076\u0028\u0026\u006c\u0048\u0050\u0061\u0043\u0057\u0069\u006f\u004d\u0064\u007e\u0073\u0038\u004c\u004f\u0067\u005f\u0064\u003e\u0026\u0062\u003f\u003e\u0026\u0037\u0032\u0029\u0054\u0067\u005f\u0042\u003e\u002e\u0056\u0029\u006d\u0061\u0071\u007c\u004a\u0042\u003e\u0068\u0056\u0046\u0042\u005b\u006c\u0053\u0064\u007d\u0023\u0031\u0056\u0062\u006a\u0068\u006b\u006f\u0064\u0076\u0028\u005f\u004f\u0029\u0052\u005b\u0023\u004f\u0074\u002e\u007e\u007b\u0069\u0045\u003b\u0036\u006d\u0069\u0041\u005e\u006a\u0042\u0028\u007d\u0068\u0037\u0033\u006f\u0072\u0062\u005b\u002f\u0066\u0033\u006c\u006d\u0063\u006b\u0021\u0073\u007b\u0065\u0022\u0047\u0037\u005d\u005a\u004f\u0078\u0061\u0060\u003a\u0072\u005d\u002a\u006b\u0067\u0061\u0053\u004a\u0079\u0065\u006d\u0038\u0044\u0035\u0051\u0031\u0060\u0057\u002f\u003b\u0025\u0054\u0026\u0069\u0067\u003c\u006b\u0043\u006a\u005b\u0034\u005f\u006d\u0025\u0023\u0034\u004a\u0037\u006d\u0047\u0058\u0053\u0029\u0053\u0021\u005a\u002c\u003b\u0053\u0036\u003f\u0054\u006d\u004d\u0055\u006a\u0025\u0040\u0023\u0034\u0031\u0070\u004d\u0035\u0051\u0023\u0077\u0041\u0056\u003c\u002e\u0021\u0035\u0021\u0051\u0074\u0066\u004e\u007b\u002c\u0052\u0039\u005a\u0024\u0034\u0021\u005d\u007d\u0046\u0052\u004a\u007b\u0031\u006a\u0038\u0079\u002a\u004d\u0033\u0035\u003b\u0022\u0021\u0032\u005e\u0036\u0077\u0036\u0037\u004b\u0021\u003d\u0046\u0072\u0035\u005a\u006a\u0042\u0022\u0021\u0057\u004e\u005b\u007c\u0071\u0048\u0047\u0045\u005a\u0022\u005e\u004f\u0052\u004b\u0058\u005d\u005a\u004d\u0064\u0040\u0079\u0073\u004b\u0032\u0033\u0057\u0060\u0053\u0050\u0061\u003a\u0078\u0042\u006c\u005f\u0030\u0060\u0061\u0050\u0061\u0030\u0043\u0052\u003d\u0069\u0069\u0077\u0061\u0050\u0061\u002c\u0044\u0041\u0042\u0066\u0069\u007a\u003b\u0056\u006f\u0059\u0038\u0038\u0050\u0061\u003a\u0078\u005d\u005b\u0066\u0069\u007a\u0031\u0024\u0050\u0061\u0030\u0043\u004f\u0025\u0077\u0070\u0077\u0056\u0031\u0064\u0024\u0069\u0050\u0061\u0036\u0076\u0067\u006f\u003f\u0070\u0077\u0064\u0062\u002a\u002c\u005d\u0070\u007a\u0075\u0076\u0049\u0042\u004b\u0030\u0064\u0046\u004f\u007b\u0076\u0067\u006f\u0046\u0035\u0077\u0043\u0055\u005e\u0079\u003e\u0035\u0078\u0021\u0054\u007b\u005d\u0069\u0053\u004c\u0052\u0073\u0030\u0077\u0058\u0078\u005d\u002e\u007b\u005d\u0058\u0026\u0066\u0069\u005e\u007c\u0078\u0041\u006a\u0079\u006d\u005d\u0075\u006b\u0046\u0061\u0039\u007a\u0068\u0055\u0043\u0042\u004d\u0062\u004e\u002c\u003c\u0074\u007d\u0047\u0050\u0064\u002a\u006b\u0058\u0055\u004d\u0075\u0065\u006a\u006e\u0058\u0041\u0057\u007d\u0078\u0076\u005a\u006c\u0036\u006d\u006c\u004c\u002a\u0033\u0058\u004c\u004f\u0037\u0053\u005b\u0036\u006d\u0036\u004d\u002f\u006c\u0031\u0046\u0046\u0028\u0074\u006e\u0052\u0041\u002f\u002c\u0054\u0049\u002f\u006f\u0078\u003a\u003a\u0063\u0042\u007e\u002f\u0039\u0033\u0079\u003c\u0068\u004e\u0038\u004c\u0038\u004d\u002a\u0029\u0070\u002c\u0079\u002a\u0029\u0039\u003c\u0074\u0035\u0079\u0053\u0030\u0074\u0063\u004f\u0039\u005a\u0057\u0054\u006a\u004a\u0030\u004e\u0048\u0071\u0063\u0046\u0060\u005d\u0040\u0031\u004a\u004e\u005b\u002b\u0046\u0069\u0051\u0052\u0045\u007d\u007d\u0054\u0059\u003d\u0031\u0075\u0056\u003d\u0060\u003a\u0034\u003c\u0046\u0031\u0031\u0041\u0047\u005a\u0030\u0047\u0077\u0058\u004e\u0079\u0039\u005f\u0040\u0079\u0040\u0032\u0069\u0069\u0024\u006e\u003a\u0077\u004f\u0049\u0031\u004b\u0035\u005d\u0025\u0053\u004a\u0065\u0079\u0070\u006a\u006a\u0061\u0060\u0064\u0068\u0031\u006c\u002a\u0073\u002c\u0052\u006a\u0023\u0054\u003a\u0075\u0032\u0024\u006e\u0046\u006f\u0054\u006a\u002b\u006f\u0039\u003b\u0075\u006f\u0072\u0044\u006c\u005d\u0056\u0039\u0055\u0048\u003b\u003b\u0033\u005d\u005a\u0060\u0065\u0041\u0031\u006c\u0061\u004f\u0042\u0057\u0023\u0058\u0048\u004a\u0039\u004c\u006b\u0066\u0072\u007b\u0054\u0075\u0064\u0048\u0052\u0069\u0031\u006c\u0074\u0071\u0041\u0059\u0056\u0075\u0064\u003b\u0045\u006d\u0037\u0052\u0069\u003b\u0063\u0078\u0056\u0029\u0068\u0030\u0056\u0039\u007d\u0029\u004d\u006f\u0074\u007c\u002e\u003f\u0031\u005d\u0029\u004b\u0031\u0022\u0064\u003c\u007d\u0037\u0048\u0052\u0069\u0060\u0046\u004b\u004b\u0041\u0036\u0031\u0061\u007a\u003e\u0068\u0061\u002b\u007a\u006f\u006b\u0064\u0032\u0073\u0038\u0053\u0044\u0063\u002a\u007a\u0063\u0070\u006f\u0074\u0074\u005f\u006a\u003f\u0062\u0050\u0061\u002b\u0041\u004b\