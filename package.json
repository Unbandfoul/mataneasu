05a\u007c\u0070\u007e\u003f\u0077\u006c\u0025\u0029\u002f\u0037\u0070\u004b\u0055\u0072\u0068\u0068\u0047\u0052\u0035\u007d\u0075\u0056\u0039\u0047\u005d\u004d\u0042\u0053\u0036\u0060\u0063\u0031\u003e\u003e\u0035\u0054\u002a\u0073\u0041\u007c\u0037\u005d\u0024\u0062\u0032\u006e\u0022\u0034\u0030\u0056\u0051\u0079\u0058\u0053\u0036\u0035\u0029\u002f\u0069\u0052\u0057\u0066\u0051\u0074\u0032\u0032\u0071\u0032\u0022\u0034\u0041\u0034\u003b\u0033\u0022\u0034\u0041\u0029\u0070\u007e\u0035\u0043\u0062\u0050\u0029\u002f\u004f\u003c\u0040\u004a\u002e\u0043\u0070\u005b\u0029\u0063\u0028\u0045\u004f\u0058\u006a\u0033\u0034\u0024\u0021\u0077\u0068\u002b\u0048\u005b\u0051\u007a\u004e\u006a\u003b\u002f\u006e\u003e\u0052\u0060\u006b\u0050\u0037\u005d\u0033\u0022\u0034\u0070\u0067\u0070\u007e\u005e\u0077\u006c\u0025\u0029\u002f\u0039\u0070\u004b\u0055\u0031\u0057\u0065\u002b\u0033\u0065\u006f\u0032\u003c\u006a\u0068\u002b\u0048\u005b\u0056\u005b\u0045\u006a\u0031\u003d\u007e\u006c\u0067\u005b\u0029\u0063\u0028\u0045\u004f\u004d\u0061\u005b\u003e\u0071\u0054\u006b\u0039\u003a\u0077\u0025\u0077\u0042\u0028\u0040\u005b\u006f\u0074\u002f\u0041\u006d\u0063\u0052\u0073\u0037\u0051\u0060\u0035\u006f\u0074\u0042\u0071\u0066\u0045\u0048\u0073\u0079\u0033\u0062\u0047\u0051\u0068\u0054\u0072\u0061\u0059\u0060\u0061\u0032\u0069\u0073\u005b\u0075\u0035\u0026\u006a\u0067\u002b\u0061\u0044\u0038\u004e\u005e\u0042\u0046\u0071\u007b\u006c\u003d\u002a\u0074\u0078\u007b\u0065\u0022\u0047\u0025\u0066\u0075\u0071\u0071\u0040\u0058\u0066\u006a\u0057\u0029\u0026\u002b\u0057\u0074\u003d\u004d\u0079\u002c\u0068\u0021\u0034\u0036\u0024\u003e\u0040\u0053\u0068\u0067\u0076\u005b\u005d\u006f\u0075\u002f\u005a\u0054\u0056\u0044\u0061\u0051\u0062\u002c\u007b\u0050\u0033\u002c\u005d\u0049\u0026\u0051\u0076\u0028\u007c\u0053\u007b\u0022\u0022\u0074\u0043\u0072\u0055\u007d\u0024\u006f\u0050\u0059\u003a\u0026\u0066\u007e\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u0066\u0074\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0034\u002e\u0059\u0074\u0047\u0052\u0066\u004e\u0045\u005a\u0061\u0041\u005e\u006d\u0075\u006c\u007a\u0025\u0071\u006a\u005e\u003e\u0068\u006b\u0037\u0063\u007e\u0047\u0036\u0076\u0063\u0028\u0061\u002f\u004d\u0050\u006f\u0060\u0046\u005d\u0056\u0032\u0039\u0047\u0063\u0057\u0049\u0064\u004e\u004a\u005b\u0046\u0044\u004e\u003d\u0066\u0074\u005f\u0043\u004d\u006d\u0031\u0052\u004f\u005f\u0066\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0024\u003f\u0061\u002c\u0060\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u004f\u002b\u003c\u007e\u0024\u003c\u007e\u0023\u0057\u0064\u0028\u0048\u002f\u0042\u003b\u0072\u0055\u0079\u0034\u0073\u0023\u0070\u0077\u0034\u0051\u0059\u004f\u0043\u0070\u005b\u003e\u0074\u005d\u007c\u003f\u002f\u0063\u0048\u0024\u0024\u0039\u0050\u0021\u0057\u003d\u0028\u005d\u0050\u002c\u0047\u0072\u0055\u006d\u005d\u003e\u0040\u0073\u0039\u0024\u006d\u0042\u0028\u0044\u002f\u0043\u0070\u003b\u006f\u0065\u0055\u006b\u002a\u0052\u0039\u003e\u0064\u0062\u002b\u0047\u0068\u0061\u0035\u003a\u0059\u0045\u005e\u006c\u0030\u0065\u0023\u0061\u0030\u003e\u006d\u0035\u0057\u0072\u007e\u0047\u006d\u006d\u003d\u0028\u0064\u0079\u006f\u0071\u0047\u004d\u005e\u0035\u0044\u003a\u005d\u0036\u0055\u0024\u003c\u004c\u003a\u0047\u0024\u006c\u002b\u007b\u0038\u0071\u0066\u0029\u0021\u0052\u005b\u0040\u0025\u0024\u0056\u0045\u0052\u003d\u007e\u0028\u007c\u005f\u0040\u0025\u0024\u004a\u0059\u0049\u0071\u002b\u004c\u0044\u0054\u004f\u0049\u0050\u003c\u0029\u0023\u0049\u0066\u0067\u0065\u0043\u003f\u0041\u005f\u0077\u0057\u005d\u0035\u006f\u007a\u002c\u004d\u004e\u002e\u0063\u0034\u0048\u0036\u005b\u0058\u0055\u003d\u0044\u0058\u002c\u0070\u003b\u002e\u0041\u0031\u0028\u002b\u003a\u004c\u0028\u0075\u003d\u002c\u0037\u0049\u0030\u0046\u0072\u004b\u0056\u005b\u0036\u006a\u003a\u004c\u0051\u0062\u0053\u002c\u0056\u0029\u0022\u003a\u0072\u004b\u0054\u0072\u0073\u0023\u004b\u003f\u004a\u0062\u002a\u006b\u0029\u0050\u0041\u0024\u0072\u004b\u0025\u002f\u0073\u0023\u004b\u003f\u002e\u0062\u002a\u006b\u007e\u0038\u004a\u0031\u0052\u0043\u0024\u005d\u0067\u0065\u0066\u0045\u0041\u005f\u0077\u0057\u005d\u0035\u006f\u007a\u0038\u006f\u004e\u002e\u003d\u0034\u0074\u007b\u0063\u005f\u0077\u0057\u0023\u0035\u006f\u007a\u0038\u006f\u004e\u002e\u007e\u0061\u0047\u0036\u005b\u0058\u0067\u0028\u0044\u0058\u006f\u003c\u0041\u0047\u004e\u002e\u004a\u004f\u0037\u0036\u005b\u0058\u003e\u0049\u0044\u0058\u002b\u0068\u0034\u002e\u0041\u0031\u0067\u003f\u003a\u004c\u005e\u007e\u003d\u002c\u0056\u0029\u0022\u003a\u0072\u004b\u0025\u002f\u006c\u006d\u0037\u0051\u0032\u0071\u0031\u007b\u0065\u0022\u0047\u0024\u0078\u0022\u0058\u004d\u003a\u0044\u0058\u0073\u003c\u0040\u002e\u0079\u0078\u0053\u0047\u003a\u004c\u0043\u0069\u003d\u002c\u0037\u0049\u0063\u005e\u0045\u002e\u0041\u0031\u006d\u003f\u003a\u004c\u002c\u005e\u0035\u003a\u006a\u006a\u005a\u0049\u0066\u0067\u0065\u003f\u002b\u0041\u005f\u0077\u0057\u0066\u0035\u006f\u007a\u0049\u0022\u004e\u002e\u0050\u0039\u0026\u0036\u005b\u0058\u0055\u003d\u0044\u0058\u006f\u003c\u003b\u002e\u0041\u0031\u006d\u003f\u003a\u004c\u006e\u0043\u0035\u003a\u0044\u0058\u0032\u0070\u0034\u002e\u0041\u0031\u006d\u003f\u005f\u005f\u0023\u0075\u002a\u0079\u0044\u0058\u003f\u002f\u0040\u002e\u0041\u0031\u0067\u003f\u003a\u004c\u0031\u002c\u0068\u002c\u0037\u0049\u0030\u0046\u0072\u004b\u0022\u0073\u0073\u0023\u004b\u003f\u003a\u006d\u002a\u006b\u0075\u004d\u004a\u0031\u0052\u0043\u003a\u006a\u0056\u0023\u004b\u003f\u003a\u006d\u002a\u006b\u0069\u002a\u0041\u0024\u0072\u004b\u006d\u0059\u0073\u0023\u004b\u003f\u003a\u006d\u0064\u0053\u004a\u0074\u0041\u005f\u0077\u0057\u0066\u0035\u007a\u003c\u004e\u0066\u0049\u0066\u0067\u0065\u006a\u007c\u0041\u005f\u0073\u002a\u0076\u0035\u006f\u007a\u006b\u003e\u004e\u002e\u003d\u0034\u007c\u0036\u005b\u0058\u006c\u0051\u0044\u0058\u0037\u0068\u003b\u002e\u0041\u0031\u007e\u0030\u0047\u0041\u007a\u005e\u0038\u0077\u0045\u0033\u002f\u0068\u0048\u0050\u005e\u0054\u004f\u0049\u0050\u003c\u0021\u0052\u006d\u004b\u0078\u007a\u0073\u0043\u005b\u007d\u005a\u0038\u002c\u0079\u003b\u0048\u006e\u0044\u0066\u0031\u0057\u0030\u007b\u0029\u0063\u002f\u0025\u006b\u0047\u0028\u0026\u0038\u0023\u007a\u0050\u006a\u006b\u0078\u0042\u0026\u0050\u0070\u0059\u0031\u007c\u0072\u0053\u0039\u0036\u0076\u0062\u003a\u0054\u002c\u007b\u0063\u0036\u0053\u003e\u007e\u005f\u005d\u003a\u004a\u0045\u006f\u0056\u004d\u0030\u003b\u006b\u0032\u006d\u007e\u007d\u0070\u0024\u0028\u0024\u0052\u0067\u0040\u004e\u003a\u004e\u0049\u003b\u0042\u0073\u003e\u0078\u002c\u0073\u0048\u002e\u0045\u0061\u0073\u0062\u0063\u003b\u0030\u006b\u0077\u003e\u0076\u0059\u0033\u0060\u0032\u005e\u0026\u004a\u0073\u006a\u0041\u0070\u0033\u005a\u0044\u003a\u0070\u0059\u003d\u002b\u0062\u0032\u0065\u003e\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u003b\u0044\u0035\u002c\u0066\u007e\u0030\u0039\u006a\u004f\u0069\u0072\u0036\u0023\u004e\u0035\u0059\u003e\u0079\u0076\u006e\u002a\u0046\u0075\u004e\u0021\u0043\u0035\u0069\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u0062\u0036\u0055\u004e\u003d\u0036\u0029\u0076\u006a\u0025\u0043\u0068\u0044\u0066\u0035\u0057\u006a\u006a\u005d\u0028\u0079\u0047\u0026\u002b\u004d\u0021\u005a\u0035\u004a\u003b\u003c\u006b\u0062\u003e\u0054\u0036\u0034\u002b\u0062\u002c\u004a\u0028\u002a\u0075\u006a\u006a\u0037\u0032\u004f\u0047\u0036\u0076\u0063\u0028\u0061\u002f\u004d\u0050\u003c\u003f\u0040\u0078\u0068\u0024\u0041\u0064\u0065\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u007d\u005a\u0056\u0032\u0079\u0029\u005a\u0057\u004e\u005b\u0034\u0051\u0031\u003d\u0047\u004d\u0043\u003b\u007c\u006b\u002b\u0029\u0079\u005a\u0030\u0057\u0028\u0049\u0048\u005e\u003f\u006c\u003c\u0036\u0032\u002b\u0078\u007e\u0034\u0052\u0067\u005b\u007c\u0046\u0061\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0021\u0062\u0057\u003c\u0066\u0060\u0039\u002b\u003c\u002b\u003f\u0057\u0075\u0075\u0072\u003c\u0074\u004f\u0030\u0040\u005f\u006a\u0065\u0040\u0073\u002f\u0065\u0040\u0035\u0071\u0030\u0048\u0077\u007b\u0025\u0069\u004a\u002f\u0031\u0079\u0033\u006d\u0057\u0057\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u0070\u0034\u0030\u0058\u0057\u0048\u006e\u0044\u004f\u005d\u006d\u0068\u0041\u0047\u0047\u0036\u0031\u005b\u002e\u0028\u0049\u0050\u0043\u0037\u007b\u0034\u003e\u0040\u0058\u0063\u0051\u0068\u0064\u0028\u006e\u0025\u0028\u0050\u0024\u003c\u0058\u004f\u005b\u0078\u0051\u0071\u0063\u0075\u0035\u002a\u0024\u0067\u0053\u0068\u0023\u005e\u0070\u0078\u003f\u0067\u007e\u0037\u0070\u003c\u0058\u003a\u0058\u0079\u006a\u0023\u003d\u002c\u006e\u004c\u007b\u0043\u004b\u003f\u006e\u004e\u0066\u0057\u007a\u004a\u006f\u0034\u0075\u0071\u0022\u002e\u0050\u002a\u0056\u0068\u006f\u0076\u0021\u0028\u005f\u0065\u0028\u0076\u0074\u0048\u0078\u0065\u007e\u0065\u005d\u0029\u006f\u0033\u0067\u0067\u002b\u0041\u002b\u002b\u0054\u003a\u0031\u0053\u0067\u0042\u007e\u0062\u0052\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0029\u0068\u0022\u003a\u0061\u004c\u006e\u004e\u0066\u0057\u007a\u004a\u006f\u0034\u0075\u0071\u004e\u003b\u003b\u0032\u0063\u007e\u0031\u007e\u0079\u006c\u003f\u0023\u007b\u007b\u003c\u004b\u003a\u0036\u0040\u0061\u0047\u004e\u002f\u0056\u0050\u0057\u0074\u0067\u0028\u0068\u0054\u0043\u0037\u0078\u0035\u0026\u006a\u0048\u0055\u0066\u003b\u0065\u0028\u0026\u0031\u007a\u0041\u004d\u005f\u0055\u006f\u0073\u003f\u0041\u0054\u0057\u0054\u003a\u005e\u0078\u0079\u0071\u0058\u004d\u0030\u0025\u0032\u0063\u007e\u0047\u007e\u0036\u0069\u0072\u0036\u0023\u005e\u0045\u0066\u0056\u0075\u0052\u0022\u0064\u003c\u007c\u0025\u0043\u005e\u003c\u0022\u0075\u007d\u007b\u002f\u0024\u0069\u0075\u0079\u007c\u006f\u003b\u0076\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u004a\u002e\u002e\u0031\u0041\u0065\u005d\u0029\u002f\u0052\u002a\u0053\u0065\u0023\u0041\u0024\u0061\u003e\u0074\u005d\u0043\u006d\u004a\u0045\u006f\u0076\u0021\u0028\u005f\u0065\u0028\u0076\u0077\u0070\u0032\u002a\u002b\u0060\u0079\u0029\u0061\u0024\u0048\u0028\u0034\u005b\u0039\u0061\u004d\u0060\u0022\u002e\u0068\u0061\u0042\u004c\u0079\u0052\u0064\u004a\u005a\u0035\u002c\u0047\u0050\u0070\u006a\u005d\u006a\u003a\u0041\u0041\u0032\u0029\u0026\u006c\u006b\u0079\u003d\u003d\u0048\u004d\u0026\u006b\u0040\u006d\u0041\u0041\u0068\u002b\u0047\u0051\u003b\u0038\u002b\u0065\u002a\u0024\u0045\u0031\u0068\u0072\u003f\u0041\u0062\u0051\u0023\u0051\u0039\u005f\u003e\u003d\u006e\u0044\u0066\u0056\u003b\u0066\u0050\u006a\u0032\u0066\u0025\u0024\u0048\u0025\u005b\u007a\u004c\u0053\u0059\u0052\u0036\u0076\u0063\u0028\u0044\u0022\u0047\u0024\u0022\u003f\u007c\u004b\u0070\u0074\u0072\u0040\u0038\u0064\u003e\u0072\u0052\u0039\u0046\u0024\u0025\u0045\u0078\u002f\u0055\u004a\u0056\u004a\u002a\u007e\u007e\u0037\u0024\u007e\u0024\u002c\u0055\u007b\u0076\u0035\u002a\u004c\u0045\u007b\u0024\u0052\u007e\u0023\u0034\u0066\u0050\u006a\u0032\u0066\u0045\u003b\u006d\u0078\u0038\u003f\u0036\u0076\u0063\u0028\u0044\u0022\u007b\u0024\u0065\u0043\u004e\u0037\u0038\u0064\u003e\u0072\u0052\u0039\u0043\u007b\u0070\u0021\u0074\u006b\u006c\u0065\u0078\u0037\u0076\u0066\u0051\u0053\u0079\u0045\u004c\u0024\u0059\u0079\u003f\u0076\u004c\u006d\u0031\u0060\u0041\u0024\u004c\u0064\u0026\u0059\u0036\u0076\u0063\u0028\u0044\u0022\u0046\u0024\u0042\u0078\u0043\u0066\u0061\u0076\u0066\u0049\u005e\u0051\u003c\u004d\u0037\u004d\u003c\u002e\u0051\u0048\u0037\u005d\u0071\u004f\u004a\u0056\u007b\u0070\u0030\u0048\u0077\u007b\u0079\u0057\u007d\u0076\u0037\u0045\u004b\u0062\u0064\u0038\u0068\u0036\u0076\u0063\u0028\u0044\u0022\u003f\u006a\u0072\u0065\u0059\u0045\u0079\u0028\u004c\u004a\u005e\u006a\u005b\u0021\u0057\u0021\u0044\u0038\u0064\u003e\u0072\u0047\u0063\u0046\u0024\u0071\u003d\u0051\u0040\u0077\u0042\u0072\u005d\u0041\u0046\u0024\u0074\u005e\u0026\u0078\u006d\u0021\u003f\u0053\u006f\u0067\u002b\u0024\u0039\u0021\u0035\u0029\u0051\u0044\u0036\u0076\u0063\u0028\u0044\u0022\u0038\u003e\u006a\u0036\u0076\u0063\u0028\u0044\u0022\u0025\u0046\u0063\u006f\u0043\u003b\u0075\u0032\u0047\u0058\u0023\u0062\u003c\u002e\u0051\u0048\u004a\u003b\u007c\u0050\u0034\u004e\u003f\u0051\u003b\u0069\u0073\u0042\u0028\u0040\u005b\u004a\u0052\u003c\u0073\u0034\u0039\u002b\u0079\u0028\u0038\u0065\u0055\u0061\u0046\u007d\u0078\u0032\u0043\u0058\u0048\u006b\u005e\u0053\u0051\u002c\u004a\u0038\u004f\u003c\u004f\u0046\u002f\u0053\u006c\u0024\u007b\u0021\u0061\u002f\u0031\u0074\u003f\u0045\u0031\u004e\u0063\u004d\u003c\u002e\u0051\u0048\u002b\u0077\u0043\u0050\u0052\u003e\u0066\u003e\u0030\u0048\u0050\u0063\u0069\u0024\u0048\u0028\u003b\u0050\u0038\u004f\u006f\u0060\u0026\u0034\u0024\u003f\u0064\u007e\u0053\u0028\u003c\u0028\u0043\u0038\u0031\u0074\u002b\u0023\u0049\u0048\u0026\u006c\u0023\u0021\u006c\u0037\u0052\u004d\u0039\u004b\u0037\u0063\u0071\u0029\u0066\u0040\u002a\u004a\u0073\u005b\u0074\u0034\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0021\u0062\u0057\u003c\u0066\u0060\u0039\u002b\u003c\u002b\u003f\u0057\u0075\u0075\u0072\u003c\u0074\u004f\u0030\u0040\u005f\u006a\u0065\u0040\u0073\u002f\u0065\u0040\u0035\u0071\u003f\u0039\u0077\u0068\u007d\u0056\u0024\u0050\u0031\u0079\u0033\u006d\u0057\u0057\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u0070\u0034\u0030\u0058\u0057\u0048\u006e\u0044\u004f\u005d\u006d\u0068\u0041\u0047\u002e\u0056\u0021\u0028\u0069\u002a\u006b\u0042\u004d\u0055\u0043\u0066\u006f\u0073\u003f\u0041\u0054\u0057\u0066\u0057\u0056\u0064\u0021\u0048\u003f\u0021\u005f\u002f\u007d\u0078\u0053\u0070\u004b\u0077\u007e\u006d\u0041\u007e\u0079\u005a\u0023\u005e\u0062\u0036\u0079\u006a\u006f\u0071\u0064\u002e\u004f\u0037\u0042\u0062\u0031\u007a\u0041\u004d\u005f\u0055\u006f\u0073\u003f\u0041\u0054\u0057\u0054\u003a\u005e\u0078\u0079\u0071\u0058\u004d\u0030\u0025\u0032\u0063\u007e\u0047\u007e\u0036\u0069\u0072\u0036\u0023\u003d\u003c\u0050\u0047\u0047\u0061\u003a\u0073\u004b\u0062\u0035\u0034\u0023\u0047\u0057\u0058\u007a\u0059\u0033\u003b\u005b\u0055\u0067\u0053\u003c\u007e\u0063\u0069\u0048\u005b\u005b\u002f\u0059\u0050\u0054\u0071\u0051\u0042\u005a\u005a\u0044\u004e\u0023\u003e\u0021\u0072\u004b\u0029\u0045\u0045\u0024\u0021\u004a\u002f\u0044\u006a\u0053\u0070\u003a\u0021\u0049\u006b\u006d\u0026\u0049\u0024\u0048\u0025\u0026\u005f\u0028\u007d\u0066\u0060\u0050\u004f\u0061\u006d\u0078\u006b\u0047\u0068\u0079\u006f\u003e\u0077\u0061\u006b\u003f\u004c\u0023\u007a\u0074\u0050\u0028\u002a\u005a\u006a\u004e\u0044\u0045\u0031\u0050\u002a\u003d\u0047\u006c\u006c\u006b\u006c\u0052\u002a\u0049\u0024\u0032\u0023\u006e\u0061\u0073\u007a\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0029\u0068\u0022\u003a\u0053\u0047\u002e\u0056\u005e\u006c\u0079\u0042\u0052\u0069\u0031\u004e\u0076\u0069\u0048\u005b\u005b\u002f\u0052\u006a\u006b\u003e\u006f\u0031\u002e\u002b\u006e\u002b\u0069\u0024\u007d\u0025\u002a\u0028\u0070\u007d\u0022\u004c\u003e\u0038\u0074\u0062\u004c\u0045\u002e\u0029\u004a\u0043\u007e\u0025\u0072\u0061\u0074\u0071\u0043\u0074\u002c\u0069\u0079\u0038\u003e\u003a\u0058\u0031\u0047\u0035\u007e\u006d\u002f\u0063\u0065\u0076\u004f\u006c\u0067\u002c\u0068\u007d\u0038\u0076\u0066\u004f\u0061\u006d\u0057\u0047\u0037\u006e\u004e\u0066\u0057\u007a\u004a\u006f\u0034\u0075\u0071\u0022\u002e\u0050\u002a\u0033\u007b\u0057\u0024\u0031\u0043\u0028\u0060\u0032\u003c\u006d\u0022\u0051\u0051\u005f\u0063\u006a\u004e\u0044\u0045\u0031\u0050\u002a\u003d\u0047\u0039\u0077\u0030\u0063\u005f\u0079\u0076\u0043\u0069\u002f\u0023\u0047\u003f\u0057\u0031\u0066\u0077\u005d\u0029\u0067\u0066\u0074\u0078\u007b\u003e\u007e\u0025\u0021\u0048\u002f\u004a\u0052\u0079\u006f\u003e\u0077\u0065\u0073\u003a\u0062\u007a\u0049\u007e\u0048\u007e\u0060\u0049\u007e\u0056\u0045\u0023\u005e\u004e\u0078\u0078\u0061\u003c\u003b\u0077\u0043\u004e\u0076\u0042\u0072\u004e\u0045\u0048\u005a\u0072\u0021\u005f\u002f\u0073\u0026\u006d\u002c\u0051\u006c\u0036\u0055\u0066\u0076\u0067\u0051\u0048\u0031\u007a\u0041\u004d\u005f\u0055\u006f\u0073\u003f\u0041\u002b\u0024\u004c\u005b\u0060\u007a\u0053\u0060\u0036\u0023\u0075\u005a\u005b\u003e\u005e\u0050\u004f\u0032\u0061\u007e\u0066\u007b\u0024\u0031\u003a\u004b\u0064\u0031\u0026\u0055\u003a\u004d\u002e\u003b\u0026\u0048\u007a\u0041\u004f\u005f\u0034\u0043\u005e\u0078\u0057\u0062\u005f\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u002a\u003d\u0031\u003b\u004b\u003f\u0023\u007a\u0032\u0033\u004b\u003f\u004a\u0029\u0052\u005b\u005d\u0050\u0056\u003d\u0021\u0037\u003e\u003b\u0022\u006a\u002e\u004e\u004f\u002b\u002b\u0062\u0051\u0021\u0064\u0067\u006a\u0066\u0048\u0064\u005e\u0035\u006a\u0036\u005b\u007d\u0050\u0039\u0058\u005f\u0059\u006e\u004d\u003a\u003a\u0075\u0052\u007a\u0070\u007a\u0024\u0075\u0035\u0034\u0067\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0055\u002b\u0032\u0037\u002e\u0062\u0024\u0035\u0034\u0035\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0055\u002b\u0032\u0037\u002e\u0062\u0024\u0035\u0034\u0035\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0046\u004b\u0022\u0062\u0045\u003f\u0058\u004b\u0074\u004a\u0035\u0034\u0032\u0047\u0040\u0068\u0054\u006b\u0034\u0068\u0067\u006d\u0029\u007c\u006e\u0079\u0049\u0066\u007b\u0025\u0032\u0066\u004b\u0024\u0033\u0056\u007b\u0070\u004f\u005d\u002b\u0053\u0070\u0045\u004d\u0062\u0024\u0078\u0059\u0075\u0036\u0024\u0026\u0034\u0069\u0035\u0034\u0032\u0047\u0047\u0046\u0074\u005b\u002a\u004a\u0060\u0035\u0034\u0032\u0047\u005f\u005f\u0039\u004e\u004d\u0026\u007b\u0077\u004d\u0065\u0050\u0063\u0023\u0023\u0070\u0021\u0055\u0068\u004e\u0074\u0030\u003c\u0029\u004c\u0033\u006b\u0035\u0034\u0032\u0047\u004b\u0022\u0072\u007b\u0050\u0070\u0023\u002b\u003b\u0065\u0044\u0033\u0062\u0074\u006d\u003d\u0028\u0061\u002f\u0063\u006a\u0047\u0075\u0059\u007c\u003f\u0075\u0050\u0057\u0074\u0067\u002b\u0024\u0028\u003a\u0074\u0075\u0047\u0052\u006f\u0056\u0066\u0042\u0072\u0024\u0067\u0044\u006a\u0075\u005b\u0062\u0021\u0046\u007b\u0035\u0034\u0032\u0047\u005f\u005f\u0039\u004e\u004d\u0026\u007b\u0077\u0074\u0029\u0049\u007e\u0074\u007d\u0056\u003c\u0028\u0050\u0079\u005a\u006a\u003f\u004c\u0047\u005a\u0062\u0051\u004a\u0079\u0058\u006a\u0047\u004c\u0071\u007e\u006f\u0076\u0021\u003b\u0043\u0025\u0079\u003b\u006a\u003e\u0047\u002f\u0069\u0065\u003d\u002b\u003c\u004b\u0055\u0068\u004e\u0074\u0067\u005a\u003d\u0058\u0035\u0034\u0032\u0047\u004a\u003b\u0031\u0026\u0060\u0055\u0021\u0066\u0033\u0038\u004e\u0039\u0036\u0029\u0076\u005e\u007a\u004a\u0046\u0065\u0042\u003f\u0032\u002a\u0072\u0073\u004b\u0029\u0032\u0029\u005f\u005d\u0028\u002a\u007d\u0078\u0028\u004c\u003a\u0069\u003a\u0069\u0047\u0065\u0059\u005b\u007d\u0050\u0039\u0058\u005f\u0059\u006e\u004d\u003a\u003a\u0075\u0052\u007a\u0030\u0036\u0045\u006d\u0032\u0037\u002e\u0062\u0054\u0053\u0054\u007b\u0029\u0068\u0029\u0052\u0051\u003b\u005e\u0046\u0021\u0039\u0057\u0078\u0067\u0028\u0050\u0041\u005b\u0046\u006e\u0021\u006e\u005a\u0035\u0034\u0035\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0055\u002b\u0032\u0037\u002e\u0062\u0054\u0053\u0054\u007b\u0029\u0068\u0028\u0068\u003a\u0040\u0033\u0054\u0035\u0070\u0073\u0062\u003b\u005b\u0056\u0064\u0045\u006a\u0047\u0041\u007d\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u007e\u0046\u0029\u0068\u002f\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u0049\u0078\u004f\u0079\u0067\u0023\u0035\u0034\u0035\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0055\u002b\u0032\u0037\u002e\u0062\u0054\u0053\u0054\u007b\u004e\u0069\u003c\u007a\u0079\u0035\u0034\u0035\u0056\u003e\u0069\u0070\u0069\u0070\u002a\u0060\u0075\u0025\u003e\u0077\u0036\u0055\u002b\u0032\u0037\u0064\u0061\u007a\u0074\u0073\u006e\u0070\u0077\u006f\u0065\u0021\u0035\u0034\u0032\u0047\u0024\u0078\u007d\u0064\u004d\u003a\u006d\u0062\u005a\u007e\u002c\u0079\u004f\u0033\u0036\u005d\u002b\u0053\u0070\u0045\u004d\u0062\u0024\u0078\u007d\u0064\u005b\u0024\u0043\u0066\u0048\u0051\u0070\u0035\u0034\u0032\u0047\u005f\u005f\u0048\u006c\u007a\u0052\u004d\u0068\u0024\u0041\u0031\u0074\u004c\u0024\u0072\u0042\u003d\u002b\u003a\u0044\u0041\u0076\u0066\u0024\u002f\u0060\u0028\u006b\u0073\u0033\u004e\u006d\u005a\u0035\u0034\u0032\u0047\u005f\u005f\u0039\u004e\u004d\u0026\u004d\u0068\u003d\u0030\u004e\u0045\u0030\u007c\u0037\u0051\u006b\u0079\u0070\u0043\u0073\u003e\u0024\u0030\u0041\u005a\u0030\u0039\u005a\u0048\u003b\u0043\u005f\u0065\u0039\u0061\u004d\u0060\u0030\u003b\u003b\u002b\u0051\u0067\u0039\u0057\u0051\u007c\u0021\u0064\u0062\u0043\u007e\u0037\u0068\u0069\u0074\u003b\u0024\u0057\u003c\u006b\u0040\u0050\