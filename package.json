044\u0059\u0069\u004d\u0060\u002f\u0060\u004f\u006f\u006d\u005e\u004d\u0040\u0048\u0056\u003a\u0056\u007b\u0034\u004e\u002b\u0049\u005a\u0044\u0062\u002e\u002c\u0061\u0028\u0023\u004c\u0052\u0063\u0078\u0037\u004d\u0040\u0048\u0021\u0042\u0037\u0067\u0060\u0077\u0068\u0023\u006f\u006b\u006c\u0050\u0050\u0047\u0067\u0036\u0033\u004d\u0030\u0040\u003b\u0047\u004a\u005e\u002a\u0076\u0034\u0044\u0075\u0034\u0046\u0041\u003f\u0044\u0040\u0041\u0075\u0077\u0063\u0039\u007b\u002e\u0070\u0076\u002a\u0037\u0025\u0045\u0060\u005f\u0079\u005a\u0066\u0072\u0033\u004d\u0030\u0040\u003b\u0047\u004a\u005e\u002a\u0076\u006f\u0078\u0065\u0053\u0023\u0055\u0079\u004d\u0079\u0075\u0058\u0032\u004f\u0079\u003f\u0067\u0076\u004b\u002b\u0023\u0079\u007c\u003c\u0074\u0047\u005d\u002b\u0040\u003a\u005d\u0078\u0041\u004e\u005f\u004a\u006a\u0072\u0048\u006b\u003a\u0037\u0065\u0028\u007d\u0066\u0079\u0046\u007a\u0022\u005f\u0049\u0034\u003d\u0054\u0022\u0076\u0071\u004c\u004b\u0075\u004f\u003e\u0052\u0062\u0038\u007e\u007c\u0031\u006f\u0069\u0033\u0059\u007c\u002c\u0042\u0056\u0074\u0053\u0060\u0067\u0055\u007a\u0057\u003c\u005a\u0051\u005d\u006f\u0077\u002f\u0047\u006a\u0067\u0079\u006d\u0043\u0022\u005f\u0049\u0034\u007d\u0022\u003f\u0060\u0067\u0055\u007a\u0057\u003c\u005a\u0051\u005d\u006f\u0077\u002f\u0047\u006a\u0067\u0079\u006d\u0043\u0022\u005f\u0049\u0034\u003d\u0054\u0022\u0076\u0071\u004c\u004b\u0075\u004f\u003e\u0052\u0062\u0038\u007e\u007c\u0031\u006f\u0069\u0033\u0059\u007c\u002c\u0042\u0056\u0074\u0053\u0060\u0067\u0055\u007a\u0057\u003c\u005a\u0051\u005d\u006f\u0077\u002f\u0047\u006a\u0067\u0079\u006d\u0043\u0022\u005f\u0049\u0034\u007d\u003a\u0070\u0050\u0031\u0079\u0072\u0060\u0067\u0055\u007a\u0057\u003c\u005a\u0051\u005d\u006f\u0077\u002f\u005d\u002e\u0055\u0069\u0058\u0065\u007b\u002c\u004f\u003e\u0063\u007d\u0021\u005b\u0063\u002a\u003d\u004b\u0055\u0035\u004a\u0061\u002b\u0066\u0068\u002a\u0033\u0021\u0044\u0025\u0070\u0069\u0021\u007c\u0040\u002a\u0078\u003e\u0048\u0051\u002e\u007c\u007b\u005b\u0075\u0035\u0070\u0060\u004e\u0060\u0056\u002a\u004f\u0044\u0038\u0025\u0060\u007e\u0058\u0065\u0028\u007d\u0024\u0034\u004e\u0061\u0039\u0057\u005a\u0062\u004f\u0044\u0074\u0066\u0057\u003c\u006d\u0051\u005d\u006f\u0077\u002f\u0047\u006a\u0067\u0079\u006d\u0043\u0022\u005f\u0049\u0034\u003d\u0054\u0022\u0076\u0071\u004c\u004b\u0075\u004f\u003e\u0047\u007d\u0022\u0028\u002e\u0060\u0067\u0055\u007a\u0057\u003c\u005a\u0051\u005d\u006f\u0077\u002f\u0047\u006a\u0067\u0079\u006d\u0043\u0022\u005f\u0049\u0034\u003d\u0054\u0022\u0076\u0071\u004c\u004b\u0075\u004f\u003e\u0052\u0062\u0038\u007e\u007c\u0031\u005a\u0074\u004b\u007d\u0072\u006b\u0028\u007d\u0024\u0034\u0058\u0065\u0044\u002b\u0072\u0042\u004e\u0025\u0058\u0063\u0069\u0038\u0076\u007a\u005d\u006e\u0075\u006d\u0034\u002a\u0073\u007a\u003b\u006e\u0053\u0056\u0046\u0038\u004a\u0078\u002b\u0060\u0022\u0071\u0021\u0063\u0062\u0044\u0073\u007a\u0067\u0052\u002a\u0060\u007a\u003b\u0031\u0064\u0036\u0051\u0034\u0072\u006f\u002b\u007a\u0054\u0031\u0021\u0063\u0062\u0044\u0073\u007a\u003b\u006e\u0063\u0069\u0036\u0032\u007b\u0065\u003f\u0069\u006e\u004b\u0043\u0052\u0046\u0063\u0057\u0035\u0069\u0024\u0058\u006b\u0043\u0033\u004d\u0075\u005e\u005a\u0032\u006f\u0033\u002f\u007b\u0038\u0062\u0065\u007e\u005d\u0021\u0063\u0039\u007b\u0061\u005a\u0043\u003a\u004a\u0077\u0079\u0079\u004f\u0046\u0048\u0064\u0070\u0026\u0057\u0063\u0054\u0051\u0063\u0066\u004f\u0055\u0036\u0035\u0052\u0056\u0069\u004d\u002b\u0023\u0071\u0031\u0053\u003b\u0042\u0066\u003d\u0049\u004c\u0073\u003c\u004d\u0036\u0024\u0046\u0038\u0021\u0029\u0077\u0035\u0043\u0053\u0024\u003a\u0050\u0074\u004a\u003b\u0047\u0050\u0070\u0022\u0062\u0063\u0068\u0021\u0047\u005b\u0024\u0021\u0063\u004c\u007b\u006f\u0065\u0047\u0025\u0059\u007b\u0041\u0070\u0050\u003f\u002e\u0022\u0028\u0026\u006f\u0053\u0048\u005f\u006e\u0067\u0079\u0029\u0045\u0036\u0048\u0023\u004e\u003c\u007d\u004e\u0038\u003d\u005e\u0041\u0079\u0073\u0076\u0030\u005e\u0037\u006c\u0056\u006e\u004c\u0051\u003d\u0023\u002b\u0041\u0042\u005e\u0070\u0074\u0058\u005a\u0052\u0031\u005e\u0048\u0079\u005d\u0060\u007c\u006e\u007d\u0034\u0032\u0063\u0039\u0029\u006a\u0041\u006e\u0045\u0067\u0051\u0044\u0037\u0063\u0032\u006e\u004c\u002b\u0064\u0053\u007b\u004f\u0021\u0068\u0052\u007b\u0038\u007d\u006a\u0053\u007d\u005a\u003f\u002c\u0078\u0076\u0053\u0051\u0053\u0023\u0025\u0068\u002b\u004f\u006c\u0067\u007a\u0074\u003c\u002e\u0051\u0048\u0024\u0078\u0022\u0058\u0031\u0060\u0043\u0072\u0024\u0049\u0067\u002f\u007c\u0035\u0037\u0059\u005a\u0067\u004a\u002c\u0028\u005f\u002c\u0036\u0072\u0064\u002a\u007c\u005a\u006b\u0024\u0051\u002b\u006e\u0039\u0045\u004b\u0077\u0062\u007d\u004e\u0055\u005b\u0048\u0022\u0028\u0030\u0069\u0060\u0062\u0042\u0063\u002e\u0047\u007a\u0023\u0025\u0028\u003a\u002a\u0038\u007b\u0036\u0040\u0068\u0048\u0047\u0051\u0077\u005b\u0052\u003b\u0057\u004e\u0034\u0026\u0032\u002e\u004d\u0037\u0051\u0059\u004f\u0036\u0024\u0066\u0064\u0022\u0043\u004e\u003d\u002b\u003b\u005b\u0052\u003f\u0038\u0064\u003c\u002e\u0051\u0048\u0024\u0078\u0022\u0058\u0031\u0060\u004a\u0073\u003d\u0030\u003b\u0045\u005f\u0079\u003b\u0043\u0067\u007a\u0048\u006a\u0021\u004e\u0035\u0025\u0032\u0063\u0067\u0047\u0024\u0051\u0077\u0051\u0069\u0065\u003d\u003c\u0073\u003e\u0026\u0034\u005b\u006d\u0021\u002a\u0077\u0058\u0075\u0075\u0035\u0022\u0039\u0065\u0022\u0046\u0053\u0041\u0075\u0041\u0048\u002f\u003f\u005d\u0077\u0064\u006a\u0029\u0023\u004c\u0062\u0070\u006b\u003f\u0060\u0049\u0060\u0037\u003d\u0051\u0030\u0072\u0047\u0052\u0044\u0041\u0023\u007e\u0021\u007b\u0076\u0025\u0079\u002f\u0047\u002a\u004b\u006b\u004a\u004f\u0031\u0040\u005d\u004b\u005d\u003c\u0048\u002f\u0031\u0025\u0051\u0038\u003e\u0023\u0024\u0026\u0037\u004d\u007d\u0031\u002a\u004a\u0075\u0075\u0035\u0022\u0039\u0065\u006d\u0023\u0059\u0044\u002a\u0069\u0065\u005f\u0049\u0078\u0033\u0043\u0058\u0062\u0070\u004b\u004d\u002f\u0062\u0034\u004c\u0054\u0060\u005f\u0060\u005a\u006b\u0074\u0074\u007a\u005a\u0033\u0065\u0062\u007d\u0028\u0023\u004f\u003c\u0078\u002a\u0025\u0037\u0078\u002a\u0049\u007e\u0029\u0032\u003c\u0043\u0066\u0022\u0061\u0039\u004f\u0041\u005a\u007d\u0053\u0032\u0053\u004a\u002a\u0039\u0034\u0022\u0025\u004a\u0031\u005b\u0046\u0047\u0029\u0024\u0071\u0023\u0076\u0025\u003e\u007d\u0072\u003a\u0065\u0077\u0046\u0050\u002a\u002b\u0032\u006a\u007c\u007a\u0024\u0073\u003a\u0059\u0075\u0075\u007e\u004f\u0063\u0029\u0067\u003c\u0038\u003d\u0045\u006d\u006f\u0038\u005e\u0059\u004f\u004c\u003a\u0068\u0078\u0061\u003a\u0052\u002b\u003a\u0067\u0073\u005f\u0053\u0031\u0043\u004b\u004d\u002f\u0047\u0074\u0038\u003e\u0023\u003c\u0054\u0024\u004b\u0062\u007a\u0079\u0043\u0067\u007e\u002e\u005f\u0060\u0028\u0073\u0035\u004f\u0041\u0042\u0064\u0035\u0062\u0071\u0030\u004e\u0039\u003e\u004f\u0078\u007b\u0030\u0035\u0050\u0026\u002a\u0060\u006f\u0025\u0024\u0051\u0038\u0037\u0032\u004d\u0028\u0028\u006c\u0040\u0075\u002a\u0049\u0021\u006b\u007c\u0034\u0043\u003d\u0049\u0057\u0052\u007d\u006c\u0056\u0023\u0056\u005a\u004d\u0062\u007a\u006b\u0049\u004d\u0063\u002f\u003f\u005d\u0077\u0064\u006a\u0029\u002b\u003a\u003d\u006e\u0034\u006f\u0072\u007e\u0038\u0037\u005b\u0077\u005e\u005b\u005f\u0074\u0038\u003e\u0062\u0073\u003f\u0051\u0063\u0024\u002a\u0069\u007d\u0025\u006f\u0038\u0063\u0060\u006a\u003a\u005a\u0039\u0058\u0066\u004d\u002b\u0032\u005d\u0062\u005d\u0041\u0046\u0058\u0026\u006a\u003e\u007a\u0066\u0068\u0062\u0071\u0030\u007a\u0047\u007c\u004f\u003b\u007b\u0044\u0065\u0040\u005a\u0065\u0063\u003e\u002f\u002c\u004d\u0050\u0049\u0064\u0060\u0077\u004e\u0049\u0035\u002c\u0071\u006f\u006c\u006a\u004c\u004c\u007e\u0038\u0037\u0075\u004d\u0025\u0050\u003b\u004d\u0042\u0038\u0067\u0039\u0032\u007e\u007c\u0058\u005d\u004c\u0077\u0068\u002c\u0037\u004e\u0029\u0040\u006a\u0051\u0039\u006f\u0060\u0064\u003f\u0021\u0021\u004e\u006c\u0044\u0057\u003e\u0035\u0068\u0071\u0049\u0021\u0060\u0062\u0075\u003f\u0058\u0030\u007b\u0052\u006f\u0038\u007c\u007e\u0028\u0024\u0064\u0033\u006e\u0032\u004b\u0050\u0043\u002a\u0060\u006d\u004f\u0070\u007e\u0022\u0047\u0077\u0031\u005b\u0034\u007e\u0029\u0024\u0064\u0033\u006e\u0032\u004b\u0050\u0043\u002a\u0060\u006d\u004f\u0070\u007e\u0022\u0047\u0077\u0031\u005b\u0034\u007e\u0029\u0024\u0064\u0033\u006e\u0032\u004b\u0050\u0056\u002b\u002b\u002a\u0044\u002a\u0076\u0043\u006d\u0066\u0063\u0029\u0052\u005a\u0066\u0054\u0077\u0029\u0031\u0021\u0057\u004a\u003f\u007d\u0035\u004b\u0064\u0050\u006a\u0077\u0066\u0054\u0034\u0037\u003f\u0062\u0049\u004d\u0032\u0038\u003b\u0061\u0055\u004b\u005e\u005e\u0074\u004f\u0024\u0068\u0053\u0026\u002b\u0073\u005b\u0075\u0035\u0067\u003d\u003c\u0046\u007e\u0070\u0042\u0075\u0040\u003b\u0043\u0065\u0065\u0032\u0059\u005d\u0071\u0038\u0056\u0024\u005e\u007d\u003e\u0063\u0021\u007b\u0076\u005e\u0068\u004b\u002a\u0039\u0051\u007c\u003d\u006d\u006f\u0036\u0076\u007c\u0021\u0072\u0035\u0060\u006a\u0073\u0025\u0033\u0031\u0077\u007a\u004d\u007a\u003b\u0060\u0034\u0070\u0024\u0026\u0023\u0042\u003c\u0028\u004d\u006f\u0055\u0025\u004a\u0025\u006f\u005d\u004a\u0056\u0034\u0034\u004e\u0079\u002f\u006d\u0034\u007e\u0055\u003b\u0031\u0064\u0076\u0047\u0031\u0066\u0061\u004d\u0044\u005b\u002e\u003a\u0069\u0068\u007a\u0078\u0033\u0034\u003e\u0044\u0023\u003f\u0070\u0076\u0042\u0021\u0068\u007e\u0047\u0065\u003d\u003c\u0062\u0043\u003d\u0025\u0025\u0031\u0068\u0025\u0028\u007e\u0039\u0076\u0034\u0044\u005b\u0050\u005b\u003b\u0037\u0044\u0060\u0021\u0057\u0066\u006b\u007d\u0065\u0068\u004f\u0067\u0065\u006a\u006b\u0045\u0034\u0041\u005b\u0077\u0079\u0045\u004a\u0039\u0047\u002b\u0035\u0061\u0043\u006b\u0076\u0054\u005e\u0073\u0030\u004f\u0036\u0073\u007a\u0067\u0071\u0065\u0023\u004e\u005b\u005b\u0068\u003d\u007c\u0024\u0072\u0066\u0044\u0045\u005b\u002e\u0046\u002c\u0052\u0026\u0030\u0051\u0057\u0056\u005a\u0055\u002b\u0050\u0046\u0060\u0068\u0042\u004f\u0068\u0033\u0062\u0033\u0072\u006b\u0047\u006c\u004f\u0026\u004c\u0076\u0072\u006f\u0075\u004a\u0033\u007a\u0058\u0044\u003a\u0069\u0058\u0025\u0057\u0044\u005a\u0021\u0076\u0062\u003a\u002f\u0021\u0043\u0035\u0060\u0063\u0051\u004b\u0031\u0025\u006b\u0030\u0053\u0067\u0048\u0038\u006c\u0063\u0055\u0055\u0075\u0026\u0068\u0023\u0022\u003d\u0041\u0034\u0046\u002c\u0035\u0059\u002f\u0067\u005e\u005a\u002b\u003f\u004e\u0071\u005d\u0057\u0037\u0060\u0037\u0038\u0037\u0063\u0075\u0039\u0062\u005f\u002b\u0066\u0047\u005a\u0022\u004a\u0040\u005e\u0057\u005b\u005a\u0049\u006a\u004e\u0052\u002f\u0055\u0062\u006c\u003d\u005d\u0043\u002c\u002c\u0069\u0055\u0076\u007d\u003b\u0048\u0063\u0077\u0055\u0060\u0067\u0057\u0026\u0047\u002c\u0052\u0034\u0070\u0039\u0034\u005a\u0052\u0049\u0062\u007b\u005d\u004a\u0049\u0078\u002c\u002c\u004f\u0026\u0044\u0048\u004a\u003b\u0072\u0063\u005a\u007b\u0068\u0029\u004f\u005d\u0033\u0071\u0076\u0022\u0048\u0023\u0077\u0062\u0061\u005e\u0067\u0075\u005d\u004a\u0038\u0026\u007a\u002e\u0049\u0053\u006c\u0076\u0079\u0074\u0063\u0042\u0061\u0067\u0050\u004b\u0053\u0075\u0035\u0051\u0038\u0026\u0052\u0074\u0028\u0045\u0029\u005e\u003b\u0076\u0055\u0024\u0030\u0026\u0056\u0025\u006a\u0025\u0063\u0035\u0030\u0045\u0044\u0032\u0048\u0059\u0051\u005e\u003e\u004a\u003c\u006e\u0059\u006b\u0077\u0051\u0021\u0074\u002a\u007d\u0063\u0053\u006d\u006f\u002a\u0029\u002b\u0066\u0077\u0034\u002f\u006b\u0034\u005d\u0033\u0031\u0064\u0047\u0077\u0051\u0021\u0074\u002a\u007d\u0044\u005b\u003a\u0074\u0062\u0023\u0045\u0044\u002e\u003e\u006c\u006c\u0077\u0040\u007c\u005e\u0044\u0068\u0031\u004d\u0028\u0039\u005b\u003a\u0053\u0032\u0067\u0067\u0064\u006a\u007a\u0062\u0039\u005b\u0037\u0044\u0070\u004f\u0067\u0072\u003e\u004d\u003a\u002a\u0050\u0050\u004d\u0067\u0034\u0074\u0025\u005e\u002f\u006f\u0060\u002b\u0067\u005d\u0074\u0043\u0024\u0061\u006a\u0032\u0041\u0033\u0050\u0067\u007b\u005a\u0040\u003c\u002c\u007b\u004d\u007b\u006a\u0062\u005d\u0025\u0051\u0038\u0031\u003f\u0068\u006e\u005b\u0067\u0074\u003d\u0044\u002a\u006b\u0042\u0033\u0036\u006f\u0061\u0063\u0051\u004b\u002b\u007e\u0061\u0069\u0039\u0049\u0055\u0021\u0037\u005b\u0055\u0054\u0033\u003f\u0048\u0023\u003e\u003d\u004c\u0040\u0071\u0028\u004b\u004b\u0029\u004f\u0026\u0040\u007b\u0058\u0067\u0072\u003e\u006c\u0075\u007a\u0024\u0079\u0054\u007e\u0064\u0073\u0035\u004b\u0065\u0028\u0078\u0038\u0032\u0062\u0067\u0031\u0070\u0044\u003d\u005f\u0037\u0056\u0045\u004b\u007d\u0024\u0046\u0074\u006e\u002f\u0044\u003d\u0072\u007e\u0067\u0068\u0035\u0036\u0030\u0024\u004b\u006d\u003a\u0023\u005f\u005d\u0028\u002a\u0071\u006a\u006c\u0076\u0026\u005e\u0035\u006c\u0026\u005a\u006c\u0022\u0051\u004b\u0064\u006f\u0074\u006e\u0046\u0065\u006d\u006d\u004c\u0044\u006b\u0079\u0058\u006a\u0060\u004f\u005e\u0059\u0023\u0032\u0051\u0056\u0064\u004e\u006a\u005a\u0022\u0076\u0067\u003c\u007e\u0065\u0051\u0059\u004f\u0075\u006a\u0048\u0066\u0079\u0051\u0023\u006f\u006c\u003a\u0074\u0050\u004f\u0050\u003b\u0049\u003e\u0033\u0024\u0077\u0054\u0058\u007b\u004c\u0057\u003d\u0075\u007d\u0043\u0055\u0043\u0052\u0077\u004f\u0050\u0077\u0043\u0029\u0030\u004a\u0077\u0044\u003e\u0075\u003f\u004c\u0040\u007e\u005e\u003e\u0032\u0079\u0071\u0077\u0077\u0025\u0057\u005a\u0072\u0026\u0072\u0058\u0069\u0063\u002f\u0026\u0077\u0058\u0079\u006f\u002c\u0037\u0054\u0057\u0064\u007d\u0065\u0060\u005a\u0030\u006d\u0044\u003b\u007a\u0047\u0074\u007e\u0067\u0050\u0021\u0059\u0069\u002f\u005b\u007b\u004d\u002e\u006d\u0062\u0065\u0052\u003d\u0072\u004c\u0031\u0046\u003b\u007a\u002c\u0077\u0047\u002a\u004d\u004f\u007b\u0026\u004f\u0070\u0048\u005b\u0060\u0036\u0045\u0035\u0025\u0023\u0074\u006a\u006f\u003b\u007a\u005d\u0064\u0056\u002e\u0040\u0077\u0064\u0057\u0035\u004b\u0067\u0065\u003c\u002e\u0073\u003a\u0034\u0075\u0045\u0045\u004a\u0030\u006d\u0059\u0041\u0032\u0073\u0045\u007d\u002c\u005a\u0042\u0054\u005f\u0045\u0030\u0031\u004d\u005d\u0038\u0040\u0067\u005d\u0062\u0052\u0023\u0047\u007a\u002e\u006d\u007d\u006b\u0030\u0068\u0075\u004a\u0035\u0040\u0043\u005d\u0038\u0062\u0075\u006c\u004e\u0078\u0024\u0037\u0065\u0055\u0033\u002f\u002c\u0057\u006f\u0058\u0075\u0046\u0071\u0065\u0059\u0045\u0073\u005b\u0051\u002a\u0039\u0037\u0057\u003e\u0033\u002f\u002c\u0057\u006f\u0058\u0054\u0061\u004f\u005b\u007d\u003c\u0034\u0038\u0079\u005b\u007a\u0058\u004e\u004d\u0078\u007a\u0026\u0042\u0061\u0056\u0056\u0032\u005e\u005d\u0035\u0057\u006a\u006d\u004b\u0047\u0026\u006c\u0028\u0050\u003b\u006a\u003c\u0063\u005d\u003b\u0045\u0071\u0053\u0077\u006c\u0026\u006c\u0069\u005f\u0029\u006a\u0044\u0056\u007b\u0049\u0064\u0038\u0032\u0063\u006a\u0071\u006c\u0024\u0037\u0074\u0064\u007b\u0052\u005b\u0048\u0022\u0048\u006a\u0066\u0049\u0032\u007b\u002b\u003a\u0044\u0068\u0060\u003c\u0059\u004f\u006d\u0057\u0023\u0047\u0051\u005d\u0035\u002e\u0026\u003c\u003f\u0073\u003d\u002b\u0035\u005b\u007e\u0025\u0046\u0024\u0037\u003d\u002b\u004c\u0044\u0038\u004d\u004b\u0067\u0023\u003d\u0028\u007c\u003f\u0040\u0046\u002f\u006b\u007c\u0062\u004f\u0075\u0040\u0032\u005e\u0052\u0057\u0075\u003e\u006f\u007d\u0021\u007b\u003b\u0043\u0073\u005b\u0022\u0078\u0057\u004e\u0046\u0045\u0077\u0072\u0022\u0058\u002b\u002b\u0062\u0051\u005f\u0065\u004e\u006a\u002a\u004e\u0024\u002c\u0056\u006b\u0075\u0035\u005b\u007d\u007d\u0040\u0042\u0079\u007a\u007a\u0023\u0077\u0067\u0046\u003f\u0039\u0074\u003d\u003f\u0021\u002e\u0060\u0076\u0076\u0043\u0068\u003e\u0060\u0054\u0046\u006e\u0077\u0079\u0052\u003a\u0028\u0026\u0021\u0069\u002f\u0067\u006a\u004b\u004d\u0030\u003b\u0072\u006b\u007b\u0029\u0026\u002b\u0049\u0064\u007e\u0025\u0038\u004f\u0063\u006f\u0045\u003e\u0063\u0024\u0030\u0039\u005d\u0040\u003c\u0028\u005d\u0035\u006c\u0070\u0076\u0037\u0035\u0025\u0065\u006d\u0072\u004e\u0044\u0074\u0049\u006d\u007b\u0029\u0021\u0045\u0032\u005e\u005d\u0035\u002e\u0026\u0047\u0070\u0041\u0057\u0023\u0047\u0051\u005d\u0035\u0063\u006a\u0034\u0026\u0026\u006b\u003d\u002b\u0035\u005b\u007e\u0025\u006c\u0024\u0059\u0050\u0050\u0045\u0045\u002b\u006a\u0024\u0076\u0050\u004a\u0070\u0035\u0040\u0036\u0026\u0034\u0033\u0078\u0057\u0055\u003d\u0066\u005f\u0037\u002b\u004a\u0021\u005e\u0074\u007b\u0079\u0079\u0067\u0031\u0072\u0024\u002b\u0058\u003c\u0059\u005f\u006a\u005f\u006d\u004c\u0031\u004c\u0079\u0057\u0056\u0066\u0028\u0060\u0069\u0079\u004d\u002c\u0029\u0060\u004e\u0060\u005f\u0079\u002f\u002c\u002c\u003d\u0030\u0030\u0050\u0047\u0074\u0060\u0060\u0040\u0063\u0029\u005e\u006a\u006f\u004e\u0043\u006a\u0034\u007a\u0038\u006d\u006d\u0057\u0069\u0051\u0038\u004b\u005e\u0068\u0063\u0074\u0035\u0045\u007c\u003e\u0034\u002e\u0021\u0029\u0058\u0071\u0062\u006e\u0078\u007e\u0064\u0033\u006c\u003e\u0079\u0054\u003f\u002f\u007d\u0026\u004d\u0056\u006b\u003c\u0051\u0056\u0023\u006e\u006f\u0039\u0050\u0052\u007c\u0039\u0044\u003d\u0045\u0046\u0061\u004a\u004e\u0066\u005b\u003c\u002b\u0073\u0061\u0044\u0039\u005f\u0067\u006a\u0031\u0039\u007b\u0021\u007b\u003b\u0043\u0073\u005b\u004e\u006a\u005d\u006d\u0046\u0039\u004d\u0072\u0030\u0059\u0040\u0025\u003e\u0079\u006c\u0074\u0047\u0026\u0047\u006e\u005f\u0022\u0057\u0067\u0043\u0069\u0050\u0044\u0058\u0071\u002c\u0064\u0033\u003e\u0035\u003f\u0073\u0024\u0065\u0079\u004c\u0046\u002f\u0073\u004d\u004d\u004d\u0060\u0026\u0078\u0032\u0024\u0065\u0077\u003e\u005d\u0056\u0036\u005d\u004d\u0079\u0025\u005e\u0076\u0063\u0061\u0044\u007d\u0023\u0053\u0073\u003c\u003c\u0067\u006b\u0059\u0037\u005d\u0042\u0052\u0074\u0072\u005e\u0060\u003f\u0038\u004a\u0074\u0054\u0050\u0077\u0059\u002e\u005d\u0022\u004b\u0022\u0056\u0045\u0052\u0050\u0033\u005a\u0044\u0043\u0042\u0067\u005d\u006b\u002f\u007a\u0033\u003a\u0058\u003f\u0039\u0068\u0073\u0048\u0026\u003e\u0035\u007b\u0059\u0028\u0039\u0059\u0055\u0041\u0040\u0035\u0056\u0078\u0071\u002e\u0060\u003b\u0064\u0039\u005a\u0071\u0065\u0050\u0062\u0072\u003b\u007c\u0056\u0051\u005e\u0049\u0024\u006a\u0064\u007b\u0059\u0066\u003e\u0044\u003e\u0022\u003e\u0041\u0024\u0054\u0023\u0071\u0039\u006a\u0041\u0060\u0061\u005a\u002b\u0068\u0041\u0059\u0068\u0034\u0052\u003b\u0032\u006d\u0054\u007d\u007d\u005b\u0064\u005b\u0068\u003a\u0067\u0055\u002e\u0064\u0047\u004e\u0029\u0072\u005d\u004c\u0056\u0074\u0026\u0073\u0032\u006a\u0041\u002a\u004b\u0058\u007b\u0054\u0041\u004c\u0076\u003c\u0070\u005f\u0074\u0066\u0073\u0023\u0059\u0057\u0039\u007a\u0055\u0063\u0040\u003f\u004d\u005e\u0048\u005d\u0070\u0048\u0026\u0042\u0073\u0055\u0033\u0057\u0036\u0043\u005a\u003b\u003f\u0061\u004f\u0029\u0041\u003b\u0069\u004a\u0058\u005b\u0032\u006d\u005b\u0064\u0057\u0030\u0078\u0068\u0064\u0028\u002b\u0043\u0044\u0068\u0073\u0050\u0037\u0071\u002b\u004c\u0044\u006c\u0041\u0045\u002c\u006d\u006f\u004b\u0054\u006a\u0060\u0069\u0044\u0061\u003f\u004a\u0036\u006d\u006e\u007d\u0046\u0038\u0065\u0073\u0077\u002c\u002c\u0038\u002f\u0071\u0063\u0041\u007d\u0071\u0063\u0022\u0063\u0026\u0045\u003d\u0026\u0042\u0051\u0071\u0062\u0038\u0065\u0044\u003c\u0067\u0025\u003a\u004e\u003c\u0057\u0026\u0072\u0042\u007b\u006c\u005f\u0077\u0078\u006a\u0044\u007b\u0032\u0062\u0043\u0057\u0028\u004f\u0033\u003e\u005e\u0061\u0030\u007d\u005a\u0048\u0029\u0046\u0046\u0073\u0071\u004b\u0068\u0054\u0079\u0055\u0073\u0064\u0073\u0025\u007c\u003f\u0058\u0041\u0046\u002f\u007d\u0078\u0070\u0021\u0044\u003c\u0041\u0022\u0026\u002f\u0032\u0070\u0038\u0055\u0033\u0072\u0032\u0061\u006c\u0055\u007e\u0022\u007b\u002f\u007e\u0050\u0035\u006b\u0061\u0062\u003d\u0038\u006b\u0032\u003e\u0023\u0051\u0071\u0078\u0021\u003b\u006c\u007d\u006b\u0032\u003e\u005d\u0070\u0041\u0066\u0079\u0046\u003d\u0058\u0062\u0079\u0046\u0074\u0043\u0054\u0022\u0026\u0031\u006f\u003b\u0057\u002c\u003e\u006f\u0079\u0061\u0061\u0043\u004d\u005a\u003b\u004a\u0039\u0069\u002f\u006b\u0028\u0071\u0058\u0050\u0030\u0071\u0028\u0047\u004a\u0065\u0055\u0069\u002f\u0062\u002e\u006f\u0043\u0045\u003d\u0041\u0042\u006e\u0075\u0061\u0036\u0029\u0036\u0024\u0029\u0079\u0047\u003a\u006a\u0038\u0055\u002e\u002e\u0065\u0040\u0022\u0062\u004c\u0036\u0071\u002b\u0047\u0042\u0043\u0046\u0055\u005a\u0042\u004b\u005d\u0054\u006a\u0071\u003c\u007d\u006b\u0034\u002c\u004b\u0034\u003b\u0053\u003e\u0023\u0039\u0053\u005f\u0038\u004f\u0022\u0043\u0053\u0026\u005f\u0022\u004b\u004c\u002b\u0071\u0077\u0053\u003e\u0049\u002c\u005b\u0074\u003c\u002a\u0070\u0057\u002c\u0078\u0030\u007a\u003d\u004c\u0052\u0034\u0030\u002b\u0034\u0067\u0071\u0072\u0076\u0025\u004e\u0072\u0046\u0073\u0077\u002a\u0050\u005d\u0035\u0071\u007a\u0023\u0022\u006a\u0073\u0067\u003a\u005b\u0030\u0070\u0037\u0029\u0076\u004b\u005b\u0057\u0064\u0068\u003a\u005e\u003d\u0068\u0060\u0021\u0076\u0046\u0061\u003c\u002a\u0022\u0038\u006f\u0058\u0054\u003e\u0030\u004d\u0043\u004f\u002b\u0044\u0055\u007e\u0062\u0046\u002b\u0029\u003a\u0055\u0054\u0025\u0038\u0024\u0058\u0076\u006c\u0043\u007e\u0069\u0063\u0043\u0038\u0028\u0047\u002c\u0031\u0066\u0067\u0071\u004e\u0038\u0043\u0074\u007b\u0049\u004f\u0030\u006f\u0021\u005a\u0048\u0029\u0046\u0051\u003a\u004d\u006f\u003d\u0035\u002f\u0030\u0041\u0079\u007a\u0035\u003b\u002a\u003d\u006a\u0071\u003c\u007d\u006b\u0034\u002c\u004b\u0034\u0070\u0077\u0043\u0061\u002e\u0050\u0022\u0073\u0077\u0070\u005b\u0038\u002f\u0059\u0023\u0073\u005e\u004f\u007b\u0048\u007e\u003f\u0071\u0061\u003c\u0066\u007e\u0032\u003e\u002f\u005d\u0052\u004c\u0061\u0039\u004a\u0043\u0056\u0029\u0071\u002a\u007d\u002f\u005b\u0046\u0024\u0043\u0037\u0029\u0022\u0039\u003e\u005d\u0043\u003e\u004a\u0043\u0056\u0029\u0071\u002a\u0046\u003c\u0045\u0054\u0028\u0024\u0043\u006b\u0055\u0062\u0041\u0046\u002f\u004a\u0040\u0021\u006a\u0050\u0055\u0058\u0058\u004a\u0035\u0075\u0035\u002f\u0068\u0054\u0039\u0043\u0062\u0046\u002b\u0029\u003a\u0055\u0067\u002f\u0038\u0065\u0061\u0029\u0055\u002c\u0021\u002f\u0056\u0060\u0030\u007a\u0073\u005e\u0061\u0069\u004a\u0055\u002c\u0021\u002f\u0046\u0068\u0031\u003a\u0033\u0076\u0021\u0037\u003c\u0077\u005b\u0024\u002f\u0038\u0063\u0065\u0074\u0038\u0065\u0061\u003c\u003b\u005b\u0038\u002f\u006e\u002c\u0039\u005a\u0048\u0029\u0046\u007d\u007d\u0040\u007a\u0032\u0068\u0077\u0073\u002f\u0047\u007b\u0028\u0048\u0029\u0024\u006a\u0028\u0029\u005f\u0055\u006e\u004c\u004d\