2a\u0047\u0074\u006c\u0021\u006e\u004f\u0070\u0023\u0036\u0053\u0058\u0060\u0065\u0059\u0022\u0042\u006f\u006d\u004a\u0028\u0028\u0035\u0042\u0065\u0045\u0057\u0065\u0072\u006f\u004f\u004b\u0061\u0028\u0058\u0048\u0073\u0056\u006d\u003c\u002f\u0079\u007b\u0066\u0053\u006a\u0071\u004f\u0074\u0058\u0065\u0022\u0048\u0061\u0062\u006d\u0030\u002a\u005a\u006c\u0071\u006a\u0052\u007e\u007b\u003f\u0072\u007c\u0049\u007b\u006d\u007c\u0039\u006a\u0022\u0051\u004a\u004e\u007b\u003e\u0034\u0055\u0034\u0033\u0068\u0071\u0032\u004d\u0076\u0050\u0064\u0031\u0060\u004f\u0047\u005f\u003b\u0079\u006d\u0024\u0029\u006c\u003f\u002a\u007d\u0040\u0020\u006c\u0041\u007e\u0028\u003b\u007b\u0059\u005e\u007e\u0069\u003a\u0041\u0059\u006b\u0031\u0077\u003f\u0049\u0026\u002d\u0077\u0074\u0076\u006b\u0069\u0057\u0051\u007c\u006d\u003f\u0022\u0079\u006d\u002d\u0035\u0022\u0063\u0076\u0053\u0076\u0054\u007c\u005f\u003f\u0032\u0034\u0059\u0058\u004d\u0057\u0052\u007b\u005f\u005c\u0065\u005d\u0021\u0074\u0070\u005f\u0059\u003d\u0034\u006d\u003a\u004f\u006b\u0024\u0036\u0036\u006a\u0057\u0032\u0039\u0020\u0049\u004b\u0061\u005b\u0051\u002b\u0075\u0028\u004f\u003c\u003a\u006f\u0025\u007c\u002a\u0065\u0070\u007d\u0067\u0036\u0048\u0023\u006c\u004a\u004b\u003a\u002f\u006a\u004c\u0076\u0075\u0064\u005d\u0060\u0070\u004d\u002d\u003c\u0039\u004f\u0063\u006e\u0038\u005b\u0027\u0023\u002f\u006b\u0036\u003a\u007d\u002e\u0042\u0059\u0070\u0032\u0076\u0024\u0079\u003d\u0052\u005a\u005b\u002f\u0030\u0020\u003b\u0037\u0063\u0050\u0057\u0073\u0069\u0078\u005b\u0070\u0061\u006f\u005f\u0079\u004a\u004f\u007a\u0029\u0058\u0028\u006b\u0038\u0026\u0049\u0078\u0064\u0071\u002f\u002e\u0055\u0030\u0038\u005d\u0079\u0041\u0051\u0077\u006e\u0051\u0030\u006f\u0053\u0076\u0041\u0078\u0042\u006b\u0039\u0068\u005e\u0045\u0046\u002a\u0072\u003c\u007e\u0049\u0053\u0033\u004b\u0041\u007b\u0059\u0064\u0060\u006b\u002e\u0020\u0045\u0044\u0027\u0074\u006c\u0063\u0043\u0068\u002d\u004d\u0040\u007a\u0035\u004f\u005b\u0065\u0055\u0028\u0042\u0067\u003c\u0076\u002a\u0055\u006b\u0028\u005b\u006d\u003f\u0061\u0056\u003a\u0046\u0078\u0070\u002d\u0049\u0022\u002b\u0031\u0048\u0035\u002b\u007d\u0059\u006d\u0072\u0078\u0033\u0056\u0063\u003d\u006d\u0027\u0068\u0039\u0034\u0060\u0059\u005d\u004a\u0045\u003e\u0043\u0035\u0075\u007b\u004d\u0067\u0044\u0048\u0079\u0030\u0057\u006b\u0036\u005b\u006f\u0072\u007a\u0072\u0049\u0031\u0053\u0075\u0030\u0034\u002a\u0062\u0073\u0042\u0041\u002f\u0020\u0057\u0034\u0030\u003c\u003c\u0025\u0046\u0030\u002c\u007d\u006b\u006e\u0042\u003d\u002a\u007c\u0036\u0059\u006e\u0064\u003a\u0076\u0046\u002e\u0072\u0050\u002f\u0067\u006a\u004a\u0053\u0046\u006e\u0028\u004b\u0074\u0059\u004b\u0065\u0044\u0026\u0030\u006e\u003d\u0053\u0066\u0039\u004f\u0056\u004b\u0065\u0074\u0026\u0047\u0060\u0075\u0029\u007a\u0040\u002a\u003f\u0031\u0028\u0022\u0066\u0025\u002d\u004e\u007b\u004c\u0078\u0075\u0031\u0025\u0045\u0077\u0076\u003b\u0076\u003c\u0077\u0048\u0035\u0078\u006e\u0049\u0074\u0028\u002d\u0044\u002f\u003c\u0067\u0077\u0032\u0028\u0067\u0033\u0040\u003d\u002b\u0071\u0060\u0043\u004a\u005f\u006e\u0026\u0059\u0024\u0056\u002c\u005b\u004e\u0060\u0024\u0078\u0048\u007e\u0033\u0046\u005a\u006e\u004d\u0067\u006d\u0074\u004c\u0061\u0047\u0037\u007d\u005d\u003c\u007c\u006b\u0057\u007a\u0064\u0039\u004d\u0050\u0027\u0046\u007b\u004f\u0045\u003e\u003c\u006b\u0053\u003d\u0030\u004a\u0048\u006d\u0071\u002e\u0045\u0025\u006d\u0072\u002b\u005d\u005e\u0021\u0076\u0051\u0057\u002f\u0039\u007c\u002a\u0051\u0068\u0044\u0050\u0031\u0041\u0037\u004a\u0054\u0023\u0053\u0066\u005a\u0061\u0053\u006c\u0048\u0066\u0021\u0020\u005e\u0025\u004b\u007e\u005c\u0048\u002b\u0048\u006e\u0041\u007d\u006b\u0078\u0043\u006a\u007c\u0073\u0029\u004d\u006b\u0074\u003b\u002b\u0067\u0064\u007e\u0033\u0027\u0074\u0049\u0075\u006d\u0078\u0044\u0036\u007c\u004e\u002d\u006a\u002f\u004b\u0064\u0045\u004a\u0070\u0040\u0061\u002a\u0078\u0038\u0079\u0060\u0070\u0045\u0045\u004e\u0063\u0037\u0048\u0021\u002d\u0070\u0024\u0024\u002e\u0056\u004d\u004e\u0057\u002f\u007e\u007b\u0053\u003f\u003b\u004c\u003c\u0031\u0058\u004f\u0074\u0054\u004f\u003d\u0070\u0056\u004f\u0079\u005c\u0021\u0072\u0079\u0032\u0057\u0021\u0038\u0020\u0061\u002b\u004b\u006d\u007d\u0074\u0051\u004a\u003a\u006f\u0062\u004b\u003a\u0038\u007c\u007c\u0039\u006e\u0028\u0024\u0020\u002d\u0063\u0073\u006d\u0031\u002d\u0040\u0058\u0061\u0047\u005e\u0051\u0036\u002e\u0020\u0055\u007b\u0064\u0031\u0047\u0046\u007b\u0076\u002f\u005d\u0042\u0078\u007e\u006c\u007d\u0051\u0043\u005f\u003b\u007a\u0039\u0053\u003c\u0070\u005e\u002a\u004e\u0058\u006b\u005c\u003d\u0079\u0076\u003d\u0046\u0035\u006a\u0031\u004c\u0063\u0043\u0023\u004d\u0071\u0072\u0032\u004e\u0068\u0077\u005d\u007d\u004f\u0044\u0049\u0063\u004d\u0020\u0062\u0035\u0046\u007d\u003e\u002e\u003c\u0039\u006f\u0078\u007e\u0036\u006e\u0074\u0059\u005f\u0054\u0049\u0024\u0058\u0029\u0028\u004c\u0022\u0045\u0055\u0061\u004e\u0021\u0037\u005e\u0049\u005b\u0023\u004e\u006f\u003b\u007b\u004e\u0025\u002b\u0022\u0052\u005b\u002d\u0058\u005c\u006b\u004b\u0036\u006d\u0040\u0071\u0043\u006a\u0031\u005c\u0027\u0077\u005a\u0059\u0034\u0060\u0057\u005c\u004a\u004f\u0071\u006a\u0068\u0067\u0043\u0057\u006a\u007b\u0046\u007b\u0075\u005d\u006c\u003c\u0037\u007b\u0025\u0041\u007b\u007a\u0061\u0059\u0063\u006d\u003d\u007d\u0049\u0043\u0051\u002a\u0078\u0048\u005a\u003a\u0064\u0056\u005c\u0059\u0062\u0024\u0038\u0062\u004b\u0038\u0049\u005e\u0024\u005d\u002b\u002d\u003c\u003d\u007e\u003b\u004c\u0038\u005a\u0078\u005f\u003e\u0045\u0038\u003d\u0057\u0073\u007e\u003d\u0046\u0055\u005f\u002f\u003d\u007c\u0025\u0057\u006b\u005d\u0058\u0079\u0075\u0053\u0053\u0072\u0033\u0065\u002d\u005e\u0020\u0042\u006f\u002b\u0036\u004b\u003b\u007e\u007c\u0043\u005f\u007e\u007b\u0026\u0020\u0073\u0031\u0072\u0036\u004b\u0024\u007b\u0022\u0031\u006a\u003d\u0047\u0025\u006b\u005e\u0072\u0065\u007e\u0065\u0043\u0025\u006c\u0021\u0059\u0052\u0072\u0068\u004f\u004b\u005a\u004f\u0022\u0036\u004b\u0078\u004e\u0044\u007a\u0031\u0076\u0049\u0041\u007c\u0022\u004f\u0065\u0025\u0026\u0050\u006e\u0033\u0022\u006e\u005a\u003b\u005c\u002b\u0052\u0033\u0029\u0036\u0045\u0059\u004e\u0021\u007b\u0073\u003b\u002a\u0068\u004a\u0063\u006a\u005d\u0022\u0051\u0078\u0044\u005f\u0051\u002c\u005e\u0033\u0034\u0077\u0059\u006e\u006d\u0062\u0033\u0056\u0031\u004d\u0049\u0070\u002a\u0040\u0025\u005a\u0039\u0023\u003f\u002d\u0065\u0068\u0068\u0057\u0073\u0077\u0064\u0037\u0050\u0045\u002c\u0027\u0076\u0020\u004f\u0059\u0045\u006f\u003f\u007d\u004f\u0067\u004a\u004a\u002c\u0057\u0039\u0029\u002b\u005b\u0030\u0057\u003a\u002a\u004b\u0044\u006d\u0046\u0026\u005f\u002d\u0052\u0049\u0054\u0056\u0068\u0033\u0042\u0059\u0058\u007d\u006e\u0050\u0073\u004e\u0025\u0056\u0037\u0021\u0067\u005b\u007e\u0036\u0056\u007a\u0027\u005f\u0046\u0041\u0050\u004a\u0025\u0021\u006b\u0021\u0035\u0074\u0074\u006f\u0068\u0062\u004b\u003f\u0067\u005d\u005d\u0033\u0048\u0035\u0023\u0045\u0073\u005c\u002a\u0073\u0030\u005b\u0023\u004e\u0041\u0027\u002a\u0058\u0037\u0055\u0046\u0066\u0033\u0023\u002d\u0059\u0046\u0077\u0023\u002e\u003e\u0050\u0061\u0077\u0076\u0060\u0032\u004b\u003d\u002e\u0055\u0042\u0033\u0021\u0046\u0058\u0029\u0026\u005c\u0056\u0044\u0031\u0054\u002c\u005b\u0038\u004f\u0035\u0035\u0076\u004d\u0043\u0076\u002b\u007a\u0030\u004b\u0077\u006d\u006b\u0077\u006e\u0041\u007e\u006e\u007e\u0058\u0079\u002c\u005b\u005e\u0041\u0047\u007d\u0056\u0037\u0062\u0073\u006e\u0036\u0071\u0031\u0023\u006f\u0074\u007c\u004a\u0053\u006a\u003f\u0066\u002d\u0024\u0052\u0024\u002c\u0060\u0037\u004f\u0070\u006c\u0032\u0024\u0041\u0020\u003f\u006d\u005a\u0027\u002f\u0022\u007b\u0063\u004a\u005a\u005c\u0052\u004c\u002d\u0079\u0055\u0069\u002c\u0052\u0040\u0065\u0026\u0045\u0027\u0041\u002e\u004c\u0048\u002f\u0053\u0033\u007c\u0076\u0059\u0045\u0058\u003c\u002a\u006d\u007b\u0024\u0046\u0070\u003b\u0061\u003a\u0029\u0057\u0072\u0022\u0039\u0073\u0046\u0079\u006b\u006e\u0052\u002c\u004b\u003f\u007c\u0047\u0044\u002c\u0070\u004a\u0064\u0029\u006b\u002c\u0073\u002d\u0025\u0062\u002f\u0073\u002a\u006f\u0024\u0053\u0047\u0032\u006e\u006b\u0051\u0058\u0057\u006c\u0042\u002e\u007d\u0078\u0078\u0056\u004e\u0060\u003f\u002b\u0060\u0072\u0028\u0044\u004e\u0071\u0054\u0029\u0072\u0046\u005f\u0059\u0047\u0020\u0027\u002d\u007e\u0049\u0058\u0034\u0063\u003e\u0050\u007b\u0046\u007b\u007e\u0031\u0041\u0051\u003a\u006d\u0027\u0020\u0035\u0059\u0047\u0062\u0041\u0056\u004e\u0067\u0031\u0072\u003a\u006f\u007b\u0055\u006d\u0024\u0041\u0044\u0054\u0079\u007c\u0043\u004a\u0021\u0045\u003b\u004c\u005d\u006d\u0053\u0062\u0077\u0069\u0065\u004c\u006a\u005a\u0031\u0041\u002a\u005c\u004a\u0024\u0063\u002f\u0034\u0034\u0066\u007e\u0059\u0042\u003e\u0070\u0039\u003d\u0058\u0047\u003b\u0022\u0058\u0046\u0041\u0053\u0071\u007e\u006f\u007e\u0047\u0031\u006c\u006f\u0041\u0056\u005e\u0073\u0024\u0059\u0047\u002e\u003d\u003e\u0040\u0073\u0031\u0020\u0024\u0053\u005c\u0032\u0067\u002a\u0072\u0068\u0045\u003a\u0040\u0042\u006b\u0024\u002f\u004c\u0020\u0070\u004f\u0064\u005d\u006c\u0075\u003a\u0037\u0072\u0075\u0057\u0043\u0030\u0073\u0060\u0067\u003e\u002f\u004b\u0029\u0060\u005d\u005d\u0056\u0054\u005e\u007a\u003e\u0059\u0075\u0068\u0063\u0072\u0079\u002b\u004f\u0043\u0076\u0062\u002e\u0074\u0077\u0061\u0030\u007d\u0051\u005b\u003c\u0040\u0036\u0024\u0039\u003e\u004f\u0021\u0025\u0045\u0040\u0040\u0079\u0038\u0068\u0028\u0022\u0078\u0022\u0021\u005c\u0036\u0072\u0079\u0033\u0033\u0077\u0033\u0053\u0034\u002b\u0047\u0046\u0070\u0028\u0068\u005b\u0077\u0025\u004f\u0068\u0065\u0043\u0077\u0077\u0060\u003f\u0038\u0064\u007b\u0046\u0029\u0054\u0070\u0059\u003f\u007d\u005f\u007a\u006a\u0036\u0025\u0020\u005e\u0043\u0052\u0037\u0054\u0053\u002d\u0077\u007e\u0055\u0041\u0060\u0077\u0070\u007b\u002e\u0078\u0066\u0033\u0033\u0045\u0056\u0044\u0056\u005f\u0062\u0077\u005d\u0034\u0026\u0046\u0076\u0053\u0050\u006a\u0056\u0060\u007a\u0025\u0021\u0043\u0051\u0077\u0079\u003e\u007a\u005a\u0043\u004a\u0045\u004e\u0074\u0048\u0032\u0020\u0052\u0048\u006c\u0059\u007d\u0070\u002f\u0034\u0052\u004c\u006c\u0075\u0046\u003c\u0024\u0051\u0049\u0052\u0021\u0075\u0040\u0039\u006c\u0043\u0040\u003b\u007b\u005e\u0076\u0042\u0044\u0033\u0066\u0069\u006b\u0064\u006b\u0023\u002e\u0036\u0040\u006d\u0046\u0065\u0035\u0025\u002f\u002a\u005c\u004c\u0068\u0040\u0039\u0050\u0056\u0042\u004a\u0062\u0040\u0020\u007c\u0032\u0037\u006e\u0030\u0078\u0047\u0046\u0032\u007c\u0073\u007e\u003e\u0039\u004c\u0043\u005c\u0055\u005c\u0071\u0057\u0045\u0027\u0066\u0075\u004e\u006a\u006d\u007a\u004d\u0056\u007b\u0071\u0024\u0040\u005c\u0058\u004f\u006b\u0029\u007c\u005d\u0067\u003e\u003c\u0034\u0039\u0064\u002e\u007a\u0042\u0079\u005e\u004b\u003b\u007a\u0022\u004b\u0067\u0035\u004a\u0024\u0047\u0037\u0044\u005f\u0038\u0074\u0043\u005b\u0056\u004b\u007c\u0048\u0079\u004c\u005a\u0021\u0078\u0058\u0049\u0068\u0065\u0024\u006d\u003c\u007c\u004c\u0050\u0048\u006f\u004f\u005d\u004b\u003c\u002b\u007a\u003d\u0074\u004f\u0062\u0079\u0051\u0072\u005d\u0079\u003d\u0057\u005d\u0031\u004f\u007c\u0037\u0056\u004c\u0041\u0029\u005a\u0062\u005b\u0033\u0030\u005a\u003a\u006a\u003f\u0047\u0026\u0061\u003f\u0034\u0041\u004c\u005f\u006b\u0024\u0056\u0075\u0021\u007c\u0031\u0026\u0077\u0076\u0022\u005c\u0061\u0078\u0067\u0039\u004b\u0073\u0062\u0038\u002b\u003c\u0037\u004d\u0029\u0057\u0026\u004e\u0061\u004c\u0069\u0028\u0063\u0041\u003d\u0041\u0072\u005e\u0079\u0073\u0028\u0022\u0058\u0075\u0027\u0041\u0037\u005a\u005d\u005b\u0078\u005c\u0049\u007e\u004d\u002f\u0079\u0043\u004e\u0063\u0051\u0041\u0022\u004c\u0052\u007d\u0029\u007c\u0047\u0062\u003e\u0043\u0031\u005d\u004f\u0037\u0027\u0037\u0033\u0021\u0072\u002e\u0046\u0064\u004e\u0024\u003b\u0026\u0037\u0040\u002a\u0031\u0073\u0028\u004e\u0038\u007b\u0053\u0074\u003d\u0075\u0025\u0043\u0070\u007d\u0041\u002c\u003a\u0055\u003b\u002f\u0029\u004f\u0022\u0024\u0074\u004d\u0028\u0075\u0078\u0077\u0037\u0071\u004d\u0031\u0044\u0061\u0020\u0034\u0070\u0061\u003e\u0026\u0054\u0029\u0026\u0053\u0040\u0051\u0060\u002f\u0046\u0056\u0068\u007e\u0031\u0068\u0048\u004a\u0065\u006c\u004f\u006b\u006b\u0073\u0069\u0052\u0070\u006b\u0075\u005c\u0047\u003c\u004f\u0057\u004f\u005e\u002e\u0029\u0072\u0023\u0041\u0033\u0055\u0064\u0075\u0069\u0072\u0076\u0073\u0070\u0058\u002f\u0022\u0075\u005b\u002e\u002c\u0021\u0044\u0061\u0028\u0025\u0055\u0051\u0076\u002c\u003f\u0054\u004a\u006a\u0074\u0076\u0038\u0045\u006b\u005b\u0059\u002c\u0079\u002c\u0040\u002c\u0025\u0029\u0028\u005c\u005d\u0056\u0058\u005e\u002c\u0022\u0079\u0021\u0026\u0026\u0049\u0025\u004c\u0067\u0059\u0044\u0034\u0075\u0075\u0061\u0024\u0045\u0061\u0075\u0060\u0041\u0037\u0030\u0020\u0048\u002d\u0055\u004c\u004a\u003b\u0075\u0074\u004b\u0048\u0070\u006b\u005d\u0066\u0046\u005a\u0070\u0073\u0051\u004e\u0023\u0051\u0056\u005d\u0038\u0079\u003a\u002d\u007c\u0069\u0040\u0048\u0063\u0059\u0039\u0040\u0061\u004f\u0038\u0025\u006e\u002a\u003d\u0056\u005a\u006a\u007e\u003b\u0074\u0051\u003c\u002e\u0065\u0077\u0046\u0063\u0045\u0030\u005f\u0056\u0052\u0063\u0076\u0079\u0049\u0071\u0025\u005d\u0075\u0071\u0053\u005e\u0031\u0060\u0058\u003d\u0050\u007a\u0020\u0077\u005b\u0042\u0050\u007c\u0021\u0053\u005e\u005f\u007c\u003b\u007a\u0062\u0025\u0026\u002f\u007e\u0068\u0032\u003a\u0027\u002b\u0079\u007a\u0060\u0054\u0021\u0072\u004c\u0071\u007d\u0058\u002a\u003b\u0044\u003c\u0062\u006a\u0050\u0058\u0029\u0021\u006e\u004d\u0066\u0064\u0075\u0024\u005a\u0056\u0071\u0079\u0063\u0050\u0021\u006b\u005a\u0077\u0048\u0048\u007a\u0057\u003a\u0034\u002a\u004b\u0055\u005d\u0060\u0063\u0064\u0028\u0033\u0069\u002c\u0064\u0032\u005f\u0075\u0044\u0022\u004e\u0046\u0069\u0065\u0051\u0042\u003d\u005e\u002e\u0073\u0060\u006d\u0020\u002b\u0027\u003e\u0039\u0039\u0030\u0046\u0071\u0044\u0028\u0033\u0027\u005d\u0023\u0045\u0066\u0028\u0035\u0065\u0053\u005a\u002f\u0061\u002f\u0021\u002e\u0037\u004c\u002d\u0063\u0068\u0030\u003c\u0025\u0060\u003d\u0076\u0069\u0027\u0030\u0038\u003b\u006b\u0051\u0037\u0078\u005b\u0055\u0040\u0041\u002f\u005f\u002b\u002c\u005a\u0031\u006a\u0078\u0067\u0032\u006d\u0034\u0043\u002b\u0051\u0051\u0053\u003f\u002d\u0021\u006a\u0039\u005b\u0050\u007e\u0058\u004a\u002d\u0040\u006e\u006a\u0060\u0058\u0048\u0070\u0054\u007b\u004f\u003d\u0032\u0061\u004e\u0076\u003f\u003f\u007b\u005a\u0024\u0050\u0067\u0037\u0055\u006c\u004e\u0047\u007b\u002c\u0048\u0041\u0041\u0078\u0047\u004c\u0067\u0058\u006d\u002d\u0029\u0026\u0051\u0077\u0073\u0059\u0055\u0074\u0047\u0029\u0052\u0060\u007d\u006d\u0042\u0039\u007d\u0023\u007c\u003e\u006d\u0048\u0032\u0037\u0051\u003b\u005d\u002d\u003a\u0045\u0077\u0024\u0021\u006a\u005c\u002d\u0056\u0061\u004f\u0020\u004c\u0062\u0059\u0035\u004a\u004c\u007d\u005f\u0024\u005f\u0039\u0061\u0067\u0032\u006a\u002f\u0037\u002f\u002a\u004b\u006e\u0047\u0028\u0038\u007b\u0048\u0037\u0043\u0062\u004d\u0076\u0069\u007a\u0046\u004d\u0026\u0077\u0032\u0032\u0034\u0077\u005f\u004a\u0063\u0020\u004d\u0069\u0055\u0027\u0023\u005e\u003f\u0078\u004a\u002c\u004e\u007b\u0060\u0052\u0060\u0038\u002e\u0073\u0070\u007a\u0079\u002a\u0038\u004a\u0042\u0027\u003f\u0069\u0020\u002e\u0021\u0050\u0029\u006b\u0063\u0056\u002b\u0055\u0023\u0040\u0036\u004c\u006d\u004e\u0029\u004a\u0059\u0060\u0053\u007e\u003d\u0021\u004b\u006b\u002d\u0034\u002c\u0067\u0024\u006b\u0030\u004e\u0072\u0044\u0022\u0063\u0046\u0035\u0054\u007b\u0055\u0035\u0058\u0061\u0068\u007d\u0020\u005d\u006d\u0038\u005f\u0074\u006d\u0062\u0079\u0041\u0077\u006c\u0062\u004f\u0029\u0060\u0032\u0067\u003c\u005a\u0065\u0039\u005a\u005a\u002c\u0074\u0053\u0037\u0053\u002e\u0060\u0054\u0021\u007c\u0031\u002b\u0071\u0077\u0059\u004c\u0046\u006f\u0038\u005d\u0026\u0021\u0035\u0074\u0078\u0070\u0038\u0030\u0044\u002c\u004f\u0028\u0079\u0027\u0021\u002d\u002a\u0027\u004d\u0039\u0040\u0069\u003c\u003e\u0040\u002a\u0040\u007d\u006d\u002b\u006a\u0033\u0024\u006d\u005d\u0052\u0076\u0059\u0077\u0047\u0026\u005a\u007c\u0055\u007d\u002e\u007a\u0041\u002c\u0034\u0025\u0058\u0031\u0049\u004d\u0070\u0060\u0038\u006e\u0028\u0054\u0050\u0042\u0037\u007a\u007c\u003c\u0069\u0039\u0068\u005d\u007e\u006e\u0055\u004e\u005e\u004b\u0026\u0071\u003f\u0048\u0075\u002a\u007c\u004b\u0062\u0062\u0042\u002c\u0069\u002d\u005d\u002b\u004d\u0024\u0041\u007b\u0024\u0049\u0078\u0063\u0043\u004c\u0033\u0050\u005a\u0070\u0045\u007d\u0054\u004f\u0035\u0053\u0077\u0057\u0079\u006b\u003c\u0075\u0037\u0058\u004d\u0070\u0076\u0030\u0046\u0028\u0043\u002f\u0045\u004a\u0073\u003a\u0066\u006e\u004f\u0074\u0042\u0040\u006d\u002f\u002d\u0066\u0073\u0028\u0033\u0065\u0033\u0042\u0024\u0073\u0075\u0054\u002b\u0076\u0061\u002f\u0047\u0026\u002f\u0073\u002d\u006a\u0058\u0025\u0047\u0073\u0066\u0026\u0027\u0045\u0030\u006f\u0051\u0053\u0036\u003b\u0024\u0021\u0055\u004a\u0036\u0056\u006c\u0035\u0033\u0036\u007b\u0021\u0037\u0070\u0044\u0046\u0066\u0029\u0058\u0048\u0065\u005d\u006c\u0051\u004d\u0062\u0047\u0044\u002b\u0069\u0025\u0064\u0020\u002c\u0063\u002f\u002b\u0029\u003a\u003d\u0026\u0049\u0076\u007c\u005b\u0047\u0065\u002f\u003f\u0022\u002c\u0042\u0064\u0077\u002e\u005f\u0043\u002c\u0024\u002c\u002f\u005e\u0052\u0047\u0060\u004e\u0055\u0039\u0023\u002f\u0030\u0027\u003e\u0056\u0063\u005e\u006a\u0045\u005b\u0026\u0069\u0061\u0078\u0053\u005c\u0052\u0054\u0075\u0050\u006b\u003c\u0042\u002e\u002c\u0040\u0021\u0065\u0078\u002c\u007c\u0034\u003e\u0071\u0035\u0056\u0031\u005e\u006d\u006d\u0075\u0027\u0053\u002e\u0023\u003c\u0023\u0066\u003e\u0059\u0049\u0034\u006e\u0046\u007e\u004b\u007c\u0038\u0025\u0056\u0039\u006f\u002d\u0071\u002d\u0036\u0047\u0048\u0022\u0024\u007d\u005b\u0051\u0051\u0037\u004f\u0042\u006b\u0063\u006c\u0049\u003a\u0031\u0046\u0064\u006f\u0055\u0055\u002e\u005a\u005b\u0074\u0032\u0076\u0035\u0043\u0023\u0059\u007e\u0055\u002b\u0045\u0034\u002d\u006f\u003a\u0055\u0066\u006d\u0023\u005a\u0048\u0036\u0050\u0068\u0060\u005d\u004e\u0061\u0079\u0037\u0069\u0040\u004d\u0055\u0035\u003a\u0061\u0071\u0039\u0067\u0045\u0046\u003c\u003d\u005b\u004c\u005e\u0076\u003c\u002d\u0051\u002a\u0073\u0072\u0063\u0057\u0058\u005f\u007c\u0037\u0050\u002b\u006c\u0020\u0077\u0054\u0054\u002f\u004b\u0025\u0023\u005f\u005c\u0059\u0045\u0076\u0044\u0062\u0053\u0058\u002b\u0077\u0024\u0039\u0028\u007c\u0062\u004c\u004a\u0024\u004c\u0038\u0039\u0034\u0057\u0069\u0020\u0060\u005a\u0046\u004c\u002b\u0035\u0062\u0023\u0044\u0036\u0060\u0070\u0020\u007d\u007b\u0078\u006b\u0068\u0048\u0061\u004c\u003b\u006d\u0064\u0044\u0036\u005e\u0057\u005f\u0026\u004c\u0032\u0060\u0030\u005a\u0027\u002b\u0064\u0053\u004c\u0027\u002a\u0076\u005f\u0061\u0021\u0067\u0051\u0032\u002b\u0069\u0062\u0055\u0078\u0071\u003e\u0070\u0067\u0068\u0056\u0058\u0055\u0079\u007b\u0051\u0069\u003d\u0042\u007d\u0032\u002d\u003a\u0054\u0025\u0066\u0069\u0070\u005d\u005b\u002e\u002e\u0079\u0053\u0033\u0037\u002d\u003e\u0072\u005b\u0028\u0027\u004f\u0022\u006a\u007a\u0051\u0068\u0065\u005b\u0036\u0047\u0063\u0031\u0039\u0048\u0029\u006f\u0034\u0071\u0025\u0064\u004a\u003f\u005a\u006f\u0072\u0028\u0077\u0079\u004c\u0043\u0032\u007e\u0060\u0031\u0046\u004f\u002f\u0042\u0050\u003f\u007c\u0039\u0043\u0026\u0052\u0044\u0073\u0051\u005a\u0061\u005d\u0039\u0029\u006a\u003b\u0040\u002c\u002f\u0054\u0068\u003d\u002d\u007d\u0056\u004e\u0028\u0068\u0056\u0032\u0060\u0047\u0053\u0075\u0065\u0023\u002d\u0070\u005a\u0025\u0048\u007a\u007e\u007e\u002c\u0026\u0031\u006d\u004b\u0030\u0040\u007a\u005b\u0031\u0050\u0043\u0029\u0031\u0032\u0065\u003d\u007e\u0038\u004c\u004e\u0027\u0076\u006a\u0033\u006b\u005a\u006e\u0060\u002e\u006b\u0042\u003e\u005a\u0049\u007c\u007a\u003f\u005d\u0075\u0043\u004b\u0037\u0069\u0074\u0069\u0024\u0076\u006f\u0029\u0047\u0025\u004c\u0049\u0031\u007b\u0041\u005c\u0051\u006e\u0046\u0073\u0043\u0060\u0065\u006c\u004b\u0039\u0065\u004b\u0053\u0042\u0045\u0021\u0058\u0077\u0044\u003c\u0064\u0040\u004a\u003a\u0058\u0036\u002d\u0041\u0026\u0032\u0049\u003b\u006a\u0066\u0048\u0065\u007a\u0049\u003e\u0039\u0066\u0065\u0057\u0064\u0059\u005c\u004f\u0077\u0063\u0066\u0030\u0027\u0074\u0030\u004f\u0054\u007a\u0020\u003b\u0054\u0065\u0071\u002e\u002e\u004d\u0041\u0046\u006a\u0058\u003e\u0058\u0046\u003a\u0063\u0028\u006c\u007a\u003d\u005a\u0023\u0033\u0023\u005e\u004b\u0074\u0076\u0054\u002d\u003e\u007a\u0043\u006f\u0063\u0054\u004d\u002f\u004d\u0037\u0034\u005e\u006f\u0050\u0069\u0072\u007a\u0052\u003f\u0056\u0040\u0073\u0020\u0066\u0038\u002f\u0040\u0060\u0073\u0047\u006b\u0049\u0070\u003b\u0073\u0040\u0023\u0050\u0043\u005e\u0075\u0029\u0072\u0066\u0034\u0065\u0055\u0040\u0057\u006c\u0053\u0068\u007b\u006c\u006a\u0076\u007c\u007a\u0029\u004d\u0040\u003f\u0044\u0061\u0048\u007e\u006a\u004e\u0076\u005e\u006c\u0063\u0045\u0066\u0053\u0071\u0070\u003b\u004d\u0067\u003f\u0054\u0023\u0060\u0026\u007e\u0033\u0028\u0033\u003f\u0075\u0068\u0052\u0071\u0071\u0026\u0066\u0055\u002c\u0077\u0073\u0035\u0062\u005c\u0066\u0029\u0038\u003a\u0066\u003b\u006c\u0050\u0024\u0025\u0036\u0076\u006c\u0064\u0034\u005b\u004e\u0063\u0037\u0025\u0070\u003c\u007b\u004b\u005e\u0035\u005a\u0043\u0051\u0070\u0054\u0070\u003f\u0024\u0078\u0025\u0056\u004a\u003c\u007e\u0032\u0041\u0032\u0042\u0062\u004e\u0072\u0052\u004a\u006b\u0023\u0058\u0054\u007c\u0058\u002b\u006d\u004e\u0050\u0066\u0027\u0076\u006a\u0039\u0062\u004a\u007e\u006d\u0074\u0030\u0056\u002e\u0079\u0048\u004b\u0025\u0048\u004e\u0033\u0029\u0055\u003d\u004a\u006a\u005a\u007d\u0069\u004e\u004d\u003e\u004b\u0074\u0022\u003b\u006e\u0030\u004f\u005c\u002d\u0079\u0029\u002b\u006b\u003c\u0035\u0049\u002b\u0072\u0048\u007b\u005f\u007b\u0077\u005b\u0038\u006d\u0074\u006d\u0031\u006d\u002b\u0023\u004c\u0049\u0036\u006c\u0027\u0023\u003a\u004a\u0041\u0042\u0057\u0042\u0079\u005b\u003f\u003b\u003e\u0052\u0047\u0023\u0044\u004e\u0050\u0025\u0028\u0036\u0034\u006b\u005b\u0058\u0056\u0041\u004a\u0036\u0048\u0036\u0047\u0067\u0057\u0038\u006e\u006f\u003a\u0065\u007c\u0038\u0048\u007a\u0046\u0036\u002a\u006d\u003d\u007e\u002a\u0068\u004c\u0055\u003c\u0076\u003e\u0061\u0033\u0042\u0055\u006a\u0058\u0060\u0068\u0029\u0077\u0042\u0065\u003e\u0057\u0061\u0057\u004a\u003f\u0036\u0060\u002c\u004d\u007c\u005f\u0048\u0053\u0079\u0029\u004d\u0065\u0066\u006f\u0064\u004d\u0067\u006c\u007c\u0056\u0024\u0052\u005d\u0058\u0043\u0031\u0042\u003b\u0041\u0023\u0075\u002a\u0037\u0072\u0043\u0030\u0071\u006b\u0068\u0052\u003d\u0049\u0066\u0052\u0024\u0052\u0044\u007c\u0053\u0068\u0057\u0053\u0065\u003b\u003f\u0051\u006f\u004f\u0065\u0056\u0027\u003d\u0044\u0070\u0026\u0065\u0033\u0026\u0072\u0031\u0077\u003c\u002a\u0040\u0046\u0054\u002e\u0060\u0028\u007b\u002f\u0076\u0078\u0068\u006e\u0020\u0064\u0043\u0031\u0026\u0061\u0040\u002f\u002d\u0046\u0020\u003b\u007c\u005a\u0070\u0077\u0054\u004d\u0046\u0074\u007d\u0064\u003c\u0037\u0038\u002d\u0022\u0062\u007a\u0024\u0054\u0060\u006f\u0036\u0070\u0037\u0035\u005c\u002e\u0046\u0026\u0024\u006f\u0050\u0034\u0027\u0025\u002b\u006e\u0059\u0041\u005c\u004d\u0078\u0064\u0066\u0077\u0049\u0062\u0060\u007c\u003b\u0048\u0041\u0054\u003b\u0073\u006d\u0030\u005c\u006e\u0046\u0050\u0033\u003d\u0023\u0043\u0023\u0040\u0047\u0077\u003f\u004c\u0066\u0027\u005a\u005b\u0063\u005a\u006c\u0021\u0059\u0054\u007b\u007d\u006d\u0046\u0067\u0043\u006e\u0060\u003a\u007e\u0025\u005a\u002a\u0024\u006c\u0043\u005a\u0022\u006b\u0044\u0043\u0064\u0058\u002b\u003b\u0052\u007b\u0069\u005a\u0067\u0061\u0063\u0036\u0061\u006e\u005a\u0033\u0038\u0063\u004d\u0059\u0026\u0075\u0070\u005d\u0032\u002a\u0051\u0070\u004c\u0053\u0044\u0064\u0066\u002b\u007e\u006d\u006a\u0038\u0039\u0072\u004b\u0059\u0024\u0044\u0041\u007d\u0066\u0051\u005b\u0050\u005e\u0042\u0024\u0050\u0079\u0041\u004d\u002b\u0020\u002b\u0067\u0055\u0028\u0043\u005f\u0054\u006a\u0020\u0078\u002a\u0077\u0027\u003d\u0057\u004c\u0067\u0058\u0025\u0040\u003b\u0042\u0077\u002a\u0058\u0074\u0021\u0036\u005c\u0033\u0027\u0034\u0025\u006d\u0022\u0077\u003a\u003c\u0052\u005e\u0059\u0045\u0032\u0045\u0062\u0032\u0067\u0038\u003a\u0061\u002b\u0071\u005d\u006e\u0061\u0064\u007a\u0041\u006b\u007c\u0078\u0069\u006e\u0036\u0021\u005b\u0028\u0073\u0025\u0054\u0032\u0024\u004e\u005a\u0056\u007a\u0067\u007e\u002f\u003f\u006f\u006d\u003a\u0060\u003e\u0047\u0074\u006f\u003c\u0048\u0078\u0039\u007d\u007e\u002b\u007e\u007d\u0054\u0078\u0038\u0028\u0037\u0050\u0031\u0044\u0024\u002d\u007a\u0024\u0024\u0026\u0046\u004e\u0023\u002f\u0077\u0077\u0022\u0035\u006d\u004e\u0039\u0051\u0079\u0030\u006a\u004d\u0061\u002c\u0045\u006b\u0024\u0038\u0052\u007a\u0033\u004d\u002e\u006a\u0028\u0044\u0039\u0022\u003b\u003d\u007a\u007c\u0021\u0040\u0059\u0039\u002c\u0053\u0053\u0021\u002e\u0074\u0022\u006e\u0048\u0073\u0051\u0070\u004a\u0076\u006d\u0024\u0026\u004f\u002b\u0051\u0039\u002b\u005f\u004b\u002b\u003c\u0034\u0056\u0055\u002c\u0056\u006b\u0077\u0038\u002e\u0070\u0063\u003d\u0072\u0037\u0071\u0046\u0034\u004a\u004b\u0057\u002d\u0046\u004d\u004f\u0076\u0066\u0042\u007d\u0034\u0056\u0062\u007c\u0045\u0036\u0038\u007b\u002d\u0061\u002d\u0078\u0057\u0072\u004c\u0026\u0023\u003a\u0024\u0060\u0025\u006d\u0069\u0053\u0077\u0041\u006a\u0044\u0060\u002d\u002c\u0058\u003d\u0059\u0079\u004c\u0020\u0062\u0026\u0047\u0046\u0050\u005e\u0035\u005b\u0068\u0062\u0057\u007c\u0060\u0034\u004e\u0066\u007e\u0072\u003e\u0029\u0025\u007c\u005b\u0052\u0028\u0046\u006d\u004a\u0073\u006e\u0063\u0023\u0064\u0066\u0022\u0078\u0053\u002c\u005f\u0027\u0072\u002b\u002d\u002d\u0043\u0022\u0067\u0075\u0027\u0023\u0034\u006c\u005d\u0059\u0031\u0069\u002f\u0069\u0061\u007b\u0055\u0045\u005b\u0046\u0052\u006a\u0041\u0043\u0075\u0068\u0021\u003b\u0062\u0079\u0031\u005b\u004d\u005e\u0033\u006e\u0057\u0033\u0064\u0042\u0023\u003a\u004c\u002b\u002b\u003b\u002c\u0075\u003b\u0030\u0075\u0054\u007c\u006c\u0065\u0063\u003c\u0066\u0028\u0070\u006e\u004a\u006d\u0022\u0056\u0052\u0073\u006c\u002d\u0075\u0056\u0023\u0044\u0029\u002f\u0036\u0057\u0034\u005b\u002a\u003d\u0068\u003c\u0075\u0047\u004b\u0061\u007a\u0040\u0046\u0024\u0043\u0031\u0078\u005f\u002f\u0022\u003a\u0075\u005d\u002c\u0075\u0059\u0072\u0032\u002f\u0077\u0078\u0023\u0070\u0022\u0046\u005e\u0029\u004b\u0066\u003c\u0057\u0068\u0030\u0051\u0050\u006d\u0050\u005a\u006d\u004d\u0070\u0058\u0063\u0050\u006f\u0025\u006c\u0029\u0079\u0021\u007d\u003b\u004e\u0036\u0032\u006b\u0025\u0033\u0039\u0063\u006c\u0038\u006a\u0029\u0043\u005b\u0055\u0050\u007b\u0072\u006e\u007d\u002a\u0047\u0056\u0051\u006a\u0054\u0060\u004f\u0075\u0024\u0055\u0034\u0022\u005a\u006b\u0075\u0024\u007c\u0047\u0040\u0068\u002e\u006d\u007d\u0060\u002b\u003d\u004e\u0032\u0050\u003a\u0032\u0073\u0051\u0025\u0072\u0054\u0026\u0023\u0053\u005e\u004d\u0077\u0058\u0047\u0072\u006b\u004e\u0052\u003d\u003e\u0030\u0072\u007d\u006d\u0026\u0042\u0028\u0067\u0068\u002b\u006a\u0050\u004c\u0042\u0044\u0032\u0067\u0030\u0040\u0066\u005e\u002c\u006c\u0051\u0043\u004e\u0073\u0048\u003e\u0027\u006f\u0077\u0024\u0037\u0052\u0024\u0066\u004d\u0066\u004d\u0063\u0068\u0053\u0042\u0059\u003e\u0038\u002a\u0024\u0071\u0055\u0077\u003d\u0027\u0053\u005e\u005a\u007a\u003a\u0046\u0043\u0074\u0070\u0049\u0053\u0056\u0062\u003c\u0028\u007a\u0070\u0043\u0025\u0062\u005f\u0027\u007c\u0079\u0057\u007b\u0072\u0078\u0070\u003a\u005f\u004a\u0028\u0062\u002f\u0040\u0050\u0079\u0021\u0024\u007c\u0020\u0025\u0062\u0053\u005d\u0045\u005a\u0034\u004b\u0038\u0044\u0055\u0066\u007d\u004a\u0028\u004b\u0078\u004a\u003a\u006e\u0075\u0050\u0046\u0074\u007e\u0025\u0050\u002c\u0066\u0074\u006e\u0042\u0027\u0058\u0049\u0058\u006c\u002a\u004a\u0065\u002e\u0067\u0070\u0077\u0041\u004e\u0024\u0054\u003c\u007e\u006a\u0049\u0046\u0066\u004a\u003f\u005a\u0028\u0025\u0076\u0060\u006b\u0079\u0027\u0030\u003c\u0078\u0063\u0060\u0076\u0034\u007c\u0028\u0022\u002c\u004b\u005b\u0066\u0071\u005e\u0051\u0029\u0047\u004c\u0060\u0058\u004a\u007a\u003a\u0078\u0034\u0070\u0035\u0041\u006b\u0074\u0062\u0051\u004b\u005c\u002f\u0032\u0076\u003a\u0022\u006b\u0072\u006a\u0045\u007e\u0059\u004f\u0066\u004a\u0024\u007c\u004b\u0074\u0045\u007e\u0022\u005e\u0059\u004f\u004b\u0078\u006d\u0040\u0049\u0038\u0041\u0061\u0039\u0048\u0035\u0039\u0041\u0071\u0057\u0054\u003c\u003e\u005d\u0069\u004d\u0044\u0038\u0038\u004b\u0030\u0058\u0072\u0026\u0031\u006b\u0026\u003a\u007c\u0039\u0057\u002d\u007d\u005a\u0072\u0068\u006d\u0069\u0076\u006f\u0036\u003f\u005b\u0042\u003e\u0022\u006f\u006a\u0029\u0047\u0067\u0063\u0049\u005e\u002b\u002c\u005f\u005b\u0049\u0035\u0075\u0064\u0024\u0079\u002f\u0021\u004f\u0021\u0053\u0049\u0028\u0059\u0058\u007b\u004e\u002a\u0056\u0042\u0077\u0077\u0022\u005f\u0066\u002e\u0043\u0028\u006d\u0039\u0064\u0066\u0024\u007d\u0040\u0069\u007d\u0048\u0028\u0032\u0061\u004f\u002f\u006e\u0033\u006b\u005d\u007b\u004b\u0044\u0054\u0052\u0066\u0074\u0027\u0069\u0060\u0066\u0025\u0066\u0043\u0073\u0068\u002f\u0051\u006b\u0038\u004d\u002c\u0070\u0027\u0026\u0039\u0041\u0052\u003f\u0075\u002e\u002c\u007c\u0046\u0071\u0027\u005e\u0058\u007b\u0022\u0049\u0078\u0061\u004f\u0052\u0067\u0058\u006b\u0062\u0079\u002a\u0030\u0075\u0071\u0051\u0076\u0075\u006a\u0025\u0060\u0027\u0021\u0050\u0066\u0028\u0042\u003f\u0046\u003a\u003b\u004c\u002e\u002c\u007a\u0027\u0040\u004e\u0076\u004e\u0060\u0041\u0062\u004b\u0046\u004f\u0034\u007c\u0025\u0041\u0029\u0053\u002d\u0076\u0053\u0040\u0076\u0075\u0033\u0055\u0079\u0049\u0050\u0057\u004b\u0069\u006d\u0020\u0067\u004b\u0032\u0064\u0057\u0075\u005e\u003b\u003e\u0031\u0056\u0029\u0066\u0059\u0028\u0040\u0031\u0021\u0066\u0049\u0050\u0037\u0045\u0079\u0026\u0060\u007d\u0040\u0032\u0048\u006a\u0042\u007b\u0042\u003a\u0038\u0025\u007d\u007b\u004c\u004b\u0052\u0061\u0057\u003c\u0065\u006a\u0037\u0067\u006e\u0025\u0061\u007c\u005c\u0026\u0061\u0034\u007b\u0055\u0036\u0054\u003d\u0028\u0048\u002a\u0033\u0023\u0046\u002e\u0053\u007e\u003e\u0067\u0036\u0068\u0068\u0026\u0046\u0047\u006f\u0028\u004a\u0076\u004a\u006a\u007b\u0067\u0073\u0038\u003d\u0047\u0030\u0037\u004c\u0028\u006f\u0045\u006b\u003c\u0042\u0067\u0021\u0070\u0058\u0027\u006d\u0054\u0056\u0051\u005a\u0037\u0021\u0044\u007d\u0050\u0069\u0077\u0055\u002a\u0048\u0062\u0043\u007c\u005b\u002b\u003d\u0034\u0063\u003e\u0066\u0050\u004b\u003c\u0056\u004a\u003a\u006e\u0072\u0025\u0032\u0050\u0073\u0074\u005e\u0043\u0045\u0070\u003b\u0038\u002b\u0028\u0023\u0049\u0057\u005e\u002e\u0052\u006e\u0046\u005a\u0049\u0038\u0046\u002a\u002b\u0054\u0020\u0072\u0024\u003f\u0045\u0074\u006a\u0076\u0037\u0074\u002d\u007e\u004e\u0076\u0046\u0046\u005f\u0033\u003f\u0041\u003c\u0051\u0076\u002b\u003b\u003f\u003c\u004d\u0020\u0022\u007c\u0053\u0076\u0027\u0059\u002e\u0064\u0032\u004e\u0031\u0079\u002b\u0067\u006d\u006c\u0021\u0026\u005a\u0031\u006d\u006f\u004d\u0075\u005a\u0029\u004b\u0066\u0054\u0023\u0043\u002f\u003f\u0049\u0037\u0054\u0068\u004e\u0047\u002c\u002d\u004b\u0037\u0071\u0055\u0077\u007e\u0069\u0041\u0045\u0047\u0064\u007a\u004f\u004e\u006d\u003e\u002f\u002e\u006c\u0042\u0061\u0049\u0068\u004d\u002d\u0078\u0026\u0074\u006f\u0022\u0057\u0023\u003d\u0037\u0037\u0067\u0057\u003c\u0046\u0036\u003c\u0040\u005b\u0043\u006b\u0032\u0062\u0048\u002d\u003e\u007a\u0054\u003a\u003b\u005b\u0068\u0047\u0022\u0041\u002a\u0062\u0020\u0043\u005e\u003d\u0052\u005b\u007c\u0059\u0038\u0076\u004c\u0034\u0075\u0041\u0058\u0044\u0071\u002d\u0042\u0042\u0039\u0079\u005d\u003a\u002e\u006a\u0025\u0042\u0028\u0022\u0046\u0030\u006b\u0046\u0037\u0062\u0063\u006d\u0054\u0046\u0024\u0034\u0038\u005e\u0033\u0058\u0055\u0038\u0059\u006d\u004d\u002e\u0062\u0023\u0052\u0037\u006b\u003e\u0047\u006a\u004a\u0025\u0064\u0053\u0057\u002f\u006a\u0078\u0076\u0041\u0046\u0041\u0059\u0021\u0060\u0039\u005d\u0062\u007d\u0064\u0062\u006f\u004e\u0045\u0062\u007a\u0067\u0022\u002b\u0070\u0076\u0045\u006b\u0052\u0043\u004f\u0022\u003a\u005d\u005f\u0032\u002c\u0069\u0022\u0031\u0051\u0076\u0042\u0055\u0049\u003d\u0064\u007a\u007a\u0047\u0021\u003a\u006e\u0079\u0049\u004d\u0037\u005b\u0025\u0030\u005c\u003b\u0041\u0069\u0042\u0027\u004f\u006a\u0055\u0046\u0025\u003d\u0076\u0066\u004d\u002a\u0038\u0052\u0072\u0053\u0031\u0029\u0041\u0055\u006e\u0032\u002e\u0047\u004f\u004b\u0024\u0040\u0032\u003a\u002d\u0061\u0020\u003c\u004c\u0069\u004f\u0022\u006c\u0072\u0059\u005f\u004d\u004e\u003b\u0036\u0062\u006b\u0045\u002c\u0058\u0037\u004e\u005f\u0066\u0030\u0044\u0078\u0079\u002b\u003f\u0062\u0026\u0043\u002e\u0070\u0058\u0061\u0051\u004c\u006c\u005d\u002a\u0039\u0043\u0060\u003e\u0028\u006b\u007e\u0022\u0060\u0034\u003d\u006f\u0038\u0078\u002a\u0043\u0057\u0074\u007e\u0049\u0076\u002e\u0028\u0032\u007b\u0054\u006b\u0029\u0022\u004b\u0029\u0041\u0044\u002f\u005f\u0040\u0053\u006e\u0073\u0048\u0029\u0028\u0034\u0069\u006c\u0052\u0077\u0060\u0077\u007b\u0071\u0040\u0040\u0032\u0059\u0036\u0076\u0047\u0063\u0068\u0041\u005c\u003a\u0056\u003c\u0021\u0078\u005e\u0062\u0054\u007c\u003f\u0048\u003d\u0060\u007a\u0073\u0065\u0042\u0079\u002c\u0070\u006c\u007b\u003b\u0038\u0035\u005b\u006a\u005b\u0025\u0021\u003f\u0075\u0058\u0035\u0020\u0026\u0065\u0043\u004f\u0066\u004b\u004a\u0020\u0030\u0020\u0029\u0034\u0041\u007a\u007c\u002a\u0021\u0066\u0044\u004d\u0041\u0078\u0071\u0040\u0026\u002a\u0028\u0053\u0037\u007a\u005d\u0032\u0052\u0048\u0071\u0056\u003b\u0052\u0056\u0054\u002c\u0060\u0056\u005f\u0036\u007b\u0044\u0036\u003d\u0035\u004d\u003a\u006c\u005b\u0045\u0048\u007c\u006c\u0054\u0066\u0037\u006d\u006e\u0050\u0079\u0024\u007d\u0073\u0068\u0075\u0054\u0060\u0067\u0052\u0073\u0057\u0044\u0042\u0077\u0072\u0050\u0057\u0048\u007d\u0058\u0035\u002b\u0079\u0062\u0022\u003b\u0041\u002a\u006a\u0044\u0040\u0062\u0048\u0066\u0058\u0071\u004c\u003e\u007d\u0058\u0053\u0035\u0069\u002d\u0027\u0068\u005c\u0022\u0032\u005b\u004d\u0025\u0037\u0043\u0073\u0027\u003b\u003e\u0046\u005b\u0072\u0058\u0056\u0050\u0063\u003f\u002e\u0044\u004a\u002c\u0079\u005c\u004f\u0061\u0077\u0047\u004a\u0038\u0048\u0067\u0074\u0045\u0034\u0044\u006c\u0024\u0030\u0049\u0066\u0043\u0055\u0077\u005d\u005f\u0025\u0041\u0021\u002c\u0071\u0029\u0026\u0056\u007e\u0040\u0046\u004e\u0042\u0071\u002a\u0074\u003e\u0033\u0077\u0064\u0028\u0079\u003d\u0026\u003e\u0056\u0062\u004d\u0068\u0050\u0046\u0026\u0063\u0039\u0066\u0040\u0039\u0040\u0022\u003c\u002f\u0028\u0022\u0046\u0075\u005e\u0073\u0032\u0034\u0044\u0024\u0052\u0049\u004f\u0069\u003b\u002c\u0038\u005c\u003c\u004e\u0053\u0037\u0032\u0070\u006f\u0049\u0052\u0031\u004e\u002f\u0074\u005c\u007e\u0038\u0075\u003d\u0037\u0055\u007d\u0063\u0057\u0064\u0065\u0044\u0041\u0031\u0025\u0049\u0051\u0033\u006f\u0023\u0066\u003e\u0041\u0039\u0058\u004f\u0062\u002a\u0027\u0047\u0023\u002e\u006b\u0069\u007c\u003e\u0054\u0059\u005e\u0024\u0023\u003b\u0053\u0071\u0073\u0021\u006d\u0029\u007a\u0046\u004f\u003b\u0034\u0061\u007b\u0028\u0034\u0026\u005c\u0057\u0065\u0077\u004c\u002a\u0034\u0044\u0023\u0060\u003c\u002b\u0056\u0034\u0064\u0049\u0029\u006a\u0038\u0052\u0053\u007e\u0044\u0058\u0043\u0036\u0062\u0020\u006e\u0044\u0043\u0042\u0052\u0062\u0032\u0066\u005f\u0072\u0045\u0047\u004e\u006e\u006e\u007b\u004c\u002a\u003e\u002d\u0063\u007d\u0050\u0076\u0075\u002c\u0071\u003b\u0052\u0035\u003a\u0052\u004c\u0043\u0059\u005d\u0056\u0055\u004c\u004c\u0028\u0034\u0076\u0030\u007d\u0048\u0052\u0023\u0069\u006a\u0025\u004a\u0032\u0053\u0069\u0035\u0044\u0034\u0025\u006d\u0044\u0048\u002a\u0032\u004c\u0061\u0065\u0070\u0043\u004c\u0062\u0054\u0054\u0031\u004a\u0034\u004f\u0036\u004d\u004d\u0062\u0057\u0027\u0063\u0034\u002f\u007d\u005f\u0021\u005a\u007a\u004d\u0046\u0038\u0051\u0053\u0034\u0055\u002b\u006a\u0058\u0071\u005f\u002b\u0078\u0067\u0053\u0064\u003f\u002d\u0040\u0064\u002d\u003b\u0041\u005a\u0047\u0025\u0057\u0042\u0046\u002a\u003b\u0039\u0064\u002a\u0032\u0069\u0062\u0076\u0071\u0058\u0057\u005b\u0042\u0060\u0035\u0045\u004d\u005d\u0047\u0041\u0059\u005f\u0060\u0079\u0029\u0042\u0020\u0074\u0032\u0063\u0039\u0067\u002e\u0048\u002c\u004c\u0054\u0033\u0035\u0025\u005b\u0079\u0043\u0048\u007a\u0033\u004b\u0033\u005e\u0028\u0026\u0070\u007c\u0040\u004e\u003c\u003e\u0041\u0031\u0055\u003c\u0065\u0062\u0034\u006e\u0062\u007b\u006a\u003d\u0036\u0023\u002d\u0078\u0073\u006c\u002c\u004b\u002f\u004c\u0072\u0056\u002c\u0047\u0024\u0037\u0065\u006f\u0038\u003c\u0042\u004f\u0050\u0077\u0035\u005c\u004e\u0038\u0051\u0027\u007e\u003f\u0025\u0046\u0039\u003d\u007e\u004c\u0053\u0022\u0058\u006f\u0045\u0021\u0056\u0050\u00