062\u0051\u0056\u0056\u002a\u006c\u0072\u0035\u0029\u006a\u002b\u0038\u0067\u0076\u003b\u005b\u0023\u004f\u007c\u0024\u0043\u0042\u0049\u0021\u003d\u002b\u0035\u005b\u007e\u0025\u0048\u006a\u0071\u0056\u0066\u0037\u0078\u005f\u0077\u0037\u0051\u005d\u0050\u0038\u004f\u0026\u0044\u0057\u0031\u0068\u0030\u002e\u0045\u0021\u007b\u0076\u005e\u0050\u0079\u0050\u007b\u0050\u0070\u0052\u0034\u004c\u006b\u003d\u0047\u0024\u007e\u0046\u004a\u002b\u0065\u0043\u0070\u0075\u006c\u002a\u0022\u0063\u005a\u0077\u0039\u0021\u0057\u0045\u006c\u0061\u0049\u0058\u0029\u0023\u005e\u0023\u0055\u006e\u002a\u003c\u007e\u0021\u0057\u0024\u0050\u004c\u002f\u0041\u0073\u0062\u002c\u004a\u0069\u002f\u006a\u005e\u003a\u0037\u0048\u004a\u0044\u006a\u0029\u0063\u0066\u0045\u0026\u006c\u0030\u0051\u0074\u0034\u0021\u0062\u0045\u006c\u0024\u0078\u0070\u0037\u0048\u0070\u0023\u0055\u0061\u006b\u0057\u0059\u006a\u0039\u0050\u006a\u005d\u0038\u0038\u004f\u0036\u003a\u003f\u0050\u004e\u0051\u003b\u0034\u003d\u002b\u0035\u005b\u0068\u0025\u0034\u0026\u0030\u0069\u006f\u0031\u005a\u0030\u0048\u0041\u002b\u002b\u005d\u0052\u004c\u004a\u0064\u003b\u0046\u0060\u0044\u003e\u0079\u0057\u002b\u005e\u002e\u0067\u002e\u0043\u0061\u002f\u0060\u006a\u0042\u004a\u0036\u0059\u004b\u0047\u0032\u005e\u002b\u002f\u0051\u006a\u007b\u0065\u0022\u0047\u0058\u0034\u0064\u0042\u0074\u0031\u006f\u0031\u0030\u0073\u0039\u0047\u0063\u0057\u0076\u005e\u004b\u0038\u005a\u006a\u005b\u0055\u0076\u0066\u0074\u006f\u005b\u0066\u0026\u0029\u0075\u0033\u0029\u0064\u0049\u0067\u0048\u0024\u004e\u0076\u0075\u0054\u0040\u0076\u005e\u004c\u0025\u0048\u006a\u006e\u006a\u003d\u0073\u0061\u0044\u0059\u005b\u003b\u006a\u0076\u0046\u002f\u0058\u0038\u004e\u0021\u0028\u0050\u0079\u0074\u0066\u0073\u0068\u0076\u0025\u0043\u002e\u0043\u0053\u002a\u0029\u006a\u0046\u0056\u0062\u0047\u005f\u007e\u0049\u0064\u007e\u0025\u0048\u006a\u007e\u004e\u0047\u0066\u007c\u0024\u0024\u0051\u006f\u006b\u0052\u006a\u0049\u0062\u0035\u0043\u0062\u003c\u002e\u0051\u0048\u006a\u0060\u005d\u0059\u0047\u0070\u0052\u0078\u0037\u003d\u002f\u0050\u006a\u0056\u0049\u0066\u003c\u004a\u0065\u0065\u0052\u006a\u0040\u0071\u0052\u0069\u0039\u0033\u0062\u006f\u006c\u0024\u0078\u0045\u006a\u005f\u007c\u0072\u003e\u004c\u007c\u0024\u0072\u005e\u007a\u004a\u0052\u006a\u0072\u003c\u0061\u005b\u0061\u0073\u0035\u005b\u003c\u0036\u0034\u003d\u0079\u006f\u0065\u0064\u0069\u0030\u0072\u0041\u0044\u0036\u0076\u007c\u0021\u0072\u0035\u003e\u003d\u003c\u0056\u006d\u002e\u0061\u004f\u003c\u002e\u0051\u0048\u0037\u005d\u0043\u0050\u0079\u006f\u004c\u004d\u007e\u006d\u006e\u0067\u0075\u0057\u005b\u006a\u005a\u0035\u003a\u0043\u0048\u0070\u0074\u0075\u0039\u0063\u0026\u0029\u004b\u0047\u002a\u004a\u0076\u0038\u006d\u005e\u0065\u0055\u004c\u004d\u0041\u005a\u003a\u007e\u006d\u004e\u0076\u0051\u005e\u0036\u0024\u0024\u0061\u0023\u0023\u003d\u0046\u0066\u004f\u0046\u0065\u003f\u0071\u0059\u004d\u006e\u006c\u007b\u0048\u006c\u0076\u002c\u0077\u006f\u002f\u0055\u0060\u0066\u003b\u0043\u0073\u0044\u0063\u005f\u007e\u0048\u003a\u005e\u004f\u0022\u0062\u0071\u0030\u0044\u0051\u0072\u005a\u0053\u0023\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u005a\u0048\u003f\u0050\u0024\u0036\u005f\u0061\u0070\u0044\u004c\u0024\u0040\u0051\u0077\u0064\u0048\u006a\u0059\u0036\u0063\u0061\u0024\u0036\u0021\u0028\u002a\u0067\u006a\u0040\u0062\u0057\u0065\u0064\u003e\u0049\u0066\u003b\u0065\u0039\u0037\u0054\u0036\u006c\u0070\u0054\u0072\u004f\u0024\u006d\u0048\u003a\u005e\u0062\u006b\u0076\u0025\u007b\u0048\u006c\u0076\u002c\u0077\u0076\u0024\u0077\u0058\u002a\u0036\u006a\u0024\u002f\u0068\u0069\u0065\u003b\u006a\u0037\u0038\u0065\u005e\u0033\u0035\u003d\u0039\u0032\u0062\u0070\u0021\u0073\u0079\u0074\u005d\u004f\u0035\u0066\u007b\u0065\u0022\u0047\u006a\u0060\u0034\u003d\u0064\u0037\u0074\u0075\u002c\u0057\u0031\u0067\u0061\u0026\u0078\u005d\u0021\u0026\u006c\u0025\u0079\u004a\u003b\u004d\u0055\u002b\u0076\u0040\u006d\u0033\u0023\u0061\u0046\u0033\u0062\u006f\u006c\u005f\u005f\u0034\u003d\u0079\u006f\u0047\u0050\u0025\u006d\u0035\u0062\u0072\u0062\u0075\u0033\u0068\u007d\u003d\u005d\u0040\u0024\u0041\u003c\u007d\u0045\u006f\u0074\u003c\u002e\u0051\u0048\u002b\u0077\u0023\u0061\u004d\u0071\u003a\u0055\u005b\u0063\u004d\u0068\u0048\u0026\u006c\u0028\u0050\u004e\u006a\u0070\u0028\u004e\u007d\u0046\u006d\u0062\u0051\u007e\u0025\u0048\u006a\u0051\u0036\u0079\u0042\u0031\u0023\u0036\u007e\u002b\u002b\u0075\u006c\u0054\u004f\u0049\u0050\u003f\u0071\u0022\u0031\u0069\u003a\u0069\u003b\u0046\u0061\u003a\u004a\u003f\u0062\u003c\u002e\u0051\u0048\u0037\u005d\u0043\u0050\u0079\u006f\u004c\u004d\u007e\u006d\u0055\u007d\u0073\u0060\u004b\u0039\u0058\u0030\u007c\u0037\u0051\u006b\u0079\u0032\u0046\u0063\u006f\u0073\u0033\u004a\u0067\u0061\u003c\u0024\u0048\u0028\u002b\u0065\u0048\u006a\u0056\u003e\u003b\u005f\u005f\u0052\u0076\u0037\u0073\u0037\u0051\u005d\u0050\u0038\u004f\u0055\u003a\u0060\u005f\u0030\u0069\u0073\u006d\u006e\u0069\u0024\u0046\u0021\u0021\u0038\u004c\u0065\u006a\u0042\u005b\u0056\u0054\u0023\u005a\u0073\u004c\u0024\u007b\u0021\u0061\u002f\u006f\u0074\u0044\u0071\u0073\u003a\u003b\u0069\u0073\u0042\u0028\u0040\u005b\u006f\u0074\u005a\u007e\u0035\u002f\u0043\u0045\u0050\u006a\u0058\u0079\u0058\u007c\u0031\u003a\u0030\u0048\u0058\u0054\u004c\u006f\u004e\u003a\u0048\u0047\u003a\u005e\u0052\u0025\u0053\u0072\u0049\u0066\u003b\u0065\u0039\u0037\u0054\u0036\u0044\u003e\u0024\u005d\u0076\u006a\u006d\u0046\u0045\u0022\u0032\u0045\u0057\u0075\u006c\u0051\u002a\u005a\u006a\u0052\u007c\u007b\u0065\u0022\u0047\u0051\u0056\u0034\u003d\u0079\u006f\u0047\u0050\u0025\u006d\u0026\u0067\u003d\u0073\u004f\u006c\u0024\u0078\u0023\u0061\u0029\u0055\u0026\u006b\u0034\u0072\u0067\u0047\u0063\u0057\u003e\u0028\u0062\u0036\u0059\u0037\u002b\u005e\u0055\u0022\u0072\u002f\u004e\u003b\u0030\u007c\u0024\u0076\u0073\u0079\u0074\u003c\u002e\u0051\u0048\u002b\u0077\u0023\u0061\u0031\u0055\u002b\u0076\u0040\u006d\u0030\u007e\u0076\u0021\u0076\u005e\u005d\u0035\u0032\u0046\u007e\u0037\u007b\u0078\u0029\u003a\u0048\u0045\u0060\u005a\u0057\u0061\u0044\u0078\u006b\u005a\u006a\u0059\u0053\u0073\u004f\u006c\u002f\u0073\u0067\u0054\u0044\u004a\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u004f\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u006f\u0021\u0063\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0077\u004b\u0046\u0075\u0079\u007c\u0044\u004c\u0023\u007a\u0026\u0076\u002a\u004b\u0036\u0024\u003e\u003a\u0045\u0052\u006e\u0069\u0053\u0068\u007d\u0077\u0055\u0024\u0035\u0034\u0076\u0052\u007a\u0035\u0036\u0053\u0068\u0045\u0074\u003c\u004e\u0049\u002e\u004f\u006b\u0024\u0069\u0075\u0079\u007c\u0051\u003b\u006d\u0046\u0021\u0039\u0051\u0036\u0036\u0044\u0056\u005e\u0021\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0045\u0031\u0050\u002a\u0021\u0062\u002e\u0074\u0023\u0031\u005b\u0045\u006a\u007e\u0048\u0046\u004a\u006b\u0079\u0034\u0026\u0047\u0070\u0062\u004b\u006b\u0032\u0057\u0059\u004c\u0024\u0036\u0021\u0028\u002a\u0062\u0043\u0077\u004d\u004b\u0066\u003b\u003f\u002f\u0063\u002a\u006e\u0051\u0048\u0024\u004d\u0051\u0059\u004f\u0050\u0046\u0074\u0071\u003a\u005d\u0072\u006b\u003b\u0062\u0057\u003c\u0066\u0060\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u005e\u0032\u0055\u0068\u0061\u0026\u0058\u0070\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u0041\u0065\u005d\u0029\u0059\u0036\u0069\u0072\u004e\u004a\u0068\u0037\u0065\u0055\u002b\u0050\u0065\u006d\u003d\u0065\u0030\u0028\u002b\u0054\u003a\u0034\u002b\u005a\u0063\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u004f\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0039\u0047\u0056\u005b\u0070\u0026\u0043\u0064\u0036\u005f\u0058\u0034\u0043\u0071\u0046\u003b\u0048\u006e\u0044\u0046\u0061\u0030\u0075\u0049\u0047\u0063\u0076\u0023\u0068\u0066\u0056\u0031\u0033\u0022\u0068\u0028\u0021\u0022\u0068\u0021\u0061\u0045\u0031\u0050\u002a\u0021\u0062\u0057\u003c\u0066\u0060\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u003f\u007b\u005b\u0043\u003a\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0054\u0053\u002a\u0079\u0029\u0068\u0071\u0052\u0051\u003b\u006d\u0046\u0021\u0039\u007c\u0078\u0065\u005e\u0050\u0041\u004e\u006a\u006e\u0021\u0076\u0066\u0035\u0034\u0067\u0056\u003e\u0069\u006c\u0069\u0070\u002a\u0075\u0075\u006b\u0070\u0077\u0036\u0045\u006d\u0032\u0037\u0044\u0024\u0031\u007a\u007b\u0070\u0022\u002e\u003b\u0026\u0044\u0063\u0073\u006c\u0042\u0028\u0021\u0038\u0042\u0026\u004a\u0070\u007e\u0069\u0074\u006c\u0031\u0033\u002a\u0062\u006c\u0071\u002b\u0035\u005b\u0068\u0025\u0034\u0026\u0046\u0038\u0062\u0057\u003c\u006d\u005b\u002e\u0078\u0051\u006a\u0069\u0042\u0036\u002a\u0032\u0068\u0073\u006b\u006c\u0051\u002a\u0049\u0024\u003a\u004f\u005f\u0034\u0043\u002b\u002a\u004a\u0041\u0046\u005f\u0058\u0034\u0043\u0071\u0046\u003b\u0048\u007d\u004b\u0062\u0076\u0070\u004f\u003f\u0045\u0053\u0073\u004f\u006c\u004f\u0045\u004d\u007a\u007b\u0070\u0051\u0066\u0067\u0067\u002b\u0041\u002b\u002b\u0054\u003a\u0061\u002e\u0021\u0067\u003b\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u0066\u0067\u0038\u0045\u003d\u0040\u004a\u005b\u002f\u0079\u0074\u0051\u002c\u007e\u0036\u0069\u0072\u0036\u0023\u0031\u0033\u0060\u0051\u007a\u004a\u0045\u003d\u0079\u0037\u0043\u0024\u0029\u0072\u0046\u007e\u0071\u0033\u0041\u0049\u002b\u005f\u005d\u0079\u003c\u0073\u0077\u0076\u004b\u0046\u0075\u0075\u0032\u002c\u0029\u0074\u0072\u004a\u005b\u004f\u0065\u0033\u004f\u0062\u004a\u007d\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0021\u0062\u0057\u003c\u0054\u003a\u007c\u007a\u0071\u0063\u0075\u0033\u007b\u002a\u0064\u007e\u007e\u0023\u005a\u004b\u0025\u0079\u002f\u0048\u004b\u006f\u0069\u0035\u0024\u004f\u007b\u005e\u002c\u005f\u0058\u0034\u0043\u0071\u0046\u003b\u0048\u007d\u004b\u0062\u0076\u0070\u004f\u003f\u0045\u0053\u0073\u0062\u0043\u003f\u0023\u002f\u004c\u0024\u0044\u003a\u004e\u0049\u002e\u004f\u0073\u003a\u0076\u0072\u0038\u0072\u0077\u0039\u003e\u0074\u0079\u0048\u005b\u0073\u004a\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u006b\u0024\u0069\u0075\u0066\u0067\u0038\u0045\u003d\u0040\u004a\u005b\u002f\u0079\u006b\u0035\u0053\u005e\u0035\u002c\u0032\u007b\u0047\u0041\u007c\u0024\u0071\u0068\u0024\u006b\u0060\u006a\u0057\u005e\u004a\u0048\u0049\u006b\u0026\u0029\u005a\u0057\u004a\u0043\u004e\u0058\u0057\u0048\u003c\u006f\u004a\u0072\u006e\u002b\u0053\u0059\u0054\u0040\u002e\u0043\u0071\u0046\u0074\u0023\u0048\u006d\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u0032\u002f\u004f\u0065\u0077\u0078\u006f\u0060\u004d\u0064\u0069\u0030\u0072\u0041\u0049\u0066\u0060\u0051\u007a\u004a\u0045\u003d\u0079\u0037\u0078\u0065\u007e\u0065\u005d\u0029\u006f\u0033\u0074\u0059\u0053\u0022\u0071\u005f\u0058\u0040\u005e\u0049\u005f\u003c\u006f\u0042\u006f\u0035\u0031\u0029\u0030\u007a\u004c\u0079\u007b\u0078\u004e\u003c\u002e\u0051\u0048\u002b\u0077\u0023\u0061\u0031\u0055\u0075\u005f\u0061\u0063\u0057\u0051\u007c\u0059\u004f\u0038\u0042\u003c\u0067\u003b\u005e\u0046\u0036\u007b\u0024\u0040\u0051\u0054\u0035\u0060\u006a\u006a\u0032\u0052\u004f\u0025\u0029\u0068\u0069\u0026\u002b\u004e\u005b\u0066\u0035\u0077\u0061\u003c\u003d\u003c\u007a\u0026\u0032\u0029\u005b\u006a\u0061\u002f\u0062\u007c\u0046\u0037\u004d\u0024\u0026\u006d\u0049\u006d\u004e\u003b\u005b\u0043\u0038\u0058\u006a\u0048\u0042\u0040\u0051\u005f\u0028\u0068\u0048\u0028\u004a\u0033\u0032\u0063\u006a\u006f\u0046\u0039\u0021\u0046\u004a\u0052\u002a\u007c\u0024\u0053\u0043\u002b\u0076\u003f\u0032\u0033\u0059\u007c\u002b\u003a\u0044\u0057\u0058\u002f\u0026\u006e\u0044\u0062\u0043\u0031\u0068\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u007d\u0077\u0030\u003b\u006a\u003a\u0054\u0045\u0072\u0048\u0076\u005e\u006b\u0079\u0075\u003d\u007e\u0037\u0074\u005d\u0073\u002b\u0067\u0047\u002e\u004d\u0037\u0051\u0059\u004f\u0024\u0024\u0021\u003a\u0071\u0052\u007b\u0065\u0022\u0047\u005f\u005f\u005b\u0058\u0043\u0052\u0044\u0058\u004d\u0076\u003b\u002e\u0041\u0031\u0054\u003f\u003a\u004c\u0043\u0069\u003d\u002c\u0037\u0049\u0063\u005e\u0037\u0039\u0063\u0040\u003c\u0028\u004e\u0078\u0061\u005d\u0065\u0055\u004c\u004d\u0063\u0024\u0079\u0056\u0022\u0040\u005f\u006a\u006b\u0078\u0042\u0026\u0050\u0070\u0028\u0068\u0068\u0030\u0021\u004d\u004a\u002b\u002b\u006d\u005b\u0033\u0032\u0063\u006a\u0039\u0045\u0073\u0051\u0022\u004f\u0039\u0021\u0046\u004a\u0052\u002a\u007c\u0024\u0057\u005e\u0021\u003b\u0075\u0032\u0033\u0059\u007c\u002b\u003a\u0044\u0057\u0058\u002f\u0026\u006e\u0044\u0051\u0076\u0061\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u007d\u0077\u0030\u003b\u006a\u003a\u005a\u0029\u004c\u0051\u003b\u0043\u0025\u0079\u0050\u0059\u0041\u006f\u004f\u0064\u0062\u006a\u0077\u003b\u004c\u0072\u0045\u003d\u0028\u0030\u002e\u0066\u0039\u003c\u005e\u007c\u005a\u0062\u0051\u0032\u0078\u004e\u006a\u0049\u0050\u0070\u0078\u005b\u007d\u0050\u0039\u0058\u005f\u0059\u006e\u004d\u003a\u0044\u0058\u002b\u0068\u0056\u002e\u0079\u0078\u0077\u0047\u0021\u005e\u004e\u002e\u004a\u004f\u007c\u0036\u005b\u0058\u0067\u0028\u0044\u0058\u0041\u007a\u005a\u0047\u006c\u0024\u0060\u0035\u0043\u007c\u0076\u0042\u0062\u006f\u006c\u002b\u002f\u002a\u0046\u0075\u0071\u0034\u003b\u005e\u0041\u0069\u0023\u0023\u005b\u007d\u007d\u0040\u002c\u0079\u0052\u0045\u0023\u0047\u0065\u0075\u007c\u003f\u0074\u0047\u0040\u0045\u003c\u005a\u005a\u0041\u0024\u0069\u0076\u0029\u0021\u0052\u0056\u0034\u002e\u0074\u0077\u0071\u0061\u0057\u0076\u0051\u0042\u004a\u006f\u0074\u005e\u003c\u0058\u0062\u0065\u0062\u0026\u006c\u003d\u002a\u0073\u006a\u0051\u0049\u0026\u0024\u0048\u0028\u0045\u004f\u003b\u006a\u0056\u0054\u005e\u002b\u0021\u0058\u0021\u005a\u0033\u004d\u0065\u0050\u0063\u007c\u0024\u0051\u003a\u0035\u0022\u0031\u007b\u0061\u0060\u003a\u0046\u0074\u0051\u0079\u005e\u0030\u005b\u007d\u006e\u0048\u0065\u0079\u0049\u0061\u0042\u004e\u0079\u0034\u003c\u003a\u006e\u007a\u006f\u0041\u0079\u002b\u0070\u005f\u0029\u005f\u003c\u006f\u0050\u0070\u0034\u0049\u0058\u0023\u0048\u0028\u0044\u002f\u005a\u003d\u0051\u0031\u0040\u0072\u0056\u006f\u0055\u005d\u0025\u004a\u005d\u0059\u005b\u004b\u0050\u0026\u0044\u0051\u006e\u0052\u006d\u006d\u003e\u0028\u0077\u005b\u006a\u006f\u003d\u005e\u0072\u0049\u003d\u0039\u0057\u0062\u0051\u0029\u007a\u002a\u0061\u0038\u003f\u004f\u005a\u0031\u005d\u0073\u0062\u003b\u005b\u0056\u0064\u0050\u0059\u0063\u0037\u0056\u0065\u0062\u0026\u006c\u003d\u002a\u0072\u0037\u0046\u007d\u0029\u0079\u0023\u006d\u003c\u002e\u0051\u0048\u0068\u0072\u0055\u0061\u0079\u0037\u006a\u0055\u003b\u004a\u0026\u0072\u003d\u0040\u0049\u0064\u0075\u0035\u0029\u006a\u0048\u002f\u0069\u0047\u007c\u005a\u0046\u004a\u003e\u005b\u0074\u0077\u0023\u006c\u0078\u0073\u0045\u006d\u006d\u003b\u005b\u0028\u002a\u0074\u0036\u0068\u002b\u0076\u005e\u005a\u0072\u0050\u0078\u004a\u003e\u0040\u004f\u004b\u0063\u0048\u0026\u005a\u0026\u006f\u0058\u0049\u0051\u0065\u0078\u007d\u0046\u0070\u0055\u007b\u004d\u0063\u0063\u0070\u0041\u0037\u0024\u0058\u005d\u0024\u0052\u0060\u0040\u0074\u006c\u0069\u0041\u0054\u005d\u002b\u002b\u0039\u0051\u0034\u005b\u0071\u006a\u0064\u0051\u004f\u0066\u0045\u0079\u0028\u0068\u002a\u0075\u006a\u002e\u003f\u0022\u002f\u007e\u004d\u003e\u0028\u002b\u0065\u0051\u006a\u0071\u006d\u004a\u0045\u002a\u0073\u005b\u002e\u0078\u0051\u006a\u006d\u0032\u0034\u0029\u0040\u0073\u005b\u006d\u0078\u0048\u006a\u002f\u0024\u0079\u0041\u0029\u002b\u0032\u0029\u0063\u0028\u0037\u0065\u0074\u006e\u0052\u006b\u006f\u0058\u0049\u0051\u0065\u0078\u0051\u006a\u0057\u0024\u0033\u003d\u0072\u0078\u004e\u002e\u0043\u0030\u002f\u0075\u006a\u002b\u0029\u002f\u006f\u0058\u003c\u0072\u003c\u0036\u0067\u006a\u007d\u0056\u0069\u0058\u002a\u0077\u0068\u002b\u0079\u0028\u0066\u004f\u002b\u0043\u0050\u004d\u0060\u0045\u0035\u0043\u0035\u002c\u0073\u006f\u0058\u0071\u005b\u0040\u0064\u0056\u0042\u004c\u006f\u0079\u0076\u002b\u0060\u0073\u0039\u0026\u0024\u0041\u0046\u002c\u006f\u0058\u0071\u005b\u0040\u0064\u004e\u006a\u0038\u002f\u0028\u004a\u0053\u0038\u0056\u007e\u006b\u006c\u0076\u0038\u0029\u006a\u0047\u0053\u0053\u0071\u0078\u004e\u0063\u0028\u0046\u004a\u0045\u006a\u0055\u0057\u0062\u0051\u005e\u0072\u002b\u0065\u0045\u006a\u007a\u006d\u006f\u0058\u0049\u0051\u0065\u0078\u007d\u0046\u0070\u0055\u005b\u0055\u005d\u0032\u002c\u0029\u0076\u0045\u005b\u004a\u0029\u005f\u0063\u006a\u0064\u004a\u0071\u0046\u002e\u0044\u005e\u0073\u0076\u0030\u0026\u0073\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0078\u0045\u0041\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u006c\u002f\u0035\u0062\u0032\u0029\u0039\u002b\u0079\u0035\u0034\u0023\u0047\u0024\u0078\u003b\u0028\u0031\u0060\u006e\u0079\u007b\u0069\u0040\u0068\u0078\u0074\u0045\u0052\u005f\u007d\u003a\u0079\u0052\u0077\u0043\u0069\u003b\u0077\u0069\u0038\u0057\u0024\u005e\u0038\u0065\u0038\u0070\u0026\u0029\u004f\u0028\u0050\u0068\u0076\u0034\u006f\u0074\u004f\u0037\u002f\u0024\u004c\u0074\u006b\u0076\u0030\u0075\u0073\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u002b\u004f\u006a\u0072\u003a\u0042\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0051\u007a\u0035\u0062\u0044\u0074\u0032\u002c\u0071\u0029\u006f\u004e\u003f\u0024\u0078\u007d\u0064\u004d\u003a\u002a\u005a\u0024\u0031\u006e\u004e\u0032\u0029\u005b\u006a\u0041\u0035\u0067\u006a\u003e\u003f\u0034\u006e\u003c\u0028\u0029\u006f\u004e\u003f\u0024\u0078\u003b\u0028\u004d\u003a\u002a\u005a\u0024\u0041\u0024\u0032\u0029\u005b\u006a\u0026\u002a\u005a\u006a\u006e\u0065\u0062\u0076\u0051\u004e\u0023\u0074\u005b\u007d\u003a\u0061\u0036\u0079\u007a\u0068\u0057\u004e\u003a\u005d\u0062\u0060\u007e\u0047\u0054\u0040\u0053\u0051\u005d\u0035\u0070\u0043\u0057\u004e\u002f\u0060\u0065\u0073\u0057\u0059\u0074\u006d\u007c\u0021\u0023\u0051\u0024\u0024\u003b\u006f\u0076\u006c\u0021\u0068\u0061\u0055\u0039\u002b\u002b\u0022\u0051\u0065\u0078\u0057\u006a\u0038\u007c\u003b\u007d\u0075\u0040\u003d\u0028\u0051\u005f\u0074\u0058\u0054\u0034\u004b\u006c\u0072\u0045\u003e\u0028\u0059\u004f\u0052\u006a\u005a\u0050\u0060\u0061\u002c\u0078\u0042\u0045\u0030\u0045\u0076\u0051\u0024\u006b\u0074\u0064\u0044\u004e\u0052\u0071\u0028\u0065\u0068\u0048\u003d\u0028\u0021\u0064\u0062\u0043\u007e\u0037\u003f\u0043\u006c\u006e\u0058\u0076\u0051\u005d\u0035\u002f\u0034\u0030\u0060\u0030\u005a\u007e\u006d\u0040\u0048\u0078\u0032\u0062\u003d\u0028\u0061\u002f\u0063\u006a\u0043\u004b\u0029\u006b\u0059\u006d\u0036\u0058\u006f\u0074\u0026\u0044\u0058\u006e\u007b\u006c\u004f\u0023\u003d\u003c\u0023\u004d\u0046\u0050\u0063\u0024\u0023\u003a\u0053\u0061\u0068\u002b\u004f\u006c\u0067\u007a\u004a\u0052\u0052\u004d\u004f\u0064\u0062\u006a\u0061\u0035\u0076\u0078\u004c\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u007d\u0077\u0030\u003b\u006a\u003a\u0054\u0045\u0072\u0048\u0076\u005e\u006b\u0079\u0075\u003d\u007e\u0037\u0074\u005d\u0073\u002b\u0067\u0047\u0068\u0048\u0047\u0051\u0077\u005b\u0024\u0024\u0069\u006a\u0068\u0045\u0079\u0074\u007b\u0065\u0022\u0047\u005a\u005a\u0023\u0061\u0049\u0071\u002c\u003c\u003c\u006b\u005d\u0021\u0026\u006c\u0025\u0079\u0067\u006a\u0029\u0067\u0043\u0066\u0045\u003c\u0028\u004e\u0078\u0048\u006a\u004b\u002a\u005e\u0051\u003b\u0043\u0025\u0079\u0074\u007e\u003b\u0042\u0025\u0043\u002e\u0043\u0054\u0035\u0026\u006a\u007c\u003a\u0030\u0073\u0039\u0057\u0051\u007c\u0021\u0064\u0067\u006a\u0046\u0028\u005a\u0072\u0045\u0046\u006d\u0024\u0057\u002e\u005b\u005b\u0029\u0063\u0028\u0045\u004f\u004d\u0061\u005b\u003e\u0021\u0048\u0063\u0079\u0057\u003d\u0028\u005d\u0050\u003d\u003c\u0073\u003e\u0072\u0066\u0038\u0063\u0030\u0039\u007b\u0024\u0036\u0021\u0028\u002a\u0062\u0043\u0077\u004d\u0053\u004d\u0074\u0078\u0053\u0074\u002f\u005e\u006f\u0036\u0076\u0063\u0028\u0061\u002f\u004d\u0050\u006a\u0073\u0030\u003b\u002a\u0063\u0069\u0037\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0059\u0047\u005b\u0024\u0076\u0069\u007e\u007c\u0053\u0028\u0079\u0052\u0033\u0077\u0028\u0076\u0064\u0034\u006d\u0061\u0045\u0062\u0047\u0053\u0061\u0045\u0064\u0052\u0047\u0058\u004e\u0064\u003f\u003d\u0066\