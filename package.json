044\u0063\u0056\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0050\u0022\u0066\u0068\u0069\u005e\u0062\u0025\u004d\u0035\u0038\u0065\u005d\u005e\u005b\u0075\u0030\u007c\u0053\u0052\u0023\u0024\u005e\u004a\u007e\u005e\u007c\u0077\u0040\u0037\u0079\u0035\u0060\u007a\u0043\u005b\u0075\u0031\u007c\u0053\u0052\u0067\u0024\u0076\u003d\u007c\u005e\u0073\u0054\u006e\u0037\u0044\u0055\u005a\u0075\u007d\u0022\u0030\u003d\u0073\u005b\u0075\u0030\u007c\u002f\u0071\u002e\u004d\u0041\u0021\u0021\u0068\u0028\u0053\u0065\u0025\u0032\u002b\u0049\u0044\u0063\u0056\u006e\u0031\u0032\u0042\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0050\u0022\u005b\u0041\u004a\u005b\u0075\u0031\u007c\u0053\u0052\u0067\u0024\u0076\u003d\u007c\u005e\u0073\u0054\u006e\u0037\u0044\u0055\u005a\u0075\u007d\u0022\u003e\u0042\u0030\u0050\u007b\u0030\u0055\u0069\u0069\u0067\u007d\u0030\u0057\u003e\u0041\u0036\u0075\u0077\u004a\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0041\u0021\u0021\u0068\u0028\u0053\u0065\u0025\u0032\u002b\u0049\u0044\u0063\u0056\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0041\u0021\u0054\u007e\u005f\u0065\u0048\u003a\u007d\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0041\u0021\u0021\u0068\u0028\u0053\u0065\u0025\u0032\u002b\u0049\u0044\u0063\u0056\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0050\u0022\u005b\u0039\u004b\u0050\u002e\u005b\u0075\u0031\u007c\u0053\u0052\u0067\u0024\u0076\u003d\u007c\u005e\u0073\u0054\u006e\u0037\u0044\u0055\u005a\u0075\u007d\u0022\u003e\u0042\u0030\u0050\u007b\u0030\u0055\u0069\u0069\u0067\u002e\u004d\u0041\u0021\u0021\u0068\u0028\u0053\u0065\u0025\u0032\u002b\u0049\u0044\u0063\u0056\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0041\u0021\u0021\u0068\u0028\u0053\u0065\u0025\u0032\u002b\u0049\u0044\u0063\u0056\u0064\u005d\u0074\u004f\u002f\u0071\u002e\u004d\u0041\u0021\u0021\u0068\u0028\u0053\u0065\u0025\u0032\u002b\u0049\u0044\u0063\u0056\u0064\u005d\u0074\u004f\u0053\u0052\u002c\u007a\u007e\u0050\u005b\u0075\u0031\u007c\u005