065\u005d\u0029\u0039\u0023\u007b\u004a\u0078\u0036\u006e\u0042\u0023\u004d\u0060\u0049\u002b\u007b\u0074\u005f\u0062\u002f\u0052\u007c\u003a\u0054\u004f\u0033\u004f\u0021\u004b\u0077\u0031\u0030\u0073\u007a\u004c\u0035\u0034\u0049\u0040\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0053\u0047\u0037\u0076\u002c\u0022\u003a\u006c\u0034\u005f\u0079\u005e\u0042\u0024\u0040\u0039\u0066\u007e\u0024\u0053\u0047\u0073\u0033\u0055\u0023\u007b\u003b\u002b\u0062\u0052\u0044\u0039\u005f\u006e\u0056\u003b\u006f\u007c\u004d\u003f\u0039\u0052\u0047\u0063\u0076\u0053\u0051\u005e\u0036\u002c\u0047\u006c\u0070\u0030\u0069\u0042\u0021\u0032\u0066\u0025\u0043\u0032\u0068\u007b\u0077\u0035\u0071\u003e\u003a\u0078\u0065\u0032\u007b\u002b\u004b\u0058\u0024\u0026\u0076\u0029\u005f\u003b\u006a\u006f\u003a\u003e\u003b\u0062\u0060\u0077\u0039\u0028\u002b\u002c\u004a\u0069\u002f\u0031\u0074\u002f\u0068\u004b\u0064\u0038\u004f\u003f\u0071\u0058\u0071\u006e\u002a\u0049\u0067\u003a\u0051\u0077\u0051\u0075\u0050\u0059\u0037\u0072\u0071\u002c\u006f\u0075\u0026\u0054\u0036\u0065\u0040\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0063\u0034\u004e\u0058\u0032\u0070\u0043\u0037\u0021\u003b\u0035\u005d\u004b\u003f\u0036\u0076\u002e\u0043\u002b\u0046\u0041\u003b\u0042\u0069\u004e\u005b\u0047\u002f\u0061\u0043\u0079\u006f\u004c\u004d\u002e\u007b\u0071\u0029\u0021\u0045\u0032\u005e\u002a\u0079\u002f\u0048\u004b\u006f\u0069\u0035\u0063\u0024\u005e\u0070\u007b\u0026\u005f\u0066\u007e\u0023\u0022\u0051\u0028\u0035\u003b\u006a\u0021\u0063\u0057\u0024\u003c\u002a\u005d\u002a\u007b\u0025\u0021\u0069\u002f\u003e\u006a\u0061\u0055\u002f\u0057\u007e\u0023\u0022\u0051\u005f\u002a\u003b\u003d\u0063\u0037\u0060\u005d\u005e\u0039\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0036\u0076\u002e\u0043\u007a\u005f\u0058\u0062\u0073\u007b\u0044\u0058\u0047\u007a\u0059\u0047\u004e\u002e\u006f\u0048\u004f\u0079\u0063\u005f\u0063\u007c\u0053\u0035\u007a\u003c\u002a\u0072\u0049\u0066\u004f\u0061\u006c\u0024\u0041\u005f\u0063\u007c\u004e\u0035\u007a\u003c\u002a\u0072\u004e\u002e\u0037\u0039\u0069\u0036\u0058\u0062\u0052\u007b\u0044\u0058\u0044\u0045\u0041\u0047\u004e\u002e\u004d\u0040\u0048\u0036\u0058\u0062\u0021\u007c\u0044\u0058\u0036\u0025\u0043\u002e\u0022\u005a\u003a\u0061\u003a\u004c\u003b\u002c\u004d\u003a\u0044\u0058\u0049\u0076\u0043\u002e\u0022\u005a\u0075\u0048\u003a\u004c\u003a\u004e\u0053\u002c\u0049\u007b\u004a\u0060\u004b\u003f\u0036\u0076\u002e\u0043\u0049\u0058\u0057\u0048\u003c\u006f\u004a\u0072\u006e\u002b\u0053\u0059\u0054\u0040\u002e\u0043\u0071\u0046\u0068\u0024\u0048\u004d\u0078\u002c\u0067\u0067\u002b\u0041\u002b\u002b\u0066\u0060\u003e\u0069\u0028\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u004d\u0062\u0035\u0034\u0023\u0047\u002b\u0077\u003e\u0048\u0060\u0040\u005a\u0052\u0063\u0024\u0045\u004e\u0049\u0066\u003c\u0077\u0045\u0033\u0051\u0074\u0043\u0022\u003a\u006c\u0034\u005f\u0079\u005e\u0042\u0024\u0040\u0039\u0066\u007e\u0024\u0053\u0047\u0073\u0033\u0047\u0077\u0042\u0045\u004e\u0024\u0062\u002f\u0061\u002f\u0063\u006a\u0043\u0046\u0033\u006a\u006b\u002a\u0050\u0063\u0049\u0048\u002e\u0066\u003e\u0069\u0036\u006a\u0056\u0069\u0036\u0024\u006e\u0077\u0053\u0068\u0029\u0033\u0060\u006a\u005d\u0036\u002a\u002b\u0036\u005d\u0037\u002a\u005d\u005d\u0048\u003e\u0053\u0034\u0078\u006d\u0047\u0053\u003e\u007e\u0069\u0028\u0040\u005b\u0060\u003d\u0077\u0070\u006a\u0044\u006b\u0032\u0057\u0059\u006d\u006d\u0038\u0066\u003e\u0069\u005d\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0031\u0062\u005f\u0058\u004c\u004a\u0040\u0064\u0033\u004f\u0021\u004b\u0064\u0022\u0057\u0030\u007a\u004c\u005f\u0050\u0029\u0076\u0051\u0066\u0035\u004a\u003b\u0046\u002b\u0069\u003d\u002e\u0058\u004c\u0044\u006e\u004f\u0046\u007c\u0047\u0070\u0043\u0066\u0070\u0030\u004e\u0045\u0041\u0037\u004a\u006a\u006d\u003f\u006c\u0024\u0078\u0023\u0061\u0071\u0055\u0051\u0075\u0030\u006b\u0049\u0067\u0065\u006e\u0059\u0053\u0028\u0032\u005e\u0075\u006b\u0034\u003d\u0064\u0037\u005b\u0040\u006c\u003f\u0067\u0047\u0066\u0055\u0060\u0056\u0038\u0049\u003d\u002b\u0069\u0028\u004c\u004a\u004d\u0050\u0063\u006f\u0046\u005d\u0062\u006a\u002e\u0045\u0043\u0031\u004e\u007b\u0072\u0045\u0032\u0051\u004e\u004a\u002f\u0026\u003c\u0071\u0029\u0053\u0033\u0065\u0060\u0026\u0029\u0040\u0035\u0039\u0051\u0058\u004f\u004e\u006a\u0054\u0045\u006e\u002f\u0069\u0057\u004e\u005b\u006b\u0079\u0028\u0065\u0073\u003e\u004c\u004d\u006b\u002b\u002f\u0063\u0056\u0056\u0026\u006c\u0066\u0035\u0051\u006a\u002a\u004d\u0063\u003e\u0034\u0072\u0039\u0047\u003d\u0040\u003c\u0028\u0050\u0079\u0073\u003d\u0030\u003e\u006b\u0056\u003f\u0039\u007b\u0029\u0032\u0062\u0062\u0051\u0072\u0035\u0039\u0037\u0048\u0070\u007b\u0064\u003d\u0059\u007c\u0028\u0040\u0065\u006e\u002e\u0058\u004c\u0044\u0030\u0065\u002f\u0026\u0048\u003e\u0021\u0066\u003a\u0030\u0058\u0063\u0032\u0029\u002a\u004a\u0048\u002f\u003d\u003c\u0065\u0055\u0030\u003b\u003c\u003a\u0044\u0069\u003a\u0023\u004c\u0044\u0025\u0066\u0046\u007c\u0029\u0055\u007a\u0064\u0048\u0053\u003e\u0039\u0063\u0057\u003a\u006d\u005b\u0073\u007e\u0023\u0022\u0051\u005f\u002a\u0045\u006a\u007a\u004c\u0062\u0048\u0052\u0030\u0045\u0050\u005e\u0038\u0021\u0035\u005a\u0028\u0055\u003f\u003a\u0063\u0076\u0068\u0044\u002f\u0079\u0070\u0043\u0073\u003e\u0024\u0030\u0041\u005a\u003a\u007e\u0028\u002b\u0047\u0051\u003b\u0050\u0038\u004f\u006f\u0060\u0030\u0025\u0072\u0073\u007e\u0047\u0028\u0073\u003d\u0028\u007e\u0025\u0037\u007b\u0075\u0071\u0033\u005a\u0071\u0030\u0021\u0045\u005a\u0074\u0044\u0060\u0060\u007c\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0036\u0076\u002e\u0043\u007a\u005f\u0058\u0062\u0073\u007b\u0044\u0058\u0047\u007a\u0059\u0047\u004e\u002e\u006f\u0048\u004f\u0079\u0063\u005f\u0063\u007c\u0053\u0035\u007a\u003c\u002a\u0072\u007d\u003a\u0028\u0056\u0045\u0068\u007b\u0049\u0066\u004f\u0061\u003a\u0061\u0041\u005f\u0063\u007c\u0051\u0035\u007a\u003c\u0072\u0076\u004e\u002e\u004e\u004f\u002b\u0036\u0058\u0062\u0052\u007b\u0044\u0058\u0049\u0076\u0057\u004c\u0075\u0066\u0076\u0051\u004f\u0023\u004d\u007a\u007b\u0070\u006f\u0031\u0047\u0063\u004f\u0041\u0054\u0023\u0022\u0051\u007c\u0044\u0043\u0074\u006a\u006e\u002f\u0052\u007c\u003a\u0054\u004f\u0033\u004f\u0021\u004b\u0077\u0031\u0030\u0073\u007a\u004c\u0022\u003a\u005e\u0061\u0052\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0077\u003a\u0021\u002b\u0046\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u004d\u0062\u0035\u0034\u0023\u0047\u002b\u0077\u003e\u0048\u0060\u0040\u005a\u0052\u0063\u0024\u0045\u004e\u0049\u0066\u003c\u0077\u0045\u0033\u0070\u0029\u003b\u0035\u006e\u0022\u003a\u006c\u0034\u005f\u0079\u003d\u0026\u0054\u0047\u0074\u003d\u0073\u0062\u0053\u0047\u0073\u0033\u0071\u0031\u0045\u0072\u004c\u0070\u003a\u0028\u0079\u004a\u0031\u0026\u0050\u0024\u0029\u0068\u0022\u003a\u0052\u0026\u0072\u0076\u007d\u0076\u0031\u0079\u006f\u0074\u0044\u003a\u005e\u007e\u0053\u004a\u0047\u0022\u003a\u005e\u0061\u003d\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\