047\u0037\u0076\u0076\u0064\u0025\u004f\u0028\u005e\u005e\u007d\u004e\u0030\u0047\u004a\u0077\u0048\u0067\u007b\u004e\u0064\u005d\u0028\u006c\u0053\u006c\u0075\u0075\u0071\u0077\u0077\u006f\u005e\u0059\u003f\u0033\u007b\u0041\u006c\u0076\u0043\u002f\u0040\u0046\u0050\u0024\u0040\u005a\u0070\u006f\u002b\u0021\u0029\u003e\u0075\u0030\u0044\u0050\u0040\u0042\u0026\u0038\u0040\u0062\u0030\u006b\u0053\u006b\u0057\u007e\u0068\u0063\u0052\u005f\u0028\u0045\u003d\u0058\u004d\u007d\u002f\u0042\u007e\u0068\u0039\u0069\u002a\u0079\u0072\u0073\u0064\u004b\u0068\u0040\u004d\u0069\u003e\u0079\u0065\u002c\u0059\u0029\u0068\u0062\u006b\u0032\u0066\u004a\u0048\u006b\u0061\u005e\u0076\u007a\u004f\u0065\u0029\u004d\u003c\u0038\u0053\u0065\u0049\u0047\u0068\u0031\u0076\u0036\u0056\u0055\u006a\u003c\u0024\u007b\u002c\u0061\u006e\u0024\u005f\u0022\u0035\u002c\u0077\u0068\u005f\u0066\u0034\u0026\u0023\u0056\u0071\u0075\u0043\u006b\u004a\u0057\u0068\u002b\u005b\u0028\u0030\u006b\u0034\u0045\u0076\u0048\u002c\u0022\u006f\u0077\u0067\u0063\u0048\u006e\u005a\u0052\u0052\u002a\u002e\u0034\u0035\u0037\u0049\u004c\u003b\u002b\u0061\u0063\u006d\u006c\u0039\u005b\u0062\u003e\u006d\u0071\u006f\u0048\u0034\u0025\u0060\u0063\u006e\u0079\u0056\u0058\u0063\u0028\u0061\u0063\u0078\u007b\u0031\u0021\u002e\u003a\u0076\u0064\u0041\u0061\u0041\u0045\u007b\u004a\u0048\u0065\u002f\u0026\u0025\u004b\u003d\u003b\u004f\u0039\u0043\u0039\u007e\u0070\u006c\u0051\u003f\u0065\u0026\u002f\u0041\u004e\u003f\u0050\u0059\u006d\u0036\u006c\u0061\u0046\u0039\u0023\u0078\u004b\u0021\u0056\u003d\u006a\u0024\u0026\u004c\u0055\u0024\u0076\u0066\u0035\u0051\u006a\u0068\u0051\u007a\u0078\u0065\u004a\u005b\u0028\u0064\u0046\u007c\u0045\u003b\u006a\u003d\u0037\u006d\u0051\u0039\u002f\u002b\u003b\u0076\u0024\u0066\u003b\u002e\u0058\u0045\u007b\u006c\u0050\u006e\u004a\u0063\u006a\u0051\u0053\u004f\u0026\u004d\u0067\u0028\u0048\u0075\u0051\u006a\u0052\u0069\u0022\u004b\u0077\u0026\u0021\u007b\u0040\u0071\u006a\u0022\u0040\u0068\u0039\u0023\u0078\u004b\u0021\u0056\u0021\u0034\u0071\u002b\u0050\u0043\u007c\u006d\u004b\u0022\u002f\u0076\u0041\u006c\u003c\u0075\u0039\u0068\u0030\u003e\u002e\u0037\u0046\u006a\u0028\u0040\u005f\u005a\u004e\u0066\u0046\u003e\u0073\u0030\u0050\u0063\u006f\u0034\u005b\u0045\u006d\u0051\u0054\u0066\u0048\u0041\u006c\u0032\u0077\u003b\u0034\u0052\u0069\u002c\u0024\u0055\u006a\u0041\u0031\u0046\u0032\u0075\u0050\u0029\u006d\u005b\u002e\u0078\u0074\u0055\u0076\u005a\u004a\u002f\u0059\u005d\u007c\u005e\u007e\u005f\u002a\u0044\u0032\u0072\u007b\u0036\u005e\u0067\u0031\u0029\u0064\u0060\u0049\u003e\u006c\u0069\u0028\u0035\u0073\u0036\u0076\u0050\u0069\u0022\u0055\u003f\u0075\u0046\u007e\u0060\u0075\u0043\u003b\u0038\u0066\u0045\u003d\u002e\u0021\u004a\u0055\u0062\u002b\u0064\u0026\u0071\u003c\u005b\u0060\u0059\u0021\u006e\u0045\u0079\u0061\u0031\u0055\u0035\u004f\u006f\u0026\u0033\u003e\u007e\u003b\u003c\u0060\u003a\u0050\u0031\u006f\u0025\u005b\u0051\u0062\u0043\u0052\u0029\u0040\u004b\u003c\u003f\u002a\u0039\u0055\u004a\u0056\u0029\u0078\u0021\u0064\u0071\u004e\u0065\u0025\u0063\u0052\u0079\u0063\u002f\u005a\u0021\u0061\u0044\u006b\u0056\u0077\u0079\u0029\u0058\u0045\u0058\u0051\u004d\u0041\u0071\u0042\u005b\u0077\u0045\u003b\u004d\u006d\u0035\u0070\u006c\u0040\u003a\u002f\u003d\u0021\u0040\u0076\u0024\u002b\u0022\u004c\u002e\u0032\u0076\u0045\u006d\u0051\u0062\u003a\u007a\u007a\u0046\u0037\u0070\u0040\u0076\u0078\u0035\u006d\u0030\u003d\u0048\u0072\u0036\u004a\u004f\u003b\u0045\u005a\u005e\u004e\u0035\u007c\u0073\u002b\u004e\u0079\u0075\u006c\u0069\u0028\u0040\u0029\u0071\u002f\u0028\u006c\u0068\u0031\u005b\u0073\u002c\u003f\u0035\u002c\u0077\u0068\u005f\u0066\u0034\u0026\u0023\u0056\u0071\u0075\u0043\u006b\u004a\u0057\u0068\u002b\u005b\u0028\u0030\u006b\u0034\u0045\u0076\u0048\u002c\u0022\u006f\u0077\u0067\u0063\u0048\u006e\u005a\u0052\u0052\u002a\u002e\u0034\u0035\u0037\u0049\u004c\u003b\u002b\u0061\u0063\u006d\u006c\u0039\u005b\u0062\u003e\u006d\u0071\u006f\u0048\u0034\u0025\u0060\u0063\u006e\u0079\u0056\u0058\u0063\u0028\u0061\u0063\u0078\u007b\u0031\u0021\u002e\u003a\u0076\u0064\u0041\u0061\u0041\u0045\u007b\u004a\u0048\u0065\u002f\u0026\u0025\u004b\u003d\u003b\u004f\u0039\u0043\u0039\u0075\u0074\u0077\u0072\u006b\u003a\u0049\u0045\u0057\u003b\u005b\u0065\u0065\u0072\u0024\u0043\u003c\u006d\u0047\u0051\u0031\u0043\u004e\u006a\u0037\u0040\u005d\u0032\u003c\u006d\u0047\u0051\u0077\u0034\u0052\u006a\u0060\u0037\u0067\u006f\u006f\u0021\u002b\u002b\u0079\u0028\u0045\u004f\u0074\u0077\u005e\u0061\u0039\u0033\u0039\u004b\u0021\u0078\u0060\u0061\u002f\u0067\u006a\u003d\u0040\u0032\u005e\u007c\u0046\u0024\u0037\u0021\u0064\u0056\u0045\u005e\u006c\u0029\u0025\u003b\u006a\u006d\u0022\u004f\u0071\u0050\u003c\u0037\u0051\u0044\u002f\u0029\u006a\u005f\u0047\u0072\u0045\u0022\u0051\u0059\u004f\u0024\u0037\u0023\u004d\u0075\u004a\u006f\u002b\u0064\u0063\u007e\u0023\u0022\u0051\u005b\u0065\u006f\u0042\u0063\u006f\u0040\u002c\u004d\u0073\u0079\u007b\u0075\u0041\u0023\u0062\u0051\u0064\u006b\u0037\u0065\u0071\u0073\u004f\u0064\u0049\u003f\u002c\u0029\u0076\u0021\u0062\u002e\u0054\u003c\u0068\u0029\u004b\u0021\u0078\u0060\u0072\u0035\u0060\u006a\u0028\u002f\u0074\u004b\u0021\u007b\u0052\u0073\u0034\u0060\u006a\u0049\u005e\u0078\u0057\u006d\u0064\u0021\u006c\u0042\u0028\u0059\u004f\u0074\u0074\u004e\u0041\u004c\u0060\u0046\u0030\u007a\u004b\u0021\u004c\u002f\u004f\u0065\u0060\u006a\u0065\u0026\u005a\u006c\u0079\u0028\u0069\u0065\u0075\u006a\u004f\u0054\u0041\u0039\u002a\u003c\u0026\u006c\u0061\u002f\u0060\u006a\u0057\u0041\u005a\u005e\u0039\u0076\u0043\u0053\u002a\u0029\u006a\u005e\u0032\u005e\u0049\u0075\u0045\u0053\u0057\u0039\u0072\u007a\u0075\u0021\u0074\u006b\u0079\u006a\u0052\u0070\u003e\u0077\u0049\u006b\u0028\u0045\u005f\u003c\u006f\u006c\u0062\u0036\u0041\u005d\u0053\u0070\u007c\u004d\u0062\u0060\u0075\u0041\u006c\u0024\u0032\u002e\u0038\u0055\u0042\u007a\u003e\u005e\u0053\u007e\u007e\u005f\u003c\u006f\u006c\u0056\u0064\u0049\u0061\u0044\u004e\u004b\u0077\u0042\u0072\u0024\u0067\u0036\u0076\u0022\u003f\u0052\u004d\u002c\u002a\u002c\u0029\u0048\u006c\u0035\u0043\u002b\u0023\u0046\u0024\u002e\u0051\u0071\u007c\u0044\u007e\u0021\u0072\u002b\u005f\u0041\u0050\u0054\u0043\u0036\u0023\u004a\u0077\u002e\u0079\u003d\u0040\u0079\u0025\u0044\u0078\u0025\u0040\u0059\u0070\u0059\u0039\u0056\u0032\u0056\u0058\u0029\u002a\u007a\u002a\u004a\u004b\u005e\u006a\u002c\u0039\u0041\u007b\u003d\u0029\u0074\u0072\u0028\u007a\u0076\u0046\u0022\u006f\u0048\u003f\u0064\u007c\u0054\u0041\u0075\u006c\u007b\u0025\u0023\u0035\u0029\u0045\u0044\u004d\u005f\u0064\u0026\u003f\u002b\u004e\u0031\u0062\u004f\u0064\u003d\u002a\u0028\u0024\u0026\u007a\u0043\u002e\u0064\u005e\u0076\u0052\u0039\u0074\u0026\u0054\u005e\u002f\u0023\u004b\u0063\u0072\u0049\u0043\u0057\u003d\u0028\u0045\u007e\u004e\u006a\u0024\u0021\u003c\u0035\u007a\u0040\u0023\u0063\u004d\u0021\u0029\u003a\u0066\u004f\u003b\u006a\u005e\u0034\u0038\u0069\u0021\u004b\u0041\u007a\u0055\u0024\u002f\u0073\u0031\u0068\u0023\u0048\u0073\u005b\u002f\u0079\u0033\u0074\u0041\u0077\u0062\u003f\u0059\u0056\u0063\u0069\u0046\u0049\u0038\u0078\u003b\u006a\u006c\u0069\u007e\u005f\u007e\u0030\u002f\u0034\u0064\u005d\u0050\u0048\u0069\u0057\u0037\u0057\u0034\u002a\u0025\u005e\u0046\u0067\u0076\u007a\u0077\u0043\u0073\u0041\u0023\u005f\u004d\u0076\u002b\u003d\u004b\u007e\u0067\u0067\u0052\u004c\u0056\u0035\u0032\u0031\u003e\u003d\u0046\u006a\u0073\u0072\u0037\u005e\u004d\u0053\u0049\u0070\u0036\u006d\u0049\u003e\u0049\u002b\u0030\u002f\u0053\u004f\u005b\u0068\u002a\u0044\u003e\u0041\u005a\u0060\u0066\u0075\u0053\u0041\u007e\u0046\u0024\u0041\u003e\u002e\u002a\u0050\u0063\u0037\u0024\u0065\u0054\u004b\u0066\u004c\u006d\u004c\u0075\u0031\u0042\u0028\u005f\u003c\u004a\u0068\u004e\u003b\u0029\u003d\u003e\u0047\u006f\u003b\u0060\u0061\u0068\u007b\u0028\u0068\u0054\u002f\u006f\u0067\u004d\u0039\u003d\u0031\u0028\u0078\u0062\u0062\u007e\u0071\u0025\u0062\u004a\u0060\u004e\u003b\u0030\u0050\u0049\u002b\u0040\u0064\u006c\u006b\u0055\u0068\u0060\u0077\u0053\u0057\u006c\u0023\u0074\u0032\u0066\u0070\u0076\u0051\u007c\u003b\u004d\u007b\u0058\u004d\u002e\u0060\u0041\u0034\u0062\u0028\u0068\u0021\u006a\u0050\u0030\u0078\u0063\u0056\u0048\u007c\u0057\u0043\u002f\u0037\u0045\u0031\u0048\u0040\u0070\u003b\u0025\u0054\u006d\u0055\u0070\u0061\u005a\u006a\u0023\u007a\u004a\u003e\u0073\u0046\u0035\u0075\u007a\u0070\u0025\u0034\u0032\u0048\u006b\u002a\u0029\u0071\u0030\u0074\u003d\u004b\u006f\u0053\u0033\u007e\u003e\u002b\u006d\u0053\u0063\u0036\u0036\u006f\u0021\u0070\u0078\u0031\u0034\u0034\u0070\u0064\u0058\u0026\u0053\u0074\u0067\u0048\u005a\u0073\u0043\u005b\u002f\u0070\u0065\u002b\u004e\u0045\u0075\u005b\u006d\u005d\u0041\u004d\u007b\u0077\u005e\u0077\u005b\u006a\u0064\u0078\u0037\u0060\u0074\u006a\u0045\u0047\u0021\u007a\u003e\u005e\u0053\u007e\u007e\u005f\u003c\u006f\u006c\u0056\u0064\u0049\u0061\u0044\u004e\u004b\u0077\u0042\u0072\u0024\u0067\u0036\u0076\u0022\u003f\u0052\u004d\u002c\u002a\u002c\u0029\u0048\u006c\u0035\u0043\u002b\u0023\u006f\u003c\u0042\u0046\u0022\u0043\u004f\u006d\u0021\u004c\u0075\u0074\u003d\u004d\u005f\u0056\u0035\u002c\u0077\u0068\u005f\u0066\u0034\u0026\u0023\u0056\u0037\u0075\u0021\u007c\u0032\u0029\u0038\u0064\u0037\u005b\u0079\u007a\u0031\u003b\u005f\u0043\u0073\u004c\u0071\u0072\u006d\u0063\u0034\u0025\u0073\u0044\u006f\u0029\u006c\u0043\u0026\u0061\u0023\u0069\u0055\u0063\u0055\u007b\u004d\u0074\u002f\u005b\u0046\u007e\u0037\u007d\u005f\u0062\u005a\u002a\u007e\u004f\u0039\u0061\u005e\u004d\u0073\u004f\u0038\u0069\u0059\u0061\u0057\u002b\u007e\u0060\u004c\u0045\u007c\u0039\u0050\u005e\u0074\u003c\u0034\u0078\u0059\u0049\u0077\u006c\u0038\u0050\u0069\u002f\u0028\u0050\u0049\u0021\u003c\u0035\u005a\u0034\u0024\u0070\u0045\u0035\u006c\u0059\u006b\u0079\u004d\u005b\u006d\u004b\u0029\u0045\u0045\u0065\u0021\u0059\u0025\u0074\u0029\u0052\u0029\u0076\u004a\u007c\u0051\u0042\u005b\u0064\u005b\u004a\u0055\u0067\u003a\u0046\u0053\u0077\u007a\u0073\u0023\u0057\u007a\u0052\u0042\u0062\u003d\u0052\u0061\u0040\u003a\u0046\u0054\u0056\u005b\u0024\u002b\u0069\u0042\u0079\u0042\u0058\u002e\u002a\u0045\u005d\u0061\u0046\u0073\u0056\u0059\u0075\u0048\u0062\u004b\u0045\u002a\u004e\u003b\u0044\u0057\u0025\u005f\u0048\u0037\u0021\u0066\u0070\u0041\u0038\u002e\u0045\u002c\u0052\u007b\u006d\u0053\u0021\u0050\u0050\u0070\u006c\u0039\u0028\u002e\u0039\u002e\u0052\u0073\u0052\u005f\u0052\u003f\u004a\u0036\u0036\u0051\u0073\u006a\u0076\u0055\u0038\u0046\u007c\u0041\u002a\u0028\u006c\u007e\u0039\u003c\u003d\u0062\u006c\u006b\u005b\u005a\u0063\u0074\u0071\u0043\u0021\u006d\u0068\u002c\u0078\u002e\u0042\u0024\u0040\u0043\u0064\u0047\u0032\u004d\u0028\u004d\u0058\u0073\u002a\u003f\u0049\u0041\u007a\u0053\u0043\u0049\u0031\u004a\u004f\u0043\u003f\u0062\u0035\u003d\u0025\u0043\u002e\u002a\u0061\u0060\u0048\u006a\u005f\u0068\u006d\u006a\u007e\u0026\u007b\u0036\u0052\u0051\u005f\u0045\u006f\u0050\u0047\u0070\u0078\u0072\u0075\u003d\u0067\u0032\u007e\u0026\u005f\u0049\u0045\u003c\u003d\u003c\u0061\u004d\u007c\u0040\u0026\u0026\u0039\u007d\u0075\u002b\u0021\u0031\u0073\u005e\u005a\u004d\u002b\u0028\u0029\u0037\u006a\u0034\u0039\u005b\u0056\u0036\u006d\u002b\u0067\u005a\u0045\u0057\u004e\u0043\u004f\u0047\u0063\u007a\u0053\u0042\u0058\u002e\u002a\u0042\u0063\u0029\u0042\u0053\u0043\u0049\u0031\u004a\u004f\u0043\u003f\u004d\u0058\u0073\u002a\u003f\u0049\u0041\u007a\u0053\u0043\u0023\u006d\u0029\u007c\u0051\u0026\u0056\u0062\u004b\u0025\u0033\u0066\u0059\u0046\u0043\u0061\u006a\u0061\u006b\u002b\u0077\u007b\u0043\u0075\u005e\u003c\u004d\u0075\u006b\u005a\u0052\u005e\u003c\u006a\u0040\u0067\u0024\u007b\u0075\u0062\u0063\u0052\u0036\u0032\u0064\u0048\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0078\u0024\u002b\u0069\u0078\u007c\u0029\u003c\u0077\u0068\u0047\u0060\u003a\u0046\u0071\u0040\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u007b\u0025\u0037\u0045\u003c\u005e\u0024\u0040\u0034\u0071\u002b\u0069\u0042\u0079\u0025\u0074\u0050\u0047\u0036\u002c\u006f\u002f\u0022\u006f\u0062\u0046\u0049\u0065\u0066\u003a\u0046\u0024\u0040\u0043\u004a\u0073\u006b\u006b\u0028\u0066\u0028\u0060\u0043\u003d\u0025\u0032\u0070\u0065\u0048\u0051\u0078\u0063\u0072\u0073\u007b\u0041\u0021\u0029\u0051\u0031\u0073\u0073\u005a\u0058\u0070\u0038\u0072\u0045\u0077\u005a\u0057\u0040\u004e\u0060\u0051\u0047\u0063\u003c\u0058\u0064\u0034\u007d\u005a\u0026\u0077\u006e\u0039\u0071\u0051\u0034\u0076\u0036\u0040\u007b\u0065\u0077\u0077\u006c\u0030\u0050\u0064\u0062\u007c\u0029\u0068\u0055\u003b\u004f\u0032\u0079\u002f\u006b\u004e\u004a\u005b\u0060\u0030\u0074\u0067\u0036\u003c\u0064\u004b\u0069\u0075\u0031\u0026\u0068\u0069\u0043\u004f\u007d\u0073\u006b\u0028\u0055\u004d\u007e\u002f\u0065\u003b\u0052\u0071\u0071\u006c\u0043\u006d\u0045\u002a\u0039\u0028\u003a\u002a\u0035\u0060\u003d\u0049\u0026\u005e\u0054\u0056\u0040\u0046\u0047\u0069\u0077\u007b\u007e\u004e\u006e\u0025\u0065\u0066\u0038\u003b\u004a\u0056\u0037\u004b\u0077\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0078\u0024\u002b\u0069\u0052\u0067\u006e\u0047\u004a\u0060\u006f\u0075\u0058\u003b\u0053\u0077\u004c\u0036\u006d\u0062\u003d\u0026\u0037\u0057\u003f\u0021\u0038\u0040\u006d\u0026\u003c\u0034\u0076\u0031\u007c\u0065\u0074\u007b\u0060\u0062\u006c\u0076\u0065\u0066\u0076\u0068\u0068\u0043\u0034\u0071\u006e\u0062\u005f\u0037\u0040\u003e\u003d\u0025\u0078\u002f\u0051\u004f\u003d\u0071\u004d\u005e\u007a\u0075\u003f\u0053\u003b\u007b\u002b\u004a\u0044\u002f\u0054\u0034\u005d\u0031\u0047\u004e\u002e\u0062\u0055\u0068\u004f\u0056\u006d\u0046\u005f\u004b\u0075\u0071\u005a\u0071\u0038\u0060\u0032\u0069\u0049\u0058\u0067\u002a\u0071\u0068\u0077\u0076\u002a\u0078\u002b\u0055\u0045\u004b\u005e\u0053\u005d\u0057\u0034\u002a\u0071\u0050\u0024\u0073\u003c\u005e\u0030\u0056\u0054\u0044\u0049\u003f\u0046\u007c\u0062\u0021\u0028\u004a\u0050\u0063\u0035\u002f\u0076\u0040\u007e\u0028\u0043\u0073\u005e\u0028\u0065\u0076\u007d\u0021\u0023\u0072\u0078\u0061\u0050\u005e\u0040\u0072\u0073\u0032\u004f\u0057\u0044\u007b\u002e\u005b\u0029\u0025\u007e\u0039\u0039\u0040\u0064\u0031\u002a\u0053\u004a\u0037\u0076\u0021\u0026\u0021\u0044\u0065\u0037\u0024\u004f\u006c\u0022\u0047\u0075\u002b\u0026\u0068\u0071\u0024\u006b\u0060\u0069\u0044\u0025\u0061\u0071\u002f\u0075\u0045\u003d\u0025\u0078\u0065\u006c\u004b\u0025\u005a\u0034\u0078\u0037\u007b\u003c\u0051\u006c\u004f\u0065\u0024\u0078\u005f\u005e\u0024\u0038\u006a\u007e\u0065\u0052\u0068\u002b\u003a\u004b\u0058\u0021\u0067\u0067\u003b\u0040\u0058\u004b\u005f\u0078\u0022\u0070\u003c\u0073\u003f\u005f\u0053\u002a\u006d\u0067\u006a\u0037\u0051\u0036\u0062\u002b\u0079\u002b\u0070\u0055\u005a\u006c\u0035\u0036\u004b\u005d\u0041\u0034\u005d\u003e\u006d\u002b\u004d\u0058\u004e\u005a\u0038\u0043\u002e\u0060\u003f\u0026\u0073\u0043\u0072\u004a\u0064\u007c\u006c\u0028\u0028\u0029\u0074\u003c\u0029\u0049\u0055\u0061\u0060\u0040\u0025\u0067\u004f\u002b\u0035\u0063\u0024\u0073\u0022\u0051\u0050\u002f\u0048\u0026\u0033\u003e\u0052\u0044\u005a\u007e\u003a\u007e\u0076\u0040\u0078\u006d\u0042\u0078\u003b\u0034\u0033\u0069\u0046\u0030\u004c\u007e\u0060\u0029\u006a\u002b\u004e\u0044\u005e\u0036\u006d\u0058\u0047\u0077\u0060\u0025\u0059\u007c\u0022\u0026\u002e\u0064\u004a\u0057\u0023\u0072\u003e\u005a\u0022\u006f\u0050\u0051\u0040\u006b\u006d\u003d\u0073\u0021\u0042\u0028\u0068\u0032\u002b\u0037\u007e\u0037\u0037\u0050\u002c\u0064\u005b\u0037\u006b\u0077\u0070\u0076\u0023\u0030\u0053\u0059\u006b\u004d\u006c\u007b\u005b\u0075\u003a\u0023\u0063\u0040\u0045\u0025\u0037\u0032\u006b\u0034\u0051\u004c\u0063\u0078\u0045\u0062\u004c\u0045\u004b\u0076\u006c\u0021\u006d\u002f\u0061\u0059\u0059\u0034\u007a\u0051\u005b\u0067\u0068\u007b\u007d\u005e\u006d\u0060\u0068\u0030\u0057\u003b\u006d\u0040\u0061\u0035\u0045\u005d\u0057\u0059\u0063\u0076\u0066\u006d\u0071\u0065\u0073\u003c\u0053\u0069\u0062\u0076\u005d\u0069\u006e\u0079\u0052\u0023\u0031\u0043\u007a\u0078\u0037\u0068\u005f\u0047\u0054\u0077\u0077\u0038\u0032\u0079\u0033\u0047\u0062\u003a\u0074\u0036\u0067\u0067\u006a\u0037\u0044\u0076\u0054\u0062\u007a\u0045\u003c\u002f\u0025\u003c\u0052\u0032\u0073\u003c\u0043\u0061\u004e\u004b\u0065\u006d\u0079\u0059\u0079\u0048\u0070\u005f\u0068\u0030\u0074\u005e\u002b\u0048\u0048\u007b\u005f\u0065\u0068\u0068\u003c\u0023\u0039\u0051\u005e\u004b\u0032\u0061\u006a\u0055\u0032\u0043\u0051\u005d\u003c\u007c\u0064\u0047\u0044\u0053\u0025\u0065\u0021\u004f\u0044\u004e\u0039\u003e\u0063\u0072\u004e\u0052\u0068\u0024\u0056\u002b\u0044\u0070\u002e\u0064\u004b\u0021\u006e\u0077\u0042\u0026\u0066\u0069\u0065\u0079\u0048\u0032\u0061\u0037\u003f\u0021\u0030\u0028\u0038\u0065\u0061\u0059\u0035\u0061\u0074\u004d\u0026\u0053\u0057\u0059\u0024\u004c\u0046\u006c\u0066\u0039\u002a\u0061\u007e\u0021\u0023\u0077\u003d\u0072\u0073\u0039\u0028\u007e\u0036\u0052\u005a\u0034\u0033\u005a\u0071\u006c\u003a\u003f\u0072\u0075\u0025\u0028\u0064\u0047\u003a\u0046\u0036\u0066\u0043\u0059\u007e\u0037\u0062\u0053\u0025\u006d\u003c\u0023\u005f\u007e\u007c\u003d\u0058\u004f\u0054\u003b\u004c\u0037\u006b\u0022\u0058\u0030\u0052\u0058\u0052\u0029\u0071\u006b\u007e\u0072\u005e\u0067\u0077\u004e\u007a\u005e\u005e\u0041\u007a\u0045\u005f\u0070\u0060\u0053\u0061\u004a\u002c\u0059\u0032\u006f\u0024\u006b\u006a\u007e\u006c\u004e\u0062\u004c\u005f\u006d\u0025\u0036\u0068\u005d\u0024\u002b\u0065\u0064\u0042\u007c\u003c\u007e\u004d\u0075\u0058\u005b\u0070\u0067\u002a\u0076\u0035\u006c\u0048\u0029\u0040\u006d\u0045\u0063\u0024\u006c\u0063\u004a\u0022\u003e\u0034\u0035\u0054\u003e\u0063\u003b\u0024\u003f\u006a\u0023\u0051\u0035\u0053\u0044\u0078\u0029\u007b\u0039\u003c\u0061\u0078\u0071\u0039\u0038\u0048\u0063\u0072\u0028\u007c\u0021\u002c\u0066\u003c\u0042\u0026\u0034\u0071\u0076\u0043\u0026\u0068\u0068\u007e\u0070\u0036\u0052\u0038\u0040\u002b\u0068\u0029\u0040\u0029\u0031\u0038\u0065\u0023\u0037\u0072\u0075\u003e\u003b\u0036\u002a\u005f\u003c\u0036\u002b\u0034\u0069\u0064\u007c\u004f\u0041\u0030\u0035\u0065\u005e\u0048\u0078\u003b\u0045\u0053\u005e\u0076\u0052\u0049\u006d\u003d\u007b\u007e\u0023\u0045\u0053\u007a\u0066\u006b\u0048\u003f\u0048\u0064\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0054\u0056\u0073\u003c\u005a\u0056\u0037\u004b\u002b\u0069\u0052\u0067\u0039\u003c\u003b\u002f\u0022\u005a\u0069\u0042\u004f\u0021\u005b\u0024\u0021\u007c\u0051\u0026\u0072\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0078\u0024\u0047\u0069\u0042\u0079\u0075\u0062\u0079\u0052\u0065\u0066\u003a\u0046\u0054\u0056\u0042\u0079\u003d\u0061\u0033\u0079\u007e\u004e\u0028\u0052\u0036\u0032\u0064\u0048\u0047\u0077\u0058\u0062\u0053\u0038\u006c\u004e\u003f\u0024\u0048\u006e\u0056\u0057\u0041\u004a\u004f\u004b\u0063\u006a\u006a\u003d\u0073\u006c\u003c\u0054\u0055\u005e\u003b\u0049\u0031\u0057\u0076\u007b\u0057\u0070\u002b\u0050\u0035\u0074\u0049\u0022\u004b\u0055\u0024\u0061\u0021\u0042\u002b\u0057\u0062\u003a\u0059\u0035\u006d\u0034\u0022\u0037\u0059\u0025\u0045\u006d\u002f\u007c\u003c\u0055\u005f\u0072\u002a\u0029\u0077\u0024\u007e\u0043\u0039\u0045\u002f\u0040\u003b\u0042\u0052\u0045\u0025\u0069\u003b\u003b\u005a\u0034\u004d\u005f\u002f\u0045\u005d\u0026\u0029\u0059\u0070\u0074\u0049\u003c\u0023\u0074\u004a\u0074\u0078\u0043\u003f\u0029\u0068\u002a\u0052\u005b\u0078\u0075\u0042\u0079\u0034\u0048\u0034\u0071\u007e\u0045\u0041\u006b\u0028\u006a\u0037\u0053\u007e\u0046\u0049\u006f\u0075\u0056\u0042\u0078\u0061\u0034\u0069\u004f\u0077\u0052\u003d\u0040\u0070\u006a\u0021\u0045\u0054\u0048\u0071\u0028\u0073\u0068\u0057\u004e\u0060\u0026\u005e\u0030\u005e\u0036\u0043\u0068\u006b\u0067\u0028\u0030\u0074\u006a\u007e\u0033\u0075\u0048\u004d\u003c\u004b\u0021\u0028\u0052\u007c\u004a\u0071\u006a\u0061\u005b\u0050\u0075\u0074\u0043\u006b\u0038\u0059\u002c\u0062\u0035\u005b\u0075\u0035\u0058\u006a\u002b\u005e\u0077\u003b\u0044\u003a\u0069\u002f\u005e\u0033\u0064\u0076\u0053\u0051\u005e\u0036\u0050\u0068\u007e\u0037\u0052\u0034\u007e\u006b\u0043\u0045\u0026\u0035\u0067\u0045\u0050\u002c\u0068\u0066\u0045\u0079\u004b\u007e\u007a\u0078\u0024\u005a\u006b\u0071\u0073\u0072\u0057\u006f\u006c\u0045\u005d\u0045\u006a\u0029\u003d\u006c\u0055\u002e\u0043\u0070\u0065\u0052\u006a\u0054\u0054\u004b\u0045\u005b\u002f\u0043\u0038\u005a\u006a\u003e\u0068\u0035\u003f\u0048\u007c\u007e\u0023\u004e\u005b\u004f\u0078\u0037\u0065\u0023\u004d\u0078\u0072\u0044\u003a\u003a\u0029\u0046\u0075\u004b\u0045\u005d\u0052\u004c\u004a\u0048\u006a\u002b\u0030\u003e\u002a\u0021\u0063\u004a\u003d\u005f\u0063\u006a\u003a\u0034\u0023\u0040\u0052\u0068\u0069\u0065\u0075\u006a\u0065\u005f\u004d\u0058\u0065\u005e\u0060\u0035\u0067\u006a\u0031\u007e\u002a\u0033\u0029\u002e\u0043\u0035\u0078\u0045\u006a\u0032\u0067\u0023\u0054\u0028\u0079\u004a\u004e\u006a\u0059\u0060\u0071\u004c\u0077\u0025\u0026\u006c\u0052\u0033\u0074\u005d\u0046\u005a\u004f\u006c\u0061\u002f\u0025\u0046\u0023\u004d\u003e\u0031\u0056\u0032\u002c\u0058\u002b\u005a\u0062\u0052\u0039\u0046\u005d\u0021\u0038\u0069\u0021\u004b\u0041\u007a\u005e\u0042\u0073\u003e\u0049\u006b\u003e\u0040\u0052\u0047\u007c\u0035\u0041\u004a\u0060\u0038\u003e\u003d\u0077\u0070\u005d\u0038\u0045\u0057\u0062\u0051\u0048\u004b\u007c\u0050\u0050\u0070\u002c\u006b\u007a\u0030\u0060\u0030\u0062\u0037\u0051\u0061\u0065\u0050\u0068\u0030\u003e\u0072\u0066\u007d\u0024\u0052\u0026\u0039\u002b\u0079\u0028\u0038\u0065\u0031\u0026\u003c\u002c\u002c\u002e\u0030\u0022\u006c\u0076\u0043\u0034\u0064\u0075\u006a\u003d\u0067\u0070\u0024\u0064\u0076\u0053\u0051\u005e\u0036\u003d\u0026\u0046\u007d\u002f\u007e\u003d\u0040\u004a\u005b\u0058\u0021\u006c\u0037\u0046\u006f\u002f\u0049\u0056\u0039\u0046\u006d\u0021\u0028\u0078\u0073\u006c\u0024\u0073\u0051\u0064\u0060\u0060\u0042\u0062\u0062\u0051\u0073\u002e\u0073\u006a\u004e\u0067\u0038\u006e\u002c\u004f\u0029\u0052\u005b\u0048\u0022\u0060\u006a\u0030\u003b\u002b\u0051\u002e\u0043\u0053\u0026\u0034\u003c\u003c\u002e\u0051\u0048\u0032\u005d\u0022\u0078\u0048\u003e\u0023\u0062\u002c\u0057\u0079\u0029\u004d\u0021\u0029\u0051\u002e\u004a\u0046\u0046\u0033\u004e\u007a\u0056\u0043\u006d\u0072\u004e\u0025\u0043\u0053\u005b\u005d\u0050\u003d\u003c\u0023\u004d\u0046\u0050\u0041\u005a\u0026\u0029\u0042\u004e\u0032\u005e\u0050\u0079\u0070\u0043\u0073\u003e\u0024\u0030\u007a\u0035\u0026\u0029\u005a\u0057\u0050\u005e\u0028\u006f\u0022\u0073\u003c\u002e\u0051\u0048\u0032\u005d\u0022\u0078\u0048\u003e\u0023\u0062\u002c\u0057\u0079\u0029\u004d\u0021\u0029\u0051\u002e\u004a\u0046\u0046\u0033\u004e\u007a\u0056\u0043\u006d\u0067\u0047\u0035\u0076\u003b\u005b\u0023\u004f\u007c\u0024\u006a\u0052\u0078\u0070\u0026\u002c\u004b\u0045\u0041\u004a\u004f\u0078\u0048\u005e\u0057\u004e\u003f\u0054\u003c\u0030\u003b\u0045\u0046\u006d\u0021\u0028\u007c\u0059\u0049\u0051\u0028\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0033\u0056\u0045\u003e\u0075\u002b\u0044\u0028\u0057\u0023\u0040\u0021\u003d\u005f\u004a\u0052\u0044\u004e\u0022\u0031\u0075\u0053\u003d\u0047\u0078\u0036\u007c\u0023\u0052\u005b\u0048\u002f\u0063\u006a\u0079\u003c\u0028\u006e\u0048\u0044\u0072\u0035\u0060\u006a\u0074\u0074\u0039\u0067\u007c\u0023\u0052\u005b\u0048\u002f\u0025\u0059\u0038\u0048\u0060\u0076\u0025\u0054\u0024\u006c\u0066\u0023\u002a\u004a\u0053\u002a\u005e\u006a\u002e\u002a\u0030\u0022\u0045\u007a\u0038\u0062\u0075\u006c\u0053\u0069\u0065\u0077\u007b\u0045\u004c\u0076\u0030\u002e\u0075\u005d\u0037\u004e\u0055\u002a\u0063\u0049\u006a\u0024\u007b\u003f\u007c\u0023\u004a\u0051\u0040\u0046\u004a\u004f\u0078\u0045\u006a\u0051\u004c\u003d\u0050\u0060\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u0025\u0047\u006d\u005d\u003c\u003a\u0078\u0026\u0068\u002b\u002e\u0043\u0049\u002a\u004a\u0052\u0044\u004e\u0022\u0031\u0075\u0053\u003d\u0047\u0043\u0052\u005e\u0043\u007e\u007e\u0040\u004c\u0044\u0