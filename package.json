079\u0056\u0079\u0044\u003a\u007d\u006f\u0034\u0064\u0051\u003b\u005b\u007d\u0037\u0039\u004f\u0079\u003f\u0048\u0047\u003e\u0024\u005d\u0024\u003f\u002f\u0063\u0025\u0043\u0030\u0028\u0051\u005f\u004d\u0066\u0047\u0070\u0053\u0034\u0030\u0048\u0050\u0063\u0053\u002f\u006f\u0062\u005e\u0067\u0050\u0071\u0043\u0028\u002b\u0069\u0028\u005d\u0050\u0074\u007e\u0032\u005b\u007d\u0072\u0040\u0033\u0079\u0041\u007b\u002f\u0070\u002c\u005a\u004d\u006d\u0038\u0079\u0038\u004e\u0042\u0028\u0064\u0079\u005a\u003c\u002c\u003b\u002a\u0022\u0052\u0026\u003b\u0062\u0065\u0069\u0022\u0051\u0072\u0050\u006c\u007a\u0041\u004d\u0029\u0075\u0062\u0063\u0067\u0047\u002f\u0062\u004e\u005b\u0075\u0050\u007c\u0050\u0050\u005a\u0023\u0031\u005f\u0072\u0070\u0041\u0057\u002f\u0028\u0064\u006f\u0065\u0023\u0061\u0048\u003e\u0021\u0066\u003d\u006a\u0045\u0076\u0059\u002c\u0061\u0073\u0062\u0077\u0051\u003b\u0050\u007d\u0046\u007e\u0037\u0021\u005a\u0056\u0032\u0078\u007e\u003c\u0024\u0050\u0057\u0043\u0029\u003e\u003c\u006a\u0068\u0045\u0037\u0043\u0040\u007a\u0075\u005b\u007d\u0062\u0039\u004f\u0079\u003f\u0048\u0025\u0070\u006a\u005d\u007c\u003f\u002f\u0069\u0025\u0043\u0038\u005e\u005d\u0035\u006a\u005e\u0023\u004d\u0070\u0066\u0068\u007d\u0061\u0060\u0034\u0068\u006c\u0068\u005f\u0065\u0071\u006f\u006f\u0060\u0067\u0025\u002c\u0057\u0079\u0029\u003f\u0024\u0024\u0051\u006f\u006b\u0052\u006a\u0021\u004e\u0035\u0025\u0032\u0063\u0067\u0047\u0024\u006d\u007c\u0021\u0025\u0079\u002a\u0046\u0047\u004d\u0028\u004d\u0074\u003c\u002e\u0051\u0048\u0058\u0034\u0077\u0078\u0047\u0070\u0033\u005a\u0073\u0048\u0064\u0063\u006c\u0070\u005a\u0035\u0046\u0051\u0076\u005e\u0026\u004f\u0061\u005d\u0048\u003e\u0053\u0034\u007c\u006d\u0028\u004f\u0035\u0032\u0072\u002a\u0076\u005e\u0024\u0078\u0058\u006f\u0047\u0070\u0056\u0066\u0074\u0066\u003e\u002b\u0029\u0042\u003b\u0075\u0033\u004d\u0065\u004b\u0029\u003c\u0024\u0073\u0056\u003b\u004b\u0044\u0029\u0046\u004a\u0047\u002f\u0024\u0024\u0079\u0053\u005a\u0039\u0031\u0067\u0023\u0022\u0051\u007c\u0032\u0048\u006a\u0032\u0063\u0045\u005f\u0060\u0078\u007d\u007b\u0065\u002f\u0069\u0048\u003b\u0038\u004f\u0070\u0055\u004c\u004d\u003e\u0040\u0073\u0039\u0072\u002a\u002e\u0043\u0075\u0035\u0025\u0078\u0077\u003a\u0033\u005a\u007c\u003f\u0067\u0047\u0072\u0045\u0026\u006c\u0024\u0078\u0023\u0061\u0048\u0070\u0077\u0066\u003b\u0073\u003b\u0045\u002b\u0051\u0051\u007c\u0043\u0038\u0025\u0059\u0065\u0055\u007c\u004d\u0030\u0048\u0050\u0063\u0032\u0062\u0070\u0021\u0047\u004c\u0021\u005b\u007d\u0065\u0040\u006e\u0079\u002c\u0068\u0038\u0055\u0030\u003b\u003c\u003a\u006d\u0049\u007c\u0036\u0066\u002b\u0063\u0057\u0047\u0051\u007c\u004a\u0064\u003b\u0055\u003a\u006e\u005a\u0024\u0043\u0033\u0048\u007a\u0034\u0057\u003b\u0057\u0049\u0064\u0068\u002a\u0057\u003d\u0047\u004d\u004c\u004d\u0024\u002f\u002a\u0069\u007c\u002b\u006e\u0062\u006f\u006c\u0029\u0038\u002e\u0026\u0073\u004d\u0021\u0066\u0074\u005f\u0049\u0026\u002b\u0047\u0051\u007c\u004a\u0064\u003b\u0069\u005e\u004c\u002f\u005b\u007d\u0036\u0036\u007a\u0079\u0065\u0068\u0047\u004d\u002c\u005a\u0043\u003f\u0039\u0047\u0046\u006d\u0047\u0051\u0064\u0079\u004a\u003b\u0047\u004d\u0043\u0066\u0068\u0030\u002f\u0063\u0063\u0057\u0076\u0051\u004c\u0028\u0028\u0076\u0023\u004d\u0077\u0066\u006e\u0073\u004a\u0063\u007e\u0057\u0051\u007c\u0038\u0065\u007c\u0050\u0047\u0070\u007b\u0060\u006d\u002a\u0038\u005b\u007d\u005f\u0029\u0033\u0079\u0024\u0061\u004b\u006f\u0030\u003b\u003c\u003a\u004a\u0045\u007e\u0048\u0046\u004a\u006b\u0079\u006a\u006f\u0047\u0070\u0056\u0066\u003a\u0030\u002f\u0063\u0046\u0051\u003e\u0028\u005a\u0035\u006d\u005e\u0023\u004d\u0043\u0066\u0050\u002b\u003b\u0045\u0032\u0029\u0046\u006d\u0022\u0054\u0075\u0050\u002b\u005b\u007d\u0043\u0061\u005f\u0079\u0043\u0068\u0047\u004d\u0026\u0034\u0025\u006d\u0046\u007e\u0074\u006d\u003f\u006c\u0030\u0065\u0046\u0065\u0070\u0055\u004c\u0034\u0042\u0024\u006a\u0063\u0050\u0029\u0068\u0044\u0028\u0050\u0054\u0034\u0047\u0070\u006d\u005d\u0074\u005e\u0074\u0075\u005f\u004f\u004e\u0074\u0049\u005b\u007d\u0039\u0039\u0042\u0079\u003c\u002f\u0076\u0037\u0025\u0074\u003f\u0021\u0057\u0032\u0051\u0061\u0065\u0052\u006a\u0037\u0074\u0057\u0078\u0071\u0048\u0064\u0052\u0050\u006a\u004c\u0075\u003f\u003a\u0077\u0037\u0073\u006f\u006c\u002b\u002f\u0063\u006a\u006b\u0050\u004e\u0064\u0071\u0057\u0062\u0051\u0041\u0025\u007c\u0024\u0053\u0043\u003f\u0050\u0034\u0072\u0069\u003c\u0041\u005e\u0046\u007d\u003a\u0076\u005e\u004b\u0038\u004e\u0035\u004d\u0060\u0044\u0050\u005f\u0072\u0069\u0028\u0038\u007e\u006e\u004c\u0032\u0023\u0072\u0045\u005e\u006c\u0053\u002c\u0021\u003e\u0050\u0070\u0064\u0025\u0062\u0063\u0069\u0079\u006b\u007d\u0069\u0076\u0051\u006b\u0079\u0030\u007d\u0042\u0025\u005f\u003c\u007e\u0076\u006e\u005d\u0034\u0062\u0047\u0051\u0050\u0079\u0067\u006a\u0063\u0070\u0053\u0066\u0045\u003b\u0043\u0022\u006b\u0031\u0074\u0057\u0049\u0066\u003c\u0077\u004d\u003c\u0024\u0028\u0065\u004a\u005e\u0052\u006a\u006d\u004e\u005b\u0054\u007b\u006f\u0074\u0035\u002c\u0035\u0039\u0070\u007b\u0065\u003f\u0048\u004a\u003b\u007c\u0050\u0034\u004e\u0047\u0066\u003a\u0069\u002e\u002b\u006e\u0047\u0076\u0037\u005f\u003e\u0057\u0048\u0063\u002f\u0050\u006a\u0032\u0061\u007a\u0046\u0050\u004e\u005a\u0079\u002b\u0065\u0021\u0069\u002f\u0069\u006a\u0075\u0033\u0068\u0048\u0064\u0028\u0040\u005b\u0074\u0053\u005e\u0064\u0046\u0040\u0067\u006f\u0042\u0069\u0040\u0021\u0053\u002a\u005a\u006a\u006f\u002f\u0077\u0059\u0045\u0026\u006c\u005f\u005f\u0026\u007e\u006b\u0079\u004a\u0042\u0068\u0078\u0071\u0057\u006f\u006c\u0072\u0035\u005a\u006a\u004c\u002c\u0031\u004b\u003a\u0046\u0021\u0021\u0056\u0072\u0062\u002a\u004a\u006b\u0079\u0057\u006a\u0034\u0071\u005a\u0070\u007c\u0053\u007b\u003d\u0040\u0026\u006c\u005f\u005f\u0078\u0069\u0023\u0057\u0063\u005e\u0021\u0022\u005f\u0066\u0032\u0077\u0079\u0028\u0050\u0079\u0030\u007d\u0050\u0057\u004d\u0055\u0075\u0042\u0069\u0037\u0051\u0060\u0035\u002a\u0046\u0044\u004e\u0055\u0022\u006b\u007a\u0030\u0043\u0055\u002f\u0058\u0076\u0063\u0028\u005b\u0065\u003c\u0067\u0055\u003a\u002e\u0054\u0026\u003c\u004c\u0035\u0070\u0048\u0044\u005b\u007d\u0031\u0069\u0042\u0079\u002f\u003e\u0025\u0070\u0042\u0064\u0048\u0053\u0079\u0029\u0063\u0057\u003b\u0043\u002c\u004a\u004a\u0034\u0063\u0046\u003f\u0026\u0076\u0033\u0062\u0076\u0051\u0058\u004f\u0074\u005f\u002f\u0041\u0042\u0072\u005d\u0076\u0052\u005b\u0059\u004f\u0048\u006a\u0049\u007b\u0057\u006a\u0022\u0031\u0046\u0078\u003b\u007b\u0076\u005e\u005f\u005f\u0038\u002c\u003b\u0052\u007b\u006a\u0053\u0067\u0050\u0023\u004b\u0042\u0058\u0045\u006c\u0051\u002a\u005a\u006a\u004c\u002c\u0072\u0034\u0071\u005e\u0035\u0034\u0072\u006b\u0051\u0076\u0022\u0051\u002b\u0065\u0031\u0033\u003c\u0077\u003d\u0028\u0024\u0039\u004e\u0021\u005f\u0048\u003d\u007d\u0056\u0062\u0051\u005f\u0065\u002c\u0047\u0079\u006b\u0062\u0024\u0048\u0051\u005b\u007d\u004f\u0048\u006a\u007b\u002f\u003e\u006c\u0070\u0053\u0034\u006a\u003a\u0029\u0063\u005d\u0021\u0076\u005e\u0063\u0064\u004e\u006a\u0048\u0070\u0038\u0055\u0073\u0053\u005b\u0069\u0051\u0074\u007b\u002b\u0032\u0051\u004c\u004a\u0074\u004e\u0048\u005d\u0038\u0069\u0032\u0051\u004c\u004a\u0037\u007b\u002f\u003e\u003c\u005d\u0046\u006a\u002c\u007b\u002f\u004d\u0026\u006c\u005f\u005f\u005d\u0075\u003c\u007c\u0074\u0041\u0034\u002a\u002f\u0077\u0042\u0028\u005e\u0036\u005b\u0025\u0050\u0070\u006a\u005d\u0066\u003f\u002f\u0063\u0049\u0066\u003a\u0069\u0059\u0046\u0024\u0054\u0051\u004c\u006d\u0057\u0046\u004a\u0075\u0035\u0043\u0070\u0048\u0070\u0074\u005d\u0063\u0024\u0079\u0056\u0029\u0063\u003a\u0063\u007e\u005b\u007d\u007d\u0040\u004f\u0079\u0045\u0035\u0025\u0070\u0055\u003b\u0078\u006d\u0030\u007e\u0023\u003b\u0076\u0056\u0029\u0040\u003c\u0028\u003c\u0036\u0038\u004f\u0047\u0070\u004d\u0031\u006f\u006d\u007e\u004f\u0060\u006c\u003b\u0043\u004f\u0065\u0071\u006f\u0047\u0070\u0070\u0038\u005b\u0024\u0041\u003d\u0069\u0022\u002c\u0062\u0076\u0051\u0079\u004a\u0048\u006a\u0050\u0065\u0051\u0058\u0057\u003a\u0044\u0059\u0051\u006c\u0050\u005e\u007d\u0069\u0037\u0051\u0077\u005b\u0074\u003a\u004e\u0040\u007d\u0069\u0062\u0051\u0061\u0065\u0048\u006a\u004e\u0039\u004d\u0062\u0069\u0028\u0068\u004f\u0030\u0071\u002e\u0078\u0049\u0064\u0034\u0062\u0047\u0051\u002b\u0065\u0074\u006b\u0025\u0065\u0077\u0047\u0051\u005b\u0065\u0074\u0026\u0076\u0032\u0051\u0031\u0062\u0077\u005e\u004b\u0038\u0074\u0025\u0030\u0050\u003e\u002b\u0057\u004e\u005b\u004d\u006b\u003b\u006a\u0029\u0066\u0051\u0058\u0028\u005b\u007d\u0072\u0040\u005f\u0079\u007a\u0066\u006c\u0070\u0053\u0034\u0041\u005a\u007b\u0029\u0058\u0057\u003a\u0044\u0046\u0032\u0023\u0061\u0052\u004d\u0043\u0066\u0026\u003f\u002f\u0063\u0053\u0023\u0040\u0021\u0055\u0068\u0021\u003e\u0044\u003e\u0061\u0050\u0041\u005a\u007b\u0029\u0058\u0057\u003a\u0044\u004c\u0025\u0039\u0061\u0072\u0071\u003f\u0071\u0075\u0079\u0075\u0033\u0078\u0024\u0037\u0029\u0037\u0024\u004b\u0034\u005a\u004d\u0026\u0061\u006d\u005b\u006a\u0048\u002f\u0069\u006a\u005b\u006b\u002e\u0076\u003b\u0043\u0048\u0068\u0074\u0067\u0024\u0021\u0053\u0074\u005f\u004b\u0065\u0069\u0039\u0051\u004e\u004a\u0048\u006a\u004c\u002c\u0042\u0077\u0035\u003c\u003a\u006e\u004a\u0045\u005b\u007d\u0066\u007e\u002e\u0079\u007a\u0066\u006c\u0070\u0026\u003b\u0029\u0026\u0057\u0043\u0057\u0075\u006c\u006d\u004a\u004e\u006a\u0045\u0047\u003b\u0037\u005a\u003b\u0043\u002f\u0079\u0051\u006a\u005d\u002a\u0072\u0057\u004d\u0021\u0055\u0068\u006f\u0074\u004a\u0042\u007b\u0055\u0047\u0074\u006d\u0021\u0028\u0068\u0049\u0043\u005b\u007d\u0062\u0039\u0074\u007b\u006c\u0046\u0047\u004d\u0072\u0066\u003f\u003f\u0078\u007e\u0039\u0057\u0048\u003a\u0061\u0049\u0074\u005e\u0070\u0055\u0077\u0066\u005a\u0057\u0057\u0059\u003f\u0073\u0075\u006c\u006d\u004a\u005d\u0059\u0077\u004d\u003b\u0069\u004d\u0065\u0050\u0063\u0023\u0023\u0070\u0021\u0073\u0079\u0060\u0035\u0048\u003e\u0044\u0050\u002e\u007b\u0044\u0063\u002e\u0076\u0049\u0064\u0029\u005f\u0025\u0059\u0055\u003a\u007c\u0031\u006e\u0023\u005b\u007d\u0076\u0039\u0065\u0079\u003c\u002f\u0025\u0070\u0052\u0079\u004a\u0078\u006c\u0065\u0077\u006c\u003b\u0043\u0069\u002f\u007c\u0024\u0044\u0058\u0035\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u006d\u0035\u0061\u006b\u004e\u0039\u003f\u002b\u0026\u0049\u0059\u004f\u0065\u0070\u0021\u006f\u006f\u0031\u0068\u0030\u0079\u0029\u0055\u006c\u0055\u004a\u0034\u0036\u0028\u0024\u0054\u0023\u0036\u002a\u003f\u0029\u0064\u0028\u0061\u002f\u0060\u006a\u005e\u0055\u005b\u0074\u003c\u002e\u0051\u0048\u0072\u0043\u005d\u0059\u0034\u004e\u0025\u0073\u006b\u0067\u0033\u0051\u003f\u0052\u0039\u0024\u0051\u005b\u006a\u0047\u002f\u003e\u003d\u0079\u006f\u0047\u0030\u006b\u002a\u0068\u003f\u003e\u003a\u006f\u0076\u0022\u0051\u002b\u0065\u0060\u006a\u0062\u0046\u0077\u0036\u0076\u002e\u0043\u002b\u002f\u004b\u0059\u0046\u0050\u0029\u0069\u0028\u007d\u004a\u0074\u002f\u007a\u0048\u006d\u0057\u0023\u0032\u0051\u0059\u004f\u004c\u0050\u0050\u0070\u004e\u0034\u0063\u0030\u0061\u0041\u0063\u0051\u005a\u0057\u004e\u005b\u0057\u0059\u005b\u007d\u0062\u0039\u0074\u007b\u002e\u0074\u003a\u0029\u0021\u0052\u0056\u006e\u007c\u0044\u0056\u0062\u007e\u0046\u0023\u005f\u0052\u0021\u0052\u0056\u006e\u0066\u0069\u003d\u0062\u006a\u003f\u0052\u0065\u0054\u004e\u0077\u004e\u0028\u006f\u002f\u0069\u004e\u005b\u0066\u0035\u005a\u006a\u0078\u006f\u002c\u0037\u002c\u0039\u004b\u0047\u0026\u006c\u0032\u005d\u004e\u006a\u006d\u0079\u006b\u007b\u002f\u002e\u0043\u004d\u004d\u004f\u0074\u0028\u0041\u003d\u005a\u0034\u0065\u0021\u0052\u0056\u006e\u0066\u0069\u003d\u0062\u006a\u003f\u0063\u003b\u0024\u0043\u0043\u0038\u004e\u003b\u0043\u002f\u0079\u004a\u003b\u0055\u003a\u0071\u0057\u003c\u007c\u0029\u002f\u0069\u002e\u0043\u0049\u002a\u0077\u0050\u005e\u0046\u004a\u0070\u002a\u0071\u0066\u0057\u0073\u0075\u006c\u0053\u0041\u004c\u0041\u0031\u006b\u005b\u007d\u006d\u004f\u002c\u0079\u0042\u0033\u006d\u0044\u0058\u0066\u0073\u0042\u0067\u006c\u0074\u0055\u0064\u0028\u006e\u0032\u006f\u0074\u002c\u0060\u0071\u003b\u0066\u0050\u006a\u0052\u002a\u0060\u006a\u005a\u0066\u0035\u0063\u006c\u0051\u0031\u0062\u0067\u0048\u004c\u0047\u003d\u0040\u0050\u0040\u0065\u0062\u0045\u0069\u0062\u007e\u0046\u0064\u0064\u006e\u002a\u0046\u007e\u002f\u004d\u0051\u007c\u0060\u0038\u004a\u003b\u0043\u0037\u0068\u0025\u0034\u0072\u0079\u0029\u003f\u0024\u004d\u0051\u0059\u004f\u0073\u003d\u0073\u003e\u0033\u005a\u003e\u0040\u004a\u0063\u0051\u0073\u0045\u006c\u006d\u004a\u005d\u0059\u0034\u004e\u005b\u0040\u006c\u003f\u0068\u003f\u0058\u0074\u0056\u007c\u003b\u002c\u003c\u002e\u0051\u0048\u002b\u0077\u0023\u0061\u0031\u0055\u002b\u0076\u0040\u006d\u0030\u007e\u0076\u0021\u0076\u005e\u005d\u0035\u0032\u0046\u007e\u0037\u0026\u0066\u004d\u0065\u004b\u0029\u003c\u0024\u0024\u0051\u006f\u006b\u0052\u006a\u0029\u006f\u004c\u004d\u0049\u003f\u0068\u003f\u002c\u0038\u005f\u0023\u0034\u0021\u0045\u0028\u0064\u0079\u005f\u0069\u006a\u006e\u0047\u003c\u0024\u0024\u0051\u006f\u006b\u0052\u006a\u006b\u0035\u0034\u0022\u0041\u003b\u0043\u004f\u0065\u0052\u006a\u004f\u0040\u0047\u005b\u007d\u006e\u0048\u0024\u007b\u006c\u0046\u0023\u0077\u0049\u0066\u0064\u0069\u0058\u0057\u0062\u0057\u0048\u0060\u0054\u0029\u0024\u0024\u004e\u0034\u003b\u0061\u0074\u002a\u003b\u0057\u0056\u006c\u0050\u002a\u0042\u0026\u0021\u0037\u0073\u0073\u0059\u006d\u005a\u0029\u0054\u0040\u002e\u0066\u0054\u0051\u002c\u0047\u003a\u003b\u0079\u0069\u0079\u0047\u005a\u0062\u0051\u004a\u0079\u0034\u0042\u0023\u004d\u0056\u0066\u0049\u0030\u004e\u0045\u003d\u002b\u0069\u0028\u0038\u0065\u006c\u0070\u0062\u004a\u004f\u007e\u0056\u0063\u0074\u0075\u0033\u0076\u0077\u002e\u0045\u006c\u0051\u0049\u0064\u0026\u0025\u0058\u0034\u0078\u0024\u0040\u0045\u007e\u0046\u002f\u0069\u004b\u0062\u0077\u0051\u0057\u0047\u0076\u0045\u0042\u002f\u0046\u0030\u003d\u002f\u004a\u005d\u007b\u005f\u0042\u0042\u006f\u0060\u0024\u0030\u006b\u002a\u0067\u0047\u0063\u0057\u0066\u0057\u005e\u0036\u005d\u0061\u0046\u0068\u0048\u0032\u005e\u0028\u0050\u004e\u006a\u0046\u004d\u0057\u006b\u0038\u0072\u0057\u0059\u0043\u0057\u005b\u006a\u003d\u002a\u006b\u003b\u003c\u0058\u0029\u005f\u0030\u0061\u0024\u004d\u0051\u0077\u005b\u0077\u0059\u0075\u0071\u0040\u0043\u0063\u005a\u0073\u0039\u0067\u0057\u003f\u006c\u0030\u0065\u0067\u0034\u003c\u0052\u004c\u0058\u0064\u007a\u007e\u0039\u0034\u007e\u007a\u006a\u0023\u0040\u003e\u0054\u002a\u002b\u0040\u0068\u0050\u0068\u004c\u0037\u0042\u0064\u0077\u0063\u0030\u0039\u0026\u0024\u0066\u004a\u004f\u0065\u0037\u0065\u006a\u0032\u0065\u0041\u006f\u0062\u004e\u0052\u006b\u003b\u0053\u004d\u0072\u0066\u006d\u003f\u0078\u007e\u0059\u0045\u0049\u0064\u0072\u0035\u0074\u0045\u0040\u0068\u0044\u0060\u0029\u0071\u002f\u002f\u005e\u007c\u0066\u0073\u0073\u002e\u0045\u006c\u0051\u0051\u007c\u0049\u005f\u0074\u004e\u0028\u0023\u006f\u006c\u0024\u0078\u0023\u0061\u0052\u004d\u0051\u0075\u002a\u0057\u003d\u003f\u0065\u0041\u0056\u0062\u005f\u0076\u004b\u004a\u005f\u002a\u0050\u0078\u003c\u0055\u0052\u0023\u0061\u004a\u004f\u0065\u0074\u0047\u0023\u004e\u0034\u002b\u0069\u0045\u0057\u0062\u0051\u005e\u0022\u0058\u006a\u003e\u003d\u0040\u003f\u006c\u003a\u0051\u0078\u0054\u006d\u0031\u007e\u0046\u004a\u0052\u002a\u005e\u006a\u0031\u0029\u0038\u0045\u0057\u0062\u0051\u007c\u0076\u0034\u0041\u0062\u0031\u007e\u0046\u004a\u0052\u002a\u007c\u0040\u0064\u006f\u0076\u005f\u004e\u0039\u006d\u005b\u0029\u0063\u0028\u0040\u005b\u0074\u0028\u0042\u0024\u0056\u006f\u006c\u0076\u005e\u003d\u002a\u005e\u006a\u0067\u005d\u0078\u0028\u0060\u0034\u007a\u0062\u0022\u005e\u0039\u005f\u005a\u006a\u0028\u007e\u0040\u004c\u0044\u0070\u0065\u0030\u007a\u0053\u0043\u006d\u0035\u0061\u006b\u0045\u0041\u0021\u006c\u0074\u0049\u002b\u0065\u003a\u0065\u0045\u003e\u0038\u0055\u0021\u0078\u0039\u0070\u0075\u0066\u0055\u004a\u004f\u0065\u0043\u0050\u002a\u0070\u0036\u0056\u006b\u002a\u002c\u0029\u0035\u0076\u0062\u002f\u0044\u0064\u0032\u004c\u0062\u007b\u0065\u0022\u0047\u0040\u0068\u007a\u007a\u0023\u004d\u0056\u0066\u003b\u0073\u004e\u0045\u002c\u0062\u0077\u0051\u0079\u004a\u0037\u007b\u0075\u0071\u0052\u0034\u0056\u0032\u0078\u007e\u003d\u0040\u0042\u0028\u0040\u005b\u0021\u003e\u0077\u004d\u0063\u003e\u0034\u0072\u0026\u0029\u0077\u0045\u003f\u0049\u0023\u007b\u002e\u0074\u003d\u004c\u006b\u0078\u004d\u005a\u003c\u002e\u0051\u0048\u006a\u0060\u005d\u0059\u0047\u0070\u004b\u0066\u003a\u0030\u0048\u007a\u005d\u0038\u0024\u0039\u0037\u005a\u003b\u005b\u003f\u0065\u006c\u0037\u006f\u003a\u0030\u0031\u0024\u005b\u0034\u0070\u0049\u0023\u0023\u0046\u006d\u0037\u005d\u0055\u0061\u0047\u0070\u0040\u0043\u0024\u003e\u003e\u0067\u0067\u0054\u0040\u006b\u006c\u006d\u004a\u0064\u003b\u007e\u0037\u0021\u005a\u0024\u004b\u0036\u0032\u0022\u0063\u0049\u005e\u006d\u0068\u0044\u004d\u0078\u0055\u0061\u0047\u0070\u003c\u003e\u0024\u0031\u004d\u002e\u005d\u0078\u004e\u0026\u006c\u0059\u005b\u0038\u004f\u0023\u004d\u007c\u004d\u0074\u0045\u002b\u0079\u006a\u0048\u004d\u0068\u0048\u004a\u0043\u003d\u005f\u0060\u006a\u003c\u0075\u0037\u006b\u0062\u006a\u0045\u005f\u003a\u0061\u0058\u0034\u0068\u0037\u0065\u0055\u0055\u0025\u002e\u007b\u0077\u0039\u0026\u0073\u0056\u006c\u006e\u004f\u007a\u0046\u0078\u0037\u0026\u0066\u0038\u0069\u0047\u0063\u003b\u007b\u0042\u0028\u0040\u005b\u0021\u003e\u0050\u0070\u0052\u0034\u004d\u006d\u003b\u003f\u0066\u0057\u0075\u006c\u003f\u0065\u006c\u0037\u0072\u0071\u003c\u003e\u0057\u0072\u0057\u0059\u0025\u0043\u0032\u005e\u0051\u002a\u0074\u005e\u0051\u0071\u005b\u0040\u0029\u0030\u007e\u0047\u0026\u002b\u0062\u0051\u005d\u0050\u0058\u006f\u0047\u0070\u0056\u0066\u0068\u0061\u0053\u0039\u0031\u003c\u006b\u006c\u0050\u0079\u0054\u003d\u004c\u0037\u002c\u005a\u0024\u003f\u0068\u003f\u0056\u006f\u002c\u0075\u004b\u0021\u003e\u0046\u005a\u0035\u0041\u0037\u005a\u0047\u0048\u0035\u0031\u0065\u0050\u0063\u007c\u002b\u0022\u005e\u0051\u002a\u0071\u006a\u0047\u007b\u0065\u0022\u0047\u007c\u0030\u0032\u0046\u0023\u004d\u0062\u006a\u007a\u006d\u007e\u0047\u0028\u0073\u003d\u0028\u007e\u0025\u0037\u007b\u004a\u0070\u002e\u0055\u0047\u0032\u0050\u0063\u007c\u002b\u0022\u005e\u0030\u0051\u0074\u002c\u004f\u0042\u0061\u0061\u0051\u0056\u0064\u003b\u0047\u004d\u007c\u004d\u0072\u006d\u0029\u0063\u005d\u0021\u0026\u006c\u006b\u0079\u006a\u006f\u0023\u004d\u006a\u0021\u0042\u0024\u004a\u0045\u0030\u0045\u004b\u004a\u0076\u0038\u0037\u007b\u0034\u004e\u0061\u0050\u0062\u006a\u006a\u004c\u005b\u007d\u005a\u0038\u002c\u0079\u007a\u007a\u0047\u004d\u0024\u005d\u0056\u0053\u003d\u0047\u003d\u0062\u0050\u005e\u0071\u0078\u0042\u0026\u006f\u003a\u0040\u0064\u0074\u0075\u0060\u0033\u0041\u0048\u0035\u0043\u0044\u0031\u002e\u0021\u003e\u0055\u0060\u0058\u003b\u0056\u0032\u0051\u0067\u0030\u0045\u0046\u004a\u005a\u0035\u0063\u006a\u0049\u0037\u0057\u005b\u003b\u006b\u007e\u0025\u0021\u002f\u0079\u006a\u006f\u0023\u004d\u006a\u0021\u0041\u005a\u0079\u0029\u0037\u0024\u004d\u0051\u0059\u004f\u0050\u0046\u0074\u0071\u0021\u0024\u0060\u005e\u006d\u003a\u0044\u005f\u005f\u0034\u0026\u0047\u0070\u0075\u0051\u004a\u002b\u002e\u0045\u0046\u006d\u004f\u006c\u002f\u0079\u006d\u006a\u0037\u006f\u0051\u0075\u0040\u003b\u0043\u0065\u0065\u0075\u006a\u0044\u0074\u003d\u0064\u007c\u007c\u0057\u004c\u0044\u0057\u0054\u0076\u0061\u0069\u0045\u005f\u003a\u0061\u0042\u0021\u0043\u0050\u0043\u0037\u0034\u0066\u0051\u003f\u0052\u0039\u0024\u0051\u0062\u003e\u0056\u004a\u0054\u0026\u0039\u0079\u003e\u0076\u005e\u0061\u002f\u006e\u004f\u006b\u005a\u007a\u002f\u006c\u003f\u0078\u007e\u0063\u0075\u0059\u0045\u0049\u0064\u0051\u005f\u003d\u003d\u0055\u003a\u0077\u003b\u006b\u002b\u004e\u0045\u0059\u0045\u0038\u0066\u0060\u0075\u0026\u005e\u004c\u0037\u005a\u003e\u002c\u0057\u0021\u0062\u002e\u0070\u006c\u004a\u003d\u0062\u0050\u005e\u0071\u0078\u0042\u0026\u006f\u003a\u0040\u0064\u0058\u006a\u0049\u0058\u0030\u0045\u0072\u003e\u0068\u002b\u0023\u0051\u0051\u002a\u0062\u007c\u0069\u0077\u0071\u0034\u007c\u003f\u0050\u0063\u003b\u006c\u002a\u006c\u0052\u002a\u0074\u0063\u0073\u0050\u006d\u0036\u006b\u006e\u0045\u005f\u003a\u0061\u006a\u0060\u005d\u0059\u0047\u0070\u0040\u0070\u004d\u0049\u0029\u0070\u0024\u006d\u0028\u004e\u0078\u0052\u006a\u006f\u0052\u005a\u0062\u0070\u0024\u0049\u0051\u0044\u002f\u005a\u006a\u0047\u006e\u0036\u0034\u0045\u0072\u0045\u005e\u006c\u004d\u0078\u0045\u006a\u0070\u0076\u002b\u002b\u0046\u006d\u0056\u0032\u0069\u0070\u0066\u0058\u004a\u0028\u006d\u0055\u0067\u0035\u006a\u0075\u006d\u0077\u0039\u0070\u0062\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u003f\u004c\u0023\u007a\u0057\u003a\u0078\u006b\u0047\u0068\u0079\u006f\u003e\u0077\u0040\u006d\u0076\u0039\u0067\u0023\u005f\u0028\u007a\u0028\u002f\u0026\u006b\u0044\u003d\u0025\u0064\u0034\u0078\u0037\u0063\u0075\u0024\u004e\u0045\u0034\u0034\u0029\u004b\u0077\u007e\u006d\u0041\u007e\u0079\u005a\u0023\u005e\u0062\u0036\u0079\u006a\u006f\u0071\u0064\u002e\u0040\u006e\u007c\u0044\u0072\u0064\u0053\u005e\u0066\u004b\u007b\u0034\u0058\u0063\u0051\u0068\u007c\u0021\u0030\u0079\u0063\u005f\u0077\u0057\u0049\u0035\u006f\u007a\u0077\u0043\u004e\u002e\u0050\u0039\u0037\u0036\u005b\u0058\u0050\u0057\u0044\u0058\u002e\u003e\u0056\u002e\u0041\u0031\u003a\u0061\u007c\u004e\u002e\u004a\u004f\u004e\u0036\u005b\u0058\u0050\u0057\u0044\u0058\u0041\u007a\u0059\u0047\u004e\u002e\u003d\u0034\u003f\u0036\u005b\u0058\u0043\u0052\u0044\u0058\u0041\u007a\u0021\u002e\u0041\u0031\u007e\u0061\u005f\u005f\u005b\u0058\u0078\u0052\u0044\u0058\u0030\u0076\u0021\u002e\u0041\u0031\u0078\u0061\u003a\u004c\u0058\u0028\u0068\u002c\u0037\u0049\u004f\u003c\u0072\u004b\u0023\u006d\u0073\u0023\u004b\u003f\u0032\u0064\u0053\u005e\u0035\u002c\u007e\u0065\u005d\u0029\u0039\u0023\u007b\u004a\u0057\u0043\u0075\u005d\u0038\u002a\u0068\u0068\u0073\u006b\u006c\u0051\u002a\u0040\u0040\u0022\u0041\u005b\u0031\u0041\u0024\u0072\u004b\u0026\u0032\u0073\u0023\u0024\u0071\u0070\u006d\u002a\u006b\u004c\u007a\u004a\u0031\u0024\u0021\