02f\u0074\u0021\u0049\u005f\u0037\u003a\u0048\u0051\u0064\u0059\u004f\u003b\u006a\u006f\u003a\u0059\u0072\u007e\u006b\u007a\u0045\u0031\u007b\u0048\u003a\u0060\u0029\u007d\u0070\u0070\u0021\u0052\u0033\u0062\u0065\u004b\u004d\u0040\u0053\u006e\u002a\u0057\u004c\u003c\u002e\u0051\u0048\u0040\u0068\u0029\u004f\u0064\u006f\u002a\u0025\u0063\u0024\u0021\u0057\u003d\u0028\u005d\u0050\u0058\u0029\u0048\u0070\u0021\u006d\u006d\u0048\u0076\u002c\u007e\u0048\u0042\u005d\u0056\u0079\u0039\u0046\u0057\u004e\u0034\u0077\u005b\u005d\u0035\u0051\u0066\u0066\u0076\u006c\u0051\u003b\u0043\u0025\u0079\u0024\u0043\u0063\u006f\u0043\u002a\u0062\u0021\u0041\u0046\u002c\u0038\u0041\u0077\u006f\u006c\u0066\u0035\u0025\u0059\u0047\u0070\u004b\u0048\u0048\u006c\u003c\u005d\u0029\u002b\u0062\u0022\u0051\u0060\u0038\u006e\u0056\u004f\u0048\u0029\u002f\u0063\u0037\u005e\u005f\u006d\u004e\u0076\u0051\u005e\u0036\u002c\u0047\u0050\u0070\u004b\u0056\u0023\u0030\u007c\u0046\u006f\u0076\u0046\u006d\u007b\u0053\u004b\u0040\u006d\u0063\u0044\u0067\u0070\u0026\u006c\u003d\u002a\u0053\u0065\u006a\u0032\u0065\u002f\u005f\u0064\u0067\u0038\u0062\u0079\u004b\u003d\u005f\u007e\u0065\u006a\u007a\u0044\u0046\u0067\u0023\u0041\u004a\u006d\u0078\u0059\u0040\u003c\u004e\u0051\u0040\u006e\u0042\u0075\u0063\u0072\u0030\u002f\u005b\u0059\u003c\u005b\u0057\u003c\u006d\u005b\u002e\u0078\u007d\u0046\u0073\u004d\u0035\u0025\u006e\u002a\u0023\u002e\u0022\u005a\u0050\u0047\u003a\u004c\u0076\u0058\u0031\u003a\u0044\u0058\u0051\u003c\u0045\u0047\u0034\u004e\u002e\u004d\u0040\u0069\u0036\u0058\u0062\u0065\u0026\u0055\u0022\u007a\u003c\u0076\u0066\u004e\u002e\u006f\u0048\u0047\u0036\u0058\u0062\u0065\u0026\u0044\u0058\u0056\u003e\u0043\u002e\u0022\u005a\u0077\u0047\u003a\u004c\u003a\u004e\u004d\u003a\u0044\u0058\u0036\u0025\u003f\u0046\u0059\u0075\u0046\u003f\u0047\u0062\u0026\u004e\u002e\u0037\u0039\u002b\u0036\u0058\u0062\u003c\u007c\u0044\u0058\u0049\u0076\u0021\u002e\u0022\u005a\u0056\u0048\u005f\u005f\u0058\u0062\u004d\u0026\u0044\u0058\u0036\u0025\u0043\u002e\u0022\u005a\u0076\u0047\u003a\u004c\u003e\u007c\u0077\u004b\u0046\u0075\u0024\u0038\u0029\u0051\u002b\u0050\u006f\u0061\u0039\u0023\u007b\u004a\u0078\u0036\u006e\u0042\u0023\u004d\u0078\u002c\u007e\u0024\u0053\u0047\u0029\u0033\u007e\u0024\u0053\u0047\u0029\u0033\u0074\u002b\u002a\u0060\u0058\u006c\u0063\u0029\u0033\u0032\u007b\u0044\u004c\u0036\u0076\u002e\u0043\u0049\u0058\u003b\u0042\u0073\u003e\u0078\u002c\u0042\u0021\u003a\u004b\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u003f\u004e\u0046\u0051\u0060\u0033\u0062\u0060\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0046\u0069\u003f\u0057\u0075\u0075\u0072\u003c\u0077\u0036\u0040\u0024\u0032\u0037\u0041\u0033\u0035\u0034\u0052\u0056\u003e\u0069\u0050\u006a\u002b\u0023\u0022\u003a\u006c\u0034\u005f\u0079\u005e\u0042\u0024\u0040\u002c\u0065\u007e\u0024\u005d\u0036\u006e\u0040\u0049\u007c\u0058\u0038\u0042\u0042\u0055\u003a\u005d\u0031\u0061\u006b\u0067\u0047\u0066\u0033\u0069\u0069\u002f\u0063\u007c\u002b\u004a\u0043\u0042\u0035\u005d\u0069\u0031\u0060\u0043\u0052\u004f\u005d\u0074\u003d\u003a\u002f\u0050\u006a\u0058\u0079\u0062\u0038\u0031\u0060\u003e\u0072\u006b\u002a\u0050\u0063\u0072\u0045\u005e\u006c\u006a\u0060\u0038\u0042\u0034\u004e\u0040\u0066\u0029\u0064\u0052\u0039\u002e\u0067\u007e\u0028\u004e\u0078\u0023\u0061\u004d\u0060\u004d\u0064\u0069\u0030\u0072\u0041\u0065\u0041\u003c\u0072\u0069\u0046\u0023\u0053\u0047\u0057\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\u0079\u0029\u0068\u0069\u0052\u0051\u003b\u0062\u0046\u005e\u0061\u007c\u0078\u0026\u0062\u0050\u0041\u002f\u0074\u0054\u0053\u004b\